/-!
# Horoballs and the cocompact part for finite-index subgroups of `SL(2, ℤ)`

Foundation file of the unconditional Eichler–Shimura route:
the height-one horoball `H_g = {z | 1 < Im (g⁻¹ z)}` at the cusp `g ∞`;
* two points of `H_∞` related by `γ ∈ SL(2, ℤ)` force `γ` to fix `∞` (`lowerLeft_eq_zero_of_horoball`), hence
  `γ H_g ∩ H_g ≠ ∅ ⇒ g⁻¹ γ g` is upper triangular (`conj_lowerLeft_eq_zero`);
* for a finite-index subgroup `Γ`, the complement of all horoballs is covered by the `Γ`-translates of
  one compact set (`exists_compact_complement_horoballs`);
* the stabiliser `Γ_{g∞}` of a cusp (`cuspStab`) consists of elements `g(±Tᵏ)g⁻¹`, and for `-1 ∉ Γ` it is
  infinite cyclic, generated by `g(εTʰ)g⁻¹` with `h > 0` (`cuspStab_eq_zpowers`).

Written by Claude Opus 5.5.
-/

open UpperHalfPlane ModularGroup Complex
open scoped Modular MatrixGroups

noncomputable section

namespace TernaryPeriodPolynomials.Argument.ESFoundations

/-- The horoball of height one at the cusp `g ∞`. -/
def horoballAt (g : SL(2, ℤ)) : Set ℍ := {z | 1 < (g⁻¹ • z).im}

theorem mem_horoballAt_one (z : ℍ) : z ∈ horoballAt 1 ↔ 1 < z.im := by
  simp [horoballAt]

/-- If `z` and `γ z` both have imaginary part `> 1`, then `γ` has lower-left entry `0`. -/
theorem lowerLeft_eq_zero_of_horoball {γ : SL(2, ℤ)} {z : ℍ} (hz : 1 < z.im)
    (hγz : 1 < (γ • z).im) : γ 1 0 = 0 := by
  by_contra hc
  have hc1 : (1 : ℝ) ≤ ((γ 1 0 : ℤ) : ℝ) ^ 2 := by
    have : (1 : ℤ) ≤ (γ 1 0) ^ 2 := by
      have := Int.one_le_abs hc
      nlinarith [sq_abs (γ 1 0)]
    exact_mod_cast this
  have hpos : 0 < z.im := z.im_pos
  have hden : ((γ 1 0 : ℤ) : ℝ) ^ 2 * z.im ^ 2 ≤ Complex.normSq (denom γ z) := by
    rw [Complex.normSq_apply]
    have him : (denom γ z).im = ((γ 1 0 : ℤ) : ℝ) * z.im := by
      rw [ModularGroup.denom_apply]
      simp
    have hre := mul_self_nonneg (denom γ z).re
    rw [him]
    nlinarith
  have hsmul := ModularGroup.im_smul_eq_div_normSq γ z
  have hnpos : 0 < Complex.normSq (denom γ z) := by
    have := mul_pos (lt_of_lt_of_le one_pos hc1) (pow_pos hpos 2)
    linarith
  rw [hsmul, lt_div_iff₀ hnpos] at hγz
  nlinarith

/-- `γ H_g ∩ H_g ≠ ∅` forces `g⁻¹ γ g` to fix `∞`. -/
theorem conj_lowerLeft_eq_zero {g γ : SL(2, ℤ)} {z : ℍ} (hz : z ∈ horoballAt g)
    (hγz : γ • z ∈ horoballAt g) : (g⁻¹ * γ * g) 1 0 = 0 := by
  apply lowerLeft_eq_zero_of_horoball (z := g⁻¹ • z) hz
  have : (g⁻¹ * γ * g) • g⁻¹ • z = g⁻¹ • γ • z := by
    rw [← mul_smul, mul_assoc, mul_assoc, mul_inv_cancel, mul_one, mul_smul]
  rw [this]
  exact hγz

/-- The compact box `|Re z| ≤ 1/2`, `1/2 ≤ Im z ≤ 1`. -/
def box : Set ℍ := {z | |z.re| ≤ 1 / 2 ∧ 1 / 2 ≤ z.im ∧ z.im ≤ 1}

theorem isCompact_box : IsCompact box := by
  rw [UpperHalfPlane.isOpenEmbedding_coe.isCompact_iff]
  have himage : ((↑) : ℍ → ℂ) '' box =
      {w : ℂ | |w.re| ≤ 1 / 2 ∧ 1 / 2 ≤ w.im ∧ w.im ≤ 1} := by
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact hz
    · rintro ⟨h1, h2, h3⟩
      exact ⟨⟨w, by linarith⟩, ⟨h1, h2, h3⟩, rfl⟩
  rw [himage]
  apply Metric.isCompact_of_isClosed_isBounded
  · exact ((isClosed_le (continuous_abs.comp Complex.continuous_re) continuous_const).inter
      ((isClosed_le continuous_const Complex.continuous_im).inter
        (isClosed_le Complex.continuous_im continuous_const)))
  · rw [Metric.isBounded_iff_subset_closedBall 0]
    refine ⟨2, fun w ⟨h1, h2, h3⟩ => ?_⟩
    rw [Metric.mem_closedBall, dist_zero_right]
    calc ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
      _ ≤ 2 := by rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ w.im)]; linarith

theorem continuous_smul_SL (g : SL(2, ℤ)) : Continuous fun z : ℍ => g • z :=
  continuous_const_smul ((g : GL (Fin 2) ℝ))

/-- **Cocompactness of the complement of the horoballs.** For a finite-index subgroup `Γ` of
`SL(2, ℤ)` there is a compact `K ⊆ ℍ` such that every point outside all height-one horoballs is a
`Γ`-translate of a point of `K`. -/
theorem exists_compact_complement_horoballs (Γ : Subgroup SL(2, ℤ)) [Γ.FiniteIndex] :
    ∃ K : Set ℍ, IsCompact K ∧
      ∀ z : ℍ, (∀ g : SL(2, ℤ), z ∉ horoballAt g) → ∃ γ ∈ Γ, ∃ k ∈ K, z = γ • k := by
  classical
  have : Finite (SL(2, ℤ) ⧸ Γ) := Subgroup.finite_quotient_of_finiteIndex
  refine ⟨⋃ q : SL(2, ℤ) ⧸ Γ, (fun z => (Quotient.out q)⁻¹ • z) '' box,
    isCompact_iUnion fun q => isCompact_box.image (continuous_smul_SL _), ?_⟩
  intro z hz
  obtain ⟨s, hs⟩ := exists_smul_mem_fd z
  have hbox : s • z ∈ box := by
    have hle : (s • z).im ≤ 1 := by
      have := hz s⁻¹
      change ¬ 1 < (s⁻¹⁻¹ • z).im at this
      rw [inv_inv, not_lt] at this
      exact this
    have h34 := three_le_four_mul_im_sq_of_mem_fd hs
    have hpos := (s • z).im_pos
    refine ⟨hs.2, ?_, hle⟩
    nlinarith
  set r := Quotient.out (QuotientGroup.mk s : SL(2, ℤ) ⧸ Γ) with hr
  have hmem : r⁻¹ * s ∈ Γ := by
    have : (QuotientGroup.mk r : SL(2, ℤ) ⧸ Γ) = QuotientGroup.mk s := by
      rw [hr]; exact QuotientGroup.out_eq' _
    exact QuotientGroup.eq.mp this
  refine ⟨(r⁻¹ * s)⁻¹, Γ.inv_mem hmem, r⁻¹ • s • z, ?_, ?_⟩
  · exact Set.mem_iUnion.mpr ⟨QuotientGroup.mk s, ⟨s • z, hbox, rfl⟩⟩
  · rw [← mul_smul, ← mul_smul, show (r⁻¹ * s)⁻¹ * r⁻¹ * s = 1 by group, one_smul]

/-- For `γ ∈ SL(2, ℤ)` fixing `∞`, `γ = ±Tʰ`. -/
theorem eq_pm_T_zpow_of_lowerLeft_eq_zero {γ : SL(2, ℤ)} (hγ : γ 1 0 = 0) :
    ∃ h : ℤ, γ = ModularGroup.T ^ h ∨ γ = -ModularGroup.T ^ h := by
  have hdet : γ 0 0 * γ 1 1 = 1 := by
    have := γ.2
    rw [Matrix.det_fin_two, hγ] at this
    linarith
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · refine ⟨γ 0 1, Or.inl ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [ModularGroup.coe_T_zpow, ha, hd, hγ]
  · refine ⟨-γ 0 1, Or.inr ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [ModularGroup.coe_T_zpow, ha, hd, hγ]

/-- The stabiliser of `∞` in `SL(2, ℤ)`: lower-left entry `0`. -/
def stabInfty : Subgroup SL(2, ℤ) where
  carrier := {γ | γ 1 0 = 0}
  one_mem' := by simp
  mul_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq] at hx hy ⊢
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, hx, hy]
    ring
  inv_mem' {x} hx := by
    simp only [Set.mem_ofPred_eq] at hx ⊢
    rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
    simp [hx]

/-- The stabiliser in `Γ` of the cusp `g ∞`. -/
def cuspStab (Γ : Subgroup SL(2, ℤ)) (g : SL(2, ℤ)) : Subgroup SL(2, ℤ) :=
  Γ ⊓ (stabInfty.map (MulAut.conj g).toMonoidHom)

theorem mem_cuspStab_iff (Γ : Subgroup SL(2, ℤ)) (g γ : SL(2, ℤ)) :
    γ ∈ cuspStab Γ g ↔ γ ∈ Γ ∧ (g⁻¹ * γ * g) 1 0 = 0 := by
  simp only [cuspStab, Subgroup.mem_inf, Subgroup.mem_map]
  constructor
  · rintro ⟨hγ, δ, hδ, rfl⟩
    refine ⟨hγ, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [show g⁻¹ * (g * δ * g⁻¹) * g = δ by group]
    exact hδ
  · rintro ⟨hγ, h0⟩
    refine ⟨hγ, g⁻¹ * γ * g, h0, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group

/-- Points of a horoball related by an element of `Γ`: the element stabilises the cusp. -/
theorem mem_cuspStab_of_horoball {Γ : Subgroup SL(2, ℤ)} {g γ : SL(2, ℤ)} (hγ : γ ∈ Γ) {z : ℍ}
    (hz : z ∈ horoballAt g) (hγz : γ • z ∈ horoballAt g) : γ ∈ cuspStab Γ g :=
  (mem_cuspStab_iff Γ g γ).mpr ⟨hγ, conj_lowerLeft_eq_zero hz hγz⟩

/-- The translation length `ψ(±Tᵏ) = k` on the stabiliser of `∞`. -/
def transLen (δ : SL(2, ℤ)) : ℤ := δ 0 0 * δ 0 1

private theorem diag_of_mem_stabInfty {δ : SL(2, ℤ)} (hδ : δ 1 0 = 0) :
    δ 1 1 = δ 0 0 ∧ δ 0 0 * δ 0 0 = 1 := by
  have hdet : δ 0 0 * δ 1 1 = 1 := by
    have := δ.2
    rw [Matrix.det_fin_two, hδ] at this
    linarith
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · exact ⟨by rw [ha, hd], by rw [ha]; norm_num⟩
  · exact ⟨by rw [ha, hd], by rw [ha]; norm_num⟩

theorem transLen_mul {δ δ' : SL(2, ℤ)} (hδ : δ 1 0 = 0) (hδ' : δ' 1 0 = 0) :
    transLen (δ * δ') = transLen δ + transLen δ' := by
  obtain ⟨h1, h2⟩ := diag_of_mem_stabInfty hδ
  obtain ⟨h1', h2'⟩ := diag_of_mem_stabInfty hδ'
  simp only [transLen, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
    hδ', h1']
  linear_combination (δ' 0 0 * δ' 0 1) * h2 + (δ 0 0 * δ 0 1) * h2'

theorem eq_one_or_neg_one_of_transLen_eq_zero {δ : SL(2, ℤ)} (hδ : δ 1 0 = 0)
    (h0 : transLen δ = 0) : δ = 1 ∨ δ = -1 := by
  obtain ⟨h1, h2⟩ := diag_of_mem_stabInfty hδ
  have hb : δ 0 1 = 0 := by
    have : δ 0 0 ≠ 0 := by intro h; rw [h] at h2; simp at h2
    exact (mul_eq_zero.mp h0).resolve_left this
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' (show δ 0 0 * δ 0 0 = 1 from h2) with ⟨ha, -⟩ | ⟨ha, -⟩
  · left; ext i j; fin_cases i <;> fin_cases j <;> simp [ha, hb, hδ, h1]
  · right; ext i j; fin_cases i <;> fin_cases j <;> simp [ha, hb, hδ, h1]

private theorem conj_lowerLeft (g : SL(2, ℤ)) {γ : SL(2, ℤ)} {Γ : Subgroup SL(2, ℤ)}
    (hγ : γ ∈ cuspStab Γ g) : (g⁻¹ * γ * g) 1 0 = 0 := ((mem_cuspStab_iff Γ g γ).mp hγ).2

private theorem transLen_conj_mul {Γ : Subgroup SL(2, ℤ)} (g : SL(2, ℤ)) {γ γ' : SL(2, ℤ)}
    (hγ : γ ∈ cuspStab Γ g) (hγ' : γ' ∈ cuspStab Γ g) :
    transLen (g⁻¹ * (γ * γ') * g) = transLen (g⁻¹ * γ * g) + transLen (g⁻¹ * γ' * g) := by
  rw [show g⁻¹ * (γ * γ') * g = (g⁻¹ * γ * g) * (g⁻¹ * γ' * g) by group]
  exact transLen_mul (conj_lowerLeft g hγ) (conj_lowerLeft g hγ')

private theorem transLen_conj_zpow {Γ : Subgroup SL(2, ℤ)} (g : SL(2, ℤ)) {γ : SL(2, ℤ)}
    (hγ : γ ∈ cuspStab Γ g) (j : ℤ) :
    transLen (g⁻¹ * γ ^ j * g) = j * transLen (g⁻¹ * γ * g) := by
  have hpow : ∀ k : ℕ, transLen (g⁻¹ * γ ^ k * g) = k * transLen (g⁻¹ * γ * g) := by
    intro k
    induction k with
    | zero => simp [transLen]
    | succ k ih =>
      rw [pow_succ, transLen_conj_mul g ((cuspStab Γ g).pow_mem hγ k) hγ, ih]
      push_cast; ring
  rcases Int.eq_nat_or_neg j with ⟨k, rfl | rfl⟩
  · rw [zpow_natCast]; exact hpow k
  · have hinv : transLen (g⁻¹ * (γ ^ k)⁻¹ * g) + transLen (g⁻¹ * γ ^ k * g) = 0 := by
      rw [← transLen_conj_mul g ((cuspStab Γ g).inv_mem ((cuspStab Γ g).pow_mem hγ k))
        ((cuspStab Γ g).pow_mem hγ k), inv_mul_cancel, mul_one, inv_mul_cancel]
      simp [transLen]
    rw [zpow_neg, zpow_natCast]
    linarith [hpow k]

private theorem exists_pos_pow_mem (Γ : Subgroup SL(2, ℤ)) [Γ.FiniteIndex] (x : SL(2, ℤ)) :
    ∃ m : ℕ, 0 < m ∧ x ^ m ∈ Γ := by
  have : Finite (SL(2, ℤ) ⧸ Γ) := Subgroup.finite_quotient_of_finiteIndex
  obtain ⟨i, j, hij, heq⟩ := Finite.exists_ne_map_eq_of_infinite
    (fun k : ℕ => (QuotientGroup.mk (x ^ k) : SL(2, ℤ) ⧸ Γ))
  have hmem := QuotientGroup.eq.mp heq
  rcases lt_or_gt_of_ne hij with h | h
  · refine ⟨j - i, by omega, ?_⟩
    have e : x ^ j = x ^ i * x ^ (j - i) := by rw [← pow_add]; congr 1; omega
    rw [e, inv_mul_cancel_left] at hmem
    exact hmem
  · refine ⟨i - j, by omega, ?_⟩
    have e : x ^ i = x ^ j * x ^ (i - j) := by rw [← pow_add]; congr 1; omega
    rw [e, mul_inv_rev, mul_assoc, inv_mul_cancel, mul_one] at hmem
    simpa using Γ.inv_mem hmem

/-- **The cusp stabiliser is infinite cyclic** for a finite-index `Γ` not containing `-1`:
`Γ_{g∞} = ⟨g (εTʰ) g⁻¹⟩` with `h > 0`, `ε = ±1`. -/
theorem cuspStab_eq_zpowers (Γ : Subgroup SL(2, ℤ)) [Γ.FiniteIndex] (hneg : (-1 : SL(2, ℤ)) ∉ Γ)
    (g : SL(2, ℤ)) :
    ∃ γ₀ ∈ cuspStab Γ g, 0 < transLen (g⁻¹ * γ₀ * g) ∧ cuspStab Γ g = Subgroup.zpowers γ₀ ∧
      ∃ ε : SL(2, ℤ), (ε = 1 ∨ ε = -1) ∧
        γ₀ = g * (ε * ModularGroup.T ^ transLen (g⁻¹ * γ₀ * g)) * g⁻¹ := by
  classical
  -- a positive translation in the stabiliser
  obtain ⟨m, hm, hmΓ⟩ := exists_pos_pow_mem Γ (g * ModularGroup.T * g⁻¹)
  have hTmem : (g * ModularGroup.T * g⁻¹) ^ m ∈ cuspStab Γ g := by
    rw [mem_cuspStab_iff]
    refine ⟨hmΓ, ?_⟩
    rw [show g⁻¹ * (g * ModularGroup.T * g⁻¹) ^ m * g = ModularGroup.T ^ m by
      rw [conj_pow]; group]
    simp [← zpow_natCast, ModularGroup.coe_T_zpow]
  have hTlen : transLen (g⁻¹ * (g * ModularGroup.T * g⁻¹) ^ m * g) = m := by
    rw [show g⁻¹ * (g * ModularGroup.T * g⁻¹) ^ m * g = ModularGroup.T ^ m by
      rw [conj_pow]; group]
    simp [transLen, ← zpow_natCast, ModularGroup.coe_T_zpow]
  -- the least positive translation length
  let P : ℕ → Prop := fun k => 0 < k ∧ ∃ γ ∈ cuspStab Γ g, transLen (g⁻¹ * γ * g) = k
  have hP : ∃ k, P k := ⟨m, hm, _, hTmem, hTlen⟩
  let h := Nat.find hP
  obtain ⟨hhpos, γ₀, hγ₀, hγ₀len⟩ := Nat.find_spec hP
  have hmin : ∀ k, 0 < k → k < h → ∀ γ ∈ cuspStab Γ g, transLen (g⁻¹ * γ * g) ≠ k :=
    fun k hk hkh γ hγ hlen => Nat.find_min hP hkh ⟨hk, γ, hγ, hlen⟩
  refine ⟨γ₀, hγ₀, by rw [hγ₀len]; exact_mod_cast hhpos, ?_, ?_⟩
  · apply le_antisymm
    · intro γ hγ
      set q := transLen (g⁻¹ * γ * g) / (h : ℤ)
      set r := transLen (g⁻¹ * γ * g) % (h : ℤ)
      have hδ : γ * γ₀ ^ (-q) ∈ cuspStab Γ g :=
        (cuspStab Γ g).mul_mem hγ ((cuspStab Γ g).zpow_mem hγ₀ _)
      have hlen : transLen (g⁻¹ * (γ * γ₀ ^ (-q)) * g) = r := by
        rw [transLen_conj_mul g hγ ((cuspStab Γ g).zpow_mem hγ₀ _), transLen_conj_zpow g hγ₀,
          hγ₀len]
        have := Int.emod_add_mul_ediv (transLen (g⁻¹ * γ * g)) h
        linarith
      have hr0 : 0 ≤ r := Int.emod_nonneg _ (by exact_mod_cast hhpos.ne')
      have hrh : r < h := Int.emod_lt_of_pos _ (by exact_mod_cast hhpos)
      have hr : r = 0 := by
        by_contra hr
        have hrpos : 0 < r := lt_of_le_of_ne hr0 (Ne.symm hr)
        exact hmin r.toNat (by omega) (by omega) _ hδ (by rw [hlen]; omega)
      rw [hr] at hlen
      rcases eq_one_or_neg_one_of_transLen_eq_zero (conj_lowerLeft g hδ) hlen with h1 | h1
      · have : γ * γ₀ ^ (-q) = 1 := by
          have := congrArg (fun x => g * x * g⁻¹) h1
          simpa [mul_assoc] using this
        rw [Subgroup.mem_zpowers_iff]
        exact ⟨q, by rw [zpow_neg] at this; exact (mul_inv_eq_one.mp this).symm⟩
      · exfalso
        have : γ * γ₀ ^ (-q) = -1 := by
          have := congrArg (fun x => g * x * g⁻¹) h1
          rw [show g * (g⁻¹ * (γ * γ₀ ^ (-q)) * g) * g⁻¹ = γ * γ₀ ^ (-q) by group] at this
          rw [this, mul_neg, mul_one, neg_mul, mul_inv_cancel]
        exact hneg (this ▸ ((mem_cuspStab_iff Γ g _).mp hδ).1)
    · rw [Subgroup.zpowers_le]
      exact hγ₀
  · obtain ⟨k, hk | hk⟩ := eq_pm_T_zpow_of_lowerLeft_eq_zero (conj_lowerLeft g hγ₀)
    · refine ⟨1, Or.inl rfl, ?_⟩
      have hkl : transLen (g⁻¹ * γ₀ * g) = k := by rw [hk]; simp [transLen, ModularGroup.coe_T_zpow]
      rw [hkl, one_mul, ← hk]; group
    · refine ⟨-1, Or.inr rfl, ?_⟩
      have hkl : transLen (g⁻¹ * γ₀ * g) = k := by rw [hk]; simp [transLen, ModularGroup.coe_T_zpow]
      rw [hkl, neg_one_mul, ← hk]; group

end TernaryPeriodPolynomials.Argument.ESFoundations
