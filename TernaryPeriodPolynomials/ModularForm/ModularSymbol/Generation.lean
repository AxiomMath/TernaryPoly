module

public import TernaryPeriodPolynomials.ModularForm.ModularSymbol.Basic
public import TernaryPeriodPolynomials.Building.RankTwo.HeightPaths

@[expose] public section


noncomputable section
namespace TernaryPoly.BinaryModularSymbol
open RankTwoAugmentedFrames RankTwoHeightZero RankTwoHeightLinks RankTwoHeightPaths

/-- The reference symbol has the literal two coordinate lines as its endpoints. -/
def reference : St := symbol (augmentedLine 1 0) (augmentedLine 1 1)

theorem lineAction_augmentedLine (g h : IntegralGL) (i : Fin 3) :
    lineAction (integral g) (augmentedLine h i) = augmentedLine (g*h) i := by
  apply Subtype.ext
  change Submodule.map (rationalRepresentation g).toLinearMap
    (Submodule.span ℚ {rationalRepresentation h (template i)}) = _
  rw [Submodule.map_span,Set.image_singleton]
  change Submodule.span ℚ {rationalRepresentation g (rationalRepresentation h (template i))} =
    Submodule.span ℚ {rationalRepresentation (g*h) (template i)}
  rw [map_mul,LinearEquiv.mul_apply]

theorem action_reference (g : IntegralGL) :
    action (integral g) reference = symbol (augmentedLine g 0) (augmentedLine g 1) := by
  rw [reference,action_symbol,lineAction_augmentedLine,lineAction_augmentedLine,mul_one]

def integralSpan : Submodule ℚ St :=
  Submodule.span ℚ (Set.range (fun g : IntegralGL => action (integral g) reference))

/-- Every actual unimodular edge is an integral translate of the reference symbol. -/
theorem edge_mem_integralSpan (L M : Line) (hf : {L,M} ∈ ambient) :
    symbol L M ∈ integralSpan := by
  classical
  by_cases he : L = M
  · subst M
    rw [symbol_self]
    exact Submodule.zero_mem _
  obtain ⟨g,h0,h1⟩ := edge_basis L M he hf
  rw [←h0,←h1,←action_reference]
  exact Submodule.subset_span (Set.mem_range_self g)

/-- Euclidean height descent generates every endpoint difference by genuine integral edges. -/
theorem based_symbol_mem_integralSpan (L : Line) : symbol zeroVertex L ∈ integralSpan := by
  classical
  by_cases hL : 0 < height L
  · have hm := based_symbol_mem_integralSpan (parent L)
    have he : symbol (parent L) L ∈ integralSpan := by
      apply edge_mem_integralSpan
      convert parent_edge L hL using 1
      ext A
      simp only [Finset.mem_insert,Finset.mem_singleton,or_comm]
    rw [←symbol_triangle zeroVertex (parent L) L]
    exact integralSpan.add_mem hm he
  · rw [height_zero_eq L (by omega),symbol_self]
    exact integralSpan.zero_mem
termination_by height L
decreasing_by exact parent_lower L hL

/-- The actual Steinberg module is generated by the full integral orbit of the reference symbol. -/
theorem integralSpan_eq_top : integralSpan = ⊤ := by
  apply top_unique
  rw [←span_symbols zeroVertex]
  exact Submodule.span_le.mpr (by rintro _ ⟨L,rfl⟩; exact based_symbol_mem_integralSpan L)

end TernaryPoly.BinaryModularSymbol
