public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.Tactic.TautoSet

@[expose] public section





open MvPolynomial TernaryPoly.CharTwoNorm Polynomial

namespace TernaryPeriodPolynomials.Argument.CharTwoKernel

/-- The subalgebra generated by the three Dickson invariants `d4, d6, d7`. -/
noncomputable abbrev B : Subalgebra (ZMod 2) Poly := Algebra.adjoin (ZMod 2) (Set.range invariant)

theorem d4_mem : d4 ∈ B := Algebra.subset_adjoin ⟨0, rfl⟩
theorem d6_mem : d6 ∈ B := Algebra.subset_adjoin ⟨1, rfl⟩
theorem d7_mem : d7 ∈ B := Algebra.subset_adjoin ⟨2, rfl⟩

/-- The monic degree-eight polynomial over `B` satisfied by every `X i`. -/
noncomputable def dicksonPoly : Polynomial B :=
  Polynomial.X ^ 8 + Polynomial.C ⟨d4, d4_mem⟩ * Polynomial.X ^ 4 +
    Polynomial.C ⟨d6, d6_mem⟩ * Polynomial.X ^ 2 + Polynomial.C ⟨d7, d7_mem⟩ * Polynomial.X

theorem dicksonPoly_monic : dicksonPoly.Monic := by
  unfold dicksonPoly
  monicity!

theorem algebraMap_d4 : (algebraMap B Poly) ⟨d4, d4_mem⟩ = d4 := rfl
theorem algebraMap_d6 : (algebraMap B Poly) ⟨d6, d6_mem⟩ = d6 := rfl
theorem algebraMap_d7 : (algebraMap B Poly) ⟨d7, d7_mem⟩ = d7 := rfl

theorem dicksonPoly_aeval (i : Fin 3) :
    Polynomial.aeval (X i : Poly) dicksonPoly = 0 := by
  unfold dicksonPoly
  simp only [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
  rw [algebraMap_d4, algebraMap_d6, algebraMap_d7]
  exact pow8_relation i

/-- Each variable `X i` is integral over `B`. -/
theorem isIntegral_X (i : Fin 3) : IsIntegral B (X i : Poly) :=
  ⟨dicksonPoly, dicksonPoly_monic, dicksonPoly_aeval i⟩

/-- Every element of `B` itself, viewed in `Poly`, is integral over `B`. -/
theorem isIntegral_mem {y : Poly} (hy : y ∈ B) : IsIntegral B y :=
  isIntegral_algebraMap (R := B) (A := Poly) (x := ⟨y, hy⟩)

/-- Every element of `Poly` is integral over `B`. -/
theorem isIntegral_all (x : Poly) : IsIntegral B x := by
  induction x using MvPolynomial.induction_on with
  | C a => exact isIntegral_mem (Subalgebra.algebraMap_mem B a)
  | add p q hp hq => exact hp.add hq
  | mul_X p n hp => exact hp.mul (isIntegral_X n)

/-- `Poly` is integral over `B`. -/
instance instAlgebraIsIntegral : Algebra.IsIntegral B Poly := ⟨isIntegral_all⟩

theorem card_le_trdeg : Cardinal.mk (Fin 3) ≤ Algebra.trdeg (ZMod 2) Poly :=
  le_of_eq (IsTranscendenceBasis.mvPolynomial (Fin 3) (ZMod 2)).cardinalMk_eq_trdeg

/-- `d4, d6, d7` form a transcendence basis of `Poly` over `ZMod 2`. -/
theorem isTranscendenceBasis_invariant : IsTranscendenceBasis (ZMod 2) invariant :=
  Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite (ZMod 2) invariant card_le_trdeg

/-- Conjunct 1 of Lemma 5.3: `d4, d6, d7` are algebraically independent over `ZMod 2`. -/
theorem lemma_5_3_conjunct1 :
    AlgebraicIndependent (ZMod 2) ![d4, d6, d7] :=
  isTranscendenceBasis_invariant.1

end TernaryPeriodPolynomials.Argument.CharTwoKernel
