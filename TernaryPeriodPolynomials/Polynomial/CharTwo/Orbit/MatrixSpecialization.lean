theorem pointEval_rootMatrix_code (ht : t^4+t+1=0) (i j : Fin 32) :
    pointEval t (OrbitSymbolSystem.rootMatrix i j) = decode t (rootMatrixCode i j) := by
  simp only [OrbitSymbolSystem.rootMatrix, pointEval_frame_apply, rootMatrixCode]
  split_ifs
  · exact eval_rootP_code t ht j _ _ _
  · exact eval_rootQ_code t ht j _ _ _

/-- Evaluation of the actual polynomial root matrix gives the certified literal matrix. -/
theorem pointEval_rootMatrix (ht : t^4+t+1=0) :
    (pointEval t).mapMatrix OrbitSymbolSystem.rootMatrix = OrbitMinorCertificate.matrix t := by
  ext i j
  change pointEval t (OrbitSymbolSystem.rootMatrix i j) =
    decode t (OrbitMinorCertificate.matrixCode i j)
  rw [pointEval_rootMatrix_code t ht, rootMatrixCode_eq]

/-- The actual differential rows specialize to the entrywise square of the certified matrix. -/
theorem pointEval_differentialMatrix (ht : t^4+t+1=0) :
    (pointEval t).mapMatrix OrbitSymbolSystem.differentialMatrix =
      OrbitMinorCertificate.squareMatrix t := by
  ext i j
  change pointEval t ((OrbitSymbolSystem.rootMatrix i j)^2) =
    (OrbitMinorCertificate.matrix t i j)^2
  rw [map_pow, pointEval_rootMatrix_code t ht, rootMatrixCode_eq]
  rfl
end Specialization

/-- The literal polynomial differential matrix has nonzero determinant. -/
theorem differentialMatrix_det_ne_zero : OrbitSymbolSystem.differentialMatrix.det ≠ 0 := by
  intro h
  have he := congrArg (pointEval OrbitMinorCertificate.root) h
  rw [AlgHom.map_det, pointEval_differentialMatrix _ OrbitMinorCertificate.root_relation,
    map_zero] at he
  exact OrbitMinorCertificate.specialized_square_det_ne_zero he
end TernaryPoly.OrbitMatrixSpecialization
