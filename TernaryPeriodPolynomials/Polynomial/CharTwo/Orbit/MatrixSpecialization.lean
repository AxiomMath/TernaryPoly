/-- Code evaluation of the polynomial root matrix in the literal row order. -/
def rootMatrixCode (i j : Fin 32) : Code :=
  let k : Fin 16 := ⟨i.val/2, by omega⟩
  if i.val % 2 = 0 then rootPCode j (frameCode k 0) (frameCode k 1) (frameCode k 2)
  else rootQCode j (frameCode k 0) (frameCode k 1) (frameCode k 2)

