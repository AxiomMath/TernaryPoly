def powerRow5 : Fin 14 → Code := ![1, 5, 2, 10, 4, 7, 8, 14, 3, 15, 6, 13, 12, 9]
def powerRow6 : Fin 14 → Code := ![1, 6, 7, 1, 6, 7, 1, 6, 7, 1, 6, 7, 1, 6]
def powerRow7 : Fin 14 → Code := ![1, 7, 6, 1, 7, 6, 1, 7, 6, 1, 7, 6, 1, 7]
def powerRow8 : Fin 14 → Code := ![1, 8, 12, 10, 15, 1, 8, 12, 10, 15, 1, 8, 12, 10]
def powerRow9 : Fin 14 → Code := ![1, 9, 13, 15, 14, 7, 10, 5, 11, 12, 6, 3, 8, 4]
def powerRow10 : Fin 14 → Code := ![1, 10, 8, 15, 12, 1, 10, 8, 15, 12, 1, 10, 8, 15]
def powerRow11 : Fin 14 → Code := ![1, 11, 9, 12, 13, 6, 15, 3, 14, 8, 7, 4, 10, 2]
