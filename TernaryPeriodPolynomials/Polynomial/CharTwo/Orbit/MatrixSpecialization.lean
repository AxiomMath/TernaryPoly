def powerRow15 : Fin 14 → Code := ![1, 15, 10, 12, 8, 1, 15, 10, 12, 8, 1, 15, 10, 12]
/-- All powers needed by the literal sparse row formulas. -/
def powerCode : Code → Fin 14 → Code :=
  ![powerRow0, powerRow1, powerRow2, powerRow3, powerRow4, powerRow5, powerRow6, powerRow7, powerRow8, powerRow9, powerRow10, powerRow11, powerRow12, powerRow13, powerRow14, powerRow15]

private theorem powerCode_row_0 : ∀ n : Fin 14, codePow 0 n.val = powerCode 0 n := by decide +kernel
private theorem powerCode_row_1 : ∀ n : Fin 14, codePow 1 n.val = powerCode 1 n := by decide +kernel
private theorem powerCode_row_2 : ∀ n : Fin 14, codePow 2 n.val = powerCode 2 n := by decide +kernel
private theorem powerCode_row_3 : ∀ n : Fin 14, codePow 3 n.val = powerCode 3 n := by decide +kernel
private theorem powerCode_row_4 : ∀ n : Fin 14, codePow 4 n.val = powerCode 4 n := by decide +kernel
private theorem powerCode_row_5 : ∀ n : Fin 14, codePow 5 n.val = powerCode 5 n := by decide +kernel
private theorem powerCode_row_6 : ∀ n : Fin 14, codePow 6 n.val = powerCode 6 n := by decide +kernel
private theorem powerCode_row_7 : ∀ n : Fin 14, codePow 7 n.val = powerCode 7 n := by decide +kernel
private theorem powerCode_row_8 : ∀ n : Fin 14, codePow 8 n.val = powerCode 8 n := by decide +kernel
private theorem powerCode_row_9 : ∀ n : Fin 14, codePow 9 n.val = powerCode 9 n := by decide +kernel
private theorem powerCode_row_10 : ∀ n : Fin 14, codePow 10 n.val = powerCode 10 n := by decide +kernel
private theorem powerCode_row_11 : ∀ n : Fin 14, codePow 11 n.val = powerCode 11 n := by decide +kernel
private theorem powerCode_row_12 : ∀ n : Fin 14, codePow 12 n.val = powerCode 12 n := by decide +kernel
private theorem powerCode_row_13 : ∀ n : Fin 14, codePow 13 n.val = powerCode 13 n := by decide +kernel
private theorem powerCode_row_14 : ∀ n : Fin 14, codePow 14 n.val = powerCode 14 n := by decide +kernel
private theorem powerCode_row_15 : ∀ n : Fin 14, codePow 15 n.val = powerCode 15 n := by decide +kernel
theorem powerCode_spec (a : Code) (n : Fin 14) : codePow a n.val = powerCode a n := by
  fin_cases a
  · exact powerCode_row_0 n
  · exact powerCode_row_1 n
  · exact powerCode_row_2 n
  · exact powerCode_row_3 n
  · exact powerCode_row_4 n
  · exact powerCode_row_5 n
  · exact powerCode_row_6 n
  · exact powerCode_row_7 n
  · exact powerCode_row_8 n
  · exact powerCode_row_9 n
  · exact powerCode_row_10 n
  · exact powerCode_row_11 n
  · exact powerCode_row_12 n
  · exact powerCode_row_13 n
  · exact powerCode_row_14 n
  · exact powerCode_row_15 n

section Powers
variable {R : Type*} [CommRing R] [CharP R 2] (t : R)

theorem decode_codePow (ht : t^4+t+1=0) (a : Code) (n : ℕ) :
    decode t (codePow a n) = (decode t a)^n := by
  induction n with
  | zero => simp [codePow, decode]
  | succ n ih =>
      rw [codePow, OrbitMinorCertificate.decode_mul t ht, ih, pow_succ]

theorem decode_powerCode (ht : t^4+t+1=0) (a : Code) (n : Fin 14) :
    decode t (powerCode a n) = (decode t a)^n.val := by
  rw [← powerCode_spec]
  exact decode_codePow t ht a n.val
end Powers

section Evaluation
variable {R : Type*} [CommRing R] [Algebra (ZMod 2) R] (t : R)

/-- Specialization at the literal point (1,t,t²). -/
def pointEval : Poly →ₐ[ZMod 2] R := aeval ![1,t,t^2]

/-- Polynomial evaluation at a hexadecimal triple. -/
def evalCode (u v w : Code) : Poly →ₐ[ZMod 2] R :=
  aeval ![decode t u,decode t v,decode t w]

@[simp] theorem evalCode_x (u v w : Code) : evalCode t u v w x = decode t u := by
  simp [evalCode,CharTwoToddSymbol.x]
@[simp] theorem evalCode_y (u v w : Code) : evalCode t u v w y = decode t v := by
  simp [evalCode,CharTwoToddSymbol.y]
@[simp] theorem evalCode_z (u v w : Code) : evalCode t u v w z = decode t w := by
  simp [evalCode,CharTwoToddSymbol.z]
end Evaluation

