module

public import TernaryPeriodPolynomials.SymmetricSolution.ResidueHecke.Cells.Levi
public import TernaryPeriodPolynomials.SymmetricSolution.ResidueHecke.Cells.Induced

@[expose] public section


/-!
# Lemma B.1: the matrix-group structure of `P_H` (Levi quotient, radical, `λ`)

Formalized by Claude Sonnet 5.5.
Paper: Appendix A.3
(`lem:literal-residue-comparison`): "The stabilizer of `a = 0` in `GL₃(ℚ)` consists of
`g = (λ 0; u C)`. On the determinant-twisted residue its action is `q ↦ det(C) q(C(b,c))`. Its integral
radical `U = ℤ²` acts trivially on that fiber."

For `g ∈ P_H ⊂ GL₃(ℤ)` (first row `(±1, 0, 0)`, `mem_PH_iff_row`) write `g = (λ 0; u C)` with
`λ = lamHom g ∈ ℤˣ`, `u = uvec g`, `C = pi g ∈ GL₂(ℤ)`.

* `pi : P_H →* GL₂(ℤ)` (the lower-right block), `pi_surjective`, `lamHom : P_H →* ℤˣ`;
* `U = ker pi ⊓ ker lamHom`, normal, `eU : Multiplicative (Fin 2 → ℤ) ≃* U`,
  `eU v = !![1,0,0; v 0,1,0; v 1,0,1]` (`eU_val`);
* `conj_eU`: `g (eU v) g⁻¹ = eU (λ(g)⁻¹ C(g) v)`; `det_PH`: `det g = λ det C`;
* `pibar : P_H ⧸ U →* GL₂(ℤ)`, surjective, with kernel generated by the image of `diag(-1,1,1)`
  (`ker_pibar`), in particular finite (`finite_ker_pibar`);
* `fiber_PH`: for all `g ∈ P_H`,
  `literalFiberMap n 0 (fiberAction n g x) = homogeneousAction (n+1) (-1) (integral (pi g)) (literalFiberMap n 0 x)`,
  and `fiberRep_U`: `U` acts trivially on `FibRep n`.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.AppendixBResidue

open TernaryPoly TernaryPoly.ModThreeGoodAction
open TernaryPoly.SinglePole TernaryPoly.SinglePoleSupport TernaryPoly.SinglePoleCoordinate
open TernaryPoly.OrdinaryResidueSupport (axis)

/-- `GL₂(ℤ)`. -/
abbrev GL2Z : Type := Matrix.GeneralLinearGroup (Fin 2) ℤ

section Block

/-- The lower-right `2 × 2` block of an integral `3 × 3` matrix. -/
def blockMat (g : IntegralGL) : Matrix (Fin 2) (Fin 2) ℤ := Matrix.of fun i j => g.val i.succ j.succ

theorem blockMat_mul {g h : IntegralGL} (hh : h ∈ PH) : blockMat (g * h) = blockMat g * blockMat h := by
  obtain ⟨h1, h2⟩ := (mem_PH_iff_row h).mp hh
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [blockMat, Matrix.mul_apply, Fin.sum_univ_three, Fin.sum_univ_two, h1, h2]

theorem blockMat_one : blockMat 1 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blockMat]

theorem PH_g00_mul {g : IntegralGL} (hg : g ∈ PH) (h : IntegralGL) :
    (g * h).val 0 0 = g.val 0 0 * h.val 0 0 := by
  obtain ⟨h1, h2⟩ := (mem_PH_iff_row g).mp hg
  simp [Matrix.mul_apply, Fin.sum_univ_three, h1, h2]

/-- `λ(g) = g₀₀ ∈ ℤˣ` for `g ∈ P_H`. -/
def lamHom : PH →* ℤˣ where
  toFun g := ⟨g.1.val 0 0, (g⁻¹).1.val 0 0,
    by
      have := PH_g00_mul g.2 (g⁻¹).1
      rw [← this]
      have h : (g.1 * (g⁻¹).1 : IntegralGL) = 1 := by
        have := mul_inv_cancel g
        exact congrArg Subtype.val this
      rw [h]; simp,
    by
      have := PH_g00_mul (g⁻¹).2 g.1
      rw [← this]
      have h : ((g⁻¹).1 * g.1 : IntegralGL) = 1 := by
        have := inv_mul_cancel g
        exact congrArg Subtype.val this
      rw [h]; simp⟩
  map_one' := by
    apply Units.ext
    simp
  map_mul' g h := by
    apply Units.ext
    exact PH_g00_mul g.2 h.1

theorem lamHom_val (g : PH) : ((lamHom g : ℤˣ) : ℤ) = g.1.val 0 0 := rfl

theorem lam_cases (g : PH) : ((lamHom g : ℤˣ) : ℤ) = 1 ∨ ((lamHom g : ℤˣ) : ℤ) = -1 := by
  rcases Int.units_eq_one_or (lamHom g) with h | h <;> simp [h]

/-- The lower-right block `C(g) ∈ GL₂(ℤ)` of `g ∈ P_H` (`det C = ±1`). -/
def pi : PH →* GL2Z where
  toFun g := ⟨blockMat g.1, blockMat (g⁻¹).1, by
      rw [← blockMat_mul (g⁻¹).2]
      have h : (g.1 * (g⁻¹).1 : IntegralGL) = 1 := congrArg Subtype.val (mul_inv_cancel g)
      rw [h, blockMat_one],
    by
      rw [← blockMat_mul g.2]
      have h : ((g⁻¹).1 * g.1 : IntegralGL) = 1 := congrArg Subtype.val (inv_mul_cancel g)
      rw [h, blockMat_one]⟩
  map_one' := by
    apply Units.ext
    exact blockMat_one
  map_mul' g h := by
    apply Units.ext
    exact blockMat_mul h.2

theorem pi_val (g : PH) : (pi g).val = blockMat g.1 := rfl

/-- The off-diagonal column `u(g)` of `g ∈ P_H`. -/
def uvec (g : PH) : Fin 2 → ℤ := fun i => g.1.val i.succ 0

theorem PH_matrix (g : PH) :
    g.1.val = !![(lamHom g : ℤ), 0, 0; uvec g 0, (pi g).val 0 0, (pi g).val 0 1;
      uvec g 1, (pi g).val 1 0, (pi g).val 1 1] := by
  obtain ⟨h1, h2⟩ := (mem_PH_iff_row g.1).mp g.2
  ext i j
  fin_cases i <;> fin_cases j <;> simp [lamHom_val, uvec, pi_val, blockMat, h1, h2]

theorem PH_ext {g h : PH} (hl : lamHom g = lamHom h) (hp : pi g = pi h) (hu : uvec g = uvec h) :
    g = h := by
  apply Subtype.ext
  apply Units.ext
  rw [PH_matrix g, PH_matrix h, hl, hp, hu]

/-- **`det g = λ det C`.** -/
theorem det_PH (g : PH) : g.1.val.det = (lamHom g : ℤ) * (pi g).val.det := by
  rw [PH_matrix g]
  simp [Matrix.det_fin_three, Matrix.det_fin_two]
  ring

theorem det_pi (g : PH) : (pi g).val.det = (blockMat g.1).det := rfl

end Block

section Radical

/-- The radical matrix `!![1,0,0; v 0,1,0; v 1,0,1]`. -/
def radMat (v : Fin 2 → ℤ) : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; v 0, 1, 0; v 1, 0, 1]

theorem radMat_mul (v w : Fin 2 → ℤ) : radMat v * radMat w = radMat (v + w) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [radMat, Matrix.mul_apply, Fin.sum_univ_three]

theorem radMat_zero : radMat 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [radMat]

/-- The radical element `U(v)` as an element of `GL₃(ℤ)`. -/
def radZ (v : Fin 2 → ℤ) : IntegralGL :=
  ⟨radMat v, radMat (-v), by rw [radMat_mul]; simp [radMat_zero], by rw [radMat_mul]; simp [radMat_zero]⟩

theorem radZ_val (v : Fin 2 → ℤ) : (radZ v).val = radMat v := rfl

theorem radZ_mem (v : Fin 2 → ℤ) : radZ v ∈ PH := by
  rw [mem_PH_iff_row]
  simp [radZ_val, radMat]

/-- The homomorphism `ℤ² → P_H`, `v ↦ U(v)`. -/
def radPH : Multiplicative (Fin 2 → ℤ) →* PH where
  toFun v := ⟨radZ (Multiplicative.toAdd v), radZ_mem _⟩
  map_one' := by
    apply Subtype.ext
    apply Units.ext
    simp [radZ_val, radMat_zero]
  map_mul' v w := by
    apply Subtype.ext
    apply Units.ext
    change radMat (Multiplicative.toAdd v + Multiplicative.toAdd w) =
      radMat (Multiplicative.toAdd v) * radMat (Multiplicative.toAdd w)
    rw [radMat_mul]

theorem radPH_val (v : Multiplicative (Fin 2 → ℤ)) :
    (radPH v).1.val = !![1, 0, 0; Multiplicative.toAdd v 0, 1, 0; Multiplicative.toAdd v 1, 0, 1] := rfl

theorem lam_radPH (v : Multiplicative (Fin 2 → ℤ)) : lamHom (radPH v) = 1 := by
  apply Units.ext
  simp [lamHom_val, radPH_val]

theorem pi_radPH (v : Multiplicative (Fin 2 → ℤ)) : pi (radPH v) = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pi_val, blockMat, radPH_val]

theorem uvec_radPH (v : Multiplicative (Fin 2 → ℤ)) : uvec (radPH v) = Multiplicative.toAdd v := by
  funext i
  fin_cases i <;> simp [uvec, radPH_val]

/-- The integral unipotent radical `U ⊂ P_H`: the elements with `λ = 1` and `C = 1`. -/
def U : Subgroup PH := pi.ker ⊓ lamHom.ker

instance U_normal : U.Normal := inferInstanceAs ((pi.ker ⊓ lamHom.ker).Normal)

theorem mem_U {g : PH} : g ∈ U ↔ pi g = 1 ∧ lamHom g = 1 := Iff.rfl

theorem U_le_ker_pi : U ≤ pi.ker := inf_le_left

theorem radPH_mem_U (v : Multiplicative (Fin 2 → ℤ)) : radPH v ∈ U := ⟨pi_radPH v, lam_radPH v⟩

/-- **(a)** `eU : ℤ² ≃* U`, `eU v = !![1,0,0; v 0,1,0; v 1,0,1]`. -/
def eU : Multiplicative (Fin 2 → ℤ) ≃* U :=
  MulEquiv.ofBijective (radPH.codRestrict U radPH_mem_U) ⟨by
    intro v w h
    have h' : radPH v = radPH w := congrArg Subtype.val h
    have := congrArg uvec h'
    rw [uvec_radPH, uvec_radPH] at this
    exact this, by
    intro u
    refine ⟨Multiplicative.ofAdd (uvec u.1), ?_⟩
    apply Subtype.ext
    show radPH (Multiplicative.ofAdd (uvec u.1)) = u.1
    apply PH_ext
    · rw [lam_radPH]; exact u.2.2.symm
    · rw [pi_radPH]; exact u.2.1.symm
    · rw [uvec_radPH]; rfl⟩

theorem eU_coe (v : Multiplicative (Fin 2 → ℤ)) : ((eU v : U) : PH) = radPH v := rfl

theorem eU_val (v : Multiplicative (Fin 2 → ℤ)) :
    ((eU v : U) : PH).1.val =
      !![1, 0, 0; Multiplicative.toAdd v 0, 1, 0; Multiplicative.toAdd v 1, 0, 1] := rfl

end Radical

section Conj

/-- Right-hand side: `λ(g)⁻¹ C(g) v`. -/
def conjVec (g : PH) (v : Fin 2 → ℤ) : Fin 2 → ℤ :=
  ((lamHom g)⁻¹ : ℤˣ).val • ((pi g).val.mulVec v)

theorem lam_inv_val (g : PH) : (((lamHom g)⁻¹ : ℤˣ) : ℤ) = (lamHom g : ℤ) := by
  rcases Int.units_eq_one_or (lamHom g) with h | h <;> rw [h] <;> rfl

theorem PH_mul_radZ (g : PH) (v : Fin 2 → ℤ) :
    g.1 * radZ v = radZ (conjVec g v) * g.1 := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, radZ_val, radZ_val, PH_matrix g]
  have hl := lam_cases g
  simp only [conjVec, lam_inv_val]
  generalize (lamHom g : ℤ) = l at hl ⊢
  rcases hl with rfl | rfl <;>
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [radMat, Matrix.mul_apply, Fin.sum_univ_three, Matrix.mulVec, dotProduct,
        Fin.sum_univ_two] <;> ring

/-- **(c)** Conjugation of the radical: `g · eU v · g⁻¹ = eU (λ(g)⁻¹ C(g) v)`. -/
theorem conj_eU (g : PH) (v : Multiplicative (Fin 2 → ℤ)) :
    g * ((eU v : U) : PH) * g⁻¹ =
      ((eU (Multiplicative.ofAdd (conjVec g (Multiplicative.toAdd v))) : U) : PH) := by
  rw [mul_inv_eq_iff_eq_mul]
  apply Subtype.ext
  exact PH_mul_radZ g (Multiplicative.toAdd v)

end Conj


section Levi

/-- **(b)** `pi` is surjective: every `C ∈ GL₂(ℤ)` is the block of `blockEmbed C ∈ P_H`. -/
theorem pi_surjective : Function.Surjective pi := by
  intro C
  refine ⟨⟨OrdinaryPlaneEdge.blockEmbed C, blockEmbed_mem_PH C⟩, ?_⟩
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [pi_val, blockMat, OrdinaryPlaneEdge.blockEmbed, OrdinaryPlaneEdge.diagonalBlock]

/-- **(b)** `pibar : P_H / U → GL₂(ℤ)`. -/
def pibar : PH ⧸ U →* GL2Z := QuotientGroup.lift U pi (fun _ hx => U_le_ker_pi hx)

theorem pibar_mk (g : PH) : pibar (QuotientGroup.mk g) = pi g := rfl

theorem pibar_surjective : Function.Surjective pibar := by
  intro C
  obtain ⟨g, rfl⟩ := pi_surjective C
  exact ⟨QuotientGroup.mk g, rfl⟩

/-- The element `diag(-1, 1, 1) ∈ P_H`. -/
def dPH : PH :=
  ⟨⟨!![-1, 0, 0; 0, 1, 0; 0, 0, 1], !![-1, 0, 0; 0, 1, 0; 0, 0, 1],
    by ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_three],
    by ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_three]⟩,
    by rw [mem_PH_iff_row]; simp⟩

theorem lam_dPH : lamHom dPH = -1 := by
  apply Units.ext
  simp [lamHom_val, dPH]

theorem pi_dPH : pi dPH = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pi_val, blockMat, dPH]

theorem dPH_sq : dPH * dPH = 1 := by
  apply PH_ext
  · rw [map_mul, lam_dPH]; simp
  · rw [map_mul, pi_dPH]; simp
  · funext i; fin_cases i <;> simp [uvec, dPH, Matrix.mul_apply, Fin.sum_univ_three]

/-- Elements of `P_H` with `C = 1` are `U` or `d · U`. -/
theorem mem_ker_pibar {x : PH ⧸ U} (hx : pibar x = 1) :
    x = 1 ∨ x = QuotientGroup.mk dPH := by
  induction x using QuotientGroup.induction_on with
  | H g =>
    have hp : pi g = 1 := hx
    rcases lam_cases g with h | h
    · left
      rw [QuotientGroup.eq_one_iff]
      exact ⟨hp, Units.ext h⟩
    · right
      rw [QuotientGroup.eq]
      refine ⟨?_, ?_⟩
      · change pi (g⁻¹ * dPH) = 1
        rw [map_mul, map_inv, pi_dPH, hp]; simp
      · change lamHom (g⁻¹ * dPH) = 1
        rw [map_mul, map_inv, lam_dPH]
        apply Units.ext
        have := h
        simp [this]

/-- **(b)** The kernel of `pibar` is the image of `⟨diag(-1,1,1)⟩`. -/
theorem ker_pibar : pibar.ker = Subgroup.zpowers (QuotientGroup.mk dPH : PH ⧸ U) := by
  apply le_antisymm
  · intro x hx
    rcases mem_ker_pibar (MonoidHom.mem_ker.mp hx) with h | h
    · rw [h]; exact one_mem _
    · rw [h]; exact Subgroup.mem_zpowers _
  · rw [Subgroup.zpowers_le]
    exact MonoidHom.mem_ker.mpr (by rw [pibar_mk, pi_dPH])

/-- **(b)** `pibar` has finite (indeed order at most two) kernel. -/
theorem finite_ker_pibar : Finite pibar.ker := by
  have : (pibar.ker : Set (PH ⧸ U)) ⊆ {1, QuotientGroup.mk dPH} := fun x hx => by
    rcases mem_ker_pibar (MonoidHom.mem_ker.mp hx) with h | h
    · simp [h]
    · simp [h]
  exact Set.finite_coe_iff.mpr (Set.Finite.subset (Set.toFinite _) this)

end Levi


section Fiber

open TernaryPoly.OrdinaryResidueParabolic (blockMatrix)

theorem integral_val_apply (g : IntegralGL) (i j : Fin 3) :
    (OrdinaryFullAction.integral g).val i j = ((g.val i j : ℤ) : ℚ) := rfl

/-- The rational matrix of `g ∈ P_H` is the literal block matrix `(λ 0; u C)`. -/
theorem integral_PH_val (g : PH) :
    (OrdinaryFullAction.integral g.1).val =
      blockMatrix (Units.map (Int.castRingHom ℚ).toMonoidHom (lamHom g)) (fun i => (uvec g i : ℚ))
        (BinaryModularSymbol.integral (pi g)) := by
  obtain ⟨h1, h2⟩ := (mem_PH_iff_row g.1).mp g.2
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [integral_val_apply, BinaryModularSymbol.integral, blockMatrix, lamHom_val, uvec,
      pi_val, blockMat, h1, h2]

/-- **(d)** For **all** `g ∈ P_H` (not only block-embedded ones): the `H`-fibre action is the
determinant-inverse twisted binary substitution by `C = pi g`. -/
theorem fiber_PH (n : ℕ) (g : PH) (x : ResidueFiber n (axis 0)) :
    literalFiberMap n 0 (fiberAction n g.1 x) =
      BinaryModularSymbolCoefficients.homogeneousAction (n + 1) (-1)
        (BinaryModularSymbol.integral (pi g)) (literalFiberMap n 0 x) := by
  have h := OrdinaryResidueParabolic.coordinateTuple_action n (OrdinaryFullAction.integral g.1)
    (Units.map (Int.castRingHom ℚ).toMonoidHom (lamHom g)) (fun i => (uvec g i : ℚ))
    (BinaryModularSymbol.integral (pi g)) (integral_PH_val g)
    (DirectSum.lof ℚ Normal (ResidueFiber n) (axis 0) x)
  rw [OrdinaryResidueSymbol.coefficient_action] at h
  have e : coordinateTuple n (DirectSum.lof ℚ Normal (ResidueFiber n) (axis 0) x) 0 =
      literalFiberMap n 0 x := by
    simp [coordinateTuple]
  rw [e] at h
  exact h

theorem fiberRep_apply (n : ℕ) (g : PH) : fiberRep n g = fiberAction n g.1 := rfl

/-- `fiber_PH` for the representation `fiberRep`. -/
theorem fiberRep_literal (n : ℕ) (g : PH) (x : ResidueFiber n (axis 0)) :
    literalFiberMap n 0 (fiberRep n g x) =
      BinaryModularSymbolCoefficients.homogeneousAction (n + 1) (-1)
        (BinaryModularSymbol.integral (pi g)) (literalFiberMap n 0 x) :=
  fiber_PH n g x

/-- **The radical acts trivially on the fibre**: `ρ(u) = id` for `u ∈ U`. -/
theorem fiberRep_U (n : ℕ) (u : U) (x : ResidueFiber n (axis 0)) : fiberRep n u.1 x = x := by
  apply literalFiberMap_injective n 0
  rw [fiberRep_literal, u.2.1, map_one, map_one]
  rfl

theorem FibRep_U (n : ℕ) (u : U) : (FibRep n).ρ u.1 = LinearMap.id :=
  LinearMap.ext fun x => fiberRep_U n u x

theorem fiberRep_eU (n : ℕ) (v : Multiplicative (Fin 2 → ℤ)) (x : ResidueFiber n (axis 0)) :
    fiberRep n ((eU v : U) : PH) x = x :=
  fiberRep_U n (eU v) x

end Fiber

end TernaryPeriodPolynomials.Argument.AppendixBResidue
