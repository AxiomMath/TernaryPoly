module

public import TernaryPeriodPolynomials.Topology.SingularHomology.SmallChainsQuasiIso
public import TernaryPeriodPolynomials.Topology.ContractibleSingularHomology

@[expose] public section

noncomputable section
namespace TernaryPoly.SingularSubdivision
open CategoryTheory
open SphereOddDegree.AffineBarycentricSubdivision
variable (X : Type) [TopologicalSpace X]

/-- The imported subdivision acts on the literal rational singular complex already used by
this project. This is equality of the complexes themselves. -/
theorem chainComplex_eq : singularChainComplex ℚ (TopCat.of X) =
    ContractibleSingularHomology.chains X := rfl

/-- Actual barycentric subdivision on the project's rational singular chains. -/
def subdivision : ContractibleSingularHomology.chains X ⟶
    ContractibleSingularHomology.chains X :=
  barycentricSubdivisionChainMap ℚ (TopCat.of X)

/-- The actual subdivision chain map is chain-homotopic to identity. -/
def subdivisionHomotopy :
    Homotopy (subdivision X) (𝟙 (ContractibleSingularHomology.chains X)) :=
  barycentricSubdivision_chainHomotopic_id ℚ (TopCat.of X)

/-- Subdivision induces identity on the existing rational singular homology. -/
theorem subdivision_homology (n : ℕ) :
    HomologicalComplex.homologyMap (subdivision X) n =
      𝟙 ((ContractibleSingularHomology.chains X).homology n) :=
  barycentricSubdivision_induces_identity_on_homology ℚ (TopCat.of X) n

/-- The subcomplex generated by simplices lying in single members of an actual open cover. -/
abbrev smallChains (𝒰 : SphereOddDegree.OpenCoverData (TopCat.of X)) :
    ChainComplex (ModuleCat.{0} ℚ) ℕ := SphereOddDegree.smallChainComplex ℚ (TopCat.of X) 𝒰

/-- Literal inclusion of the cover-small singular subcomplex. -/
def inclusion (𝒰 : SphereOddDegree.OpenCoverData (TopCat.of X)) :
    smallChains X 𝒰 ⟶ ContractibleSingularHomology.chains X :=
  SphereOddDegree.smallChainsInclusion ℚ (TopCat.of X) 𝒰

/-- Every actual open cover gives a quasi-isomorphism from its small singular chains. -/
instance inclusion_quasiIso (𝒰 : SphereOddDegree.OpenCoverData (TopCat.of X)) :
    QuasiIso (inclusion X 𝒰) :=
  SphereOddDegree.smallChains_inclusion_quasiIso ℚ (TopCat.of X) 𝒰

/-- The homology isomorphism is induced by the literal inclusion. -/
def smallChainsHomologyIso (𝒰 : SphereOddDegree.OpenCoverData (TopCat.of X)) (n : ℕ) :
    (smallChains X 𝒰).homology n ≅ (ContractibleSingularHomology.chains X).homology n :=
  SphereOddDegree.smallChains_homologyIso ℚ (TopCat.of X) 𝒰 n

@[simp] theorem smallChainsHomologyIso_hom
    (𝒰 : SphereOddDegree.OpenCoverData (TopCat.of X)) (n : ℕ) :
    (smallChainsHomologyIso X 𝒰 n).hom = HomologicalComplex.homologyMap (inclusion X 𝒰) n := rfl

end TernaryPoly.SingularSubdivision
