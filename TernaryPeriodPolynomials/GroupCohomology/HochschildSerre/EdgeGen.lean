module

public import TernaryPeriodPolynomials.GroupCohomology.HochschildSerre.EvalQ
public import TernaryPeriodPolynomials.GroupCohomology.HochschildSerre.TreeTheorem

@[expose] public section


/-!
# The classes of `(M ⊗ P1)_Q` are generated by the standard edge

Formalized by Claude Sonnet 5.5.

`edgeGen = ½([p₀] - [swap p₀])` is the image of `[p₀]` under the retraction of `P1` onto the antisymmetric chains.  If
`Q` surjects onto `GL₂(ℤ)` then every class of `(M ⊗ P1)_Q` is `[m ⊗ edgeGen]` (`exists_mk_edgeGen`), and
`evalQ_edgeGen` computes the coefficient at the standard edge of such a class as
`½(∑_{q • p₀ = p₀} q m - ∑_{q • p₀ = swap p₀} q m)`.
-/

open CategoryTheory MonoidalCategory Representation Limits

noncomputable section

namespace TernaryPeriodPolynomials.Argument.HochschildSerre

open TernaryPeriodPolynomials.Argument.FareyTree TernaryPeriodPolynomials.Argument.BinaryDuality
  TernaryPoly.RankTwoAugmentedFrames

variable {Q : Type} [Group Q] (π : Q →* IntegralGL)

/-- The generator `e₀ = ½([p₀] − [swap p₀])` of the antisymmetric chains, as an element of `P1`. -/
def edgeGen : P1.V := retrP1.hom (MonoidAlgebra.single p0 (1 : ℚ))

theorem edgeGen_coe : (edgeGen : PE) = edgeVec p0 := by
  change antiLin (MonoidAlgebra.single p0 (1 : ℚ)) = _
  rw [antiLin_apply, swapMap_single]
  unfold edgeVec
  rfl

theorem exists_mk_edgeGen (hπ : Function.Surjective π) (M : Rep.{0} ℚ Q) (x : (FX (Rep.res π P1)).obj M) :
    ∃ m : M.V, x = Coinvariants.mk (M.ρ.tprod (Rep.res π P1).ρ) (m ⊗ₜ[ℚ] edgeGen) := by
  let _ : MulAction Q OTE := oteMulActionQ π
  have htr : ∀ y : OTE, ∃ q : Q, q • p0 = y := by
    intro y
    obtain ⟨g, hg⟩ := ote_transitive y
    obtain ⟨q, hq⟩ := hπ g
    exact ⟨q, by change π q • p0 = y; rw [hq]; exact hg⟩
  have hid : ∀ z : (FX (Rep.res π P1)).obj M,
      ((FXmap (Rep.resMap π retrP1)).app M).hom (((FXmap (Rep.resMap π inclP1)).app M).hom z) = z := by
    intro z
    induction z using Coinvariants.induction_on with
    | h v =>
      induction v using TensorProduct.inductionOn with
      | add a b ha hb => simp only [map_add, ha, hb]
      | tmul m p =>
        erw [FXmap_mk_gen, FXmap_mk_gen]
        have := congrArg (fun t => t.hom p) (inclP1_retrP1)
        exact congrArg (fun y => Coinvariants.mk (M.ρ.tprod (Rep.res π P1).ρ) (m ⊗ₜ[ℚ] y)) this
  obtain ⟨m, hm⟩ := genAt_surjective (x₀ := p0) M htr
    (((FXmap (Rep.resMap π inclP1)).app M).hom x)
  refine ⟨m, ?_⟩
  rw [← hid x, ← hm]
  exact FXmap_mk_gen (Rep.resMap π retrP1) (m ⊗ₜ[ℚ] MonoidAlgebra.single p0 (1 : ℚ))

theorem evalQ_edgeGen (hker : (π.ker : Set Q).Finite) (M : Rep.{0} ℚ Q) (m : M.V) :
    letI : MulAction Q OTE := oteMulActionQ π
    evalQ π hker M (Coinvariants.mk (M.ρ.tprod (Rep.res π P1).ρ) (m ⊗ₜ[ℚ] edgeGen)) =
      (1 / 2 : ℚ) • (normAt (stab_finite_Q π hker) M p0 m - normAt (stab_finite_Q π hker) M p0.swap m) := by
  let _ : MulAction Q OTE := oteMulActionQ π
  have h1 : ((FXmap (Rep.resMap π inclP1)).app M).hom (Coinvariants.mk (M.ρ.tprod (Rep.res π P1).ρ) (m ⊗ₜ[ℚ] edgeGen)) =
      Coinvariants.mk (M.ρ.tprod (Rep.res π PE).ρ) (m ⊗ₜ[ℚ] edgeVec p0) := by
    erw [FXmap_mk_gen]
    exact congrArg (fun y => Coinvariants.mk (M.ρ.tprod (Rep.res π PE).ρ) (m ⊗ₜ[ℚ] y)) edgeGen_coe
  have key : evalQ π hker M (Coinvariants.mk (M.ρ.tprod (Rep.res π P1).ρ) (m ⊗ₜ[ℚ] edgeGen)) =
      evalTen (stab_finite_Q π hker) M (m ⊗ₜ[ℚ] edgeVec p0) :=
    (congrArg (evalAt (stab_finite_Q π hker) M) h1).trans (evalAt_mk _ M m _)
  rw [key]
  unfold edgeVec
  rw [TensorProduct.tmul_smul, map_smul, TensorProduct.tmul_sub, map_sub, evalTen_tmul_single,
    evalTen_tmul_single, one_smul, one_smul]

end TernaryPeriodPolynomials.Argument.HochschildSerre
