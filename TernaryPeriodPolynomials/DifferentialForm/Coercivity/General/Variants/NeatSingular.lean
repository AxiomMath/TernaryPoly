module

public import TernaryPeriodPolynomials.DifferentialForm.Coercivity.General.Variants.GeneralSingular
public import TernaryPeriodPolynomials.EisensteinSeries.ConstantTerms.Neat

@[expose] public section


/-!
# The singular `H²_c → H²` vanishing for every neat finite-index subgroup of `SL₃(ℤ)`

The paper applies Proposition
`ar:prop:coercivity` to a *neat* normal congruence subgroup `Γ' ⊂ K ∩ SL₃(ℤ)`, and states it for a neat
principal congruence subgroup `Γ ⊂ SL₃(ℤ)` of level divisible by three and its rational conjugates.
`Variants/GeneralSingular` proves the vanishing for the principal congruence subgroups `Γ(N)`, `3 ∣ N`, and
their rational conjugates.  This file removes the principal-congruence restriction: it holds for **every
subgroup `H ≤ GL₃(ℤ)` of finite index, of determinant one, that is neat** (and, more generally, for every
torsion-free such `H`), and for every rational conjugate of such an `H`.  Normality in `K` plays no role in
the vanishing.

* `IsNeat H`: for every `h ∈ H`, the subgroup of `ℂˣ` generated by the eigenvalues of `h` (the nonzero
  complex roots of its characteristic polynomial) contains no nontrivial root of unity (Borel, as in the
  paper).
* `IsNeat.torsionFree`: a neat subgroup is torsion-free.  (If `h` has finite order `n`, its eigenvalues are
  `n`-th roots of unity by the spectral mapping, hence `1` by neatness; then the characteristic polynomial
  is `(X - 1)³`, `(h - 1)³ = 0` by Cayley-Hamilton, and `h^n = 1` forces `h = 1` in characteristic zero.)
* `admissible_map_realIntegral_of_torsionFree`: a torsion-free determinant-one subgroup of `GL₃(ℤ)` is
  `Admissible` (an integral matrix fixing a point of the symmetric space has finite order, as in
  `admissible_map_realIntegral`).
* `commensurable_map_realIntegral`: a finite-index subgroup of `GL₃(ℤ)` is commensurable with `Γ(6)`.
* `singularVanish_neat_*`, `singularVanish_neatConj_*`: the five coefficient systems.
* Bridge to the paper's `SL₃(ℤ)` wording: for a finite-index `Γ ≤ SL₃(ℤ)` that is neat in the sense of
  `ConvergenceC4.IsNeat` (`singularVanish_neatSL_*`), and in particular for the neat principal congruence
  subgroups `Γ(N)`, **every** `N ≥ 3` (not only `3 ∣ N`, `singularVanish_gammaN_*`; neatness of `Γ(N)` is
  `ConvergenceC4.gammaN_isNeat`).

Formalized by Claude Sonnet 5.5.
-/

noncomputable section
namespace TernaryPeriodPolynomials.Argument.GeneralCoercivity

open Polynomial Matrix TernaryPoly.SymmetricSpacePositive TernaryPoly.SymmetricSpaceCovering
  TernaryPoly.PolynomialCoefficientMetric TernaryPoly.SmoothSingularGlobal
  TernaryPoly.IntegralGL3Congruence TernaryPoly.SymmetricSpaceArithmeticProper
open TernaryPoly.PolynomialGLAction (GL3)

section Algebra

/-- A unipotent matrix of finite order is trivial (characteristic zero). -/
theorem nilp_eq_zero_of_pow_eq_one {R : Type*} [Ring R] [Algebra ℂ R] (N : R) (n : ℕ) (hn : 0 < n)
    (hN : IsNilpotent N) (h : (1 + N) ^ n = 1) : N = 0 := by
  have hgeom : N * ∑ i ∈ Finset.range n, (1 + N) ^ i = 0 := by
    have := mul_geom_sum (1 + N) n
    rw [h, sub_self] at this
    have h2 : (1 + N) - 1 = N := by abel
    rw [h2] at this
    exact this
  have hpow : ∀ i : ℕ, ∃ Q : R, Commute N Q ∧ (1 + N) ^ i = 1 + N * Q := by
    intro i
    induction i with
    | zero => exact ⟨0, Commute.zero_right N, by simp⟩
    | succ i ih =>
      obtain ⟨Q, hQ, hi⟩ := ih
      refine ⟨1 + Q + Q * N, ?_, ?_⟩
      · exact ((Commute.one_right N).add_right hQ).add_right (hQ.mul_right (Commute.refl N))
      · rw [pow_succ, hi]
        noncomm_ring
  have hS : ∀ m : ℕ, ∃ Q : R, Commute N Q ∧ ∑ i ∈ Finset.range m, (1 + N) ^ i = (m : R) + N * Q := by
    intro m
    induction m with
    | zero => exact ⟨0, Commute.zero_right N, by simp⟩
    | succ m ih =>
      obtain ⟨Q, hQ, hs⟩ := ih
      obtain ⟨Q', hQ', hp⟩ := hpow m
      refine ⟨Q + Q', hQ.add_right hQ', ?_⟩
      rw [Finset.sum_range_succ, hs, hp]
      push_cast
      noncomm_ring
  obtain ⟨Q, hQ, hs⟩ := hS n
  have hnil : IsNilpotent (N * Q) := by
    obtain ⟨k, hk⟩ := hN
    exact ⟨k, by rw [hQ.mul_pow, hk, zero_mul]⟩
  have hu : IsUnit ((n : R) + N * Q) := by
    have hu0 : IsUnit (n : R) := by
      have : (n : R) = algebraMap ℂ R (n : ℂ) := by simp
      rw [this]
      exact (isUnit_iff_ne_zero.mpr (by exact_mod_cast hn.ne')).map _
    exact hnil.isUnit_add_left_of_commute hu0 (Nat.cast_commute _ _).symm
  rw [hs] at hgeom
  exact (hu.mul_left_eq_zero).mp hgeom

/-- A complex `3 × 3` matrix of finite order all of whose eigenvalues equal `1` is the identity. -/
theorem matrix_eq_one_of_pow_eq_one_of_roots (M : Matrix (Fin 3) (Fin 3) ℂ) (n : ℕ) (hn : 0 < n)
    (hM : M ^ n = 1) (hroots : ∀ r : ℂ, M.charpoly.IsRoot r → r = 1) : M = 1 := by
  have hmon : M.charpoly.Monic := Matrix.charpoly_monic M
  have hsp : M.charpoly.Splits := IsAlgClosed.splits _
  have hform := hsp.eq_prod_roots_of_monic hmon
  have hcard : Multiset.card M.charpoly.roots = 3 := by
    rw [IsAlgClosed.card_roots_eq_natDegree, Matrix.charpoly_natDegree_eq_dim]
    simp
  have hrep : M.charpoly.roots = Multiset.replicate 3 1 := by
    apply Multiset.eq_replicate.mpr
    refine ⟨hcard, fun r hr => ?_⟩
    exact hroots r ((Polynomial.mem_roots hmon.ne_zero).mp hr)
  have hcp : M.charpoly = (Polynomial.X - 1) ^ 3 := by
    rw [hform, hrep]
    simp
    ring
  have hCH := Matrix.aeval_self_charpoly M
  rw [hcp] at hCH
  have hN : IsNilpotent (M - 1) := ⟨3, by simpa using hCH⟩
  have := nilp_eq_zero_of_pow_eq_one (M - 1) n hn hN (by simpa using hM)
  exact sub_eq_zero.mp this

/-- Every eigenvalue of a complex matrix with `M ^ n = 1` is an `n`-th root of unity. -/
theorem root_pow_eq_one_of_pow_eq_one {M : Matrix (Fin 3) (Fin 3) ℂ} {n : ℕ} (hM : M ^ n = 1)
    {r : ℂ} (hr : M.charpoly.IsRoot r) : r ^ n = 1 := by
  have h1 : r ∈ spectrum ℂ M := (Matrix.mem_spectrum_iff_isRoot_charpoly).mpr hr
  have h2 : (fun x : ℂ => x ^ n) r ∈ spectrum ℂ (M ^ n) := by
    have := spectrum.subset_polynomial_aeval M (Polynomial.X ^ n : ℂ[X])
    simpa using this ⟨r, h1, rfl⟩
  rw [hM, spectrum.one_eq] at h2
  exact h2

end Algebra

section Neat

/-- The complex matrix of an integral matrix. -/
def complexMat (h : IntegralGL) : Matrix (Fin 3) (Fin 3) ℂ :=
  (Matrix.GeneralLinearGroup.map (Int.castRingHom ℂ) h).val

/-- The eigenvalues of an integral matrix, as units of `ℂ`. -/
def eigenvalueUnits (h : IntegralGL) : Set ℂˣ :=
  {u | (complexMat h).charpoly.IsRoot (u : ℂ)}

/-- **Neat subgroup** (Borel): for every element, the subgroup of `ℂˣ` generated by its
eigenvalues contains no nontrivial root of unity. -/
def IsNeat (H : Subgroup IntegralGL) : Prop :=
  ∀ h ∈ H, ∀ u ∈ Subgroup.closure (eigenvalueUnits h), IsOfFinOrder u → u = 1

theorem complexMat_pow (h : IntegralGL) (n : ℕ) :
    complexMat h ^ n = complexMat (h ^ n) := by
  unfold complexMat
  rw [map_pow, Units.val_pow_eq_pow_val]

/-- **A neat subgroup is torsion-free.** -/
theorem IsNeat.torsionFree {H : Subgroup IntegralGL} (hH : IsNeat H) :
    ∀ h ∈ H, IsOfFinOrder h → h = 1 := by
  intro h hh hfin
  obtain ⟨n, hn, hpow⟩ := (isOfFinOrder_iff_pow_eq_one.mp hfin)
  have hM : complexMat h ^ n = 1 := by
    rw [complexMat_pow, hpow]
    unfold complexMat
    rw [map_one]
    rfl
  have hroots : ∀ r : ℂ, (complexMat h).charpoly.IsRoot r → r = 1 := by
    intro r hr
    have hrn := root_pow_eq_one_of_pow_eq_one hM hr
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [zero_pow hn.ne'] at hrn
      exact zero_ne_one hrn
    let u : ℂˣ := Units.mk0 r hr0
    have hu : u ∈ eigenvalueUnits h := hr
    have hfu : IsOfFinOrder u := by
      rw [isOfFinOrder_iff_pow_eq_one]
      exact ⟨n, hn, Units.ext (by simpa [u] using hrn)⟩
    have := hH h hh u (Subgroup.subset_closure hu) hfu
    exact congrArg Units.val this
  have h1 : complexMat h = 1 := matrix_eq_one_of_pow_eq_one_of_roots _ n hn hM hroots
  apply Units.ext
  ext i j
  have := congrFun (congrFun h1 i) j
  simp only [complexMat, Matrix.GeneralLinearGroup.map] at this
  have h2 : ((h.val i j : ℤ) : ℂ) = ((1 : Matrix (Fin 3) (Fin 3) ℤ) i j : ℤ) := by
    simpa [Matrix.one_apply] using this
  exact_mod_cast h2

end Neat

section Admissible

/-- A torsion-free determinant-one subgroup of `GL₃(ℤ)` is admissible. -/
theorem admissible_map_realIntegral_of_torsionFree (H : Subgroup IntegralGL)
    (hdet : ∀ h ∈ H, h.val.det = 1) (htf : ∀ h ∈ H, IsOfFinOrder h → h = 1) :
    Admissible (H.map realIntegral) where
  det_one := by
    rintro _ ⟨h, hh, rfl⟩
    rw [realIntegral_det, hdet h hh]
    exact Int.cast_one
  free := by
    rintro _ ⟨h, hh, rfl⟩ S hS
    rw [htf h hh (integral_fixed_isOfFinOrder h S hS), map_one]
  transporters C D hC hD := by
    have hf := (compact_transporter_finite C D hC hD).image realIntegral
    refine (hf.preimage (Subtype.val_injective.injOn)).subset ?_
    rintro ⟨_, g, hg, rfl⟩ ⟨_, ⟨S, hS, rfl⟩, hT⟩
    exact ⟨g, ⟨S, hS, hT⟩, rfl⟩

/-- A finite-index subgroup of `GL₃(ℤ)` is commensurable with the principal congruence subgroup `Γ(6)`. -/
theorem commensurable_int_principal (H : Subgroup IntegralGL) [H.FiniteIndex] :
    H.Commensurable (principal 6) := by
  have : NeZero (6 : ℕ) := ⟨by norm_num⟩
  have h1 : H.IsFiniteRelIndex (principal 6) := Subgroup.isFiniteRelIndex_of_finiteIndex
  have h2 : (principal 6).IsFiniteRelIndex H := Subgroup.isFiniteRelIndex_of_finiteIndex
  exact ⟨h1, h2⟩

/-- The image in `GL₃(ℝ)` of a finite-index subgroup of `GL₃(ℤ)` is commensurable with the cover `gamma0 = Γ(6)`. -/
theorem commensurable_map_realIntegral (H : Subgroup IntegralGL) [H.FiniteIndex] :
    (H.map realIntegral).Commensurable gamma0 := by
  rw [gamma0_eq]
  exact commensurable_map realIntegral_injective (commensurable_int_principal H)

/-- The image in `GL₃(ℚ)` of a finite-index subgroup of `GL₃(ℤ)` is commensurable with `Γ(6)`. -/
theorem commensurable_map_embZ (H : Subgroup IntegralGL) [H.FiniteIndex] :
    (H.map embZ).Commensurable (PQ 6) :=
  commensurable_map embZ_injective (commensurable_int_principal H)

/-- Conjugates of finite-index subgroups of `GL₃(ℤ)` by rational matrices are commensurable with
`gamma0`. -/
theorem commensurable_conj_map_realIntegral (H : Subgroup IntegralGL) [H.FiniteIndex] (g0 : GL3) :
    (conjSubgroup (H.map realIntegral) (embQ g0)).Commensurable gamma0 := by
  have h1 : (conjQ (H.map embZ) g0).Commensurable (conjQ (PQ 6) g0) :=
    commensurable_map (MulAut.conj g0).injective (commensurable_map_embZ H)
  have h2 := h1.trans (commensurable_conjQ_PQ g0 6 (by norm_num))
  have h3 := commensurable_map glMap_injective h2
  rw [conjQ_map_embQ] at h3
  have e1 : (H.map embZ).map embQ = H.map realIntegral := by
    rw [Subgroup.map_map, ← realIntegral_eq_comp]
  have e2 : (PQ 6).map embQ = gamma0 := by
    rw [gamma0_eq, principalReal_eq]
    rfl
  rw [e1, e2] at h3
  exact h3

end Admissible

