/-! ### Bridge to the paper's `SL₃(ℤ)` formulation (`ConvergenceC4.IsNeat`) -/

section SL

open scoped MatrixGroups

/-- The image in `GL₃(ℤ)` of a subgroup of `SL₃(ℤ)`. -/
abbrev toGLSubgroup (Γ : Subgroup SL(3, ℤ)) : Subgroup IntegralGL :=
  Γ.map (Matrix.SpecialLinearGroup.toGL : SL(3, ℤ) →* IntegralGL)

theorem toGLSubgroup_det (Γ : Subgroup SL(3, ℤ)) : ∀ h ∈ toGLSubgroup Γ, h.val.det = 1 := by
  rintro _ ⟨γ, _, rfl⟩
  exact γ.2

/-- A neat subgroup of `SL₃(ℤ)` in the sense of `ConvergenceC4.IsNeat` is neat in `GL₃(ℤ)`. -/
theorem isNeat_toGLSubgroup {Γ : Subgroup SL(3, ℤ)} (hΓ : ConvergenceC4.IsNeat Γ) :
    IsNeat (toGLSubgroup Γ) := by
  rintro _ ⟨γ, hγ, rfl⟩ u hu hfin
  exact hΓ γ hγ u hu hfin

theorem finiteIndex_range_toGL :
    (Matrix.SpecialLinearGroup.toGL : SL(3, ℤ) →* IntegralGL).range.FiniteIndex := by
  have h1 : (Matrix.GeneralLinearGroup.det : IntegralGL →* ℤˣ).ker.FiniteIndex := by
    have : Finite (Matrix.GeneralLinearGroup.det : IntegralGL →* ℤˣ).range :=
      Finite.of_injective (fun x : (Matrix.GeneralLinearGroup.det : IntegralGL →* ℤˣ).range => (x : ℤˣ))
        Subtype.val_injective
    infer_instance
  refine Subgroup.finiteIndex_of_le (H := (Matrix.GeneralLinearGroup.det : IntegralGL →* ℤˣ).ker) ?_
  intro g hg
  refine ⟨⟨g.val, ?_⟩, ?_⟩
  · have := (MonoidHom.mem_ker).mp hg
    have h2 := congrArg Units.val this
    simpa using h2
  · apply Units.ext
    rfl

theorem finiteIndex_toGLSubgroup (Γ : Subgroup SL(3, ℤ)) [Γ.FiniteIndex] :
    (toGLSubgroup Γ).FiniteIndex := by
  have := finiteIndex_range_toGL
  refine ⟨?_⟩
  rw [Subgroup.index_map]
  have hk : (Matrix.SpecialLinearGroup.toGL : SL(3, ℤ) →* IntegralGL).ker = ⊥ :=
    (MonoidHom.ker_eq_bot_iff _).mpr Matrix.SpecialLinearGroup.toGL_injective
  rw [hk, sup_bot_eq]
  exact mul_ne_zero Subgroup.FiniteIndex.index_ne_zero Subgroup.FiniteIndex.index_ne_zero

end SL

section Neat

