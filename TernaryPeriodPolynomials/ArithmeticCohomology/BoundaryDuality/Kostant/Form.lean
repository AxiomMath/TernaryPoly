/-!
# The cochain form of the cup product on a rank-two abelian group

Let `U` be an abelian group generated by two elements `a, b`, let `ρ, σ` be representations of
`U` on `V, W`, and let `β : V × W → ℂ` be a bilinear form which is adjoint for `ρ, σ` at the
generators, `β (ρ x v) w = β v (σ x w)` for `x ∈ {a, b}`.  For 1-cocycles `z` of `ρ` and `w` of `σ`
the cup product `z ∪ w` evaluated on the fundamental 2-cycle `[a|b] − [b|a]` of `U` is

  `K(z, w) = β (z a) (w b) − β (z b) (w a)`,

which depends only on the two pairs of generator values.  This module proves the two
cohomological facts which make it a pairing on `H¹(U, V) × H¹(U, W)`: it vanishes when `z` is a
coboundary and `w` is a cocycle, and when `w` is a coboundary and `z` is a cocycle.  The cocycle
condition for the commuting pair `(a, b)` enters only through
`(ρ a − 1) (z b) = (ρ b − 1) (z a)`.

Original work by Claude Sonnet 5.5 (AxiomCode).
-/

noncomputable section

namespace TernaryPeriodPolynomials.BoundaryDuality.Kostant

section Generic

variable {G V W : Type} [Group G] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]

/-- The Kostant pairing of two 1-cocycles, read from their values on the two generators:
`K = β zα wβ − β zβ wα` where `zα, zβ` are the values of `z` and `wα, wβ` those of `w`. -/
def kostantValue (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (zα zβ : V) (wα wβ : W) : ℂ :=
  β zα wβ - β zβ wα

/-- Adjointness of a bilinear form for two representations at a group element. -/
def IsAdjointAt (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (x : G) : Prop :=
  ∀ (v : V) (w : W), β (ρ x v) w = β v (σ x w)

/-- The Kostant pairing is additive in the first cocycle. -/
theorem kostantValue_add_left (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (zα zβ zα' zβ' : V) (wα wβ : W) :
    kostantValue β (zα + zα') (zβ + zβ') wα wβ =
      kostantValue β zα zβ wα wβ + kostantValue β zα' zβ' wα wβ := by
  unfold kostantValue
  simp only [map_add, LinearMap.add_apply]
  ring

/-- The Kostant pairing is additive in the second cocycle. -/
theorem kostantValue_add_right (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (zα zβ : V) (wα wβ wα' wβ' : W) :
    kostantValue β zα zβ (wα + wα') (wβ + wβ') =
      kostantValue β zα zβ wα wβ + kostantValue β zα zβ wα' wβ' := by
  unfold kostantValue
  simp only [map_add]
  ring

/-- The Kostant pairing is homogeneous in the first cocycle. -/
theorem kostantValue_smul_left (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (c : ℂ) (zα zβ : V) (wα wβ : W) :
    kostantValue β (c • zα) (c • zβ) wα wβ = c * kostantValue β zα zβ wα wβ := by
  unfold kostantValue
  simp only [map_smul, LinearMap.smul_apply, smul_eq_mul]
  ring

/-- The Kostant pairing is homogeneous in the second cocycle. -/
theorem kostantValue_smul_right (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (c : ℂ) (zα zβ : V) (wα wβ : W) :
    kostantValue β zα zβ (c • wα) (c • wβ) = c * kostantValue β zα zβ wα wβ := by
  unfold kostantValue
  simp only [map_smul, smul_eq_mul]
  ring

/-- **Left invariance.**  If `z = d v` is the coboundary of a vector, its Kostant pairing with
every cocycle `w` vanishes (the cocycle condition of `w` on the commuting pair `(a, b)`). -/
theorem kostantValue_boundary_left (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (a b : G) (ha : IsAdjointAt ρ σ β a) (hb : IsAdjointAt ρ σ β b)
    (v : V) (wα wβ : W) (hw : σ a wβ - wβ = σ b wα - wα) :
    kostantValue β (ρ a v - v) (ρ b v - v) wα wβ = 0 := by
  unfold kostantValue
  simp only [map_sub, LinearMap.sub_apply, ha v wβ, hb v wα]
  have h := congrArg (β v) hw
  simp only [map_sub] at h
  linear_combination h

/-- **Right invariance.**  If `w = d u` is the coboundary of a vector, its Kostant pairing with
every cocycle `z` vanishes. -/
theorem kostantValue_boundary_right (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (a b : G) (ha : IsAdjointAt ρ σ β a) (hb : IsAdjointAt ρ σ β b)
    (zα zβ : V) (hz : ρ a zβ - zβ = ρ b zα - zα) (u : W) :
    kostantValue β zα zβ (σ a u - u) (σ b u - u) = 0 := by
  unfold kostantValue
  simp only [map_sub, ← ha zβ u, ← hb zα u]
  have h := congrArg (fun x => β x u) hz
  simp only [map_sub, LinearMap.sub_apply] at h
  linear_combination (-1 : ℂ) * h

/-- The cocycle law for a commuting pair gives `(ρ a − 1) (z b) = (ρ b − 1) (z a)`. -/
theorem closed_of_cocycle (ρ : Representation ℂ G V) (z : G → V)
    (hz : ∀ g h, z (g * h) = ρ g (z h) + z g) (a b : G) (hab : a * b = b * a) :
    ρ a (z b) - z b = ρ b (z a) - z a := by
  have h1 := hz a b
  have h2 := hz b a
  rw [hab] at h1
  exact sub_eq_sub_iff_add_eq_add.mpr (h1.symm.trans h2)

/-- **Left invariance for an arbitrary pair of adjoint endomorphisms.**  If `A, B` on `V` are adjoint
to `A', B'` on `W` for `β`, and `(A' − 1) wβ = (B' − 1) wα`, the pairing of the coboundary
`((A − 1) v, (B − 1) v)` with `(wα, wβ)` vanishes. -/
theorem kostantValue_boundary_left_end (β : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (A B : Module.End ℂ V)
    (A' B' : Module.End ℂ W) (ha : ∀ (v : V) (w : W), β (A v) w = β v (A' w))
    (hb : ∀ (v : V) (w : W), β (B v) w = β v (B' w)) (v : V) (wα wβ : W)
    (hw : A' wβ - wβ = B' wα - wα) :
    kostantValue β (A v - v) (B v - v) wα wβ = 0 := by
  unfold kostantValue
  simp only [map_sub, LinearMap.sub_apply, ha v wβ, hb v wα]
  have h := congrArg (β v) hw
  simp only [map_sub] at h
  linear_combination h

end Generic

end TernaryPeriodPolynomials.BoundaryDuality.Kostant

