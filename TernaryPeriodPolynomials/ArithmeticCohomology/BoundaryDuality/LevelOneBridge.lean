module

public import TernaryPeriodPolynomials.ArithmeticCohomology.BoundaryDuality.EpsilonSplit

@[expose] public section


/-!
# The parabolic cup pairing on a group generated by `S` and `U = S T` (level one)

For `G = SL₂(ℤ) = ⟨S⟩ *_{⟨S²⟩} ⟨U⟩` acting through `PSL₂(ℤ)` (`S²` acts trivially), the three
special elements of the triple model are `a = S`, `g₂ = T⁻¹` and `a g₂ = S T⁻¹` (an element of order
three): one cusp (`T`) and two cone points.  Two inputs are supplied by the amalgam structure:

* `generated`: cocycles are determined by their values at `S` and `U`;
* `exb`: for every `w` there is a cocycle `z_w` with `z_w (S) = 0` and `z_w (U) = (U - 1) w`
  (the connecting cocycle of the Mayer–Vietoris sequence).

From them, cocycles are determined by their values at `S` and `T⁻¹`, and every constrained triple is the
primitive triple of a cocycle.  The Poincaré duality of `CocycleBridge` and `EpsilonSplit` then holds
for the parabolic classes of `SL₂(ℤ)` and of `GL₂(ℤ)`.
-/

noncomputable section

namespace TernaryPeriodPolynomials.BoundaryDuality.LevelOneBridge

open TripleModel LinearDuality CocycleBridge EpsilonSplit

variable {G V : Type} [Group G] [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ G V) (S T : G)

/-- Cocycles are determined by their values at `S` and `T⁻¹`. -/
theorem generated_of
    (gen : ∀ z z' : G → V, IsCocycle ρ z → IsCocycle ρ z' → z S = z' S →
      z (S * T) = z' (S * T) → z = z')
    (z z' : G → V) (hz : IsCocycle ρ z) (hz' : IsCocycle ρ z') (h1 : z S = z' S)
    (h2 : z T⁻¹ = z' T⁻¹) : z = z' := by
  apply gen z z' hz hz' h1
  have hT : ∀ y : G → V, IsCocycle ρ y → y T = -ρ T (y T⁻¹) := fun y hy => by
    have := isCocycle_map_inv hy T⁻¹
    rw [inv_inv] at this
    exact this
  rw [hz S T, hz' S T, h1, hT z hz, hT z' hz', h2]

/-- Every constrained triple is the primitive triple of a cocycle. -/
theorem exists_primitive (hS2 : ∀ v, ρ (S * S) v = v)
    (exb : ∀ w : V, ∃ z : G → V, IsCocycle ρ z ∧ z S = 0 ∧ z (S * T) = (ρ (S * T) - 1) w)
    {v : V × V × V} (hv : v ∈ tripleCycles ρ S T⁻¹) :
    ∃ z : G → V, IsCocycle ρ z ∧ IsPrimitive ρ S T⁻¹ z v := by
  have hc : constraint ρ S T⁻¹ v = 0 := LinearMap.mem_ker.1 hv
  rw [constraint_apply] at hc
  obtain ⟨x, hx⟩ : ∃ x : V, x = v.2.2 - v.1 := ⟨_, rfl⟩
  obtain ⟨z₀, hz₀, hS, hU⟩ := exb (ρ S⁻¹ x)
  obtain ⟨zf, hzf⟩ : ∃ zf : G → V, ∀ g, zf g = z₀ g + (ρ g v.1 - v.1) := ⟨fun g => _, fun g => rfl⟩
  have hz : IsCocycle ρ zf := by
    have := isCocycle_add hz₀ (isCocycle_boundary ρ v.1)
    intro g h
    rw [hzf, hzf, hzf]
    exact this g h
  have hS2inv : ∀ x, ρ (S * S)⁻¹ x = x := fun x => by
    have := rep_inv_apply ρ (S * S) x
    rwa [hS2] at this
  have hb : S * T⁻¹ = S * ((S * T)⁻¹ * S) := by group
  have e1 : z₀ (S * ((S * T)⁻¹ * S)) = -ρ S (ρ (S * T)⁻¹ (z₀ (S * T))) := by
    rw [hz₀ S ((S * T)⁻¹ * S), hz₀ (S * T)⁻¹ S, hS, isCocycle_map_inv hz₀ (S * T), map_zero,
      add_zero, zero_add, map_neg]
  have k : ρ S (ρ (S * T)⁻¹ (ρ S⁻¹ x)) = ρ (S * T⁻¹) x := by
    rw [← rep_mul_apply, ← rep_mul_apply]
    have : S * (S * T)⁻¹ * S⁻¹ = (S * T⁻¹) * (S * S)⁻¹ := by group
    rw [this, rep_mul_apply ρ (S * T⁻¹) (S * S)⁻¹, hS2inv]
  have z0b : z₀ (S * T⁻¹) = (ρ (S * T⁻¹) - 1) x := by
    rw [congrArg z₀ hb, e1, hU]
    simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub, rep_inv_apply ρ,
      rep_apply_inv ρ]
    rw [k]
    abel
  have hzS : zf S = (ρ S - 1) v.1 := by
    rw [hzf, hS, zero_add, LinearMap.sub_apply, Module.End.one_apply]
  have hzb : zf (S * T⁻¹) = (ρ (S * T⁻¹) - 1) v.2.2 := by
    rw [hzf, z0b, hx]
    simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub]
    abel
  refine ⟨zf, hz, ?_⟩
  refine ⟨hzS, ?_, ?_⟩
  · have h1 : zf T⁻¹ = zf S⁻¹ + ρ S⁻¹ (zf (S * T⁻¹)) := by
      have := hz S⁻¹ (S * T⁻¹)
      rwa [show S⁻¹ * (S * T⁻¹) = T⁻¹ by group] at this
    have h2 := isCocycle_map_inv hz S
    rw [h1, h2, hzS, hzb]
    have key : (ρ (S * T⁻¹) - 1) v.2.2 - (ρ S - 1) v.1 = (ρ (S * T⁻¹) - ρ S) v.2.1 := by
      simp only [LinearMap.sub_apply, Module.End.one_apply] at hc ⊢
      linear_combination (norm := module) (-1 : ℂ) • hc
    have e2 : ρ S⁻¹ ((ρ (S * T⁻¹) - ρ S) v.2.1) = (ρ T⁻¹ - 1) v.2.1 := by
      simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub, rep_inv_apply ρ]
      rw [← rep_mul_apply, show S⁻¹ * (S * T⁻¹) = T⁻¹ by group]
    calc -ρ S⁻¹ ((ρ S - 1) v.1) + ρ S⁻¹ ((ρ (S * T⁻¹) - 1) v.2.2)
        = ρ S⁻¹ ((ρ (S * T⁻¹) - 1) v.2.2 - (ρ S - 1) v.1) := by
          rw [map_sub]; abel
      _ = (ρ T⁻¹ - 1) v.2.1 := by rw [key, e2]
  · have h := isCocycle_map_inv hz (S * T⁻¹)
    rw [h, hzb]
    simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub, rep_inv_apply ρ]
    abel

section Nondegenerate

variable {W : Type} [AddCommGroup W] [Module ℂ W] {ρ' : Representation ℂ G W}
  {B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ}

/-- **Left nondegeneracy of the parabolic cup pairing at level one.** -/
theorem left_nondegenerate [FiniteDimensional ℂ V] [FiniteDimensional ℂ W]
    (hL : ∀ v, (∀ w, B v w = 0) → v = 0) (hR : ∀ w, (∀ v, B v w = 0) → w = 0)
    (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w)
    (gen : ∀ z z' : G → V, IsCocycle ρ z → IsCocycle ρ z' → z S = z' S →
      z (S * T) = z' (S * T) → z = z')
    (hS2' : ∀ w, ρ' (S * S) w = w)
    (exb' : ∀ w : W, ∃ z : G → W, IsCocycle ρ' z ∧ z S = 0 ∧ z (S * T) = (ρ' (S * T) - 1) w)
    {z : G → V} (hz : IsCocycle ρ z) {v : V × V × V} (hv : IsPrimitive ρ S T⁻¹ z v)
    (zero : ∀ (z' : G → W) (v' : W × W × W), IsCocycle ρ' z' → IsPrimitive ρ' S T⁻¹ z' v' →
      tripleForm B ρ' S T⁻¹ v v' = 0) :
    ∃ u : V, ∀ g, z g = ρ g u - u :=
  CocycleBridge.left_nondegenerate hL hR hinv S T⁻¹ (generated_of ρ S T gen)
    (fun _ hv' => exists_primitive ρ' S T hS2' exb' hv') hz hv zero

/-- **Left nondegeneracy for the reflection-invariant classes at level one** (`GL₂(ℤ)`; twisted
coefficients, `B (e v) (e' w) = - B v w`). -/
theorem left_nondegenerate_reflect [FiniteDimensional ℂ V] [FiniteDimensional ℂ W]
    (hL : ∀ v, (∀ w, B v w = 0) → v = 0) (hR : ∀ w, (∀ v, B v w = 0) → w = 0)
    (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w)
    (D : ReflectData ρ ρ' B S T⁻¹ (-1 : ℂ))
    (gen : ∀ z z' : G → V, IsCocycle ρ z → IsCocycle ρ z' → z S = z' S →
      z (S * T) = z' (S * T) → z = z')
    (hS2' : ∀ w, ρ' (S * S) w = w)
    (exb' : ∀ w : W, ∃ z : G → W, IsCocycle ρ' z ∧ z S = 0 ∧ z (S * T) = (ρ' (S * T) - 1) w)
    {z : G → V} (hz : IsCocycle ρ z) {v : V × V × V} (hv : IsPrimitive ρ S T⁻¹ z v)
    (zinv : reflect D.σ D.e z = z)
    (zero : ∀ (z' : G → W) (v' : W × W × W), IsCocycle ρ' z' → IsPrimitive ρ' S T⁻¹ z' v' →
      reflect D.σ D.e' z' = z' → cupFormula B ρ' S T⁻¹ z z' v = 0) :
    ∃ u : V, D.e u = u ∧ ∀ g, z g = ρ g u - u :=
  EpsilonSplit.left_nondegenerate_reflect hL hR hinv D (generated_of ρ S T gen)
    (fun _ hv' => exists_primitive ρ' S T hS2' exb' hv') hz hv zinv zero

end Nondegenerate

end TernaryPeriodPolynomials.BoundaryDuality.LevelOneBridge
