module

public import TernaryPeriodPolynomials.ArithmeticCohomology.BoundaryDuality.TripleModel
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Tactic.LinearCombination
public import Mathlib.Tactic.Module
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.Group

@[expose] public section


/-!
# Perfectness of the cup-product form on the triple model

For a perfect `G`-invariant pairing `B : V × W → ℂ` the form `tripleForm` on the constrained triples
`ker Ψ ⊂ V³`, `ker Ψ' ⊂ W³` has left radical exactly the trivial triples `R` and right radical
exactly `R'`.  Hence the induced pairing on `ker Ψ / R` and `ker Ψ' / R'` (the parabolic first
cohomology of a group generated by `a, g₂` whose cocycles are freely prescribed) is perfect.
-/

noncomputable section

namespace TernaryPeriodPolynomials.BoundaryDuality.LinearDuality

open TripleModel

section Representation

variable {G M : Type} [Group G] [AddCommGroup M] [Module ℂ M] (ρ : Representation ℂ G M)

theorem rep_mul_apply (g h : G) (v : M) : ρ (g * h) v = ρ g (ρ h v) := by
  rw [map_mul, Module.End.mul_apply]

theorem rep_apply_inv (g : G) (v : M) : ρ g (ρ g⁻¹ v) = v := by
  rw [← rep_mul_apply, mul_inv_cancel, map_one, Module.End.one_apply]

theorem rep_inv_apply (g : G) (v : M) : ρ g⁻¹ (ρ g v) = v := by
  rw [← rep_mul_apply, inv_mul_cancel, map_one, Module.End.one_apply]

theorem mem_fixedBy_inv {g : G} {v : M} : v ∈ fixedBy ρ g⁻¹ ↔ v ∈ fixedBy ρ g := by
  rw [mem_fixedBy, mem_fixedBy]
  constructor
  · intro h
    have := congrArg (fun w => ρ g w) h
    rw [rep_apply_inv] at this
    exact this.symm
  · intro h
    have := congrArg (fun w => ρ g⁻¹ w) h
    rw [rep_inv_apply] at this
    exact this.symm

end Representation

section Pairing

variable {G V W : Type} [Group G] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
  {ρ : Representation ℂ G V} {ρ' : Representation ℂ G W} {B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ}

theorem pair_rep_left (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (g : G) (v : V) (w : W) :
    B (ρ g v) w = B v (ρ' g⁻¹ w) := by
  have := hinv g v (ρ' g⁻¹ w)
  rwa [rep_apply_inv ρ'] at this

theorem pair_rep_right (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (g : G) (v : V) (w : W) :
    B v (ρ' g w) = B (ρ g⁻¹ v) w := by
  rw [pair_rep_left hinv, inv_inv]

theorem pair_fixed (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) {g : G} {u : V}
    (hu : u ∈ fixedBy ρ g) (x : W) : B u (ρ' g x) = B u x := by
  have h : ρ g⁻¹ u = u := mem_fixedBy.1 ((mem_fixedBy_inv ρ).2 hu)
  rw [pair_rep_right hinv, h]

theorem mem_fixedBy_of_pair (hL : ∀ v, (∀ w, B v w = 0) → v = 0)
    (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) {g : G} {u : V}
    (h : ∀ x, B u ((ρ' g - 1) x) = 0) : u ∈ fixedBy ρ g := by
  rw [← mem_fixedBy_inv ρ, mem_fixedBy]
  have hz : ρ g⁻¹ u - u = 0 := by
    apply hL
    intro x
    have h1 := h x
    rw [LinearMap.sub_apply, Module.End.one_apply, map_sub] at h1
    rw [map_sub, LinearMap.sub_apply, pair_rep_left hinv, inv_inv]
    linear_combination h1
  exact sub_eq_zero.1 hz

end Pairing

section Factoring

variable {M N : Type} [AddCommGroup M] [Module ℂ M] [AddCommGroup N] [Module ℂ N]

/-- A functional vanishing on the kernel of `Φ` factors through `Φ`. -/
theorem exists_factor (Φ : M →ₗ[ℂ] N) (f : M →ₗ[ℂ] ℂ) (h : ∀ m ∈ LinearMap.ker Φ, f m = 0) :
    ∃ g : N →ₗ[ℂ] ℂ, ∀ m, f m = g (Φ m) := by
  have hmem : f ∈ (LinearMap.ker Φ).dualAnnihilator := by
    rw [Submodule.mem_dualAnnihilator]
    exact h
  rw [← LinearMap.range_dualMap_eq_dualAnnihilator_ker] at hmem
  obtain ⟨g, hg⟩ := hmem
  exact ⟨g, fun m => by rw [← hg, LinearMap.dualMap_apply]⟩

end Factoring

section Perfect

variable {V W : Type} [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
  [FiniteDimensional ℂ V] [FiniteDimensional ℂ W] {B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ}

/-- Every functional on `W` is `B μ ·` for a perfect pairing. -/
theorem exists_pairing_left (hL : ∀ v, (∀ w, B v w = 0) → v = 0)
    (hR : ∀ w, (∀ v, B v w = 0) → w = 0) (f : W →ₗ[ℂ] ℂ) : ∃ μ : V, ∀ w, f w = B μ w := by
  have inj1 : Function.Injective B := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    exact hL v (fun w => by simpa using LinearMap.congr_fun hv w)
  have inj2 : Function.Injective B.flip := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro w hw
    exact hR w (fun v => by simpa using LinearMap.congr_fun hw v)
  have le1 : Module.finrank ℂ V ≤ Module.finrank ℂ (Module.Dual ℂ W) :=
    LinearMap.finrank_le_finrank_of_injective inj1
  have le2 : Module.finrank ℂ W ≤ Module.finrank ℂ (Module.Dual ℂ V) :=
    LinearMap.finrank_le_finrank_of_injective inj2
  rw [Subspace.dual_finrank_eq] at le1 le2
  have heq : Module.finrank ℂ V = Module.finrank ℂ (Module.Dual ℂ W) := by
    rw [Subspace.dual_finrank_eq]; omega
  have surj := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := B) heq).1 inj1
  obtain ⟨μ, hμ⟩ := surj f
  exact ⟨μ, fun w => by rw [← hμ]⟩

/-- Every functional on `V` is `B · ν` for a perfect pairing. -/
theorem exists_pairing_right (hL : ∀ v, (∀ w, B v w = 0) → v = 0)
    (hR : ∀ w, (∀ v, B v w = 0) → w = 0) (f : V →ₗ[ℂ] ℂ) : ∃ ν : W, ∀ v, f v = B v ν := by
  obtain ⟨ν, hν⟩ := exists_pairing_left (B := B.flip) hR hL f
  exact ⟨ν, fun v => hν v⟩

omit [FiniteDimensional ℂ V] [FiniteDimensional ℂ W] in
theorem eq_of_pair_eq (hR : ∀ w, (∀ v, B v w = 0) → w = 0) {p q : W}
    (h : ∀ x, B x p = B x q) : p = q := by
  have : p - q = 0 := by
    apply hR
    intro x
    rw [map_sub, h x, sub_self]
  exact sub_eq_zero.1 this

end Perfect

section Triple

variable {G V W : Type} [Group G] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
  {ρ : Representation ℂ G V} {ρ' : Representation ℂ G W} {B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ}

theorem tripleForm_apply (a g₂ : G) (v : V × V × V) (v' : W × W × W) :
    tripleForm B ρ' a g₂ v v' =
      B v.2.2 ((ρ' (a * g₂) - 1) v'.2.2) +
        B v.1 ((ρ' g₂ - 1 - ρ' (a * g₂) + ρ' a) v'.2.1 - (ρ' a - 1) v'.1) -
        B v.2.1 ((ρ' g₂ - 1) v'.2.1) := rfl

/-- The form is zero on the fixed parts of the first argument. -/
theorem tripleForm_fixed (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (a g₂ : G)
    {f₁ f₂ f₃ : V} (h₁ : f₁ ∈ fixedBy ρ a) (h₂ : f₂ ∈ fixedBy ρ g₂)
    (h₃ : f₃ ∈ fixedBy ρ (a * g₂)⁻¹) (v' : W × W × W) :
    tripleForm B ρ' a g₂ (f₁, f₂, f₃) v' = 0 := by
  have h₃' : f₃ ∈ fixedBy ρ (a * g₂) := (mem_fixedBy_inv ρ).1 h₃
  have e1 := pair_fixed hinv h₁
  have e2 := pair_fixed hinv h₂
  have e3 := pair_fixed hinv h₃'
  have e4 : ∀ x, B f₁ (ρ' (a * g₂) x) = B f₁ (ρ' g₂ x) := fun x => by
    rw [rep_mul_apply, e1]
  rw [tripleForm_apply]
  dsimp only
  simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
    e1, e2, e3, e4]
  ring

/-- The diagonal triples pair through the constraint. -/
theorem tripleForm_diag (a g₂ : G) (u : V) (v' : W × W × W) :
    tripleForm B ρ' a g₂ (u, u, u) v' = -B u (constraint ρ' a g₂ v') := by
  rw [tripleForm_apply, constraint_apply]
  dsimp only
  simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add]
  ring

/-- The form is zero on the fixed parts of the second argument. -/
theorem tripleForm_fixed' (a g₂ : G) (v : V × V × V)
    {f₁ f₂ f₃ : W} (h₁ : f₁ ∈ fixedBy ρ' a) (h₂ : f₂ ∈ fixedBy ρ' g₂)
    (h₃ : f₃ ∈ fixedBy ρ' (a * g₂)⁻¹) :
    tripleForm B ρ' a g₂ v (f₁, f₂, f₃) = 0 := by
  have h₃' : f₃ ∈ fixedBy ρ' (a * g₂) := (mem_fixedBy_inv ρ').1 h₃
  have e1 : ρ' a f₁ = f₁ := mem_fixedBy.1 h₁
  have e2 : ρ' g₂ f₂ = f₂ := mem_fixedBy.1 h₂
  have e3 : ρ' (a * g₂) f₃ = f₃ := mem_fixedBy.1 h₃'
  have e4 : ρ' (a * g₂) f₂ = ρ' a f₂ := by rw [rep_mul_apply, e2]
  have z3 : (ρ' (a * g₂) - 1) f₃ = 0 := by
    rw [LinearMap.sub_apply, Module.End.one_apply, e3, sub_self]
  have z2 : (ρ' g₂ - 1) f₂ = 0 := by
    rw [LinearMap.sub_apply, Module.End.one_apply, e2, sub_self]
  have z1 : (ρ' g₂ - 1 - ρ' (a * g₂) + ρ' a) f₂ - (ρ' a - 1) f₁ = 0 := by
    simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, e1, e2, e4]
    abel
  rw [tripleForm_apply]
  dsimp only
  rw [z3, z2, z1]
  simp

/-- The diagonal in the second argument pairs through the constraint. -/
theorem tripleForm_diag' (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (a g₂ : G)
    (v : V × V × V) (w : W) :
    tripleForm B ρ' a g₂ v (w, w, w) = B (constraint ρ a g₂ v) (ρ' (a * g₂) w) := by
  have k1 : ρ' a⁻¹ (ρ' (a * g₂) w) = ρ' g₂ w := by
    rw [← rep_mul_apply, inv_mul_cancel_left]
  have k2 : ρ' (a * g₂)⁻¹ (ρ' (a * g₂) w) = w := rep_inv_apply _ _ _
  rw [tripleForm_apply, constraint_apply]
  dsimp only
  simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
    pair_rep_left hinv a, pair_rep_left hinv (a * g₂), k1, k2]
  ring

end Triple

section Radicals

variable {G V W : Type} [Group G] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
  {ρ : Representation ℂ G V} {ρ' : Representation ℂ G W} {B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ}

/-- The trivial triples satisfy the constraint. -/
theorem tripleTrivial_le_tripleCycles (ρ : Representation ℂ G V) (a g₂ : G) :
    tripleTrivial ρ a g₂ ≤ tripleCycles ρ a g₂ := by
  intro v hv
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 hv
  obtain ⟨u, rfl⟩ := hz
  rw [Submodule.mem_prod] at hy
  obtain ⟨hy1, hy23⟩ := hy
  rw [Submodule.mem_prod] at hy23
  obtain ⟨hy2, hy3⟩ := hy23
  have h1 : ρ a y.1 = y.1 := mem_fixedBy.1 hy1
  have h2 : ρ g₂ y.2.1 = y.2.1 := mem_fixedBy.1 hy2
  have h3 : ρ (a * g₂) y.2.2 = y.2.2 := mem_fixedBy.1 ((mem_fixedBy_inv ρ).1 hy3)
  have h4 : ρ (a * g₂) y.2.1 = ρ a y.2.1 := by rw [rep_mul_apply, h2]
  have hz : (LinearMap.prod LinearMap.id (LinearMap.prod LinearMap.id LinearMap.id) :
      V →ₗ[ℂ] V × V × V) u = (u, u, u) := rfl
  rw [tripleCycles, LinearMap.mem_ker, hz, map_add, constraint_apply, constraint_apply]
  simp only [LinearMap.sub_apply, Module.End.one_apply, h1, h4, h3]
  module

/-- **Left radical.**  A constrained triple lies in the left radical of the form on the constrained
triples iff it is trivial. -/
theorem leftRadical_iff [FiniteDimensional ℂ V] [FiniteDimensional ℂ W]
    (hL : ∀ v, (∀ w, B v w = 0) → v = 0) (hR : ∀ w, (∀ v, B v w = 0) → w = 0)
    (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (a g₂ : G) (v : V × V × V) :
    (∀ v' ∈ tripleCycles ρ' a g₂, tripleForm B ρ' a g₂ v v' = 0) ↔ v ∈ tripleTrivial ρ a g₂ := by
  constructor
  · intro hrad
    obtain ⟨g, hg⟩ := exists_factor (constraint ρ' a g₂) (tripleForm B ρ' a g₂ v) hrad
    obtain ⟨μ, hμ⟩ := exists_pairing_left hL hR g
    have hfun : ∀ v', tripleForm B ρ' a g₂ v v' = B μ (constraint ρ' a g₂ v') :=
      fun v' => by rw [hg, hμ]
    -- first coordinate
    have e1 : ∀ x, B (v.1 + μ) ((ρ' a - 1) x) = 0 := by
      intro x
      have h := hfun (x, 0, 0)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub,
        map_zero, map_neg, sub_zero, zero_sub, add_zero] at h
      simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply,
        Module.End.one_apply]
      linear_combination -h
    have f1 : v.1 + μ ∈ fixedBy ρ a := mem_fixedBy_of_pair hL hinv e1
    -- third coordinate
    have e3 : ∀ x, B (v.2.2 + μ) ((ρ' (a * g₂) - 1) x) = 0 := by
      intro x
      have h := hfun (0, 0, x)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, Module.End.one_apply, map_sub, map_add,
        map_zero, sub_zero, add_zero] at h
      simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply,
        Module.End.one_apply]
      linear_combination h
    have f3 : v.2.2 + μ ∈ fixedBy ρ (a * g₂) := mem_fixedBy_of_pair hL hinv e3
    -- second coordinate
    have e2 : ∀ x, B (v.2.1 + μ) ((ρ' g₂ - 1) x) = 0 := by
      intro x
      have h := hfun (0, x, 0)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
        map_zero, sub_zero, add_zero] at h
      have K := pair_fixed hinv f1 x
      have K2 := pair_fixed hinv f1 (ρ' g₂ x)
      rw [← rep_mul_apply] at K2
      simp only [map_add, LinearMap.add_apply] at K K2
      simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply,
        Module.End.one_apply]
      linear_combination (-1 : ℂ) * h + (-1 : ℂ) * K2 + (1 : ℂ) * K
    have f2 : v.2.1 + μ ∈ fixedBy ρ g₂ := mem_fixedBy_of_pair hL hinv e2
    refine Submodule.mem_sup.2 ⟨(v.1 + μ, v.2.1 + μ, v.2.2 + μ), ?_, (-μ, -μ, -μ), ⟨-μ, rfl⟩, ?_⟩
    · rw [Submodule.mem_prod, Submodule.mem_prod]
      exact ⟨f1, f2, (mem_fixedBy_inv ρ).2 f3⟩
    · exact Prod.ext (by simp) (Prod.ext (by simp) (by simp))
  · intro htriv v' hv'
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 htriv
    obtain ⟨u, rfl⟩ := hz
    rw [Submodule.mem_prod] at hy
    obtain ⟨hy1, hy23⟩ := hy
    rw [Submodule.mem_prod] at hy23
    obtain ⟨hy2, hy3⟩ := hy23
    have hfix := tripleForm_fixed (ρ' := ρ') (B := B) hinv a g₂ hy1 hy2 hy3 v'
    have hdiag := tripleForm_diag (B := B) (ρ' := ρ') a g₂ u v'
    have hv'0 : constraint ρ' a g₂ v' = 0 := LinearMap.mem_ker.1 hv'
    have : tripleForm B ρ' a g₂ (y + (LinearMap.prod LinearMap.id
        (LinearMap.prod LinearMap.id LinearMap.id) : V →ₗ[ℂ] V × V × V) u) v' = 0 := by
      have hz : (LinearMap.prod LinearMap.id
        (LinearMap.prod LinearMap.id LinearMap.id) : V →ₗ[ℂ] V × V × V) u = (u, u, u) := rfl
      rw [hz, map_add, LinearMap.add_apply]
      have hy' : y = (y.1, y.2.1, y.2.2) := rfl
      rw [hy']
      rw [hfix, hdiag, hv'0]
      simp
    exact this

/-- **Right radical.**  A triple lies in the right radical of the form on the constrained triples
iff it is trivial. -/
theorem rightRadical_iff [FiniteDimensional ℂ V] [FiniteDimensional ℂ W]
    (hL : ∀ v, (∀ w, B v w = 0) → v = 0) (hR : ∀ w, (∀ v, B v w = 0) → w = 0)
    (hinv : ∀ g v w, B (ρ g v) (ρ' g w) = B v w) (a g₂ : G) (v' : W × W × W) :
    (∀ v ∈ tripleCycles ρ a g₂, tripleForm B ρ' a g₂ v v' = 0) ↔ v' ∈ tripleTrivial ρ' a g₂ := by
  constructor
  · intro hrad
    obtain ⟨g, hg⟩ := exists_factor (constraint ρ a g₂) ((tripleForm B ρ' a g₂).flip v') hrad
    obtain ⟨ν, hν⟩ := exists_pairing_right hL hR g
    have hfun : ∀ v, tripleForm B ρ' a g₂ v v' = B (constraint ρ a g₂ v) ν :=
      fun v => by
        have := hg v
        rw [LinearMap.flip_apply] at this
        rw [this, hν]
    have E1 : (ρ' g₂ - 1 - ρ' (a * g₂) + ρ' a) v'.2.1 - (ρ' a - 1) v'.1 = ρ' a⁻¹ ν - ν := by
      apply eq_of_pair_eq hR
      intro x
      have h := hfun (x, 0, 0)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
        map_zero, sub_zero, add_zero, LinearMap.zero_apply,
        pair_rep_left hinv a] at h
      simp only [map_sub, map_add, LinearMap.sub_apply, LinearMap.add_apply,
        Module.End.one_apply]
      linear_combination h
    have E2 : -((ρ' g₂ - 1) v'.2.1) = ρ' (a * g₂)⁻¹ ν - ρ' a⁻¹ ν := by
      apply eq_of_pair_eq hR
      intro x
      have h := hfun (0, x, 0)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
        map_zero, sub_zero, zero_sub, add_zero, LinearMap.zero_apply,
        pair_rep_left hinv a, pair_rep_left hinv (a * g₂)] at h
      simp only [map_sub, map_neg, LinearMap.sub_apply,
        Module.End.one_apply]
      linear_combination h
    have E3 : (ρ' (a * g₂) - 1) v'.2.2 = ν - ρ' (a * g₂)⁻¹ ν := by
      apply eq_of_pair_eq hR
      intro x
      have h := hfun (0, 0, x)
      rw [tripleForm_apply, constraint_apply] at h
      dsimp only at h
      simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, map_sub, map_add,
        map_zero, sub_zero, add_zero, LinearMap.zero_apply,
        pair_rep_left hinv (a * g₂)] at h
      simp only [map_sub, LinearMap.sub_apply,
        Module.End.one_apply]
      linear_combination h
    set ν' : W := ρ' (a * g₂)⁻¹ ν with hν'
    have i1 : ρ' (a * g₂) v'.2.1 = ρ' a (ρ' g₂ v'.2.1) := rep_mul_apply ρ' a g₂ _
    have i2 : ρ' a (ρ' a⁻¹ ν) = ν := rep_apply_inv ρ' a ν
    have i3 : ρ' (a * g₂) ν' = ν := rep_apply_inv ρ' (a * g₂) ν
    have i4 : ρ' g₂ ν' = ρ' a⁻¹ ν := by
      have h : g₂ * (a * g₂)⁻¹ = a⁻¹ := by group
      rw [hν', ← rep_mul_apply, h]
    have E2a := congrArg (fun w => ρ' a w) E2
    simp only [map_neg, map_sub, LinearMap.sub_apply, Module.End.one_apply, i2] at E2a
    simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.one_apply, i1] at E1 E2 E3
    have c3 : ρ' (a * g₂) (v'.2.2 - ν') = v'.2.2 - ν' := by
      rw [map_sub, i3]
      linear_combination (norm := module) E3
    have c2 : ρ' g₂ (v'.2.1 - ν') = v'.2.1 - ν' := by
      rw [map_sub, i4]
      linear_combination (norm := module) (-1 : ℂ) • E2
    have c1 : ρ' a (v'.1 - ν') = v'.1 - ν' := by
      rw [map_sub]
      linear_combination (norm := module) (-1 : ℂ) • E1 + (-1 : ℂ) • E2 + (1 : ℂ) • E2a
    refine Submodule.mem_sup.2 ⟨(v'.1 - ν', v'.2.1 - ν', v'.2.2 - ν'), ?_, (ν', ν', ν'),
      ⟨ν', rfl⟩, ?_⟩
    · rw [Submodule.mem_prod, Submodule.mem_prod]
      exact ⟨mem_fixedBy.2 c1, mem_fixedBy.2 c2, (mem_fixedBy_inv ρ').2 (mem_fixedBy.2 c3)⟩
    · exact Prod.ext (by simp) (Prod.ext (by simp) (by simp))
  · intro htriv v hv
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 htriv
    obtain ⟨w, rfl⟩ := hz
    rw [Submodule.mem_prod] at hy
    obtain ⟨hy1, hy23⟩ := hy
    rw [Submodule.mem_prod] at hy23
    obtain ⟨hy2, hy3⟩ := hy23
    have hfix := tripleForm_fixed' (ρ' := ρ') (B := B) a g₂ v hy1 hy2 hy3
    have hdiag := tripleForm_diag' (B := B) hinv a g₂ v w
    have hv0 : constraint ρ a g₂ v = 0 := LinearMap.mem_ker.1 hv
    have hz : (LinearMap.prod LinearMap.id
        (LinearMap.prod LinearMap.id LinearMap.id) : W →ₗ[ℂ] W × W × W) w = (w, w, w) := rfl
    rw [hz, map_add]
    have hy' : y = (y.1, y.2.1, y.2.2) := rfl
    rw [hy', hfix, hdiag, hv0]
    simp

end Radicals

