/-!
# The triple model of parabolic first cohomology on a three-point sphere

Let `G` be generated by `a` and `g₂`, put `b = a g₂` and `g₃ = b⁻¹`, so that `a g₂ g₃ = 1`.
For a representation `ρ` of `G` on `V`, a crossed homomorphism `z` (`z (g h) = z g + g • z h`) with
`z gᵢ = (gᵢ - 1) vᵢ` for the three special elements determines a triple `(v₁, v₂, v₃)` which
satisfies the single linear constraint `Ψ v = 0` coming from `z (a g₂ g₃) = 0`; the triple is
determined by `z` up to `R` = (fixed vectors of each `gᵢ`) + (diagonal).

For an invariant pairing `B : V × W → ℂ` the cup product of two such cocycles on the fundamental
two-chain `[a | g₂] + [a g₂ | g₃]` of the three-punctured sphere, corrected by the primitives at the
three special points, is the form `tripleForm` below
(`⟨z, z'⟩ = (z ∪ z')(σ) - ∑ᵢ B (vᵢ, z' gᵢ)`).

This file only fixes the definitions; `LinearDuality` proves that the induced pairing on
`ker Ψ / R` is perfect.
-/

noncomputable section

namespace TernaryPeriodPolynomials.BoundaryDuality.TripleModel

variable {G V W : Type} [Group G] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]

/-- The vectors fixed by `g`. -/
def fixedBy (ρ : Representation ℂ G V) (g : G) : Submodule ℂ V := LinearMap.ker (ρ g - 1)

theorem mem_fixedBy {ρ : Representation ℂ G V} {g : G} {v : V} :
    v ∈ fixedBy ρ g ↔ ρ g v = v := by
  simp [fixedBy, sub_eq_zero]

/-- The constraint `(a - 1) v₁ + (a g₂ - a) v₂ + (1 - a g₂) v₃ = 0` expressing
`z (a) + a z (g₂) + a g₂ z ((a g₂)⁻¹) = 0`. -/
def constraint (ρ : Representation ℂ G V) (a g₂ : G) : (V × V × V) →ₗ[ℂ] V :=
  (ρ a - 1).comp (LinearMap.fst ℂ V (V × V)) +
    (ρ (a * g₂) - ρ a).comp ((LinearMap.fst ℂ V V).comp (LinearMap.snd ℂ V (V × V))) +
    (1 - ρ (a * g₂)).comp ((LinearMap.snd ℂ V V).comp (LinearMap.snd ℂ V (V × V)))

theorem constraint_apply (ρ : Representation ℂ G V) (a g₂ : G) (v : V × V × V) :
    constraint ρ a g₂ v =
      (ρ a - 1) v.1 + (ρ (a * g₂) - ρ a) v.2.1 + (1 - ρ (a * g₂)) v.2.2 := rfl

/-- Triples satisfying the cocycle constraint. -/
def tripleCycles (ρ : Representation ℂ G V) (a g₂ : G) : Submodule ℂ (V × V × V) :=
  LinearMap.ker (constraint ρ a g₂)

/-- The triples attached to the zero class: `vᵢ - u` fixed by `gᵢ` for a common `u`. -/
def tripleTrivial (ρ : Representation ℂ G V) (a g₂ : G) : Submodule ℂ (V × V × V) :=
  (fixedBy ρ a).prod ((fixedBy ρ g₂).prod (fixedBy ρ (a * g₂)⁻¹)) ⊔
    LinearMap.range (LinearMap.prod LinearMap.id (LinearMap.prod LinearMap.id LinearMap.id) :
      V →ₗ[ℂ] V × V × V)

/-- The cup-product form on triples, for a pairing `B` invariant under `ρ`, `ρ'`:
`B v₃ ((b - 1) v₃') + B v₁ ((g₂ - 1 - b + a) v₂' - (a - 1) v₁') - B v₂ ((g₂ - 1) v₂')`
with `b = a g₂`. -/
def tripleForm (B : V →ₗ[ℂ] W →ₗ[ℂ] ℂ) (ρ' : Representation ℂ G W) (a g₂ : G) :
    (V × V × V) →ₗ[ℂ] (W × W × W) →ₗ[ℂ] ℂ :=
  LinearMap.mk₂ ℂ
    (fun v v' =>
      B v.2.2 ((ρ' (a * g₂) - 1) v'.2.2) +
        B v.1 ((ρ' g₂ - 1 - ρ' (a * g₂) + ρ' a) v'.2.1 - (ρ' a - 1) v'.1) -
        B v.2.1 ((ρ' g₂ - 1) v'.2.1))
    (by
      intro v₁ v₂ v'
      simp only [Prod.fst_add, Prod.snd_add, map_add, LinearMap.add_apply]
      ring)
    (by
      intro c v v'
      simp only [Prod.smul_fst, Prod.smul_snd, map_smul, LinearMap.smul_apply, smul_eq_mul]
      ring)
    (by
      intro v v₁ v₂
      simp only [Prod.fst_add, Prod.snd_add, map_add, map_sub, LinearMap.add_apply,
        LinearMap.sub_apply, Module.End.one_apply]
      ring)
    (by
      intro c v v'
      simp only [Prod.smul_fst, Prod.smul_snd, map_smul, map_sub, map_add,
        LinearMap.add_apply, LinearMap.sub_apply, Module.End.one_apply, smul_eq_mul]
      ring)

end TernaryPeriodPolynomials.BoundaryDuality.TripleModel
