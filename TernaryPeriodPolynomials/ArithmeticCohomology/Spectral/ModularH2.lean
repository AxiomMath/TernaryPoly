module

public import TernaryPeriodPolynomials.ArithmeticCohomology.SphericalDetection.Modular.TrivialH2
public import Mathlib.RepresentationTheory.Homological.GroupCohomology.Shapiro
public import Mathlib.RepresentationTheory.Coinduced
public import TernaryPeriodPolynomials.ArithmeticCohomology.SphericalDetection.Arithmetic.EdgeExactness

@[expose] public section


/-!
# Degree-two cohomology of `SL₂(ℤ)` vanishes for every complex representation

`SL₂(ℤ)` is the amalgam `ℤ/4 *_{ℤ/2} ℤ/6` generated by `S` and `U = ST` with
`S⁴ = 1`, `U³ = S²`.  For a two-cocycle `c` with values in an arbitrary complex
representation `W`, the extension group `W ⋊_c SL₂(ℤ)` splits over each finite cyclic
subgroup (complex coefficients), and the two lifts of the central element `S² = U³` can be
matched by conjugating with an element of `W`, because they differ by a vector on which
`S²` acts by `-1`.  The resulting lifts satisfy the defining relations, hence give a
splitting, so `c` is a coboundary.

This generalizes `SphericalDetection.Helpers.modularTrivialH2_zero` (trivial action, Sol) to arbitrary coefficients, reusing its extension group and the presentation
`modularLiftSection`.

Original work by Claude Opus 5.5 (AxiomCode).
-/

noncomputable section

namespace TernaryPeriodPolynomials.Spectral.ModularH2

open TernaryPeriodPolynomials.SphericalDetection.Helpers Matrix CategoryTheory

variable {G : Type} [Group G]

section Extension

variable (W : Rep ℂ G) (cycle : groupCohomology.cocycles₂ W) (unit_zero : cycle (1, 1) = 0)

/-- The vector `w`, as an element of the extension group. -/
abbrev incl (w : W) : TwoCocycleExtension W cycle unit_zero :=
  twoCocycleExtensionInclusion W cycle unit_zero (Multiplicative.ofAdd w)

theorem incl_mul (w : W) (x : TwoCocycleExtension W cycle unit_zero) :
    incl W cycle unit_zero w * x = ⟨w + x.coefficient, x.element⟩ := by
  apply TwoCocycleExtension.ext
  · change w + W.ρ 1 x.coefficient + cycle (1, x.element) = w + x.coefficient
    rw [map_one, Module.End.one_apply, twoCocycle_one_left, unit_zero, add_zero]
  · exact one_mul _

theorem mul_incl (x : TwoCocycleExtension W cycle unit_zero) (w : W) :
    x * incl W cycle unit_zero w = incl W cycle unit_zero (W.ρ x.element w) * x := by
  rw [incl_mul]
  apply TwoCocycleExtension.ext
  · change x.coefficient + W.ρ x.element w + cycle (x.element, 1) = W.ρ x.element w + x.coefficient
    rw [twoCocycle_one_right, unit_zero, map_zero, add_zero, add_comm]
  · exact mul_one _

theorem incl_add (v w : W) :
    incl W cycle unit_zero (v + w) = incl W cycle unit_zero v * incl W cycle unit_zero w := by
  rw [incl, ofAdd_add, map_mul]

theorem incl_zero : incl W cycle unit_zero 0 = 1 := by
  rw [incl, ofAdd_zero, map_one]

theorem incl_neg (w : W) : incl W cycle unit_zero (-w) = (incl W cycle unit_zero w)⁻¹ := by
  rw [incl, ofAdd_neg, map_inv]

theorem incl_injective {v w : W} (h : incl W cycle unit_zero v = incl W cycle unit_zero w) :
    v = w :=
  congrArg TwoCocycleExtension.coefficient h

theorem element_pow (x : TwoCocycleExtension W cycle unit_zero) (k : ℕ) :
    (x ^ k).element = x.element ^ k :=
  (twoCocycleExtensionProjection W cycle unit_zero).map_pow x k

theorem incl_mul_pow (w : W) (x : TwoCocycleExtension W cycle unit_zero) (k : ℕ) :
    (incl W cycle unit_zero w * x) ^ k =
      incl W cycle unit_zero (∑ i ∈ Finset.range k, W.ρ (x.element ^ i) w) * x ^ k := by
  induction k with
  | zero => simp [incl_zero]
  | succ k ih =>
    rw [pow_succ, ih, Finset.sum_range_succ, incl_add, pow_succ]
    have hx : x ^ k * incl W cycle unit_zero w =
        incl W cycle unit_zero (W.ρ (x.element ^ k) w) * x ^ k := by
      rw [mul_incl, element_pow]
    calc incl W cycle unit_zero (∑ i ∈ Finset.range k, W.ρ (x.element ^ i) w) * x ^ k *
          (incl W cycle unit_zero w * x)
        = incl W cycle unit_zero (∑ i ∈ Finset.range k, W.ρ (x.element ^ i) w) *
          (x ^ k * incl W cycle unit_zero w) * x := by group
      _ = _ := by rw [hx]; group

/-- Every torsion element lifts to a torsion element of the same order, for arbitrary
complex coefficients. -/
theorem torsion_lift (g : G) (m : ℕ) (positive : 0 < m) (torsion : g ^ m = 1) :
    ∃ lifted : TwoCocycleExtension W cycle unit_zero,
      twoCocycleExtensionProjection W cycle unit_zero lifted = g ∧ lifted ^ m = 1 := by
  let x : TwoCocycleExtension W cycle unit_zero := ⟨0, g⟩
  have kernel : twoCocycleExtensionProjection W cycle unit_zero (x ^ m) = 1 := by
    rw [map_pow]
    exact torsion
  set v : W := (x ^ m).coefficient with hv
  have xm : x ^ m = incl W cycle unit_zero v :=
    twoCocycleExtension_kernel W cycle unit_zero (x ^ m) kernel
  have fixed : W.ρ g v = v := by
    have commute : x * x ^ m = x ^ m * x := (Commute.self_pow x m).eq
    rw [xm, mul_incl] at commute
    exact incl_injective W cycle unit_zero (mul_right_cancel commute)
  have fixed_pow : ∀ i : ℕ, W.ρ (g ^ i) v = v := by
    intro i
    induction i with
    | zero => simp
    | succ i ih => rw [pow_succ, map_mul, Module.End.mul_apply, fixed, ih]
  refine ⟨incl W cycle unit_zero (-((m : ℂ)⁻¹ • v)) * x, ?_, ?_⟩
  · rw [map_mul, twoCocycleExtensionInclusion_projection, one_mul]
    rfl
  · rw [incl_mul_pow, xm, ← incl_add]
    have hsum : ∑ i ∈ Finset.range m, W.ρ (x.element ^ i) (-((m : ℂ)⁻¹ • v)) = -v := by
      have hterm : ∀ i ∈ Finset.range m, W.ρ (x.element ^ i) (-((m : ℂ)⁻¹ • v)) =
          -((m : ℂ)⁻¹ • v) := by
        intro i _
        rw [map_neg, map_smul]
        change -((m : ℂ)⁻¹ • W.ρ (g ^ i) v) = _
        rw [fixed_pow]
      rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, ← Nat.cast_smul_eq_nsmul ℂ,
        smul_neg, smul_smul, mul_inv_cancel₀ (by exact_mod_cast positive.ne'), one_smul]
    rw [hsum, neg_add_cancel, incl_zero]

end Extension

section Modular

variable (W : Rep ℂ (SpecialLinearGroup (Fin 2) ℤ)) (cycle : groupCohomology.cocycles₂ W)

/-- Lifts of `S` (order four) and of `U = ST` (order six) can be chosen with `u³ = s²`. -/
theorem modular_compatible_lifts (unit_zero : cycle (1, 1) = 0) :
    ∃ s u : TwoCocycleExtension W cycle unit_zero,
      twoCocycleExtensionProjection W cycle unit_zero s = ModularGroup.S ∧
      twoCocycleExtensionProjection W cycle unit_zero u = modularOrderSix ∧
      s ^ 4 = 1 ∧ u ^ 3 = s ^ 2 := by
  have sixth : modularOrderSix ^ 6 = 1 := by
    calc
      modularOrderSix ^ 6 = (modularOrderSix ^ 3) ^ 2 := by rw [← pow_mul]
      _ = (ModularGroup.S ^ 2) ^ 2 := by rw [modularOrderSix_cube]
      _ = ModularGroup.S ^ 4 := by rw [← pow_mul]
      _ = 1 := modularOrderFour
  obtain ⟨s, s_image, s_fourth⟩ := torsion_lift W cycle unit_zero ModularGroup.S 4 (by decide)
    modularOrderFour
  obtain ⟨u, u_image, u_sixth⟩ := torsion_lift W cycle unit_zero modularOrderSix 6 (by decide) sixth
  let π := twoCocycleExtensionProjection W cycle unit_zero
  have kernel : π (u ^ 3 * (s ^ 2)⁻¹) = 1 := by
    rw [map_mul, map_inv, map_pow, map_pow, u_image, s_image, modularOrderSix_cube, mul_inv_cancel]
  set δ : W := (u ^ 3 * (s ^ 2)⁻¹).coefficient with hδ
  have hu3 : u ^ 3 = incl W cycle unit_zero δ * s ^ 2 := by
    have description := twoCocycleExtension_kernel W cycle unit_zero _ kernel
    calc u ^ 3 = (u ^ 3 * (s ^ 2)⁻¹) * s ^ 2 := by group
      _ = incl W cycle unit_zero δ * s ^ 2 := by rw [description]
  have hs2 : (s ^ 2).element = ModularGroup.S ^ 2 := by
    rw [element_pow]
    exact congrArg (· ^ 2) s_image
  have s4 : s ^ 2 * s ^ 2 = 1 := by rw [← pow_add]; exact s_fourth
  have anti : W.ρ (ModularGroup.S ^ 2) δ = -δ := by
    have square : (u ^ 3) * (u ^ 3) = 1 := by rw [← pow_add]; exact u_sixth
    rw [hu3] at square
    have expand : incl W cycle unit_zero δ * s ^ 2 * (incl W cycle unit_zero δ * s ^ 2) =
        incl W cycle unit_zero (δ + W.ρ (ModularGroup.S ^ 2) δ) := by
      calc incl W cycle unit_zero δ * s ^ 2 * (incl W cycle unit_zero δ * s ^ 2)
          = incl W cycle unit_zero δ * (s ^ 2 * incl W cycle unit_zero δ) * s ^ 2 := by group
        _ = incl W cycle unit_zero δ * incl W cycle unit_zero (W.ρ (ModularGroup.S ^ 2) δ) *
              (s ^ 2 * s ^ 2) := by rw [mul_incl, hs2]; group
        _ = _ := by rw [s4, mul_one, ← incl_add]
    rw [expand, ← incl_zero W cycle unit_zero] at square
    have := incl_injective W cycle unit_zero square
    exact eq_neg_of_add_eq_zero_right this
  let w : W := -((2 : ℂ)⁻¹ • δ)
  refine ⟨s, incl W cycle unit_zero w * u * (incl W cycle unit_zero w)⁻¹, s_image, ?_, s_fourth, ?_⟩
  · rw [map_mul, map_mul, map_inv, twoCocycleExtensionInclusion_projection, inv_one, one_mul,
      mul_one]
    exact u_image
  · rw [conj_pow, hu3, ← incl_neg]
    have hw : W.ρ (ModularGroup.S ^ 2) (-w) = -((2 : ℂ)⁻¹ • δ) := by
      change W.ρ (ModularGroup.S ^ 2) (-(-((2 : ℂ)⁻¹ • δ))) = _
      rw [neg_neg, map_smul, anti, smul_neg]
    calc incl W cycle unit_zero w * (incl W cycle unit_zero δ * s ^ 2) * incl W cycle unit_zero (-w)
        = incl W cycle unit_zero w * incl W cycle unit_zero δ *
            (s ^ 2 * incl W cycle unit_zero (-w)) := by group
      _ = incl W cycle unit_zero (w + δ + W.ρ (ModularGroup.S ^ 2) (-w)) * s ^ 2 := by
          rw [mul_incl W cycle unit_zero (s ^ 2) (-w), hs2, incl_add, incl_add]; group
      _ = s ^ 2 := by
          rw [hw]
          have zero : w + δ + -((2 : ℂ)⁻¹ • δ) = 0 := by
            change -((2 : ℂ)⁻¹ • δ) + δ + -((2 : ℂ)⁻¹ • δ) = 0
            have two : δ = (2 : ℂ)⁻¹ • δ + (2 : ℂ)⁻¹ • δ := by
              rw [← add_smul]; norm_num
            nth_rewrite 2 [two]
            abel
          rw [zero, incl_zero, one_mul]

/-- A two-cocycle of `SL₂(ℤ)` with values in any complex representation is a coboundary. -/
theorem modularCocycle_boundary (unit_zero : cycle (1, 1) = 0) :
    ∃ primitive : SpecialLinearGroup (Fin 2) ℤ → W,
      ∀ first second, W.ρ first (primitive second) - primitive (first * second) + primitive first =
        cycle (first, second) := by
  obtain ⟨s, u, s_image, u_image, fourth, relation⟩ := modular_compatible_lifts W cycle unit_zero
  let splitting := modularLiftSection (twoCocycleExtensionProjection W cycle unit_zero)
    s u s_image u_image fourth relation
  refine ⟨fun element => -(splitting element).coefficient, ?_⟩
  exact twoCocycleExtension_section_boundary W cycle unit_zero splitting
    (modularLiftSection_projection (twoCocycleExtensionProjection W cycle unit_zero)
      s u s_image u_image fourth relation)

end Modular

/-- Complex degree-two cohomology of `SL₂(ℤ)` vanishes for every representation. -/
theorem modularH2_zero (W : Rep ℂ (SpecialLinearGroup (Fin 2) ℤ))
    (cohomology : groupCohomology.H2 W) : cohomology = 0 := by
  obtain ⟨cycle, rfl⟩ := twoCocycle_H2_surjective W cohomology
  rw [← unitNormalizedTwoCocycle_H2]
  rw [groupCohomology.H2π_eq_zero_iff]
  obtain ⟨primitive, boundary⟩ := modularCocycle_boundary W
    (unitNormalizedTwoCocycle W cycle) (unitNormalizedTwoCocycle_unit W cycle)
  refine ⟨primitive, ?_⟩
  funext pair
  exact boundary pair.1 pair.2


section Transport

/-- Complex `H²`-vanishing for all representations transports along group isomorphisms. -/
theorem H2_zero_of_mulEquiv {K L : Type} [Group K] [Group L] (e : K ≃* L)
    (vanishing : ∀ (B : Rep ℂ L) (y : groupCohomology.H2 B), y = 0)
    (A : Rep ℂ K) (x : groupCohomology.H2 A) : x = 0 := by
  obtain ⟨cycle, rfl⟩ := twoCocycle_H2_surjective A x
  let B : Rep ℂ L := Rep.res e.symm.toMonoidHom A
  let transported : L × L → B := fun pair => cycle (e.symm pair.1, e.symm pair.2)
  have closed : transported ∈ groupCohomology.cocycles₂ B := by
    rw [groupCohomology.mem_cocycles₂_iff]
    intro g h j
    change cycle (e.symm (g * h), e.symm j) + cycle (e.symm g, e.symm h) =
      A.ρ (e.symm g) (cycle (e.symm h, e.symm j)) + cycle (e.symm g, e.symm (h * j))
    rw [map_mul, map_mul]
    exact twoCocycle_relation A cycle _ _ _
  have zero := vanishing B (groupCohomology.H2π B ⟨transported, closed⟩)
  rw [groupCohomology.H2π_eq_zero_iff] at zero
  obtain ⟨primitive, hprimitive⟩ := zero
  have hcycle : cycle = twoBoundaryCycle A (fun k => primitive (e k)) := by
    apply Subtype.ext
    funext pair
    have value := congrFun hprimitive (e pair.1, e pair.2)
    change B.ρ (e pair.1) (primitive (e pair.2)) - primitive (e pair.1 * e pair.2) +
      primitive (e pair.1) = cycle (e.symm (e pair.1), e.symm (e pair.2)) at value
    rw [e.symm_apply_apply, e.symm_apply_apply] at value
    change cycle (pair.1, pair.2) = A.ρ pair.1 (primitive (e pair.2)) -
      primitive (e (pair.1 * pair.2)) + primitive (e pair.1)
    rw [map_mul, ← value]
    change A.ρ (e.symm (e pair.1)) (primitive (e pair.2)) - _ + _ = _
    rw [e.symm_apply_apply]
  rw [hcycle, twoBoundaryCycle_H2_zero]

/-- Injective homomorphisms reflect complex `H²`-vanishing for all subgroups of the target. -/
theorem H2_zero_of_injective {K L : Type} [Group K] [Group L] (ψ : K →* L)
    (injective : Function.Injective ψ)
    (vanishing : ∀ (S : Subgroup L) (B : Rep ℂ S) (y : groupCohomology.H2 B), y = 0)
    (A : Rep ℂ K) (x : groupCohomology.H2 A) : x = 0 :=
  H2_zero_of_mulEquiv (MonoidHom.ofInjective injective) (vanishing ψ.range) A x

end Transport

section Shapiro

/-- Shapiro: complex `H²` of every subgroup of `SL₂(ℤ)` vanishes for every representation. -/
theorem modularSubgroupH2_zero (S : Subgroup (SpecialLinearGroup (Fin 2) ℤ)) (A : Rep ℂ S)
    (x : groupCohomology.H2 A) : x = 0 := by
  let e := groupCohomology.coindIso A 2
  have h := modularH2_zero (Rep.coind S.subtype A) (e.inv x)
  have back : e.hom (e.inv x) = x := by
    change (e.inv ≫ e.hom) x = x
    rw [e.inv_hom_id]
    rfl
  rw [← back, h, map_zero]

end Shapiro

section Transfer

variable {Γ : Type} [Group Γ] (H : Subgroup Γ) (A : Rep ℂ Γ)

/-- The unit `A → Coind_H^Γ Res A`, `w ↦ (g ↦ g w)`. -/
def coindUnit : A.ρ.IntertwiningMap (Rep.coind H.subtype (Rep.res H.subtype A)).ρ where
  toLinearMap :=
    { toFun := fun w => ⟨fun g => A.ρ g w, by
        rw [Representation.mem_coindV]
        intro h g
        change A.ρ (h.val * g) w = A.ρ h.val (A.ρ g w)
        rw [map_mul, Module.End.mul_apply]⟩
      map_add' := by
        intro v w
        apply Subtype.ext
        funext g
        exact map_add (A.ρ g) v w
      map_smul' := by
        intro a w
        apply Subtype.ext
        funext g
        exact map_smul (A.ρ g) a w }
  isIntertwining' := by
    intro x
    apply LinearMap.ext
    intro w
    apply Subtype.ext
    funext g
    change A.ρ g (A.ρ x w) = A.ρ (g * x) w
    rw [map_mul, Module.End.mul_apply]

/-- The value of a coinduced function on the left coset `gH`, namely `g f(g⁻¹)`. -/
def cosetValue (f : Representation.coindV H.subtype (Rep.res H.subtype A).ρ) : Γ ⧸ H → A :=
  Quotient.lift (fun g => A.ρ g (f.val g⁻¹)) (by
    intro a b related
    obtain ⟨h, rfl⟩ : ∃ h : H, b = a * h.val := by
      refine ⟨⟨a⁻¹ * b, QuotientGroup.leftRel_apply.mp related⟩, ?_⟩
      change b = a * (a⁻¹ * b)
      group
    have equivariant := (Representation.mem_coindV _ _ _).mp f.property h⁻¹ a⁻¹
    change f.val (h.val⁻¹ * a⁻¹) = A.ρ h.val⁻¹ (f.val a⁻¹) at equivariant
    change A.ρ a (f.val a⁻¹) = A.ρ (a * h.val) (f.val (a * h.val)⁻¹)
    rw [_root_.mul_inv_rev, equivariant, map_mul, Module.End.mul_apply,
      ← Module.End.mul_apply (A.ρ h.val), ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply])

theorem cosetValue_mk (f : Representation.coindV H.subtype (Rep.res H.subtype A).ρ) (g : Γ) :
    cosetValue H A f (QuotientGroup.mk g) = A.ρ g (f.val g⁻¹) := rfl

variable [H.FiniteIndex]

/-- Averaging over left cosets, normalized by the index: a retraction of `coindUnit`. -/
def coindAverage : (Rep.coind H.subtype (Rep.res H.subtype A)).ρ.IntertwiningMap A.ρ :=
  let := Subgroup.fintypeQuotientOfFiniteIndex (H := H)
  { toLinearMap :=
      { toFun := fun f => (H.index : ℂ)⁻¹ • ∑ q : Γ ⧸ H, cosetValue H A f q
        map_add' := by
          intro f f'
          rw [← smul_add, ← Finset.sum_add_distrib]
          congr 1
          apply Finset.sum_congr rfl
          intro q _
          refine QuotientGroup.induction_on q (fun g => ?_)
          exact map_add (A.ρ g) _ _
        map_smul' := by
          intro a f
          have linear : ∑ q : Γ ⧸ H, cosetValue H A (a • f) q = a • ∑ q : Γ ⧸ H, cosetValue H A f q := by
            rw [Finset.smul_sum]
            apply Finset.sum_congr rfl
            intro q _
            refine QuotientGroup.induction_on q (fun g => ?_)
            exact map_smul (A.ρ g) a _
          rw [RingHom.id_apply, linear, smul_comm] }
    isIntertwining' := by
      intro x
      apply LinearMap.ext
      intro f
      change (H.index : ℂ)⁻¹ • ∑ q : Γ ⧸ H, cosetValue H A
          ((Rep.coind H.subtype (Rep.res H.subtype A)).ρ x f) q =
        A.ρ x ((H.index : ℂ)⁻¹ • ∑ q : Γ ⧸ H, cosetValue H A f q)
      have shift : ∀ q : Γ ⧸ H, cosetValue H A ((Rep.coind H.subtype (Rep.res H.subtype A)).ρ x f) q =
          A.ρ x (cosetValue H A f (x⁻¹ • q)) := by
        intro q
        refine QuotientGroup.induction_on q (fun g => ?_)
        change A.ρ g (f.val (g⁻¹ * x)) = A.ρ x (A.ρ (x⁻¹ * g) (f.val (x⁻¹ * g)⁻¹))
        rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel_left, _root_.mul_inv_rev, inv_inv]
      rw [Finset.sum_congr rfl (fun q _ => shift q), ← map_sum, map_smul]
      congr 2
      exact Equiv.sum_comp (MulAction.toPerm x⁻¹) (cosetValue H A f) }

theorem coindAverage_coindUnit (w : A) : coindAverage H A (coindUnit H A w) = w := by
  let := Subgroup.fintypeQuotientOfFiniteIndex (H := H)
  change (H.index : ℂ)⁻¹ • ∑ q : Γ ⧸ H, cosetValue H A (coindUnit H A w) q = w
  have constant : ∀ q : Γ ⧸ H, cosetValue H A (coindUnit H A w) q = w := by
    intro q
    refine QuotientGroup.induction_on q (fun g => ?_)
    change A.ρ g (A.ρ g⁻¹ w) = w
    rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  rw [Finset.sum_congr rfl (fun q _ => constant q), Finset.sum_const, Finset.card_univ,
    ← Nat.card_eq_fintype_card, ← Subgroup.index, ← Nat.cast_smul_eq_nsmul ℂ, smul_smul,
    inv_mul_cancel₀ (by exact_mod_cast Subgroup.FiniteIndex.index_ne_zero), one_smul]

/-- Transfer: if a finite-index subgroup has vanishing complex `H²` for every representation,
so does the whole group. -/
theorem H2_zero_of_finiteIndex
    (vanishing : ∀ (B : Rep ℂ H) (y : groupCohomology.H2 B), y = 0)
    (x : groupCohomology.H2 A) : x = 0 := by
  let η : A ⟶ Rep.coind H.subtype (Rep.res H.subtype A) := Rep.ofHom (coindUnit H A)
  let α : Rep.coind H.subtype (Rep.res H.subtype A) ⟶ A := Rep.ofHom (coindAverage H A)
  have retraction : η ≫ α = 𝟙 A := by
    apply Rep.hom_ext
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro w
    exact coindAverage_coindUnit H A w
  let F := groupCohomology.functor ℂ Γ 2
  have middle : (F.map η) x = 0 := by
    let e := groupCohomology.coindIso (Rep.res H.subtype A) 2
    have zero : e.hom ((F.map η) x) = 0 := vanishing _ _
    have back : e.inv (e.hom ((F.map η) x)) = (F.map η) x := by
      change (e.hom ≫ e.inv) _ = _
      rw [e.hom_inv_id]
      rfl
    rw [← back, zero]
    exact map_zero _
  have identity : (F.map α) ((F.map η) x) = x := by
    change (F.map η ≫ F.map α) x = x
    rw [← F.map_comp, retraction, F.map_id]
    rfl
  rw [← identity, middle]
  exact map_zero _

end Transfer


section Binary

/-- Complex `H²` vanishes for every representation of every group embedding into
`GL₂(ℤ) × ℤˣ` (the Levi quotients of all arithmetic cusp stabilizers): the kernel of
`(det ∘ pr₁, pr₂)` has finite index and embeds into `SL₂(ℤ)`. -/
theorem H2_zero_of_injective_binary {Γ : Type} [Group Γ]
    (ψ : Γ →* GeneralLinearGroup (Fin 2) ℤ × ℤˣ) (injective : Function.Injective ψ)
    (A : Rep ℂ Γ) (x : groupCohomology.H2 A) : x = 0 := by
  let δ : Γ →* ℤˣ × ℤˣ :=
    (GeneralLinearGroup.det.comp ((MonoidHom.fst _ _).comp ψ)).prod ((MonoidHom.snd _ _).comp ψ)
  have : δ.ker.FiniteIndex := Subgroup.finiteIndex_ker δ
  have kernel : ∀ k : δ.ker, GeneralLinearGroup.det (ψ k.val).1 = 1 ∧ (ψ k.val).2 = 1 := by
    intro k
    have h := k.property
    rw [MonoidHom.mem_ker] at h
    exact Prod.ext_iff.mp h
  let φ : δ.ker →* SpecialLinearGroup (Fin 2) ℤ :=
    { toFun := fun k => ⟨(ψ k.val).1.val, by
        have h := congrArg Units.val (kernel k).1
        rwa [GeneralLinearGroup.val_det_apply] at h⟩
      map_one' := by
        apply Subtype.ext
        simp
      map_mul' := by
        intro k k'
        apply Subtype.ext
        simp only [Subgroup.coe_mul, map_mul, Prod.fst_mul, Units.val_mul]
        rfl }
  have φ_injective : Function.Injective φ := by
    intro k k' equality
    have first : (ψ k.val).1 = (ψ k'.val).1 := Units.ext (congrArg Subtype.val equality)
    have second : (ψ k.val).2 = (ψ k'.val).2 := by rw [(kernel k).2, (kernel k').2]
    exact Subtype.ext (injective (Prod.ext first second))
  exact H2_zero_of_finiteIndex δ.ker A
    (fun B y => H2_zero_of_injective φ φ_injective modularSubgroupH2_zero B y) x

/-- Complex `H²` of every subgroup of `GL₂(ℤ)` vanishes for every representation. -/
theorem binarySubgroupH2_zero (S : Subgroup (GeneralLinearGroup (Fin 2) ℤ)) (A : Rep ℂ S)
    (x : groupCohomology.H2 A) : x = 0 :=
  H2_zero_of_injective_binary (S.subtype.prod 1)
    (fun _ _ equality => S.subtype_injective (congrArg Prod.fst equality)) A x

/-- Complex `H²` of `GL₂(ℤ)` vanishes for every representation. -/
theorem binaryH2_zero (A : Rep ℂ (GeneralLinearGroup (Fin 2) ℤ)) (x : groupCohomology.H2 A) :
    x = 0 :=
  H2_zero_of_injective_binary ((MonoidHom.id _).prod 1)
    (fun _ _ equality => congrArg Prod.fst equality) A x

end Binary

section Edges

/-- Hochschild–Serre edge injectivity for every split extension whose Levi quotient embeds in
`GL₂(ℤ) × ℤˣ`: the inflation term `H²(L, V^N)` vanishes. -/
theorem splitCohomologyEdge_injective_of_binary {N E L : Type} [Group N] [Group E] [Group L]
    {extension : GroupExtension N E L} (splitting : extension.Splitting) (representation : Rep ℂ E)
    (ψ : L →* GeneralLinearGroup (Fin 2) ℤ × ℤˣ) (injective : Function.Injective ψ) :
    Function.Injective (splitCohomologyEdge splitting representation) :=
  splitCohomologyEdge_injective_of_invariant_H2_zero splitting representation
    (H2_zero_of_injective_binary ψ injective _)

/-- The Hochschild–Serre edge of the good line stabilizer is injective in every positive degree. -/
theorem goodLineBinaryEdge_injective (degree : ℕ) (positive : 0 < degree) :
    Function.Injective (goodLineBinaryEdge degree positive) :=
  goodLineBinaryEdge_injective_of_invariant_H2_zero degree positive (binaryH2_zero _)

/-- The Hochschild–Serre edge of the identity plane stabilizer is injective. -/
theorem identityPlaneBinaryEdge_injective (degree : ℕ) :
    Function.Injective (identityPlaneBinaryEdge degree) :=
  identityPlaneBinaryEdge_injective_of_invariant_H2_zero degree (binaryH2_zero _)

end Edges

end TernaryPeriodPolynomials.Spectral.ModularH2
