module

public import TernaryPeriodPolynomials.ArithmeticCohomology.Spectral.SideReduction
public import TernaryPeriodPolynomials.ArithmeticCohomology.Spectral.GeneratorTest

@[expose] public section


/-!
# Separation of the associate pair is equivalent to separation on both strata

Converse of `eigenSeparated_of_sideSeparated`: separation for the whole away-three algebra gives
separation on each maximal stratum, tested on generators. Hence the obligation
`EigenSeparated (awayThreeHeckeAlgebra D hecke) (associatePair D)` is *equivalent* to
`SideSeparated D hecke .plane ∧ SideSeparated D hecke .line`.

Original work by Claude Opus 5.5 (AxiomCode).
-/

noncomputable section

open GeneralEisenstein

namespace TernaryPeriodPolynomials.Spectral

open TernaryPeriodPolynomials.SpectralSeparation

variable {n : ℕ}

/-- A stratum class as a boundary coordinate. -/
def embedSide {χ : RankOneCharacter} : (side : Side) → StratumH2 n χ side → BoundaryCoordinates n χ
  | .plane, w => (w, 0)
  | .line, w => (0, w)

section Generic

variable {W X ι : Type*} [AddCommGroup W] [Module ℂ W] [AddCommGroup X] [Module ℂ X]

private theorem pow_apply_inl {P Q : Type*} [AddCommGroup P] [Module ℂ P] [AddCommGroup Q]
    [Module ℂ Q] (f : Module.End ℂ P) (g : Module.End ℂ Q) (c : ℂ) (k : ℕ) (w : P) :
    (((f.prodMap g) - c • 1) ^ k) (w, 0) = (((f - c • 1) ^ k) w, 0) := by
  rw [prodMap_sub_smul_pow_apply]
  exact Prod.ext rfl (map_zero _)

private theorem pow_apply_inr {P Q : Type*} [AddCommGroup P] [Module ℂ P] [AddCommGroup Q]
    [Module ℂ Q] (f : Module.End ℂ P) (g : Module.End ℂ Q) (c : ℂ) (k : ℕ) (w : Q) :
    (((f.prodMap g) - c • 1) ^ k) (0, w) = (0, ((g - c • 1) ^ k) w) := by
  rw [prodMap_sub_smul_pow_apply]
  exact Prod.ext (map_zero _) rfl

/-- Abstract converse reduction: separation of `A` for the algebra generated by the operators
`H t` (`t` good) gives separation tested on generators for any space `X` mapped to `W` compatibly
with the operators. -/
private theorem sideSeparated_generic [FiniteDimensional ℂ W] (good : ι → Prop)
    (H : ι → Module.End ℂ W) (A : Submodule ℂ W)
    (hcomm : ∀ f ∈ Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t},
      ∀ g ∈ Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t}, Commute f g)
    (hsep : EigenSeparated (Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t}) A)
    (e : X → W) (Hx : ι → Module.End ℂ X) (SX : Submodule ℂ X) (he0 : e 0 = 0)
    (hpow : ∀ t (c : ℂ) (k : ℕ) (w : X), ((H t - c • 1) ^ k) (e w) = e (((Hx t - c • 1) ^ k) w))
    (hmem : ∀ w, e w ∈ A → w ∈ SX) (c : ι → ℂ)
    (hex : ∃ a ∈ A, a ≠ 0 ∧ ∀ t, good t → H t a = c t • a) (w : X)
    (hw : ∀ t, good t → ∃ k : ℕ, ((Hx t - c t • 1) ^ k) w = 0) : w ∈ SX := by
  classical
  let a := hex.choose
  have ha : a ∈ A := hex.choose_spec.1
  have ha0 : a ≠ 0 := hex.choose_spec.2.1
  have hca : ∀ t, good t → H t a = c t • a := hex.choose_spec.2.2
  let S : Set (Module.End ℂ W) := {B | ∃ t, good t ∧ B = H t}
  let c' : Module.End ℂ W → ℂ := fun s => if h : ∃ μ : ℂ, s a = μ • a then h.choose else 0
  have hc' : ∀ t, good t → c' (H t) = c t := by
    intro t ht
    have h : ∃ μ : ℂ, H t a = μ • a := ⟨c t, hca t ht⟩
    simp only [c', dite_eq_left h]
    exact smul_cancel_of_ne_zero a ha0 _ _ (h.choose_spec.symm.trans (hca t ht))
  let V : Submodule ℂ W := ⨅ s ∈ S, s.maxGenEigenspace (c' s)
  have hmemV : ∀ v, v ∈ V ↔ ∀ s ∈ S, v ∈ s.maxGenEigenspace (c' s) := by
    intro v; simp only [V, Submodule.mem_iInf]
  have hV : ∀ f ∈ Algebra.adjoin ℂ S, ∀ v ∈ V, f v ∈ V := by
    intro f hf v hv
    rw [hmemV] at hv ⊢
    intro s hs
    exact Module.End.mapsTo_maxGenEigenspace_of_comm
      (hcomm s (Algebra.subset_adjoin hs) f hf) (c' s) (hv s hs)
  have haV : a ∈ V := by
    rw [hmemV]
    rintro s ⟨t, ht, rfl⟩
    rw [hc' t ht]
    exact Module.End.eigenspace_le_maxGenEigenspace (Module.End.mem_eigenspace_iff.mpr (hca t ht))
  have hwV : e w ∈ V := by
    rw [hmemV]
    rintro s ⟨t, ht, rfl⟩
    rw [hc' t ht, Module.End.mem_maxGenEigenspace]
    obtain ⟨k, hk⟩ := hw t ht
    refine ⟨k, ?_⟩
    rw [hpow, hk, he0]
  have key := adjoin_scalar_add_nilpotent S hcomm V hV c' (fun s hs v hv => (hmemV v).mp hv s hs)
  apply hmem w
  refine hsep a (e w) ha ha0 (fun f hf => ?_)
  have hk := key f hf
  exact ⟨hk.choose, ⟨hk.choose_spec.choose, hk.choose_spec.choose_spec a haV⟩,
    ⟨hk.choose_spec.choose, hk.choose_spec.choose_spec _ hwV⟩⟩

/-- Abstract form of the gap equality. -/
private theorem eigenSeparated_iff_eq_iInf [FiniteDimensional ℂ W] (good : ι → Prop)
    (H : ι → Module.End ℂ W) (A : Submodule ℂ W)
    (hcomm : ∀ f ∈ Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t},
      ∀ g ∈ Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t}, Commute f g)
    (hsc : ∀ t, good t → ∃ μ : ℂ, ∀ y ∈ A, H t y = μ • y)
    (c : ι → ℂ) (a : W) (ha : a ∈ A) (ha0 : a ≠ 0) (hca : ∀ t, good t → H t a = c t • a) :
    EigenSeparated (Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t}) A ↔
      A = ⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1) := by
  classical
  have hmemJ : ∀ v, v ∈ (⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1)) ↔
      ∀ t, good t → v ∈ (H t).maxGenEigenspace (c t) := by
    intro v
    simp only [Submodule.mem_iInf, Subtype.forall]
  have hle : A ≤ ⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1) := by
    intro y hy
    rw [hmemJ]
    intro t ht
    have hsc' := hsc t ht
    have hct : hsc'.choose = c t :=
      smul_cancel_of_ne_zero a ha0 _ _ ((hsc'.choose_spec a ha).symm.trans (hca t ht))
    apply Module.End.eigenspace_le_maxGenEigenspace
    rw [Module.End.mem_eigenspace_iff, ← hct]
    exact hsc'.choose_spec y hy
  constructor
  · intro hsep
    refine le_antisymm hle (fun w hw => ?_)
    let S : Set (Module.End ℂ W) := {B | ∃ t, good t ∧ B = H t}
    let c' : Module.End ℂ W → ℂ := fun s => if h : ∃ μ : ℂ, s a = μ • a then h.choose else 0
    have hc' : ∀ t, good t → c' (H t) = c t := by
      intro t ht
      have h : ∃ μ : ℂ, H t a = μ • a := ⟨c t, hca t ht⟩
      simp only [c', dite_eq_left h]
      exact smul_cancel_of_ne_zero a ha0 _ _ (h.choose_spec.symm.trans (hca t ht))
    have hV : ∀ f ∈ Algebra.adjoin ℂ S,
        ∀ v ∈ (⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1)),
        f v ∈ (⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1)) := by
      intro f hf v hv
      rw [hmemJ] at hv ⊢
      intro t ht
      exact Module.End.mapsTo_maxGenEigenspace_of_comm
        (hcomm _ (Algebra.subset_adjoin ⟨t, ht, rfl⟩) f hf) (c t) (hv t ht)
    have hS : ∀ s ∈ S, ∀ v ∈ (⨅ t : {t // good t}, (H t.1).maxGenEigenspace (c t.1)),
        v ∈ s.maxGenEigenspace (c' s) := by
      rintro s ⟨t, ht, rfl⟩ v hv
      rw [hc' t ht]
      exact (hmemJ v).mp hv t ht
    have key := adjoin_scalar_add_nilpotent S hcomm _ hV c' hS
    refine hsep a w ha ha0 (fun f hf => ?_)
    have hk := key f hf
    exact ⟨hk.choose, ⟨hk.choose_spec.choose, hk.choose_spec.choose_spec a (hle ha)⟩,
      ⟨hk.choose_spec.choose, hk.choose_spec.choose_spec w hw⟩⟩
  · intro heq a' w ha' ha'0 hshare
    rw [heq, hmemJ]
    intro t ht
    have hmem : H t ∈ Algebra.adjoin ℂ {B | ∃ t, good t ∧ B = H t} :=
      Algebra.subset_adjoin ⟨t, ht, rfl⟩
    have ha't : H t a' = c t • a' := by
      have hsc' := hsc t ht
      have hct : hsc'.choose = c t :=
        smul_cancel_of_ne_zero a ha0 _ _ ((hsc'.choose_spec a ha).symm.trans (hca t ht))
      rw [← hct]
      exact hsc'.choose_spec a' ha'
    exact mem_maxGenEigenspace_of_shared (H t) a' w (c t) ha't ha'0 (hshare (H t) hmem)

end Generic

theorem pairHecke_pow_embedSide (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (t : HeckeCorrespondence) (c : ℂ) (k : ℕ) (side : Side) (w : StratumH2 n D.chi side) :
    ((pairHecke D hecke t - c • 1) ^ k) (embedSide side w) =
      embedSide side (((hecke side t - c • 1) ^ k) w) := by
  cases side
  · exact pow_apply_inl (hecke .plane t) (hecke .line t) c k w
  · exact pow_apply_inr (hecke .plane t) (hecke .line t) c k w

theorem mem_of_embedSide_mem (D : InducingData n) (side : Side) (w : StratumH2 n D.chi side)
    (h : embedSide side w ∈ associatePair D) : w ∈ boundarySummand D side := by
  cases side
  · exact h.1
  · exact h.2

/-- **Converse reduction.** Separation of the associate pair gives separation on each stratum. -/
theorem sideSeparated_of_eigenSeparated (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (hhecke : ActualBoundaryHecke n D.chi hecke)
    (hsep : EigenSeparated (awayThreeHeckeAlgebra D hecke) (associatePair D)) (side : Side) :
    SideSeparated D hecke side := by
  have := BoundaryFiniteness.BoundaryDimension.boundary_finiteDimensional n D.chi
  intro c hex w hw
  exact sideSeparated_generic (fun t => AwayThree t) (pairHecke D hecke) (associatePair D)
    (fun f hf g hg =>
      TernaryPeriodPolynomials.HeckeCommutativity.awayThreeHeckeAlgebra_commute D hecke
        hhecke hf hg)
    hsep (embedSide side) (fun t => hecke side t) (boundarySummand D side)
    (by cases side <;> rfl)
    (fun t c k w => pairHecke_pow_embedSide D hecke t c k side w)
    (fun w hw => mem_of_embedSide_mem D side w hw) c hex w hw

/-- **Equivalence.** Separation of the associate pair for the away-three algebra is exactly
separation on both maximal strata, tested on generators. -/
theorem eigenSeparated_iff_sideSeparated (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (hhecke : ActualBoundaryHecke n D.chi hecke) :
    EigenSeparated (awayThreeHeckeAlgebra D hecke) (associatePair D) ↔
      SideSeparated D hecke .plane ∧ SideSeparated D hecke .line :=
  ⟨fun h => ⟨sideSeparated_of_eigenSeparated D hecke hhecke h .plane,
      sideSeparated_of_eigenSeparated D hecke hhecke h .line⟩,
    fun h => eigenSeparated_of_sideSeparated D hecke hhecke h.1 h.2⟩

/-- The joint generalized eigenspace of the away-three correspondences for a character `c`. -/
def jointGenEigenspace (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (c : HeckeCorrespondence → ℂ) : Submodule ℂ (BoundaryCoordinates n D.chi) :=
  ⨅ t : {t : HeckeCorrespondence // AwayThree t}, (pairHecke D hecke t.1).maxGenEigenspace (c t.1)

/-- **The gap as an equality of subspaces.** Let `a ≠ 0` be a vector of the associate pair with
away-three eigencharacter `c`. Separation holds exactly when the associate pair *is* the joint
generalized eigenspace of `c`. (The inclusion `associatePair D ≤ jointGenEigenspace` always holds,
by `pair_scalar`; the open content is the reverse inclusion.) -/
theorem eigenSeparated_iff_eq_jointGenEigenspace (D : InducingData n)
    (hecke : BoundaryHecke n D.chi) (hhecke : ActualBoundaryHecke n D.chi hecke)
    (c : HeckeCorrespondence → ℂ) (a : BoundaryCoordinates n D.chi) (ha : a ∈ associatePair D)
    (ha0 : a ≠ 0) (hca : ∀ t, AwayThree t → pairHecke D hecke t a = c t • a) :
    EigenSeparated (awayThreeHeckeAlgebra D hecke) (associatePair D) ↔
      associatePair D = jointGenEigenspace D hecke c := by
  have := BoundaryFiniteness.BoundaryDimension.boundary_finiteDimensional n D.chi
  exact eigenSeparated_iff_eq_iInf (fun t => AwayThree t) (pairHecke D hecke) (associatePair D)
    (fun f hf g hg =>
      TernaryPeriodPolynomials.HeckeCommutativity.awayThreeHeckeAlgebra_commute D hecke
        hhecke hf hg)
    (fun t ht => HeckeEigen.Satake.pair_scalar D hecke hhecke t ht) c a ha ha0 hca

end TernaryPeriodPolynomials.Spectral
