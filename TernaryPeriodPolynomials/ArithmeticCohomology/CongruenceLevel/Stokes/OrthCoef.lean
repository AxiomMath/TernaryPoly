section FamC

variable {V : Type} [AddCommGroup V] [Module ℂ V] [Module ℚ V] [IsScalarTower ℚ ℂ V]
  (σ : Representation ℂ Γ6 V) {Z : Type} [MulAction Γ6 Z] (z₀ : Z)
  (e : V →ₗ[ℂ] V) (he : ∀ (s : Γ6), s • z₀ = z₀ → ∀ v, e (σ s v) = σ s (e v))

/-- The equivariant family generated by a `ℂ`-linear map commuting with the stabilizer, on the module `E`. -/
def famC : Fam (qRep (MonoidHom.id Γ6) σ) Z :=
  famOfStab (W := qRep (MonoidHom.id Γ6) σ) z₀ (e.restrictScalars ℚ) (fun s hs v => he s hs v)

include he in
omit [Module ℚ V] [IsScalarTower ℚ ℂ V] in
theorem dual_equiv (s : Γ6) (hs : s • z₀ = z₀) (f : Module.Dual ℂ V) :
    e.dualMap (σ.dual s f) = σ.dual s (e.dualMap f) := by
  apply LinearMap.ext
  intro v
  change f (σ s⁻¹ (e v)) = f (e (σ s⁻¹ v))
  have hs' : s⁻¹ • z₀ = z₀ := by rw [inv_smul_eq_iff, hs]
  rw [he s⁻¹ hs' v]

/-- … on the complex dual `E^*`, generated by the transpose. -/
def famCD : Fam (qRep (MonoidHom.id Γ6) σ.dual) Z :=
  famOfStab (W := qRep (MonoidHom.id Γ6) σ.dual) z₀ (e.dualMap.restrictScalars ℚ) (fun s hs f => dual_equiv σ z₀ e he s hs f)

include he in
theorem famC_adj (z : Z) (a : qRep (MonoidHom.id Γ6) σ) (f : qRep (MonoidHom.id Γ6) σ.dual) :
    (evalC (MonoidHom.id Γ6) σ).hom ((famC σ z₀ e he).P z a ⊗ₜ[ℚ] f) =
      (evalC (MonoidHom.id Γ6) σ).hom (a ⊗ₜ[ℚ] (famCD σ z₀ e he).P z f) := by
  by_cases h : ∃ γ : Γ6, γ • z₀ = z
  · obtain ⟨γ, rfl⟩ := h
    have hs1 : (famC σ z₀ e he).P (γ • z₀) =
        (qRep (MonoidHom.id Γ6) σ).ρ γ ∘ₗ e.restrictScalars ℚ ∘ₗ (qRep (MonoidHom.id Γ6) σ).ρ γ⁻¹ :=
      famOfStab_apply (W := qRep (MonoidHom.id Γ6) σ) z₀ (e.restrictScalars ℚ) (fun s hs v => he s hs v) γ
    have hs2 : (famCD σ z₀ e he).P (γ • z₀) =
        (qRep (MonoidHom.id Γ6) σ.dual).ρ γ ∘ₗ e.dualMap.restrictScalars ℚ ∘ₗ (qRep (MonoidHom.id Γ6) σ.dual).ρ γ⁻¹ :=
      famOfStab_apply (W := qRep (MonoidHom.id Γ6) σ.dual) z₀ (e.dualMap.restrictScalars ℚ)
        (fun s hs f => dual_equiv σ z₀ e he s hs f) γ
    rw [hs1, hs2]
    change (show Module.Dual ℂ V from f) (σ γ (e (σ γ⁻¹ (show V from a)))) =
      (σ.dual γ (e.dualMap (σ.dual γ⁻¹ (show Module.Dual ℂ V from f)))) (show V from a)
    change _ = (show Module.Dual ℂ V from f) (σ γ⁻¹⁻¹ (e (σ γ⁻¹ (show V from a))))
    rw [inv_inv]
  · have h1 : (famC σ z₀ e he).P z = 0 :=
      famOfStab_not_mem (W := qRep (MonoidHom.id Γ6) σ) z₀ (e.restrictScalars ℚ) (fun s hs v => he s hs v) z h
    have h2 : (famCD σ z₀ e he).P z = 0 :=
      famOfStab_not_mem (W := qRep (MonoidHom.id Γ6) σ.dual) z₀ (e.dualMap.restrictScalars ℚ)
        (fun s hs f => dual_equiv σ z₀ e he s hs f) z h
    rw [h1, h2]
    simp

end FamC

section PairCAct

variable {W W' : Rep.{0} ℚ Γ6} (π : W ⊗ W' ⟶ Rep.trivial ℚ Γ6 ℂ) (v : coneR.X 4)

theorem conePairC_lineCone_act (P : Fam W Line) (P' : Fam W' Line)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P'.P z f))
    (d : LineDatum W) (e : LineDatum W') :
    conePairC π v (d.act P).cone e.cone = conePairC π v d.cone (e.act P').cone := by
  rw [← sub_eq_zero]
  apply eq_zero_of_forall_rat_functional
  intro r
  rw [map_sub, rHom_conePairC, rHom_conePairC,
    conePair_lineCone_act (π ≫ rHom r) v P P' (fun z a f => congrArg r (hadj z a f)) d e, sub_self]

theorem conePairC_planeCone_act (P : Fam W Plane) (P' : Fam W' Plane)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P'.P z f))
    (d : PlaneDatum W) (e : PlaneDatum W') :
    conePairC π v (d.act P).cone e.cone = conePairC π v d.cone (e.act P').cone := by
  rw [← sub_eq_zero]
  apply eq_zero_of_forall_rat_functional
  intro r
  rw [map_sub, rHom_conePairC, rHom_conePairC,
    conePair_planeCone_act (π ≫ rHom r) v P P' (fun z a f => congrArg r (hadj z a f)) d e, sub_self]

theorem conePairC_zero_right' (X : coneR.X 2 ⟶ W) : conePairC π v X 0 = 0 := by
  unfold conePairC
  rw [PushCone.tensorHom_zero', zero_comp, comp_zero]
  rfl

theorem Fam.act_act_zero {Z : Type} [MulAction Γ6 Z] {k : ℕ} (P Q : Fam W' Z)
    (hPQ : ∀ z (a : W'), P.P z (Q.P z a) = 0) (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W') :
    P.act (Q.act c) = 0 := by
  apply homFunA_injective
  funext y
  rw [Fam.homFunA_act, Fam.homFunA_act]
  exact (hPQ y.2 (homFunA c y)).trans rfl

/-- **Orthogonality of pointwise acted line data**: if `P₁` has the pointwise adjoint `P₁D` and `P₁D ∘ P₂D = 0` pointwise, the cone pairing of `P₁ d` and `P₂D e` vanishes. -/
theorem conePairC_lineCone_orth (P₁ : Fam W Line) (P₁D P₂D : Fam W' Line)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P₁.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P₁D.P z f))
    (hcomp : ∀ z (f : W'), P₁D.P z (P₂D.P z f) = 0) (d : LineDatum W) (e : LineDatum W') :
    conePairC π v (d.act P₁).cone (e.act P₂D).cone = 0 := by
  rw [conePairC_lineCone_act π v P₁ P₁D hadj d (e.act P₂D)]
  have : ((e.act P₂D).act P₁D).cone = 0 := by
    show lineCone _ (P₁D.act (P₂D.act e.z)) = 0
    have h1 : P₁D.act (P₂D.act e.z) = 0 := Fam.act_act_zero P₁D P₂D hcomp e.z
    have h2 : (P₁D.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act
        ((P₂D.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act e.w) = 0 :=
      Fam.act_act_zero (P₁D.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant)
        (P₂D.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant)
        (fun F a => hcomp _ a) e.w
    have h3 : ((e.act P₂D).act P₁D).w = 0 := h2
    rw [h1]
    rw [show ((e.act P₂D).act P₁D).w = 0 from h3]
    exact lineCone_zero
  rw [this]
  exact conePairC_zero_right' π v _

theorem conePairC_planeCone_orth (P₁ : Fam W Plane) (P₁D P₂D : Fam W' Plane)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P₁.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P₁D.P z f))
    (hcomp : ∀ z (f : W'), P₁D.P z (P₂D.P z f) = 0) (d : PlaneDatum W) (e : PlaneDatum W') :
    conePairC π v (d.act P₁).cone (e.act P₂D).cone = 0 := by
  rw [conePairC_planeCone_act π v P₁ P₁D hadj d (e.act P₂D)]
  have : ((e.act P₂D).act P₁D).cone = 0 := by
    show planeCone _ (P₁D.act (P₂D.act e.z)) = 0
    have h1 : P₁D.act (P₂D.act e.z) = 0 := Fam.act_act_zero P₁D P₂D hcomp e.z
    have h2 : (P₁D.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act
        ((P₂D.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act e.w) = 0 :=
      Fam.act_act_zero (P₁D.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant)
        (P₂D.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant)
        (fun F a => hcomp _ a) e.w
    have h3 : ((e.act P₂D).act P₁D).w = 0 := h2
    rw [h1]
    rw [show ((e.act P₂D).act P₁D).w = 0 from h3]
    exact planeCone_zero
  rw [this]
  exact conePairC_zero_right' π v _

end PairCAct

section TauE

variable {Z : Type} [MulAction Γ6 Z] {F : Type} (o : F → labelOrbits Γ6 Z) (b : F → Z)
  (hb : ∀ i, b i ∈ labelOrbit Γ6 Z (o i))
  (Grp : F → Type) [∀ i, Group (Grp i)] (emb : ∀ i, Grp i →* Γ6) (hinj : ∀ i, Function.Injective (emb i))
  (hrange : ∀ i, (emb i).range = MulAction.stabilizer Γ6 (b i))
  {V : Type} [AddCommGroup V] [Module ℂ V] (σ : Representation ℂ Γ6 V)

/-- A `ℂ`-linear endomorphism of the coefficients commuting with the group, acting on `H²`. -/
def h2E {K : Type} [Group K] (A : Rep ℂ K) (e : A →ₗ[ℂ] A) (he : ∀ k v, e (A.ρ k v) = A.ρ k (e v)) :
    groupCohomology.H2 A →ₗ[ℂ] groupCohomology.H2 A :=
  EdgeNat.h2Map (MonoidHom.id K) A A e (fun g v => he g v)

theorem h2E_π {K : Type} [Group K] (A : Rep ℂ K) (e : A →ₗ[ℂ] A) (he : ∀ k v, e (A.ρ k v) = A.ρ k (e v))
    (z : groupCohomology.cocycles₂ A) :
    h2E A e he (groupCohomology.H2π A z) =
      groupCohomology.H2π A (groupCohomology.mapCocycles₂ (MonoidHom.id K)
        (EdgeNat.comparison (MonoidHom.id K) A A e (fun g v => he g v)) z) :=
  EdgeNat.h2Map_π (MonoidHom.id K) A A e (fun g v => he g v) z

theorem h2Map_h2E {K₁ K₂ : Type} [Group K₁] [Group K₂] (α : K₂ →* K₁) (A₁ : Rep ℂ K₁) (A₂ : Rep ℂ K₂)
    (T : A₁ →ₗ[ℂ] A₂) (hT : ∀ (g : K₂) (v : A₁), T (A₁.ρ (α g) v) = A₂.ρ g (T v))
    (e₁ : A₁ →ₗ[ℂ] A₁) (he₁ : ∀ k v, e₁ (A₁.ρ k v) = A₁.ρ k (e₁ v))
    (e₂ : A₂ →ₗ[ℂ] A₂) (he₂ : ∀ k v, e₂ (A₂.ρ k v) = A₂.ρ k (e₂ v)) (hcomm : ∀ v, T (e₁ v) = e₂ (T v))
    (x : groupCohomology.H2 A₁) :
    EdgeNat.h2Map α A₁ A₂ T hT (h2E A₁ e₁ he₁ x) = h2E A₂ e₂ he₂ (EdgeNat.h2Map α A₁ A₂ T hT x) := by
  obtain ⟨z, rfl⟩ := twoCocycle_H2_surjective A₁ x
  unfold h2E
  rw [EdgeNat.h2Map_π, EdgeNat.h2Map_π, EdgeNat.h2Map_π, EdgeNat.h2Map_π]
  congr 1
  apply Subtype.ext
  funext ab
  exact hcomm _

/-- The conjugate by the group element carrying the representative of the orbit to the base point. -/
def eConj (i : F) (e : V →ₗ[ℂ] V) : V →ₗ[ℂ] V :=
  (σ (faceG o b hb i)⁻¹) ∘ₗ e ∘ₗ (σ (faceG o b hb i))

include hinj hrange in
theorem eConj_commute (i : F) (e : V →ₗ[ℂ] V)
    (he : ∀ (t : Grp i) (v : V), e (σ (emb i t) v) = σ (emb i t) (e v))
    (s : MulAction.stabilizer Γ6 (o i).out) (v : V) :
    eConj o b hb σ i e (σ s v) = σ s (eConj o b hb σ i e v) := by
  have h1 := emb_faceAlpha o b hb Grp emb hinj hrange i s
  have h2 := he (faceAlpha o b hb Grp emb hinj hrange i s) (σ (faceG o b hb i) v)
  rw [h1] at h2
  set G := faceG o b hb i with hG
  change σ G⁻¹ (e (σ G (σ s v))) = σ s (σ G⁻¹ (e (σ G v)))
  have e1 : σ G (σ s v) = σ (G * s * G⁻¹) (σ G v) := by
    rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
    congr 2
    group
  have e2 : ∀ w : V, σ G⁻¹ (σ (G * s * G⁻¹) w) = σ s (σ G⁻¹ w) := by
    intro w
    rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
    congr 2
    group
  rw [e1, h2, e2]

theorem eConj_comm (i : F) (e : V →ₗ[ℂ] V) (v : V) :
    σ (faceG o b hb i)⁻¹ (e v) = eConj o b hb σ i e (σ (faceG o b hb i)⁻¹ v) := by
  unfold eConj
  change σ (faceG o b hb i)⁻¹ (e v) = σ (faceG o b hb i)⁻¹ (e (σ (faceG o b hb i) (σ (faceG o b hb i)⁻¹ v)))
  rw [← Module.End.mul_apply (σ (faceG o b hb i)) (σ (faceG o b hb i)⁻¹), ← map_mul, mul_inv_cancel, map_one]
  rfl

theorem stabEnd_hom {W : Rep.{0} ℚ Γ6} (S : Subgroup Γ6) (e : W →ₗ[ℚ] W)
    (he : ∀ (g : S) (v : W), e (W.ρ g v) = W.ρ g (e v)) (v : W) : (stabEnd S e he).hom v = e v := rfl

include hinj hrange in
/-- **The transport `faceTau` of the image of a class under a coefficient endomorphism is the image of the transport under the conjugated endomorphism.** -/
theorem faceTau_h2E (i : F) (e : V →ₗ[ℂ] V)
    (he : ∀ (t : Grp i) (v : V), e (σ (emb i t) v) = σ (emb i t) (e v))
    (heB : ∀ (k : MulAction.stabilizer Γ6 (o i).out) (v : V), eConj o b hb σ i e (σ k v) = σ k (eConj o b hb σ i e v))
    (x : groupCohomology.H2 (Rep.res (emb i) (Rep.of σ))) :
    faceTau o b hb Grp emb hinj hrange σ i (h2E (Rep.res (emb i) (Rep.of σ)) e (fun k v => he k v) x) =
      h2E (Rep.res (MulAction.stabilizer Γ6 (o i).out).subtype (Rep.of σ)) (eConj o b hb σ i e)
        (fun k v => heB k v) (faceTau o b hb Grp emb hinj hrange σ i x) :=
  h2Map_h2E (faceAlpha o b hb Grp emb hinj hrange i) (Rep.res (emb i) (Rep.of σ))
      (Rep.res (MulAction.stabilizer Γ6 (o i).out).subtype (Rep.of σ)) (σ (faceG o b hb i)⁻¹)
      (faceTau_hT o b hb Grp emb hinj hrange σ i) e (fun k v => he k v) (eConj o b hb σ i e) (fun k v => heB k v)
      (fun v => eConj_comm o b hb σ i e v) x

end TauE

section TauQ

variable {Z : Type} [MulAction Γ6 Z] {F : Type} (o : F → labelOrbits Γ6 Z) (b : F → Z)
  (hb : ∀ i, b i ∈ labelOrbit Γ6 Z (o i))
  (Grp : F → Type) [∀ i, Group (Grp i)] (emb : ∀ i, Grp i →* Γ6) (hinj : ∀ i, Function.Injective (emb i))
  (hrange : ∀ i, (emb i).range = MulAction.stabilizer Γ6 (b i))
  {V : Type} [AddCommGroup V] [Module ℂ V] [Module ℚ V] [IsScalarTower ℚ ℂ V] (σ : Representation ℂ Γ6 V)

theorem qH2_h2E_S (S : Subgroup Γ6) (e : V →ₗ[ℂ] V) (he : ∀ (k : S) (v : V), e (σ k v) = σ k (e v))
    (φ : Rep.res (MonoidHom.id S) (qRepG (σ.comp S.subtype)) ⟶ qRepG (σ.comp S.subtype))
    (hφ : ∀ v : V, φ.hom v = e v)
    (y : groupCohomology.H2 (Rep.res S.subtype (Rep.of σ))) :
    qH2 (σ.comp S.subtype) (h2E (Rep.res S.subtype (Rep.of σ)) e (fun k v => he k v) y) =
      (groupCohomology.map (MonoidHom.id S) φ 2).hom (qH2 (σ.comp S.subtype) y) := by
  induction y using groupCohomology.H2_induction_on with
  | h z =>
    erw [h2E_π]
    erw [qH2_π, qH2_π, groupCohomology.H2π_comp_map_apply]
    congr 1
    apply Subtype.ext
    funext x
    exact (hφ _).symm

theorem faceTauQ_eq (i : F)
    (x : groupCohomology.H2 (Rep.res (emb i) (Rep.of σ))) :
    faceTauQ o b hb Grp emb hinj hrange σ i x =
      qH2 (σ.comp (MulAction.stabilizer Γ6 (o i).out).subtype) (faceTau o b hb Grp emb hinj hrange σ i x) := rfl

/-- **The rational transport of the image of a class under a coefficient endomorphism is the image of the transport under the conjugated endomorphism.** -/
theorem faceTauQ_h2E (i : F) (e : V →ₗ[ℂ] V)
    (he : ∀ (t : Grp i) (v : V), e (σ (emb i t) v) = σ (emb i t) (e v))
    (x : groupCohomology.H2 (Rep.res (emb i) (Rep.of σ))) :
    faceTauQ o b hb Grp emb hinj hrange σ i (h2E (Rep.res (emb i) (Rep.of σ)) e (fun k v => he k v) x) =
      (groupCohomology.map (MonoidHom.id (MulAction.stabilizer Γ6 (o i).out))
        (stabEnd (MulAction.stabilizer Γ6 (o i).out) ((eConj o b hb σ i e).restrictScalars ℚ)
          (fun g v => eConj_commute o b hb Grp emb hinj hrange σ i e he g v)) 2).hom
        (faceTauQ o b hb Grp emb hinj hrange σ i x) := by
  have heB : ∀ (k : MulAction.stabilizer Γ6 (o i).out) (v : V), eConj o b hb σ i e (σ k v) = σ k (eConj o b hb σ i e v) :=
    fun k v => eConj_commute o b hb Grp emb hinj hrange σ i e he k v
  rw [faceTauQ_eq o b hb Grp emb hinj hrange σ i, faceTauQ_eq o b hb Grp emb hinj hrange σ i,
    faceTau_h2E o b hb Grp emb hinj hrange σ i e he heB x]
  refine qH2_h2E_S σ (MulAction.stabilizer Γ6 (o i).out) (eConj o b hb σ i e) (fun k v => heB k v) _ ?_ _
  intro v
  rfl

end TauQ

section H2E

theorem h2E_congr {K : Type} [Group K] (A : Rep ℂ K) {e e' : A →ₗ[ℂ] A} (h : e = e')
    (he : ∀ k v, e (A.ρ k v) = A.ρ k (e v)) (he' : ∀ k v, e' (A.ρ k v) = A.ρ k (e' v)) :
    h2E A e he = h2E A e' he' := by
  subst h
  rfl

theorem h2E_add {K : Type} [Group K] (A : Rep ℂ K) (e₁ e₂ : A →ₗ[ℂ] A) (he₁ : ∀ k v, e₁ (A.ρ k v) = A.ρ k (e₁ v))
    (he₂ : ∀ k v, e₂ (A.ρ k v) = A.ρ k (e₂ v)) (he₁₂ : ∀ k v, (e₁ + e₂) (A.ρ k v) = A.ρ k ((e₁ + e₂) v))
    (x : groupCohomology.H2 A) :
    h2E A (e₁ + e₂) he₁₂ x = h2E A e₁ he₁ x + h2E A e₂ he₂ x := by
  obtain ⟨z, rfl⟩ := twoCocycle_H2_surjective A x
  unfold h2E
  rw [EdgeNat.h2Map_π, EdgeNat.h2Map_π, EdgeNat.h2Map_π, ← map_add]
  congr 1

theorem h2E_id {K : Type} [Group K] (A : Rep ℂ K) (he : ∀ k v, (LinearMap.id : A →ₗ[ℂ] A) (A.ρ k v) = A.ρ k (LinearMap.id v))
    (x : groupCohomology.H2 A) : h2E A LinearMap.id he x = x := by
  obtain ⟨z, rfl⟩ := twoCocycle_H2_surjective A x
  unfold h2E
  rw [EdgeNat.h2Map_π]
  congr 1

theorem restriction_h2E {K K' : Type} [Group K] [Group K'] (κ : K' →* K) (A : Rep ℂ K) (e : A →ₗ[ℂ] A)
    (he : ∀ k v, e (A.ρ k v) = A.ρ k (e v)) (he' : ∀ k v, e ((Rep.res κ A).ρ k v) = (Rep.res κ A).ρ k (e v))
    (x : groupCohomology.H2 A) :
    twoCohomologyRestriction κ A (h2E A e he x) = h2E (Rep.res κ A) e he' (twoCohomologyRestriction κ A x) := by
  obtain ⟨z, rfl⟩ := twoCocycle_H2_surjective A x
  rw [h2E_π, twoCohomologyRestriction_apply, twoCohomologyRestriction_apply, h2E_π]
  congr 1

end H2E

end TernaryPeriodPolynomials.Argument.GammaNStokes
