open TernaryPeriodPolynomials.Argument.FacePairingFull.Comparison

attribute [local instance] TernaryPeriodPolynomials.Argument.FacePairingFull.Comparison.vertexAction

/-- The generator `T⁶ = (1 6; 0 1)` of the cusp stabilizer of `Γ(6)` at `∞`. -/
def T6 : SL(2, ℤ) := ModularGroup.T ^ (6 : ℤ)

theorem T6_zpow_coe (k : ℤ) : ((T6 ^ k : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 6 * k; 0, 1] := by
  rw [T6, ← zpow_mul, ModularGroup.coe_T_zpow]

theorem T6_zpow_mem (k : ℤ) : T6 ^ k ∈ Gamma 6 := by
  rw [Gamma_mem, T6_zpow_coe]
  have h6 : (6 : ZMod 6) = 0 := by decide
  simp [h6]

/-- The homomorphism `ℤ → SL₂(ℤ)`, `k ↦ T⁶ᵏ`. -/
def cuspGen : Multiplicative ℤ →* SL(2, ℤ) := zpowersHom SL(2, ℤ) T6

theorem cuspGen_apply (k : Multiplicative ℤ) : cuspGen k = T6 ^ (Multiplicative.toAdd k) := rfl

theorem cuspGen_mem_cusp (k : Multiplicative ℤ) :
    (⟨cuspGen k, by rw [cuspGen_apply]; exact T6_zpow_mem _⟩ : ↥(Gamma 6)) ∈ leviCuspStab (Gamma 6) 1 := by
  rw [mem_leviCuspStab_iff]
  change (((1 : GL (Fin 2) ℚ)⁻¹ * Matrix.SpecialLinearGroup.mapGL ℚ (T6 ^ Multiplicative.toAdd k) * 1 : GL (Fin 2) ℚ) :
    Matrix (Fin 2) (Fin 2) ℚ) 1 0 = 0
  rw [inv_one, one_mul, mul_one, Matrix.SpecialLinearGroup.mapGL_coe_matrix,
    Matrix.SpecialLinearGroup.map_apply_coe, T6_zpow_coe]
  simp

/-- **The cusp stabilizer `{γ ∈ Γ(6) | γ₁₀ = 0}` at `∞` contains the infinite cyclic group generated by `T⁶`, as a homomorphism from `ℤ`.** -/
def cuspHom : Multiplicative ℤ →* ↥(leviCuspStab (Gamma 6) 1) where
  toFun k := ⟨⟨cuspGen k, by rw [cuspGen_apply]; exact T6_zpow_mem _⟩, cuspGen_mem_cusp k⟩
  map_one' := by apply Subtype.ext; apply Subtype.ext; simp
  map_mul' a b := by apply Subtype.ext; apply Subtype.ext; simp

theorem cuspHom_injective : Function.Injective cuspHom := by
  intro a b hab
  have h := congrArg (fun x : ↥(leviCuspStab (Gamma 6) 1) => ((x : ↥(Gamma 6)) : SL(2, ℤ))) hab
  simp only [cuspHom, MonoidHom.coe_mk, OneHom.coe_mk, cuspGen_apply] at h
  have h2 := congrArg (fun x : SL(2, ℤ) => (x : Matrix (Fin 2) (Fin 2) ℤ) 0 1) h
  simp only [T6_zpow_coe] at h2
  simp at h2
  exact h2

theorem cuspHom_surjective : Function.Surjective cuspHom := by
  rintro ⟨⟨γ, hγ⟩, hc⟩
  rw [mem_leviCuspStab_iff] at hc
  have h10 : (γ : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 := by
    simpa [Matrix.SpecialLinearGroup.mapGL_coe_matrix, Matrix.SpecialLinearGroup.map_apply_coe] using hc
  have hG := Gamma_mem.1 hγ
  rcases upper_unipotent_cases γ h10 with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · obtain ⟨hG00, hG01, hG10, hG11⟩ := hG
    rw [ModularGroup.coe_T_zpow] at hG01
    simp at hG01
    obtain ⟨j, rfl⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k 6).1 hG01
    refine ⟨Multiplicative.ofAdd j, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    simp only [cuspHom, MonoidHom.coe_mk, OneHom.coe_mk, cuspGen_apply, T6]
    rw [← zpow_mul]
    simp
  · exfalso
    obtain ⟨hG00, _, _, _⟩ := hG
    rw [Matrix.SpecialLinearGroup.coe_neg, ModularGroup.coe_T_zpow] at hG00
    simp at hG00
    revert hG00
    decide

/-- The cusp stabilizer of `Γ(6)` at `∞` is infinite cyclic. -/
def cuspEquiv : Multiplicative ℤ ≃* ↥(leviCuspStab (Gamma 6) 1) :=
  MulEquiv.ofBijective cuspHom ⟨cuspHom_injective, cuspHom_surjective⟩

section Transport

variable {N E G E' G' : Type*} [Group N] [Group E] [Group G] [Group E'] [Group G']

/-- Transport of a group extension along isomorphisms of the middle and the right group. -/
def mapEquivExt (X : GroupExtension N E G) (e : E ≃* E') (f : G ≃* G') : GroupExtension N E' G' where
  inl := e.toMonoidHom.comp X.inl
  rightHom := f.toMonoidHom.comp (X.rightHom.comp e.symm.toMonoidHom)
  inl_injective := e.injective.comp X.inl_injective
  range_inl_eq_ker_rightHom := by
    ext y
    constructor
    · rintro ⟨r, rfl⟩
      have : X.rightHom (X.inl r) = 1 := by
        have : X.inl r ∈ X.rightHom.ker := by rw [← X.range_inl_eq_ker_rightHom]; exact ⟨r, rfl⟩
        exact this
      simp [MonoidHom.mem_ker, this]
    · intro hy
      have h1 : X.rightHom (e.symm y) = 1 := by
        have : f (X.rightHom (e.symm y)) = 1 := hy
        simpa using this
      have h2 : e.symm y ∈ X.inl.range := by rw [X.range_inl_eq_ker_rightHom]; exact h1
      obtain ⟨r, hr⟩ := h2
      exact ⟨r, by simp [hr]⟩
  rightHom_surjective := by
    intro z
    obtain ⟨x, hx⟩ := X.rightHom_surjective (f.symm z)
    exact ⟨e x, by simp [hx]⟩

end Transport

section FlagExt

variable (g : SL(3, ℤ))

/-- The restriction of the projection to the stabilizer of the flag `∞` of the line group. -/
def flagRight : ↥(lineFlagStab 6 g 1) →* ↥(leviCuspStab (Gamma 6) 1) :=
  ((lineFaceExt 6 g).rightHom.comp (lineFlagStab 6 g 1).subtype).codRestrict _ (fun x => x.2)

/-- The line-group extension restricted to the standard flag stabilizer: `ℤ² → (flag stabilizer) → (cusp stabilizer of `Γ(6)`)`. -/
def flagExt0 : GroupExtension RadicalLattice ↥(lineFlagStab 6 g 1) ↥(leviCuspStab (Gamma 6) 1) where
  inl := lineInlFlag 6 g 1
  rightHom := flagRight g
  inl_injective := by
    intro a b hab
    apply (lineFaceExt 6 g).inl_injective
    have := congrArg Subtype.val hab
    exact this
  range_inl_eq_ker_rightHom := by
    ext x
    constructor
    · rintro ⟨r, rfl⟩
      rw [MonoidHom.mem_ker]
      apply Subtype.ext
      have : (lineFaceExt 6 g).rightHom ((lineFaceExt 6 g).inl r) = 1 := by
        have : (lineFaceExt 6 g).inl r ∈ (lineFaceExt 6 g).rightHom.ker := by
          rw [← (lineFaceExt 6 g).range_inl_eq_ker_rightHom]; exact ⟨r, rfl⟩
        exact this
      change (lineFaceExt 6 g).rightHom ((lineFaceExt 6 g).inl r) = 1
      exact this
    · intro hx
      have h1 : (lineFaceExt 6 g).rightHom x.1 = 1 := by
        have := congrArg (fun y : ↥(leviCuspStab (Gamma 6) 1) => ((y : ↥(Gamma 6))) ) (MonoidHom.mem_ker.mp hx)
        exact this
      have h2 : x.1 ∈ (lineFaceExt 6 g).inl.range := by
        rw [(lineFaceExt 6 g).range_inl_eq_ker_rightHom]; exact h1
      obtain ⟨r, hr⟩ := h2
      exact ⟨r, Subtype.ext hr⟩
  rightHom_surjective := by
    intro c
    obtain ⟨e, he⟩ := (lineFaceExt 6 g).rightHom_surjective (c : ↥(Gamma 6))
    have hmem : e ∈ lineFlagStab 6 g 1 := by
      show (lineFaceExt 6 g).rightHom e ∈ leviCuspStab (Gamma 6) 1
      rw [he]; exact c.2
    exact ⟨⟨e, hmem⟩, Subtype.ext he⟩

/-- The stabilizer of the standard flag in the line group of `g⁻¹Qg` is the flag group `Γ(6) ∩ g⁻¹Bg`. -/
def lineFlagStabEquiv : ↥(lineFlagStab 6 g 1) ≃* ↥(gammaNBAt 6 g) :=
  (Subgroup.equivMapOfInjective _ _ (gammaNQAt 6 g).subtype_injective).trans
    (MulEquiv.subgroupCongr (lineFlagStab_one_map 6 (by norm_num) g))

theorem lineFlagStabEquiv_coe (x : ↥(lineFlagStab 6 g 1)) :
    ((lineFlagStabEquiv g x : ↥(gammaNBAt 6 g)) : SL(3, ℤ)) = ((x : ↥(gammaNQAt 6 g)) : SL(3, ℤ)) := rfl

/-- **The flag group `Γ(6) ∩ g⁻¹Bg` is an extension of `ℤ` by `ℤ²`** (the radical `N_Q` of the line group, by the cusp stabilizer of `Γ(6)` at `∞`). -/
def flagExt : GroupExtension RadicalLattice ↥(gammaNBAt 6 g) (Multiplicative ℤ) :=
  mapEquivExt (flagExt0 g) (lineFlagStabEquiv g) cuspEquiv.symm

theorem flagExt_nonempty : Nonempty (GroupExtension RadicalLattice ↥(gammaNBAt 6 g) (Multiplicative ℤ)) :=
  ⟨flagExt g⟩

/-- The same for the stabilizer of the flag `flagOf g` in `Γ(6)`. -/
def flagStabExt : GroupExtension RadicalLattice ↥(MulAction.stabilizer Γ6 (flagOf g)) (Multiplicative ℤ) :=
  mapEquivExt (flagExt g) (flagStabEquiv g) (MulEquiv.refl _)

end FlagExt

end TernaryPeriodPolynomials.Argument.GammaNStokes
