/-- An equivariant family of `ℚ`-linear endomorphisms of the coefficient module `W`, indexed by the labels `Z`. -/
structure Fam (W : Rep.{0} ℚ Γ6) (Z : Type) [MulAction Γ6 Z] where
  P : Z → W →ₗ[ℚ] W
  equiv : ∀ (γ : Γ6) (z : Z) (v : W), P (γ • z) (W.ρ γ v) = W.ρ γ (P z v)

namespace Fam

section Act

variable {W : Rep.{0} ℚ Γ6} {Z : Type} [MulAction Γ6 Z] (P : Fam W Z) {k : ℕ}

/-- The family induced on the complete flags by a family on lines (or planes). -/
def comap {Z' : Type} [MulAction Γ6 Z'] (α : Z' → Z) (hα : ∀ (γ : Γ6) (z : Z'), α (γ • z) = γ • α z) : Fam W Z' where
  P z' := P.P (α z')
  equiv γ z' v := by rw [hα]; exact P.equiv γ (α z') v

/-- Pointwise application of the family to a cochain of the model resolution. -/
def act (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W :=
  homOfFunA (fun y => P.P y.2 (homFunA c y)) (fun γ y => by
    change P.P (γ • y.2) (homFunA c (γ • y)) = W.ρ γ (P.P y.2 (homFunA c y))
    rw [homFunA_equivariant]
    exact P.equiv γ y.2 _)

theorem homFunA_act (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) :
    homFunA (P.act c) = fun y => P.P y.2 (homFunA c y) :=
  homFunA_homOfFunA _ _

theorem act_hom_single (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) (y : (Fin (k + 1) → RationalGL3) × Z) :
    (P.act c).hom (MonoidAlgebra.single y 1) = P.P y.2 (c.hom (MonoidAlgebra.single y 1)) :=
  congrFun (homFunA_act P c) y

theorem act_zero : P.act (0 : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) = 0 := by
  apply homFunA_injective
  funext y
  rw [homFunA_act]
  change P.P y.2 ((0 : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W).hom (MonoidAlgebra.single y 1)) = _
  erw [map_zero]
  rfl

theorem act_d (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) :
    (prodComplex Γ6 RationalGL3 Z).d (k + 1) k ≫ P.act c = P.act ((prodComplex Γ6 RationalGL3 Z).d (k + 1) k ≫ c) := by
  apply homFunA_injective
  funext y
  rw [homFunA_comp_d, homFunA_act]
  simp only [homFunA_act]
  rw [homFunA_comp_d]
  simp only [map_sum, map_zsmul]
  rfl

theorem act_neg (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) : P.act (-c) = -P.act c := by
  apply homFunA_injective
  funext y
  rw [homFunA_act]
  change P.P y.2 ((-c).hom (MonoidAlgebra.single y 1)) = (-(P.act c)).hom (MonoidAlgebra.single y 1)
  have e1 : (-c).hom (MonoidAlgebra.single y 1) = -(c.hom (MonoidAlgebra.single y 1)) := rfl
  have e2 : (-(P.act c)).hom (MonoidAlgebra.single y 1) = -((P.act c).hom (MonoidAlgebra.single y 1)) := rfl
  rw [e1, e2, map_neg, act_hom_single]

end Act

end Fam

section DatumAct

variable {W : Rep.{0} ℚ Γ6}

theorem flagLine_act (P : Fam W Line) (z : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ W) :
    flagLineHom.hom.f 2 ≫ P.act z =
      (P.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act
        (flagLineHom.hom.f 2 ≫ z) := by
  apply homFunA_injective
  funext y
  obtain ⟨u, F⟩ := y
  change (flagLineHom.hom.f 2 ≫ P.act z).hom (MonoidAlgebra.single (u, F) 1) =
    ((P.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act
      (flagLineHom.hom.f 2 ≫ z)).hom (MonoidAlgebra.single (u, F) 1)
  rw [flagLineHom_cochain_single, Fam.act_hom_single, Fam.act_hom_single, flagLineHom_cochain_single]
  rfl

theorem flagPlane_act (P : Fam W Plane) (z : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ W) :
    flagPlaneHom.hom.f 2 ≫ P.act z =
      (P.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act
        (flagPlaneHom.hom.f 2 ≫ z) := by
  apply homFunA_injective
  funext y
  obtain ⟨u, F⟩ := y
  change (flagPlaneHom.hom.f 2 ≫ P.act z).hom (MonoidAlgebra.single (u, F) 1) =
    ((P.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act
      (flagPlaneHom.hom.f 2 ≫ z)).hom (MonoidAlgebra.single (u, F) 1)
  rw [flagPlaneHom_cochain_single, Fam.act_hom_single, Fam.act_hom_single, flagPlaneHom_cochain_single]
  rfl

/-- The line datum obtained by applying a family of endomorphisms pointwise to the cochain and to the flag primitive. -/
def LineDatum.act (P : Fam W Line) (d : LineDatum W) : LineDatum W where
  z := P.act d.z
  hz := by rw [Fam.act_d, d.hz, Fam.act_zero]
  w := (P.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act d.w
  hw := by rw [Fam.act_d, d.hw, flagLine_act]

/-- … for planes. -/
def PlaneDatum.act (P : Fam W Plane) (d : PlaneDatum W) : PlaneDatum W where
  z := P.act d.z
  hz := by rw [Fam.act_d, d.hz, Fam.act_zero]
  w := (P.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act d.w
  hw := by rw [Fam.act_d, d.hw, flagPlane_act]

end DatumAct

section Adjoint

variable {W W' : Rep.{0} ℚ Γ6} {T : Rep.{0} ℚ Γ6} (π : W ⊗ W' ⟶ T)

/-- **Pointwise adjointness of families passes to the diagonal cup of cochains.** -/
theorem nerveDelta_adj {Z : Type} [MulAction Γ6 Z] (P : Fam W Z) (P' : Fam W' Z)
    (hadj : ∀ z (v : W) (f : W'), π.hom (P.P z v ⊗ₜ[ℚ] f) = π.hom (v ⊗ₜ[ℚ] P'.P z f))
    (p q n : ℕ) (h : p + q = n) (X : (prodComplex Γ6 RationalGL3 Z).X p ⟶ W)
    (Y : (prodComplex Γ6 RationalGL3 Z).X q ⟶ W') :
    nerveDelta Γ6 RationalGL3 Z p q n h ≫ (P.act X ⊗ₘ Y) ≫ π =
      nerveDelta Γ6 RationalGL3 Z p q n h ≫ (X ⊗ₘ P'.act Y) ≫ π := by
  refine hom_ext_single ((Fin (n + 1) → RationalGL3) × Z) _ (fun s => ?_)
  change π.hom ((P.act X ⊗ₘ Y).hom ((nerveDelta Γ6 RationalGL3 Z p q n h).hom (MonoidAlgebra.single s 1))) =
    π.hom ((X ⊗ₘ P'.act Y).hom ((nerveDelta Γ6 RationalGL3 Z p q n h).hom (MonoidAlgebra.single s 1)))
  rw [nerveDelta_single]
  erw [tensorHom_hom_tmul, tensorHom_hom_tmul]
  rw [Fam.act_hom_single, Fam.act_hom_single]
  exact hadj s.2 _ _

end Adjoint

section PairAdj

variable {W W' : Rep.{0} ℚ Γ6} (π : W ⊗ W' ⟶ 𝟙_ (Rep.{0} ℚ Γ6)) (v : coneR.X 4)

theorem conePair_lineCone_eq (w : A.X 1 ⟶ W) (z : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ W)
    (w' : A.X 1 ⟶ W') (z' : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ W') :
    conePair π v (lineCone w z) (lineCone w' z') =
      ((nerveDiagSystem Γ6 RationalGL3 Flag).Δ 1 2 3 rfl ≫ (w ⊗ₘ (flagLineHom.hom.f 2 ≫ z')) ≫ π).hom
        ((modelPush.pA 3).hom v) +
      ((nerveDiagSystem Γ6 RationalGL3 Line).Δ 2 2 4 rfl ≫ (z ⊗ₘ z') ≫ π).hom ((modelPush.pL 3).hom v) := by
  rw [conePair_coords]
  simp only [lineCone_corner, lineCone_line, lineCone_plane, comp_zero, PushCone.zero_tensorHom',
    PushCone.tensorHom_zero', zero_comp]
  simp

theorem conePair_planeCone_eq (w : A.X 1 ⟶ W) (z : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ W)
    (w' : A.X 1 ⟶ W') (z' : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ W') :
    conePair π v (planeCone w z) (planeCone w' z') =
      ((nerveDiagSystem Γ6 RationalGL3 Flag).Δ 2 1 3 rfl ≫ ((flagPlaneHom.hom.f 2 ≫ z) ⊗ₘ (-w')) ≫ π).hom
        ((modelPush.pA 3).hom v) +
      ((nerveDiagSystem Γ6 RationalGL3 Plane).Δ 2 2 4 rfl ≫ (z ⊗ₘ z') ≫ π).hom ((modelPush.pP 3).hom v) := by
  rw [conePair_coords]
  simp only [planeCone_corner, planeCone_line, planeCone_plane, comp_zero, PushCone.tensorHom_zero', zero_comp]
  simp

end PairAdj

section PairAct

variable {W W' : Rep.{0} ℚ Γ6} (π : W ⊗ W' ⟶ 𝟙_ (Rep.{0} ℚ Γ6)) (v : coneR.X 4)

/-- **Adjointness of the cone pairing of line data with respect to pointwise adjoint families.** -/
theorem conePair_lineCone_act (P : Fam W Line) (P' : Fam W' Line)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P'.P z f))
    (d : LineDatum W) (e : LineDatum W') :
    conePair π v (d.act P).cone e.cone = conePair π v d.cone (e.act P').cone := by
  show conePair π v (lineCone _ (P.act d.z)) (lineCone e.w e.z) =
    conePair π v (lineCone d.w d.z) (lineCone _ (P'.act e.z))
  rw [conePair_lineCone_eq, conePair_lineCone_eq]
  have hA : (nerveDiagSystem Γ6 RationalGL3 Flag).Δ 1 2 3 rfl ≫
        ((d.act P).w ⊗ₘ (flagLineHom.hom.f 2 ≫ e.z)) ≫ π =
      (nerveDiagSystem Γ6 RationalGL3 Flag).Δ 1 2 3 rfl ≫
        (d.w ⊗ₘ (flagLineHom.hom.f 2 ≫ P'.act e.z)) ≫ π := by
    rw [flagLine_act]
    exact nerveDelta_adj π (P.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant)
      (P'.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant)
      (fun F a f => hadj _ a f) 1 2 3 rfl d.w _
  have hL : (nerveDiagSystem Γ6 RationalGL3 Line).Δ 2 2 4 rfl ≫ (P.act d.z ⊗ₘ e.z) ≫ π =
      (nerveDiagSystem Γ6 RationalGL3 Line).Δ 2 2 4 rfl ≫ (d.z ⊗ₘ P'.act e.z) ≫ π :=
    nerveDelta_adj π P P' hadj 2 2 4 rfl d.z e.z
  rw [hA, hL]

theorem conePair_planeCone_act (P : Fam W Plane) (P' : Fam W' Plane)
    (hadj : ∀ z (a : W) (f : W'), π.hom (P.P z a ⊗ₜ[ℚ] f) = π.hom (a ⊗ₜ[ℚ] P'.P z f))
    (d : PlaneDatum W) (e : PlaneDatum W') :
    conePair π v (d.act P).cone e.cone = conePair π v d.cone (e.act P').cone := by
  show conePair π v (planeCone _ (P.act d.z)) (planeCone e.w e.z) =
    conePair π v (planeCone d.w d.z) (planeCone _ (P'.act e.z))
  rw [conePair_planeCone_eq, conePair_planeCone_eq]
  have hA : (nerveDiagSystem Γ6 RationalGL3 Flag).Δ 2 1 3 rfl ≫
        ((flagPlaneHom.hom.f 2 ≫ P.act d.z) ⊗ₘ (-e.w)) ≫ π =
      (nerveDiagSystem Γ6 RationalGL3 Flag).Δ 2 1 3 rfl ≫
        ((flagPlaneHom.hom.f 2 ≫ d.z) ⊗ₘ (-(e.act P').w)) ≫ π := by
    have hw : (e.act P').w =
        (P'.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act e.w := rfl
    rw [hw, flagPlane_act, ← Fam.act_neg]
    exact nerveDelta_adj π (P.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant)
      (P'.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant)
      (fun F a f => hadj _ a f) 2 1 3 rfl (flagPlaneHom.hom.f 2 ≫ d.z) (-e.w)
  have hP : (nerveDiagSystem Γ6 RationalGL3 Plane).Δ 2 2 4 rfl ≫ (P.act d.z ⊗ₘ e.z) ≫ π =
      (nerveDiagSystem Γ6 RationalGL3 Plane).Δ 2 2 4 rfl ≫ (d.z ⊗ₘ P'.act e.z) ≫ π :=
    nerveDelta_adj π P P' hadj 2 2 4 rfl d.z e.z
  rw [hA, hP]

end PairAct

section ActChain

variable {W : Rep.{0} ℚ Γ6} {Z : Type} [MulAction Γ6 Z] (P : Fam W Z)

theorem Fam.act_add {k : ℕ} (c c' : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) : P.act (c + c') = P.act c + P.act c' := by
  apply homFunA_injective
  funext y
  rw [homFunA_act]
  change P.P y.2 ((c + c').hom (MonoidAlgebra.single y 1)) = (P.act c + P.act c').hom (MonoidAlgebra.single y 1)
  have e1 : (c + c').hom (MonoidAlgebra.single y 1) = c.hom (MonoidAlgebra.single y 1) + c'.hom (MonoidAlgebra.single y 1) := rfl
  have e2 : (P.act c + P.act c').hom (MonoidAlgebra.single y 1) =
      (P.act c).hom (MonoidAlgebra.single y 1) + (P.act c').hom (MonoidAlgebra.single y 1) := rfl
  rw [e1, e2, map_add, Fam.act_hom_single, Fam.act_hom_single]

theorem Fam.act_smul {k : ℕ} (r : ℚ) (c : (prodComplex Γ6 RationalGL3 Z).X k ⟶ W) : P.act (r • c) = r • P.act c := by
  apply homFunA_injective
  funext y
  rw [homFunA_act]
  change P.P y.2 ((r • c).hom (MonoidAlgebra.single y 1)) = (r • P.act c).hom (MonoidAlgebra.single y 1)
  have e1 : (r • c).hom (MonoidAlgebra.single y 1) = r • c.hom (MonoidAlgebra.single y 1) := rfl
  have e2 : (r • P.act c).hom (MonoidAlgebra.single y 1) = r • (P.act c).hom (MonoidAlgebra.single y 1) := rfl
  rw [e1, e2, map_smul, Fam.act_hom_single]

/-- The pointwise action of a family on the Hom cochains, as a cochain map. -/
def actChain : homCochains (prodComplex Γ6 RationalGL3 Z) W ⟶ homCochains (prodComplex Γ6 RationalGL3 Z) W where
  f n := ModuleCat.ofHom
    { toFun := fun c => P.act c
      map_add' := fun c c' => Fam.act_add P c c'
      map_smul' := fun r c => Fam.act_smul P r c }
  comm' i j hij := by
    obtain rfl : i + 1 = j := hij
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro c
    exact Fam.act_d P c

theorem actChain_apply (n : ℕ) (c : (prodComplex Γ6 RationalGL3 Z).X n ⟶ W) : (actChain P).f n c = P.act c := rfl

end ActChain

section ActCoord

variable {W : Rep.{0} ℚ Γ6} {Z : Type} [MulAction Γ6 Z] (P : Fam W Z)
  (S : Subgroup Γ6) (z₀ : Z) (hz : ∀ g : S, g • z₀ = z₀)

include hz in
/-- The value of the family at a label fixed by `S` commutes with the action of `S`. -/
theorem Fam.equiv_stab (g : S) (v : W) : P.P z₀ (W.ρ g v) = W.ρ g (P.P z₀ v) := by
  have := P.equiv (g : Γ6) z₀ v
  rwa [show (g : Γ6) • z₀ = z₀ from hz g] at this

/-- The `S`-endomorphism of `Res_S W` given by a `ℚ`-linear map commuting with `S`, as a coefficient comparison. -/
def stabEnd (e : W →ₗ[ℚ] W) (he : ∀ (g : S) (v : W), e (W.ρ g v) = W.ρ g (e v)) :
    Rep.res (MonoidHom.id S) (Rep.res S.subtype W) ⟶ Rep.res S.subtype W :=
  Rep.ofHom (LinearMap.intertwiningMap_of_isIntertwiningMap _ _ e (fun g v => he g v))

theorem stabCoord_act (v₀ : RationalGL3) :
    actChain P ≫ stabCoord S W v₀ z₀ hz =
      stabCoord S W v₀ z₀ hz ≫ barChainMap (MonoidHom.id S) (stabEnd S (P.P z₀) (Fam.equiv_stab P S z₀ hz)) := by
  apply HomologicalComplex.hom_ext
  intro k
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro c
  apply Rep.free_ext
  intro x
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp, LinearMap.comp_apply, LinearMap.comp_apply]
  have e1 := stabCoord_single S W v₀ z₀ hz k (P.act c) x
  have e2 := stabCoord_single S W v₀ z₀ hz k c (fun i => (MonoidHom.id S) (x i))
  have e3 := barChainMap_apply (MonoidHom.id S) (stabEnd S (P.P z₀) (Fam.equiv_stab P S z₀ hz)) k
    (((stabCoord S W v₀ z₀ hz).f k).hom c) x
  have e4 : homFunA (P.act c) (fun i => Fin.partialProd x i • v₀, z₀) =
      P.P z₀ (homFunA c (fun i => Fin.partialProd x i • v₀, z₀)) := congrFun (Fam.homFunA_act P c) _
  exact (e1.trans (e4.trans (congrArg (P.P z₀) e2.symm))).trans e3.symm

theorem faceCoord_act (v₀ : RationalGL3) (n : ℕ) :
    HomologicalComplex.homologyMap (actChain P) n ≫ faceCoord S W v₀ z₀ hz n =
      faceCoord S W v₀ z₀ hz n ≫
        groupCohomology.map (MonoidHom.id S) (stabEnd S (P.P z₀) (Fam.equiv_stab P S z₀ hz)) n := by
  rw [faceCoord_eq_homologyMap_stabCoord]
  rw [← Category.assoc, ← HomologicalComplex.homologyMap_comp, stabCoord_act, HomologicalComplex.homologyMap_comp,
    Category.assoc, Category.assoc]
  refine congrArg (fun t => HomologicalComplex.homologyMap (stabCoord S W v₀ z₀ hz) n ≫ t) ?_
  exact barChainMap_homology (A := Rep.res S.subtype W) (B := Rep.res S.subtype W) (MonoidHom.id S)
    (stabEnd S (P.P z₀) (Fam.equiv_stab P S z₀ hz)) n

end ActCoord

section DatumActCoord

variable {W : Rep.{0} ℚ Γ6}

theorem LineDatum.act_cls (P : Fam W Line) (d : LineDatum W) :
    (d.act P).cls = (HomologicalComplex.homologyMap (actChain P) 2).hom d.cls := by
  have hc : ((LineCochains W).d 2 3).hom d.z = 0 := d.hz
  exact (cls2_map (LineCochains W) (actChain P) d.z hc (d.act P).hz).symm

theorem PlaneDatum.act_cls (P : Fam W Plane) (d : PlaneDatum W) :
    (d.act P).cls = (HomologicalComplex.homologyMap (actChain P) 2).hom d.cls := by
  have hc : ((PlaneCochains W).d 2 3).hom d.z = 0 := d.hz
  exact (cls2_map (PlaneCochains W) (actChain P) d.z hc (d.act P).hz).symm

/-- **The Shapiro coordinate of the pointwise acted datum is the image of the coordinate under the value of the family at the representative.** -/
theorem LineDatum.act_coord (P : Fam W Line) (o : labelOrbits Γ6 Line) (d : LineDatum W) :
    (d.act P).coord o = (groupCohomology.map (MonoidHom.id (stabilizer Γ6 o.out))
      (stabEnd (stabilizer Γ6 o.out) (P.P o.out) (Fam.equiv_stab P _ o.out (fun g => g.2))) 2).hom (d.coord o) := by
  unfold LineDatum.coord
  rw [LineDatum.act_cls]
  exact congrArg (fun m => m.hom d.cls)
    (faceCoord_act P (stabilizer Γ6 o.out) o.out (fun g => g.2) (1 : RationalGL3) 2)

theorem PlaneDatum.act_coord (P : Fam W Plane) (o : labelOrbits Γ6 Plane) (d : PlaneDatum W) :
    (d.act P).coord o = (groupCohomology.map (MonoidHom.id (stabilizer Γ6 o.out))
      (stabEnd (stabilizer Γ6 o.out) (P.P o.out) (Fam.equiv_stab P _ o.out (fun g => g.2))) 2).hom (d.coord o) := by
  unfold PlaneDatum.coord
  rw [PlaneDatum.act_cls]
  exact congrArg (fun m => m.hom d.cls)
    (faceCoord_act P (stabilizer Γ6 o.out) o.out (fun g => g.2) (1 : RationalGL3) 2)

theorem LineDatum.act_isOn (P : Fam W Line) (S : Set Line) (d : LineDatum W) (h : d.IsOn S) : (d.act P).IsOn S :=
  ⟨fun u ℓ hℓ => by
    change (P.act d.z).hom (MonoidAlgebra.single (u, ℓ) 1) = 0
    rw [Fam.act_hom_single]
    change P.P ℓ (d.z.hom (MonoidAlgebra.single (u, ℓ) 1)) = 0
    rw [h.1 u ℓ hℓ, map_zero],
   fun u F hF => by
    change ((P.comap flagLineOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant).act d.w).hom
      (MonoidAlgebra.single (u, F) 1) = 0
    rw [Fam.act_hom_single]
    change P.P (flagLineOf F) (d.w.hom (MonoidAlgebra.single (u, F) 1)) = 0
    rw [h.2 u F hF, map_zero]⟩

theorem PlaneDatum.act_isOn (P : Fam W Plane) (S : Set Plane) (d : PlaneDatum W) (h : d.IsOn S) : (d.act P).IsOn S :=
  ⟨fun u ℓ hℓ => by
    change (P.act d.z).hom (MonoidAlgebra.single (u, ℓ) 1) = 0
    rw [Fam.act_hom_single]
    change P.P ℓ (d.z.hom (MonoidAlgebra.single (u, ℓ) 1)) = 0
    rw [h.1 u ℓ hℓ, map_zero],
   fun u F hF => by
    change ((P.comap flagPlaneOf TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant).act d.w).hom
      (MonoidAlgebra.single (u, F) 1) = 0
    rw [Fam.act_hom_single]
    change P.P (flagPlaneOf F) (d.w.hom (MonoidAlgebra.single (u, F) 1)) = 0
    rw [h.2 u F hF, map_zero]⟩

end DatumActCoord

section FamOfStab

variable {W : Rep.{0} ℚ Γ6} {Z : Type} [MulAction Γ6 Z] (z₀ : Z) (e : W →ₗ[ℚ] W)
  (he : ∀ (s : Γ6), s • z₀ = z₀ → ∀ v, e (W.ρ s v) = W.ρ s (e v))

include he in
theorem conj_indep (γ γ' : Γ6) (h : γ • z₀ = γ' • z₀) :
    (W.ρ γ) ∘ₗ e ∘ₗ (W.ρ γ⁻¹) = (W.ρ γ') ∘ₗ e ∘ₗ (W.ρ γ'⁻¹) := by
  obtain ⟨s, rfl⟩ : ∃ s, γ = γ' * s := ⟨γ'⁻¹ * γ, by group⟩
  have hs : s • z₀ = z₀ := by
    rw [mul_smul] at h
    exact smul_left_cancel γ' h
  apply LinearMap.ext
  intro v
  change W.ρ (γ' * s) (e (W.ρ (γ' * s)⁻¹ v)) = W.ρ γ' (e (W.ρ γ'⁻¹ v))
  rw [mul_inv_rev, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply]
  rw [← he s hs, ← Module.End.mul_apply (W.ρ s) (W.ρ s⁻¹), ← map_mul, mul_inv_cancel, map_one]
  rfl

open Classical in
/-- **The equivariant family of endomorphisms generated by a map commuting with the stabilizer of a label.**  On the orbit of `z₀`, the value at `γ • z₀` is `ρ(γ) e ρ(γ)⁻¹`; elsewhere it is `0`. -/
def famOfStab : Fam W Z where
  P z := if h : ∃ γ : Γ6, γ • z₀ = z then (W.ρ h.choose) ∘ₗ e ∘ₗ (W.ρ h.choose⁻¹) else 0
  equiv γ z v := by
    by_cases h : ∃ γ' : Γ6, γ' • z₀ = z
    · have h' : ∃ γ' : Γ6, γ' • z₀ = γ • z := by
        obtain ⟨γ', hγ'⟩ := h
        exact ⟨γ * γ', by rw [mul_smul, hγ']⟩
      rw [dite_eq_left h, dite_eq_left h']
      have c1 := conj_indep z₀ e he h'.choose (γ * h.choose) (by rw [h'.choose_spec, mul_smul, h.choose_spec])
      rw [c1]
      change W.ρ (γ * h.choose) (e (W.ρ (γ * h.choose)⁻¹ (W.ρ γ v))) = W.ρ γ (W.ρ h.choose (e (W.ρ h.choose⁻¹ v)))
      rw [map_mul, mul_inv_rev, map_mul, Module.End.mul_apply, Module.End.mul_apply,
        ← Module.End.mul_apply (W.ρ γ⁻¹) (W.ρ γ), ← map_mul, inv_mul_cancel, map_one]
      rfl
    · have h' : ¬ ∃ γ' : Γ6, γ' • z₀ = γ • z := by
        rintro ⟨γ', hγ'⟩
        exact h ⟨γ⁻¹ * γ', by rw [mul_smul, hγ', inv_smul_smul]⟩
      rw [dite_eq_right h, dite_eq_right h']
      simp

include he in
theorem famOfStab_apply (γ : Γ6) :
    (famOfStab z₀ e he).P (γ • z₀) = (W.ρ γ) ∘ₗ e ∘ₗ (W.ρ γ⁻¹) := by
  classical
  have h : ∃ γ' : Γ6, γ' • z₀ = γ • z₀ := ⟨γ, rfl⟩
  change (if h : ∃ γ' : Γ6, γ' • z₀ = γ • z₀ then (W.ρ h.choose) ∘ₗ e ∘ₗ (W.ρ h.choose⁻¹) else 0) = _
  rw [dite_eq_left h]
  exact conj_indep z₀ e he _ _ h.choose_spec

include he in
theorem famOfStab_not_mem (z : Z) (h : ¬ ∃ γ : Γ6, γ • z₀ = z) : (famOfStab z₀ e he).P z = 0 := by
  classical
  change (if h : ∃ γ' : Γ6, γ' • z₀ = z then (W.ρ h.choose) ∘ₗ e ∘ₗ (W.ρ h.choose⁻¹) else 0) = _
  rw [dite_eq_right h]

end FamOfStab

end TernaryPeriodPolynomials.Argument.GammaNStokes
