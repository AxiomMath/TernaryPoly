/-!
# The cuspidal subspace of `H¹(Γ(N), A)` and the orthogonality criterion

Formalized by Claude Sonnet 5.5.  Paper: `ar:eq:facepair`.

* `cuspidalSub A`: the classes of `H¹(Γ(N), A)` with zero restriction to the stabilizer of every cusp `x ∈ P¹(ℚ)` (the literal cuspidal
  definition; `mem_cuspidalSub_π`: concretely, the cocycle is a coboundary of a vector on each stabilizer);
* `stab_eq_zpow`: the stabilizer of a cusp in `Γ(N)` is generated by `cuspSigma c`;
* **`cuspidal_iff_orth`**: a cochain `G ∈ C¹(A')` has cuspidal class iff it is orthogonal (for the duality pairing) to every Farey cocycle
  `dΦ` of a strictly equivariant cusp function `Φ`.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.GammaNParabolicPD

open TernaryPeriodPolynomials.Argument.FareyTree TernaryPeriodPolynomials.Argument.HeckeDuality
  TernaryPoly.RankTwoAugmentedFrames TernaryPoly.BinaryModularSymbol
open TernaryPeriodPolynomials.Argument.SeedC3S4c (oneRestriction oneRestriction_π_eq_zero_iff)
open scoped Classical

section Cuspidal

variable {N : ℕ}

/-- **The cuspidal subspace** of `H¹(Γ(N), A)`: the classes restricting to zero on the stabilizer of every cusp. -/
def cuspidalSub (A : Rep ℂ (gammaNGL N)) : Submodule ℂ (groupCohomology.H1 A) :=
  ⨅ x : RationalLine2, LinearMap.ker (oneRestriction (MulAction.stabilizer (gammaNGL N) x) A)

theorem mem_cuspidalSub_π (A : Rep ℂ (gammaNGL N)) (c : groupCohomology.cocycles₁ A) :
    groupCohomology.H1π A c ∈ cuspidalSub A ↔
      ∀ x : RationalLine2, ∃ u : A, ∀ γ : gammaNGL N, γ • x = x → c.1 γ = A.ρ γ u - u := by
  unfold cuspidalSub
  simp only [Submodule.mem_iInf, LinearMap.mem_ker]
  refine forall_congr' fun x => (oneRestriction_π_eq_zero_iff _ A c).trans ?_
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨u, fun γ hγ => hu ⟨γ, hγ⟩⟩
  · rintro ⟨u, hu⟩
    exact ⟨u, fun γ => hu γ.1 γ.2⟩

theorem Tk_zpow (n j : ℤ) : Tk (n * j) = (Tk n) ^ j := by
  induction j using Int.induction_on with
  | zero => simp [Tk_zero]
  | succ i ih =>
    rw [mul_add, mul_one, Tk_add, ih, zpow_add_one]
  | pred i ih =>
    have hinv : (Tk n)⁻¹ = Tk (-n) := by
      rw [inv_eq_iff_mul_eq_one, ← Tk_add]; simp [Tk_zero]
    rw [mul_sub, mul_one, sub_eq_add_neg, Tk_add, ih, zpow_sub_one, hinv]

/-- **The stabilizer of a cusp in `Γ(N)` is generated by `cuspSigma c`.** -/
theorem stab_eq_zpow (hN : 3 ≤ N) (c : RationalLine2) (γ : gammaNGL N) (h : (γ : IntegralGL) • c = c) :
    ∃ j : ℤ, γ = (cuspSigma (N := N) c) ^ j := by
  have hconj : (cuspElt c)⁻¹ * (γ : IntegralGL) * cuspElt c ∈ gammaNGL N := by
    have := gammaN_conj (k := (cuspElt c)⁻¹) (g := (γ : IntegralGL)) γ.2
    rwa [inv_inv] at this
  have hfix : ((cuspElt c)⁻¹ * (γ : IntegralGL) * cuspElt c) • cusp1 = cusp1 := by
    rw [mul_smul, mul_smul, cuspElt_cusp1, h, inv_smul_eq_iff.mpr (cuspElt_cusp1 c).symm]
  obtain ⟨j, hj⟩ := gammaN_stab_cusp1 hN hconj hfix
  refine ⟨j, Subtype.ext ?_⟩
  rw [Subgroup.coe_zpow, cuspSigma_val, conj_zpow, ← Tk_zpow (N : ℤ) j, ← hj]
  group

theorem cuspSigma_cuspVan {E' : Type} [AddCommGroup E'] [Module ℂ E'] {ρ' : Representation ℂ (gammaNGL N) E'} {f : gammaNGL N → E'}
    (hf : ∀ g h, f (g * h) = ρ' g (f h) + f g) (hN : 3 ≤ N) (c : RationalLine2) (u : E')
    (hu : f (cuspSigma c) = ρ' (cuspSigma c) u - u) :
    ∀ γ : gammaNGL N, (γ : IntegralGL) • c = c → f γ = ρ' γ u - u := by
  intro γ hγ
  obtain ⟨j, rfl⟩ := stab_eq_zpow hN c γ hγ
  exact cocycle_zpow ρ' f hf _ u hu j

end Cuspidal

section Orth

variable {N : ℕ}

/-- **Orthogonality criterion for cuspidality.**  A cochain has cuspidal class iff it pairs to zero with every Farey cocycle `dΦ`, `Φ` a
strictly equivariant function on the cusps. -/
theorem cuspidal_iff_orth (hN : 3 ≤ N) (A : Rep ℂ (gammaNGL N)) (A' : Rep ℂ (gammaNGL N))
    [FiniteDimensional ℂ A] [FiniteDimensional ℂ A'] (C : Coupling A.ρ A'.ρ) (G : C1 A'.ρ) :
    cohMap A' G ∈ cuspidalSub A' ↔
      ∀ (Φ : RationalLine2 → A) (hΦ : Φ ∈ EqFn (gammaNGL N) RationalLine2 A.ρ),
        pV C (gammaNFareyData hN) (bdryTw A.ρ hN ⟨Φ, eqFn_le_Tw A.ρ hΦ⟩) G = 0 := by
  have hf : ∀ g h, coc A'.ρ G (g * h) = A'.ρ g (coc A'.ρ G h) + coc A'.ρ G g := coc_mul A'.ρ G
  rw [cohMap_apply, mem_cuspidalSub_π]
  constructor
  · intro h Φ hΦ
    rw [pV_bdry_eq hN C hΦ G]
    have hz : ∀ c ∈ (cuspReps hN).R, C.e (Φ c) (coc A'.ρ G (cuspSigma c)) = 0 := by
      intro c _
      obtain ⟨u, hu⟩ := h c
      have hu' : coc A'.ρ G (cuspSigma c) = A'.ρ (cuspSigma c) u - u := hu (cuspSigma c) (cuspSigma_cusp c)
      have hfix : A.ρ (cuspSigma c) (Φ c) = Φ c := by
        have := hΦ (cuspSigma (N := N) c) c
        rw [← this]
        change Φ (((cuspSigma (N := N) c : gammaNGL N) : IntegralGL) • c) = Φ c
        rw [cuspSigma_cusp]
      have hI := C.inv (cuspSigma c) (Φ c) u
      rw [hfix] at hI
      rw [hu', map_sub, hI, sub_self]
    rw [Finset.sum_eq_zero hz, mul_zero]
  · intro H x
    -- the cocycle is a coboundary on the stabilizer of each representative
    have hreps : ∀ c ∈ (cuspReps hN).R, ∃ u : A', ∀ γ : gammaNGL N, γ • c = c → coc A'.ρ G γ = A'.ρ γ u - u := by
      intro c hc
      have horth : ∀ v : A, A.ρ (cuspSigma c) v = v → C.e v (coc A'.ρ G (cuspSigma c)) = 0 := by
        intro v hv
        obtain ⟨Φ, hΦ, hΦc, hΦ0⟩ := exists_eqfn_of_invariant A.ρ c v (fun γ hγ => by
          obtain ⟨j, rfl⟩ := stab_eq_zpow hN c γ hγ
          exact rep_zpow_fix A.ρ (cuspSigma c) v hv j)
        have h0 := H Φ hΦ
        rw [pV_bdry_eq hN C hΦ G] at h0
        have h1 : ∑ c' ∈ (cuspReps hN).R, C.e (Φ c') (coc A'.ρ G (cuspSigma c')) = C.e v (coc A'.ρ G (cuspSigma c)) := by
          rw [Finset.sum_eq_single c, hΦc]
          · intro c' hc' hne
            have : Φ c' = 0 := hΦ0 c' (by
              rintro ⟨γ, hγ⟩
              exact hne ((cuspReps hN).inj c hc c' hc' γ hγ).symm)
            rw [this, map_zero, LinearMap.zero_apply]
          · intro hn; exact absurd hc hn
        rw [h1] at h0
        rcases mul_eq_zero.mp h0 with h2 | h2
        · norm_num at h2
        · exact h2
      obtain ⟨w, hw⟩ := exists_coboundary_of_orth A.ρ A'.ρ C.e C.inv C.left C.right (cuspSigma c) _ horth
      exact ⟨w, cuspSigma_cuspVan hf hN c w hw⟩
    obtain ⟨r, hr, γ, hγ⟩ := (cuspReps hN).cover x
    obtain ⟨u, hu⟩ := hreps r hr
    refine ⟨A'.ρ γ u - coc A'.ρ G γ, fun s hs => ?_⟩
    rw [← hγ] at hs
    exact stab_coboundary_translate A'.ρ (coc A'.ρ G) hf r u hu γ s hs

end Orth



end TernaryPeriodPolynomials.Argument.GammaNParabolicPD
