module

public import TernaryPeriodPolynomials.ArithmeticCohomology.CongruenceLevel.FaceFactor.Flag.SlantEval
public import TernaryPeriodPolynomials.ArithmeticCohomology.CongruenceLevel.FaceFactor.SlantExt

@[expose] public section


/-!
# A primitive on a flag group, extended to the line/plane group, satisfies the flag relations `hR1`-`hR3`

Formalized by Claude Sonnet 5.5.

For a letter lift `Lt` of a flag group `B` into `E` (extension language) and a function `wB : B → W` with `dd1 wB = z∘ι` on `B`, the extension `extendG Lt wB = wB ∘ ι⁻¹` satisfies the three relations
`hR1`-`hR3` of the `LocalCusp` (primitive of `z` on the flag group generated by `inl N` and `s σ`).
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.GammaNFaceFactor

open TernaryPeriodPolynomials.SphericalDetection.Helpers

namespace LetterLift

variable {E L B : Type} [Group E] [Group L] [Group B] {ext : GroupExtension RadicalLattice E L} (s : ext.Splitting)
  {σ : L} (Lt : LetterLift (pairModelOfSplitting s) B σ) (W : Rep ℂ E) (z : relativeTwoCocycles ext.inl W) (wB : B → W)

/-- The extension of a function on the flag group to `E`. -/
def extendG : E → W := fun g => wB (Function.invFun Lt.ι g)

theorem extendG_ι (b : B) : Lt.extendG s W wB (Lt.ι b) = wB b := by
  classical
  unfold extendG
  rw [Function.leftInverse_invFun Lt.inj b]

theorem ι_nlB (r : RadicalLattice) : Lt.ι (Lt.nlB (Additive.ofMul r)) = ext.inl r :=
  (Lt.hnl _).trans (pm_nl_ofMul s r)

theorem ι_llB : Lt.ι Lt.llB = s σ := Lt.hll.trans (pm_ll s σ)

variable (hwB : ∀ b₁ b₂, W.ρ (Lt.ι b₁) (wB b₂) - wB (b₁ * b₂) + wB b₁ = z.val (Lt.ι b₁, Lt.ι b₂))

include hwB in
theorem extendG_hR1 (r r' : RadicalLattice) :
    W.ρ (ext.inl r) (Lt.extendG s W wB (ext.inl r')) - Lt.extendG s W wB (ext.inl r * ext.inl r') +
      Lt.extendG s W wB (ext.inl r) = 0 := by
  have e1 := Lt.ι_nlB s r
  have e2 := Lt.ι_nlB s r'
  have := hwB (Lt.nlB (Additive.ofMul r)) (Lt.nlB (Additive.ofMul r'))
  rw [e1, e2, z.property r r'] at this
  have k1 : Lt.extendG s W wB (ext.inl r') = wB (Lt.nlB (Additive.ofMul r')) := by rw [← e2, extendG_ι]
  have k2 : Lt.extendG s W wB (ext.inl r) = wB (Lt.nlB (Additive.ofMul r)) := by rw [← e1, extendG_ι]
  have k3 : Lt.extendG s W wB (ext.inl r * ext.inl r') =
      wB (Lt.nlB (Additive.ofMul r) * Lt.nlB (Additive.ofMul r')) := by
    rw [← e1, ← e2, ← map_mul, extendG_ι]
  rw [k1, k2, k3]
  exact this

include hwB in
theorem extendG_hR2 (hmix : ∀ (r : RadicalLattice) (l : L), z.val (ext.inl r, s l) = 0) (r : RadicalLattice) :
    W.ρ (ext.inl r) (Lt.extendG s W wB (s σ)) - Lt.extendG s W wB (ext.inl r * s σ) + Lt.extendG s W wB (ext.inl r) = 0 := by
  have e1 := Lt.ι_nlB s r
  have e2 := Lt.ι_llB s
  have := hwB (Lt.nlB (Additive.ofMul r)) Lt.llB
  rw [e1, e2, hmix] at this
  have k1 : Lt.extendG s W wB (s σ) = wB Lt.llB := by rw [← e2, extendG_ι]
  have k2 : Lt.extendG s W wB (ext.inl r) = wB (Lt.nlB (Additive.ofMul r)) := by rw [← e1, extendG_ι]
  have k3 : Lt.extendG s W wB (ext.inl r * s σ) = wB (Lt.nlB (Additive.ofMul r) * Lt.llB) := by
    rw [← e1, ← e2, ← map_mul, extendG_ι]
  rw [k1, k2, k3]
  exact this

include hwB in
theorem extendG_hR3 (r : RadicalLattice) :
    W.ρ (s σ) (Lt.extendG s W wB (ext.inl r)) - Lt.extendG s W wB (s σ * ext.inl r) + Lt.extendG s W wB (s σ) =
      z.val (s σ, ext.inl r) := by
  have e1 := Lt.ι_nlB s r
  have e2 := Lt.ι_llB s
  have := hwB Lt.llB (Lt.nlB (Additive.ofMul r))
  rw [e1, e2] at this
  have k1 : Lt.extendG s W wB (s σ) = wB Lt.llB := by rw [← e2, extendG_ι]
  have k2 : Lt.extendG s W wB (ext.inl r) = wB (Lt.nlB (Additive.ofMul r)) := by rw [← e1, extendG_ι]
  have k3 : Lt.extendG s W wB (s σ * ext.inl r) = wB (Lt.llB * Lt.nlB (Additive.ofMul r)) := by
    rw [← e1, ← e2, ← map_mul, extendG_ι]
  rw [k1, k2, k3]
  exact this

end LetterLift

end TernaryPeriodPolynomials.Argument.GammaNFaceFactor
