    Helpers.cohomological_exists_spherical_eigenform data.cusp spherical odd
      data.cohomological 3
  have eigen_interior_moments := Helpers.levelOneCuspForm_interiorMoments_ne_zero eigenform
    eigenform_nonzero eigenvalues eigenform_relations
  have eigen_period_parities := Helpers.levelOneCuspForm_periodParity_nonzero eigenform
    eigenform_nonzero eigenvalues eigenform_relations (n + 1) (by omega)
    (by obtain ⟨half, equality⟩ := odd; exact ⟨half + 1, by omega⟩)
  have eigen_classical_period_class (twist : ℤ) := Helpers.classicalBinaryCocycle_H1_ne_zero
    eigenform
    eigenform_nonzero eigenvalues eigenform_relations (n + 1) (by omega) twist
  have eigen_arithmetic_period_class (twist : ℤ) (parity : Fin 2)
      (sign : (-1 : ℂ) ^ twist = (-1 : ℂ) ^ parity.val) :=
    Helpers.classicalArithmeticCocycle_H1_ne_zero eigenform eigenform_nonzero eigenvalues
      eigenform_relations
      (n + 1) (by omega) (by obtain ⟨half, equality⟩ := odd; exact ⟨half + 1, by omega⟩)
      twist parity sign
  have local_central (place : FinitePlace) :=
    Helpers.cohomological_cuspLocalPadicCentralChar_eq_one data.cusp spherical data.cohomological
      place
  have eigen_sphere (place : FinitePlace) : Helpers.cuspLocalPadicSphereOperator data.cusp place 1
    eigenvector =
      (((Rat.HeightOneSpectrum.primesEquiv place).val : ℂ) ^ (eigen_half_weight + 1) *
        eigenvalues (Rat.HeightOneSpectrum.primesEquiv place)) • eigenvector := by
    simpa only [local_central, one_mul] using
      Helpers.cuspLocalPadicSphereOperator_one_of_hecke_eigen
      data.cusp eigenvector eigenvector_classical.1 place _ (eigenvector_relations
        (Rat.HeightOneSpectrum.primesEquiv place))
  have eigen_local_integral (base : BinaryFiniteGL) (place : FinitePlace) (exponent : ℂ)
      (convergent : 2 < exponent.re) := Helpers.cuspLocalPadicIntegral_eulerQuotient data.cusp
        eigenvector
    eigenvector_nonzero eigenvector_classical.1 base place exponent convergent _ (eigen_sphere
      place)
  have eigen_local_factor_nonzero (place : FinitePlace) (exponent : ℂ) (convergent : 2 <
    exponent.re) :=
    Helpers.cuspLocalPadicEulerFactor_ne_zero data.cusp eigenvector eigenvector_nonzero
      eigenvector_classical.1
      place exponent convergent _ (eigen_sphere place)
  have eigen_local_endpoint (base : BinaryFiniteGL) (place : FinitePlace) :=
    eigen_local_integral base place ((n : ℂ) / 2 + 3 + cohomologicalPoint)
      (Helpers.cohomological_localExponent_convergent (by omega))
  have eigen_local_critical_factor (place : FinitePlace) :=
    Helpers.cuspLocalPadicEulerFactor_cohomological
    data.cusp spherical data.cohomological place eigen_half_weight eigen_weight (eigenvalues
      (Rat.HeightOneSpectrum.primesEquiv place))
  have eigen_critical_product := Helpers.cuspCriticalEulerProduct_hasProd data.cusp spherical
    data.cohomological
    eigen_half_weight eigen_weight eigenform eigenform_nonzero eigenvalues eigenform_relations
  have eigen_critical_product_nonzero := Helpers.cuspCriticalEulerProduct_ne_zero data.cusp
    spherical data.cohomological
    eigen_half_weight eigen_weight eigenform eigenform_nonzero eigenvalues eigenform_relations
  have finite_endpoint_integrable := Helpers.goodLineFiniteVectorIntegrand_endpoint_integrable n
    (by omega : 3 < n) data.cusp
  have finite_endpoint_analytic := Helpers.goodLineFiniteVectorIntegral_endpoint_analytic n
    (by omega : 3 < n) data.cusp
  have eigen_finite_critical := Helpers.goodLineFiniteVectorIntegral_endpointValue data.cusp
    spherical
    (by omega : 3 < n) data.cohomological eigen_half_weight eigen_weight eigenform
      eigenform_nonzero eigenvalues
