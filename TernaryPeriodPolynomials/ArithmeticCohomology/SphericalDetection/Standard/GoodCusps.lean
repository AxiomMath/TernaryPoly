      (Helpers.binaryHilbertOperator data.cusp (Helpers.binaryWeightBasis (n + 1))
        (source_chart_block point) binary_correction.val - binary_correction.val) := by
    simpa only [source_chart_point point pivot] using source_period_reconstruction
      (source_chart_block point)
  rw [← same_class]
  apply Helpers.realPlaneLevelBinaryCocycle_zero_arithmeticEdge n positive odd data.cusp data.chi
    trivial
    basis relative mixed_regular
  apply normal_detects
  apply (Helpers.binaryNormalForm_coboundary_iff_endpoints data.cusp spherical data.cohomological
    (Helpers.finiteIntegralGLLevel 2) (Helpers.finiteIntegralGLLevel_isOpen 2)
    (Helpers.finiteIntegralGLLevel_isCompact 2) normal_cycle normal_regular normal_rotations
    lower upper lower_value upper_value normal_closed normal_support).mpr
  apply (Helpers.binaryEndpointBoundary_iff_zero data.cusp spherical odd data.cohomological
    (Helpers.finiteIntegralGLLevel 2) (lower 0) (upper (Fin.last (n + 1)))).mpr
  apply Helpers.binaryClassicalEndpoints_finite_detects data.cusp spherical (by omega : 3 < n)
    data.cohomological eigen_half_weight eigen_weight (lower 0) (upper (Fin.last (n + 1)))
