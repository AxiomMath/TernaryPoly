    Helpers.binaryRelative_exists_classical_endpoints data.cusp spherical odd data.cohomological
      eigen_half_weight eigen_weight lower upper lower_mem upper_mem normal_closed
  have source_endpoint_reflection := Helpers.binaryRelativeEndpoints_reflection data.cusp spherical
    odd
    data.cohomological (Helpers.finiteIntegralGLLevel 2) normal_cycle normal_regular
      normal_rotations
    lower upper lower_value upper_value normal_support
  have source_endpoints_equal := Helpers.binaryClassicalEndpoints_eq_of_reflection data.cusp
    eigen_half_weight
    (lower 0) (upper (Fin.last (n + 1))) source_lower_classical source_upper_classical
    source_lower_value source_upper_value source_endpoint_reflection
  have source_endpoint_form_holomorphic := Helpers.binaryRelativeLowerEndpoint_holomorphic
    data.cusp spherical odd
    data.cohomological (Helpers.finiteIntegralGLLevel 2) eigen_half_weight eigen_weight lower upper
