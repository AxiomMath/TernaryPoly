    (Helpers.realPlaneFirstProjection
      (Helpers.standardGoodLineRealArgument (Helpers.goodLineHalfPlaneCoordinateMap point))).right
  have source_chart_point (point : ℝ × ℝ) (pivot : point.2 ≠ 0) :
      (↑(source_chart_block point • UpperHalfPlane.I) : ℂ) =
        (point.1 : ℂ) + ((|point.2| : ℝ) : ℂ) * Complex.I :=
    Helpers.goodLineFirstProjection_planePoint_coe point pivot
  have source_chart_period (point : ℝ × ℝ) (pivot : point.2 ≠ 0) :
      Helpers.binaryHilbertEmbedding data.cusp (Helpers.binaryWeightBasis (n + 1))
        (Helpers.realPlaneLevelBinaryCocycle n data.cusp data.chi trivial basis relative
