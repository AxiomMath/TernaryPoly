    PlaneEisensteinHolomorphic D →
    ∀ T : boundarySummand D .plane →ₗ[ℂ] boundarySummand D .line,
    RealizesStandard D T → ∀ ξ : boundarySummand D .plane,
    BadPlaneRepresentative D ξ → VanishesOnGood n D.chi .line (T ξ).val → ξ = 0 := by
  intro local_entry n positive odd data trivial spherical holomorphic operator realizes
    coordinate supported good_zero
  obtain ⟨eigen_half_weight, eigenform, eigenvector, eigenvalues, eigen_weight,
    degree_lower_bound, eigenform_nonzero, eigenvector_nonzero, eigenvector_classical,
    eigenvector_realizes, eigenform_relations, eigenvector_relations,
