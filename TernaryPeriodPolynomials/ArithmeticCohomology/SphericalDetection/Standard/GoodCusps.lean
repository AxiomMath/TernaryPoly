      (2 : ℂ)⁻¹ • (Helpers.binaryEndpointPeriod data.cusp n eigen_half_weight
        source_lower_classical.val.val
        ((point.1 : ℂ) + ((|point.2| : ℝ) : ℂ) * Complex.I) +
        Helpers.binaryHilbertOperator data.cusp (Helpers.binaryWeightBasis (n + 1)) UpperHalfPlane.J
