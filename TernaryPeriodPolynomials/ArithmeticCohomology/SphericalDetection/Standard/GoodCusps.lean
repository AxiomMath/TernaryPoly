  rw [source_endpoints_equal, and_self]
  apply Helpers.goodLineFiniteVectorIntegral_zero_of_period_zero data.cusp
    (Helpers.cohomological_centralCharacter_positive data.cusp data.cohomological)
    (by omega : 3 < n) odd eigen_half_weight eigen_weight source_lower_classical
  -- Iwasawa reduction (AxiomCode): after the Gram–Schmidt prism transfer, the
  -- integral of the finite average of the source on plane-parabolic simplices is the good-line
  -- mixed coordinate of an explicit two-coboundary.
  have projected_coboundary :=
    TernaryPeriodPolynomials.AnalyticClasses.projectedAverage_integral_coboundary
      degree_lower_bound local_entry data trivial source source_cocycle flat standard flat_sections
      flat_endpoint (Helpers.sourceCoefficient_localThree_support data source source_cocycle
        source_support)
      continuations standard_analytic line_radical_primitive line_mixed_comparison
  -- Explicit-primitive reduction (AxiomCode, round 3): on the determinant-normalized
  -- source, modulo integrability of the transported edges of the explicit total primitive, the
  -- projected integral is the canonical one plus a coboundary coordinate.
  have canonical_reduction :=
    TernaryPeriodPolynomials.AnalyticClasses.integral_projectedAverage_canonical
      degree_lower_bound data trivial basis source source_cocycle source_radical_primitive
      relative source_relative_formula mixed_regular
      (TernaryPeriodPolynomials.EdgeControl.totalPrimitiveEdge_edgeIntegrable (by omega)
        data trivial basis source source_cocycle source_radical_primitive source_radical_analytic
        relative source_relative_formula mixed_regular)
  -- Archimedean comparison (AxiomCode): the real-side comparison for the averaged
  -- real form of the classical source endpoint makes its twisted Eichler cocycle a coboundary, so
  -- the period class of the finite average of the endpoint vanishes.
  exact TernaryPeriodPolynomials.AnalyticClasses.cuspClassicalArithmeticPeriodMap_sourceEndpoint_eq_zero
    degree_lower_bound odd local_entry data trivial basis source source_cocycle flat standard
    flat_sections flat_endpoint
    (Helpers.sourceCoefficient_localThree_support data source source_cocycle source_support)
    continuations standard_analytic line_radical_primitive line_relative line_relative_formula
    source_radical_primitive source_radical_analytic relative source_relative_formula
    mixed_regular projected_coboundary canonical_reduction
    (Helpers.cohomological_centralCharacter_positive data.cusp data.cohomological)
    eigen_half_weight eigen_weight source_lower_classical
    (TernaryPeriodPolynomials.AnalyticClasses.eichlerData_classicalEndpoint data.cusp spherical odd
      data.cohomological (Helpers.finiteIntegralGLLevel 2) eigen_half_weight eigen_weight lower
      upper lower_mem upper_mem normal_closed source_lower_classical source_lower_value)
    binary_correction.val
    (TernaryPeriodPolynomials.AnalyticClasses.correction_smooth data.cusp eigen_half_weight
      source_lower_classical.val
      (Helpers.realPlaneLevelBinaryCocycle n data.cusp data.chi trivial basis relative
        mixed_regular)
      binary_analytic binary_correction.val (Helpers.finiteIntegralGLLevel 2)
      (Helpers.finiteIntegralGLLevel_isOpen 2) (Helpers.finiteIntegralGLLevel_isCompact 2)
      binary_correction.property source_period_reconstruction)
    (TernaryPeriodPolynomials.AnalyticClasses.spherical_of_integralLevel data.cusp binary_correction.val
      binary_correction.property)
    source_period_reconstruction

