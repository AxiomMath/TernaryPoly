module

public import TernaryPeriodPolynomials.ArithmeticCohomology.SphericalDetection.Modular.PositiveWords

@[expose] public section


open Matrix

noncomputable section

namespace TernaryPeriodPolynomials.SphericalDetection.Helpers

theorem modularGenerators_closure :
    Subgroup.closure ({ModularGroup.S, modularOrderSix} : Set (SpecialLinearGroup (Fin 2) ℤ)) = ⊤ := by
  apply top_unique
  rw [← _root_.SpecialLinearGroup.SL2Z_generators]
  apply (Subgroup.closure_le _).mpr
  intro element member
  have first : ModularGroup.S ∈ Subgroup.closure ({ModularGroup.S, modularOrderSix} : Set (SpecialLinearGroup (Fin 2) ℤ)) :=
    Subgroup.subset_closure (by simp)
  have second : modularOrderSix ∈ Subgroup.closure ({ModularGroup.S, modularOrderSix} : Set (SpecialLinearGroup (Fin 2) ℤ)) :=
    Subgroup.subset_closure (by simp)
  rcases member with rfl | rfl
  · exact first
  · have membership := (Subgroup.closure ({ModularGroup.S, modularOrderSix} : Set (SpecialLinearGroup (Fin 2) ℤ))).mul_mem
        ((Subgroup.closure _).inv_mem first) second
    simp only [modularOrderSix, inv_mul_cancel_left] at membership
    exact membership

theorem modularBlockWord_map {G H : Type*} [Group G] [Group H] (hom : G →* H)
    (first second : G) (blocks : List (Fin 2)) :
    hom (modularBlockWord first second blocks) = modularBlockWord (hom first) (hom second) blocks := by
  induction blocks with
  | nil => exact hom.map_one
  | cons block blocks induction => simp only [modularBlockWord, map_mul, map_pow, induction]

theorem modularNormalValue_map {G H : Type*} [Group G] [Group H] (hom : G →* H)
    (first second central : G) (power : ℕ) (head : Fin 3) (blocks : List (Fin 2)) (tail : Fin 2) :
    hom (modularNormalValue first second central power head blocks tail) =
      modularNormalValue (hom first) (hom second) (hom central) power head blocks tail := by
  simp only [modularNormalValue, map_mul, map_pow, modularBlockWord_map]

/-- The modular relations force injectivity on the subgroup generated by any lifts of S and ST. -/
theorem modularLift_kernel {G : Type*} [Group G] (projection : G →* SpecialLinearGroup (Fin 2) ℤ)
    (first second : G) (first_image : projection first = ModularGroup.S)
    (second_image : projection second = modularOrderSix)
    (fourth : first ^ 4 = 1) (relation : second ^ 3 = first ^ 2)
    (element : G) (member : element ∈ Subgroup.closure ({first, second} : Set G))
    (image : projection element = 1) : element = 1 := by
  obtain ⟨power, head, blocks, tail, rfl⟩ := modularNormalForm_of_mem_closure first second fourth relation member
  rw [modularNormalValue_map, map_pow, first_image, second_image] at image
  obtain ⟨rfl, rfl, rfl, even⟩ := modularNormalValue_identity power head blocks tail image
  simp only [modularNormalValue, modularBlockWord, Fin.val_zero, pow_zero, mul_one]
  obtain ⟨half, power⟩ := even.two_dvd
  rw [power, pow_mul]
  have central_square : (first ^ 2) ^ 2 = 1 := by simpa only [← pow_mul] using fourth
  rw [central_square, one_pow]

theorem modularLift_bijective {G : Type*} [Group G] (projection : G →* SpecialLinearGroup (Fin 2) ℤ)
    (first second : G) (first_image : projection first = ModularGroup.S)
    (second_image : projection second = modularOrderSix)
    (fourth : first ^ 4 = 1) (relation : second ^ 3 = first ^ 2) :
    Function.Bijective (projection.comp (Subgroup.closure ({first, second} : Set G)).subtype) := by
  constructor
  · intro left right equality
    apply Subtype.ext
    apply mul_inv_eq_one.mp
    apply modularLift_kernel projection first second first_image second_image fourth relation
    · exact (Subgroup.closure _).mul_mem left.property ((Subgroup.closure _).inv_mem right.property)
    · change projection left.val = projection right.val at equality
      rw [map_mul, map_inv, equality, mul_inv_cancel]
  · apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← modularGenerators_closure]
    apply (Subgroup.closure_le _).mpr
    intro element member
    rcases member with rfl | rfl
    · exact ⟨⟨first, Subgroup.subset_closure (by simp)⟩, first_image⟩
    · exact ⟨⟨second, Subgroup.subset_closure (by simp)⟩, second_image⟩

def modularLiftSection {G : Type*} [Group G] (projection : G →* SpecialLinearGroup (Fin 2) ℤ)
    (first second : G) (first_image : projection first = ModularGroup.S)
    (second_image : projection second = modularOrderSix)
    (fourth : first ^ 4 = 1) (relation : second ^ 3 = first ^ 2) :
    SpecialLinearGroup (Fin 2) ℤ →* G :=
  (Subgroup.closure ({first, second} : Set G)).subtype.comp
    (MulEquiv.ofBijective (projection.comp (Subgroup.closure ({first, second} : Set G)).subtype)
      (modularLift_bijective projection first second first_image second_image fourth relation)).symm.toMonoidHom

theorem modularLiftSection_projection {G : Type*} [Group G] (projection : G →* SpecialLinearGroup (Fin 2) ℤ)
    (first second : G) (first_image : projection first = ModularGroup.S)
    (second_image : projection second = modularOrderSix)
    (fourth : first ^ 4 = 1) (relation : second ^ 3 = first ^ 2) (element : SpecialLinearGroup (Fin 2) ℤ) :
    projection (modularLiftSection projection first second first_image second_image fourth relation element) = element :=
  (MulEquiv.ofBijective (projection.comp (Subgroup.closure ({first, second} : Set G)).subtype)
    (modularLift_bijective projection first second first_image second_image fourth relation)).apply_symm_apply element

end TernaryPeriodPolynomials.SphericalDetection.Helpers
