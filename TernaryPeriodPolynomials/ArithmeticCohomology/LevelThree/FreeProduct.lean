module

public import TernaryPeriodPolynomials.ArithmeticCohomology.LevelThree.GammaOneThree
public import Mathlib.GroupTheory.CoprodI

@[expose] public section


/-!
# `Γ₁(3) ≅ ℤ * ℤ/3`

The determinant-one level-three Levi `core = ⟨T, L⟩ ≤ Γ₁'(3)` is the free product of `⟨T⟩ ≅ ℤ`
(`T = [[1,1],[0,1]]`) and `⟨E⟩ ≅ ℤ/3` (`E = T L⁻¹ = [[-2,1],[-3,1]]`). Proof by Mathlib's
ping-pong lemma for the linear action on `ℝ²`: on slopes `x = v₀/v₁`, nonzero powers of `T` move
`(0, 1)` off `[0, 1]`, and `E`, `E² = E⁻¹` move the complement of `[0, 1]` (including `∞`) into
`(0, 1)`.

* `pingPong_injective`, `lift_bijective`, **`coreEquiv : CoprodI Factor ≃* core`**.

Original work by Claude Opus 5.5 (AxiomCode).
-/

noncomputable section

namespace TernaryPeriodPolynomials.LevelThree.FreeProduct

open TernaryPeriodPolynomials.EisensteinGraph.InnerCuspidalArithmetic
open Helpers ArithmeticGenerators LowDegreeParabolic GammaOneThree
open Matrix Monoid
open scoped Pointwise

/-- The elliptic element `E = T L⁻¹` of `Γ₁(3)`. -/
abbrev coreE : core := coreT * coreL⁻¹

/-- The free factors: `ℤ` (powers of `T`) and the cyclic group generated by `E`. -/
abbrev Factor : Bool → Type
  | false => Multiplicative ℤ
  | true => Subgroup.zpowers coreE

instance instGroupFactor : (b : Bool) → Group (Factor b)
  | false => inferInstanceAs (Group (Multiplicative ℤ))
  | true => inferInstanceAs (Group (Subgroup.zpowers coreE))

/-- The inclusions of the factors. -/
def factorHom : (b : Bool) → Factor b →* core
  | false => zpowersHom core coreT
  | true => (Subgroup.zpowers coreE).subtype

/-! ### The linear action on `ℝ²` -/

/-- The real matrix of an element of `Γ₁(3)`. -/
def realMatrix (g : core) : Matrix (Fin 2) (Fin 2) ℝ := (g.val.val.val).map (Int.castRingHom ℝ)

theorem realMatrix_one : realMatrix 1 = 1 := by
  simp [realMatrix]

theorem realMatrix_mul (g h : core) : realMatrix (g * h) = realMatrix g * realMatrix h := by
  change (g.val.val.val * h.val.val.val).map (Int.castRingHom ℝ) = _
  rw [Matrix.map_mul]
  rfl

/-- Column vectors of `ℝ²`, acted on by `Γ₁(3)`. -/
abbrev Plane : Type := Fin 2 → ℝ

instance : MulAction core Plane where
  smul g v := realMatrix g *ᵥ v
  one_smul v := by
    change realMatrix 1 *ᵥ v = v
    rw [realMatrix_one, one_mulVec]
  mul_smul g h v := by
    change realMatrix (g * h) *ᵥ v = realMatrix g *ᵥ (realMatrix h *ᵥ v)
    rw [realMatrix_mul, mulVec_mulVec]

theorem smul_def (g : core) (v : Plane) : g • v = realMatrix g *ᵥ v := rfl

theorem smul_apply_zero (g : core) (v : Plane) :
    (g • v) 0 = (g.val.val.val 0 0 : ℝ) * v 0 + (g.val.val.val 0 1 : ℝ) * v 1 := by
  simp [smul_def, realMatrix, mulVec, dotProduct, Fin.sum_univ_two]

theorem smul_apply_one (g : core) (v : Plane) :
    (g • v) 1 = (g.val.val.val 1 0 : ℝ) * v 0 + (g.val.val.val 1 1 : ℝ) * v 1 := by
  simp [smul_def, realMatrix, mulVec, dotProduct, Fin.sum_univ_two]

/-! ### Matrices of the relevant elements -/

theorem coreT_zpow_val (n : ℤ) : ((coreT ^ n : core) : binaryArithmeticLevel) = upper n := by
  rw [Subgroup.coe_zpow, upper_zpow]
  rfl

theorem coreE_val : ((coreE : core) : binaryArithmeticLevel) = upper 1 * lower (-1) := by
  change upper 1 * (lower 1)⁻¹ = _
  rw [lower_inv]

theorem coreE_matrix : (coreE : core).val.val.val = !![-2, 1; -3, 1] := by
  rw [coreE_val]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [upper, lower, Matrix.mul_apply, Fin.sum_univ_two]

theorem coreE_cube : coreE ^ 3 = 1 := core_elliptic_cube

theorem coreE_sq_matrix : (coreE ^ 2 : core).val.val.val = !![1, -1; 3, -2] := by
  have h : (coreE ^ 2 : core).val.val.val = (coreE : core).val.val.val * (coreE : core).val.val.val := by
    rw [pow_two]
    rfl
  rw [h, coreE_matrix]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-! ### The ping-pong sets -/

/-- Slopes in the open interval `(0, 1)`. -/
def inside : Set Plane := {v | 0 < v 0 * v 1 ∧ v 0 * v 1 < v 1 * v 1}

/-- Slopes outside the closed interval `[0, 1]`, including `∞`. -/
def outside : Set Plane :=
  {v | (v 1 = 0 ∧ v 0 ≠ 0) ∨ v 0 * v 1 < 0 ∨ v 1 * v 1 < v 0 * v 1}

/-- The ping-pong sets: `outside` for `⟨T⟩`, `inside` for `⟨E⟩`. -/
def pingSet : Bool → Set Plane
  | false => outside
  | true => inside

theorem pos_mul_of_pos_mul {x y b : ℝ} (hx : 0 < x * b) (hy : 0 < y * b) : 0 < x * y := by
  have hb : 0 < b * b := by
    rcases lt_trichotomy b 0 with h | h | h
    · nlinarith
    · rw [h, mul_zero] at hx
      exact absurd hx (lt_irrefl 0)
    · nlinarith
  have product : 0 < (x * y) * (b * b) := by
    have := mul_pos hx hy
    nlinarith
  exact pos_of_mul_pos_left product hb.le

theorem inside_nonempty : inside.Nonempty :=
  ⟨![1, 2], by change (0 : ℝ) < 1 * 2 ∧ (1 : ℝ) * 2 < 2 * 2; norm_num⟩

theorem outside_nonempty : outside.Nonempty :=
  ⟨![1, 0], Or.inl ⟨rfl, by change (1 : ℝ) ≠ 0; norm_num⟩⟩

theorem inside_outside_disjoint : Disjoint inside outside := by
  rw [Set.disjoint_left]
  rintro v ⟨h1, h2⟩ (⟨h3, _⟩ | h3 | h3)
  · rw [h3, mul_zero] at h1
    exact lt_irrefl 0 h1
  · exact lt_asymm h1 h3
  · exact lt_asymm h2 h3

/-- Nonzero powers of `T` move `inside` into `outside`. -/
theorem translate_inside (n : ℤ) (hn : n ≠ 0) (v : Plane) (hv : v ∈ inside) :
    (coreT ^ n) • v ∈ outside := by
  obtain ⟨h1, h2⟩ := hv
  have zero : (coreT ^ n • v) 0 = v 0 + n * v 1 := by
    rw [smul_apply_zero, coreT_zpow_val]
    simp [upper]
  have one : (coreT ^ n • v) 1 = v 1 := by
    rw [smul_apply_one, coreT_zpow_val]
    simp [upper]
  have hb : 0 < v 1 * v 1 := by nlinarith
  right
  rw [zero, one]
  rcases lt_or_gt_of_ne hn with neg | pos
  · left
    have : (n : ℝ) ≤ -1 := by exact_mod_cast Int.le_sub_one_of_lt neg
    nlinarith
  · right
    have : (1 : ℝ) ≤ n := by exact_mod_cast pos
    nlinarith

/-- `E` moves `outside` into `inside`. -/
theorem elliptic_outside (v : Plane) (hv : v ∈ outside) : coreE • v ∈ inside := by
  have zero : (coreE • v) 0 = -2 * v 0 + v 1 := by
    rw [smul_apply_zero, coreE_matrix]
    simp
  have one : (coreE • v) 1 = -3 * v 0 + v 1 := by
    rw [smul_apply_one, coreE_matrix]
    simp
  change 0 < (coreE • v) 0 * (coreE • v) 1 ∧ (coreE • v) 0 * (coreE • v) 1 < (coreE • v) 1 * (coreE • v) 1
  rw [zero, one]
  rcases hv with ⟨hb, ha⟩ | hab | hab
  · rw [hb]
    have : 0 < v 0 * v 0 := mul_self_pos.mpr ha
    constructor <;> nlinarith
  · constructor <;> nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
  · have h1 : 0 < (2 * v 0 - v 1) * v 1 := by nlinarith
    have h2 : 0 < (3 * v 0 - v 1) * v 1 := by nlinarith
    have h3 : 0 < v 0 * v 1 := by nlinarith
    have p1 := pos_mul_of_pos_mul h1 h2
    have p2 := pos_mul_of_pos_mul h3 h2
    constructor <;> nlinarith

/-- `E² = E⁻¹` moves `outside` into `inside`. -/
theorem elliptic_sq_outside (v : Plane) (hv : v ∈ outside) : coreE ^ 2 • v ∈ inside := by
  have zero : (coreE ^ 2 • v) 0 = v 0 - v 1 := by
    rw [smul_apply_zero, coreE_sq_matrix]
    simp
    ring
  have one : (coreE ^ 2 • v) 1 = 3 * v 0 - 2 * v 1 := by
    rw [smul_apply_one, coreE_sq_matrix]
    simp
    ring
  change 0 < (coreE ^ 2 • v) 0 * (coreE ^ 2 • v) 1 ∧
    (coreE ^ 2 • v) 0 * (coreE ^ 2 • v) 1 < (coreE ^ 2 • v) 1 * (coreE ^ 2 • v) 1
  rw [zero, one]
  rcases hv with ⟨hb, ha⟩ | hab | hab
  · rw [hb]
    have : 0 < v 0 * v 0 := mul_self_pos.mpr ha
    constructor <;> nlinarith
  · constructor <;> nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
  · have h1 : 0 < (v 0 - v 1) * v 1 := by nlinarith
    have h2 : 0 < (3 * v 0 - 2 * v 1) * v 1 := by nlinarith
    have h3 : 0 < (2 * v 0 - v 1) * v 1 := by nlinarith
    have p1 := pos_mul_of_pos_mul h1 h2
    have p2 := pos_mul_of_pos_mul h2 h3
    constructor <;> nlinarith

/-- A nontrivial element of `⟨E⟩` is `E` or `E²`. -/
theorem zpowers_E_cases (h : Subgroup.zpowers coreE) (hh : h ≠ 1) :
    (h : core) = coreE ∨ (h : core) = coreE ^ 2 := by
  obtain ⟨g, k, rfl⟩ := h
  have reduce : coreE ^ k = coreE ^ (k % 3) := by
    conv_lhs => rw [← Int.mul_ediv_add_emod k 3]
    rw [zpow_add, zpow_mul, show (coreE ^ (3 : ℤ)) = 1 by exact_mod_cast coreE_cube, one_zpow,
      one_mul]
  have range : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  change coreE ^ k = coreE ∨ coreE ^ k = coreE ^ 2
  rw [reduce]
  rcases range with h0 | h1 | h2
  · exfalso
    apply hh
    apply Subtype.ext
    change coreE ^ k = 1
    rw [reduce, h0, zpow_zero]
  · left
    rw [h1, zpow_one]
  · right
    rw [h2]
    exact_mod_cast rfl

theorem pingPong (i j : Bool) (hij : i ≠ j) (h : Factor i) (hh : h ≠ 1) :
    factorHom i h • pingSet j ⊆ pingSet i := by
  rintro _ ⟨v, hv, rfl⟩
  cases i <;> cases j
  · exact absurd rfl hij
  · -- `T^n` on `inside`
    change v ∈ inside at hv
    change zpowersHom core coreT h • v ∈ outside
    rw [zpowersHom_apply]
    apply translate_inside _ _ v hv
    intro zero
    apply hh
    change Multiplicative.ofAdd (Multiplicative.toAdd h) = Multiplicative.ofAdd 0
    rw [zero]
  · -- `E^k` on `outside`
    change v ∈ outside at hv
    change ((h : Subgroup.zpowers coreE) : core) • v ∈ inside
    rcases zpowers_E_cases h hh with hE | hE
    · rw [hE]
      exact elliptic_outside v hv
    · rw [hE]
      exact elliptic_sq_outside v hv
  · exact absurd rfl hij

theorem card_factor : 3 ≤ Cardinal.mk (Factor false) := by
  change 3 ≤ Cardinal.mk (Multiplicative ℤ)
  rw [show Cardinal.mk (Multiplicative ℤ) = Cardinal.mk ℤ from rfl, Cardinal.mk_int]
  exact (Cardinal.natCast_lt_aleph0 (n := 3)).le

/-- **Ping-pong**: the free product `ℤ * ⟨E⟩` embeds into `Γ₁(3)`. -/
theorem pingPong_injective : Function.Injective (CoprodI.lift factorHom) := by
  apply CoprodI.lift_injective_of_ping_pong factorHom (Or.inr ⟨false, card_factor⟩) pingSet
  · intro i
    cases i
    · exact outside_nonempty
    · exact inside_nonempty
  · intro i j hij
    cases i <;> cases j
    · exact absurd rfl hij
    · exact inside_outside_disjoint.symm
    · exact inside_outside_disjoint
    · exact absurd rfl hij
  · intro i j hij h hh
    exact pingPong i j hij h hh

theorem coreL_eq : coreL = coreE⁻¹ * coreT := by
  simp [coreE]

theorem lift_surjective : Function.Surjective (CoprodI.lift factorHom) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← core_closure, Subgroup.closure_le]
  intro x hx
  have hT : coreT ∈ (CoprodI.lift factorHom).range :=
    ⟨CoprodI.of (i := false) (Multiplicative.ofAdd 1), by
      rw [CoprodI.lift_of]
      change zpowersHom core coreT (Multiplicative.ofAdd 1) = coreT
      rw [zpowersHom_apply, toAdd_ofAdd, zpow_one]⟩
  have hE : coreE ∈ (CoprodI.lift factorHom).range :=
    ⟨CoprodI.of (i := true) ⟨coreE, Subgroup.mem_zpowers coreE⟩, by
      rw [CoprodI.lift_of]
      rfl⟩
  rcases hx with rfl | rfl
  · exact hT
  · rw [coreL_eq]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hE) hT

/-- **`Γ₁(3) ≅ ℤ * ℤ/3`**. -/
def coreEquiv : CoprodI Factor ≃* core :=
  MulEquiv.ofBijective (CoprodI.lift factorHom) ⟨pingPong_injective, lift_surjective⟩

end TernaryPeriodPolynomials.LevelThree.FreeProduct
