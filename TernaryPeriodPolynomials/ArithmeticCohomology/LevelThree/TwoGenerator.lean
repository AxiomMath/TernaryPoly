module

public import TernaryPeriodPolynomials.ArithmeticCohomology.EisensteinGraph.InnerCuspidalArithmetic.LeviCrossedAction

@[expose] public section


/-!
# First cohomology of a group generated by a parabolic pair with elliptic quotient

Let `G` be generated by `T` and `L` such that `E = T L⁻¹` satisfies `E³ = 1` (for example
`Γ₁(3) = ⟨[[1,1],[0,1]], [[1,0],[3,1]]⟩`). For a finite-dimensional complex representation `V`:

* `finrank_H1_add_le`: `dim H¹(G, V) + dim V^E ≤ dim V + dim V^G`;
* `finrank_parabolicH1_add_le`: if `V^T ∩ V^L = 0` and `(T - 1)V + (L - 1)V = V`, the classes whose
  restrictions to `⟨T⟩` and `⟨L⟩` are trivial satisfy
  `dim H¹_par + dim V^T + dim V^L + dim V^E ≤ dim V`.

Cocycles are Sol's crossed homomorphisms `z (g h) = z g + g · z h` (`crossedCocycles`), so that the
results apply directly to the bad-line interface `binaryParabolicH1`.

Original work by Claude Opus 5.5 (AxiomCode).
-/

noncomputable section

namespace TernaryPeriodPolynomials.LevelThree.TwoGenerator

open TernaryPeriodPolynomials.EisensteinGraph.InnerCuspidalArithmetic.Helpers
open Module

variable {G V : Type} [Group G] [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ G V)

/-- Vectors fixed by one element. -/
def fixed (g : G) : Submodule ℂ V := LinearMap.ker (ρ g - 1)

theorem mem_fixed {g : G} {v : V} : v ∈ fixed ρ g ↔ ρ g v = v := by
  simp [fixed, sub_eq_zero]

/-- The image of `g - 1`. -/
def moved (g : G) : Submodule ℂ V := LinearMap.range (ρ g - 1)

theorem sub_mem_moved (g : G) (v : V) : ρ g v - v ∈ moved ρ g := ⟨v, rfl⟩

theorem mem_moved {g : G} {w : V} : w ∈ moved ρ g ↔ ∃ v, ρ g v - v = w := by
  simp [moved]

/-- The norm `1 + g + g²`. -/
def norm3 (g : G) : V →ₗ[ℂ] V := 1 + ρ g + ρ (g ^ 2)

theorem norm3_apply (g : G) (v : V) : norm3 ρ g v = v + ρ g v + ρ g (ρ g v) := by
  simp [norm3, pow_two, map_mul, Module.End.mul_apply]

/-- Evaluation of a cocycle at one element. -/
def evalAt (g : G) : crossedCocycles ρ →ₗ[ℂ] V where
  toFun z := z.val g
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem evalAt_apply (g : G) (z : crossedCocycles ρ) : evalAt ρ g z = z.val g := rfl

variable {ρ}

theorem cocycle_mul (z : crossedCocycles ρ) (g h : G) : z.val (g * h) = z.val g + ρ g (z.val h) :=
  z.property g h

theorem cocycle_one (z : crossedCocycles ρ) : z.val 1 = 0 := crossedCocycle_one ρ z

theorem cocycle_inv (z : crossedCocycles ρ) (g : G) : z.val g⁻¹ = -ρ g⁻¹ (z.val g) := by
  have h := cocycle_mul z g⁻¹ g
  rw [inv_mul_cancel, cocycle_one] at h
  exact eq_neg_of_add_eq_zero_left h.symm

theorem rho_inv_apply (g : G) (v : V) : ρ g⁻¹ (ρ g v) = v := by
  rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]

theorem rho_apply_inv (g : G) (v : V) : ρ g (ρ g⁻¹ v) = v := by
  rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]

/-- A cocycle is determined by its values on a generating set. -/
theorem cocycle_ext_of_closure {S : Set G} (hS : Subgroup.closure S = ⊤) {z z' : crossedCocycles ρ}
    (h : ∀ s ∈ S, z.val s = z'.val s) : z = z' := by
  let agree : Subgroup G :=
    { carrier := {g | z.val g = z'.val g}
      one_mem' := by
        change z.val 1 = z'.val 1
        rw [cocycle_one, cocycle_one]
      mul_mem' := by
        intro g k hg hk
        change z.val g = z'.val g at hg
        change z.val k = z'.val k at hk
        change z.val (g * k) = z'.val (g * k)
        rw [cocycle_mul, cocycle_mul, hg, hk]
      inv_mem' := by
        intro g hg
        change z.val g = z'.val g at hg
        change z.val g⁻¹ = z'.val g⁻¹
        rw [cocycle_inv, cocycle_inv, hg] }
  have top : agree = ⊤ := by
    apply top_unique
    rw [← hS]
    exact (Subgroup.closure_le _).mpr h
  apply Subtype.ext
  funext g
  have member : g ∈ agree := top ▸ Subgroup.mem_top g
  exact member

theorem cocycle_pow_three (z : crossedCocycles ρ) (g : G) :
    z.val (g ^ 3) = norm3 ρ g (z.val g) := by
  rw [show g ^ 3 = g * (g * g) by rw [pow_succ', pow_two], cocycle_mul, cocycle_mul, map_add, norm3_apply]
  abel

theorem norm3_cocycle_eq_zero (z : crossedCocycles ρ) {g : G} (cube : g ^ 3 = 1) :
    norm3 ρ g (z.val g) = 0 := by
  rw [← cocycle_pow_three, cube, cocycle_one]

theorem norm3_sub_eq_zero {g : G} (cube : g ^ 3 = 1) (v : V) : norm3 ρ g (ρ g v - v) = 0 := by
  have h3 : ρ g (ρ g (ρ g v)) = v := by
    rw [← Module.End.mul_apply, ← Module.End.mul_apply, ← map_mul, ← map_mul,
      show g * g * g = g ^ 3 by rw [pow_succ, pow_two], cube, map_one, Module.End.one_apply]
  rw [norm3_apply, map_sub, map_sub, h3]
  abel

theorem norm3_rho {g : G} (cube : g ^ 3 = 1) (v : V) : norm3 ρ g (ρ g v) = norm3 ρ g v := by
  have h := norm3_sub_eq_zero (ρ := ρ) cube v
  rw [map_sub, sub_eq_zero] at h
  exact h

theorem fixed_le_range_norm3 (g : G) : fixed ρ g ≤ LinearMap.range (norm3 ρ g) := by
  intro v hv
  rw [mem_fixed] at hv
  refine ⟨(3 : ℂ)⁻¹ • v, ?_⟩
  rw [map_smul, norm3_apply, hv, hv]
  module

theorem finrank_ker_norm3_add_le [FiniteDimensional ℂ V] (g : G) :
    finrank ℂ (LinearMap.ker (norm3 ρ g)) + finrank ℂ (fixed ρ g) ≤ finrank ℂ V := by
  have rank_nullity := LinearMap.finrank_range_add_finrank_ker (norm3 ρ g)
  have le := Submodule.finrank_mono (fixed_le_range_norm3 (ρ := ρ) g)
  omega

theorem finrank_moved_add [FiniteDimensional ℂ V] (g : G) :
    finrank ℂ (moved ρ g) + finrank ℂ (fixed ρ g) = finrank ℂ V :=
  LinearMap.finrank_range_add_finrank_ker (ρ g - 1)

/-- The kernel of the coboundary map consists of invariant vectors. -/
theorem boundary_eq_zero_iff (v : V) : crossedBoundary ρ v = 0 ↔ ∀ g, ρ g v = v := by
  constructor
  · intro h g
    have value := congrFun (congrArg Subtype.val h) g
    change ρ g v - v = 0 at value
    exact sub_eq_zero.mp value
  · intro h
    apply Subtype.ext
    funext g
    change ρ g v - v = 0
    rw [h g, sub_self]

theorem ker_boundary_le (S : Set G) :
    LinearMap.ker (crossedBoundary ρ) ≤ ⨅ s ∈ S, fixed ρ s := by
  intro v hv
  rw [LinearMap.mem_ker, boundary_eq_zero_iff] at hv
  simp only [Submodule.mem_iInf, mem_fixed]
  intro s _
  exact hv s

/-- `dim H¹ = dim Z¹ - dim V + dim (ker δ)`. -/
theorem finrank_H1_add_finrank_eq [FiniteDimensional ℂ V] [FiniteDimensional ℂ (crossedCocycles ρ)] :
    finrank ℂ (CrossedH1 ρ) + finrank ℂ V =
      finrank ℂ (crossedCocycles ρ) + finrank ℂ (LinearMap.ker (crossedBoundary ρ)) := by
  have quotient : finrank ℂ (CrossedH1 ρ) + finrank ℂ (LinearMap.range (crossedBoundary ρ)) =
      finrank ℂ (crossedCocycles ρ) := Submodule.finrank_quotient_add_finrank _
  have rank_nullity := LinearMap.finrank_range_add_finrank_ker (crossedBoundary ρ)
  omega

section TwoGenerators

variable (T L : G)

/-- The values at `T` and `E = T L⁻¹`. -/
theorem cocycle_elliptic (z : crossedCocycles ρ) :
    z.val (T * L⁻¹) = z.val T - ρ (T * L⁻¹) (z.val L) := by
  rw [cocycle_mul, cocycle_inv, map_neg, ← Module.End.mul_apply (ρ T), ← map_mul, sub_eq_add_neg]

variable {T L}

theorem cocycle_eq_zero_of_values (gen : Subgroup.closure ({T, L} : Set G) = ⊤)
    {z : crossedCocycles ρ} (hT : z.val T = 0) (hL : z.val L = 0) : z = 0 := by
  apply cocycle_ext_of_closure gen
  intro s hs
  rcases hs with rfl | rfl
  · exact hT
  · exact hL

/-- `z ↦ (z T, z E)`, with `z E` in the kernel of the norm of `E`. -/
def pairMap (cube : (T * L⁻¹) ^ 3 = 1) :
    crossedCocycles ρ →ₗ[ℂ] V × LinearMap.ker (norm3 ρ (T * L⁻¹)) :=
  (evalAt ρ T).prod ((evalAt ρ (T * L⁻¹)).codRestrict _ (fun z => norm3_cocycle_eq_zero z cube))

theorem pairMap_injective (gen : Subgroup.closure ({T, L} : Set G) = ⊤)
    (cube : (T * L⁻¹) ^ 3 = 1) : Function.Injective (pairMap (ρ := ρ) cube) := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro z hz
  rw [LinearMap.mem_ker] at hz
  have hT : z.val T = 0 := congrArg Prod.fst hz
  have hE : z.val (T * L⁻¹) = 0 := congrArg (fun p => (p.2 : V)) hz
  have hL : z.val L = 0 := by
    rw [cocycle_elliptic, hT, zero_sub, neg_eq_zero] at hE
    rw [← rho_inv_apply (ρ := ρ) (T * L⁻¹) (z.val L), hE, map_zero]
  rw [Submodule.mem_bot]
  exact cocycle_eq_zero_of_values gen hT hL

theorem cocycles_finiteDimensional [FiniteDimensional ℂ V]
    (gen : Subgroup.closure ({T, L} : Set G) = ⊤) (cube : (T * L⁻¹) ^ 3 = 1) :
    FiniteDimensional ℂ (crossedCocycles ρ) :=
  Module.Finite.of_injective (pairMap (ρ := ρ) cube) (pairMap_injective gen cube)

/-- **Upper bound for `H¹`**: `dim H¹(G, V) + dim V^E ≤ dim V + dim V^G`. -/
theorem finrank_H1_add_le [FiniteDimensional ℂ V] (gen : Subgroup.closure ({T, L} : Set G) = ⊤)
    (cube : (T * L⁻¹) ^ 3 = 1) :
    finrank ℂ (CrossedH1 ρ) + finrank ℂ (fixed ρ (T * L⁻¹)) ≤
      finrank ℂ V + finrank ℂ (fixed ρ T ⊓ fixed ρ L : Submodule ℂ V) := by
  have := cocycles_finiteDimensional (ρ := ρ) gen cube
  have equation := finrank_H1_add_finrank_eq (ρ := ρ)
  have cocycles := LinearMap.finrank_le_finrank_of_injective (pairMap_injective (ρ := ρ) gen cube)
  rw [Module.finrank_prod] at cocycles
  have norm := finrank_ker_norm3_add_le (ρ := ρ) (T * L⁻¹)
  have kernel : LinearMap.ker (crossedBoundary ρ) ≤ fixed ρ T ⊓ fixed ρ L := by
    intro v hv
    rw [LinearMap.mem_ker, boundary_eq_zero_iff] at hv
    exact ⟨(mem_fixed ρ).mpr (hv T), (mem_fixed ρ).mpr (hv L)⟩
  have kernel_le := Submodule.finrank_mono kernel
  omega

/-! ### Parabolic classes -/

variable (ρ T L)

/-- Cocycles whose restrictions to `⟨T⟩` and `⟨L⟩` are coboundaries. -/
def parabolicCocycles : Submodule ℂ (crossedCocycles ρ) where
  carrier := {z | z.val T ∈ moved ρ T ∧ z.val L ∈ moved ρ L}
  zero_mem' := ⟨Submodule.zero_mem _, Submodule.zero_mem _⟩
  add_mem' := fun hz hw => ⟨Submodule.add_mem _ hz.1 hw.1, Submodule.add_mem _ hz.2 hw.2⟩
  smul_mem' := fun c _ hz => ⟨Submodule.smul_mem _ c hz.1, Submodule.smul_mem _ c hz.2⟩

/-- Parabolic classes: the image of the parabolic cocycles in `H¹`. -/
def parabolicH1 : Submodule ℂ (CrossedH1 ρ) :=
  (parabolicCocycles ρ T L).map (crossedBoundaries ρ).mkQ

/-- Normalized parabolic cocycles: `z T = 0`, `z L ∈ (L - 1)V`. -/
def normalizedCocycles : Submodule ℂ (crossedCocycles ρ) where
  carrier := {z | z.val T = 0 ∧ z.val L ∈ moved ρ L}
  zero_mem' := ⟨rfl, Submodule.zero_mem _⟩
  add_mem' := by
    intro z w hz hw
    refine ⟨?_, Submodule.add_mem _ hz.2 hw.2⟩
    change z.val T + w.val T = 0
    rw [hz.1, hw.1, add_zero]
  smul_mem' := by
    intro c z hz
    refine ⟨?_, Submodule.smul_mem _ c hz.2⟩
    change c • z.val T = 0
    rw [hz.1, smul_zero]

variable {ρ T L}

theorem boundary_apply (v : V) (g : G) : (crossedBoundary ρ v).val g = ρ g v - v := rfl

theorem mkQ_boundary (v : V) : (crossedBoundaries ρ).mkQ (crossedBoundary ρ v) = 0 := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact ⟨v, rfl⟩

theorem parabolicH1_le_normalized :
    parabolicH1 ρ T L ≤ (normalizedCocycles ρ T L).map (crossedBoundaries ρ).mkQ := by
  rintro _ ⟨z, ⟨⟨a, ha⟩, hL⟩, rfl⟩
  refine ⟨z - crossedBoundary ρ a, ⟨?_, ?_⟩, ?_⟩
  · change z.val T - (ρ T a - a) = 0
    rw [← ha, LinearMap.sub_apply, Module.End.one_apply, sub_self]
  · change z.val L - (ρ L a - a) ∈ moved ρ L
    exact Submodule.sub_mem _ hL (sub_mem_moved ρ L a)
  · rw [map_sub, mkQ_boundary, sub_zero]

/-- The values `z L` of normalized cocycles lie in `(L - 1)V ∩ ker N_E`. -/
theorem normalized_value_mem (cube : (T * L⁻¹) ^ 3 = 1) (z : normalizedCocycles ρ T L) :
    z.val.val L ∈ moved ρ L ⊓ LinearMap.ker (norm3 ρ (T * L⁻¹)) := by
  refine ⟨z.property.2, ?_⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker]
  have h := norm3_cocycle_eq_zero z.val cube
  rw [cocycle_elliptic, z.property.1, zero_sub, map_neg, norm3_rho cube, neg_eq_zero] at h
  exact h

/-- `z ↦ z L` on normalized cocycles. -/
def normalizedValue (cube : (T * L⁻¹) ^ 3 = 1) :
    normalizedCocycles ρ T L →ₗ[ℂ] (moved ρ L ⊓ LinearMap.ker (norm3 ρ (T * L⁻¹)) : Submodule ℂ V) :=
  ((evalAt ρ L).comp (normalizedCocycles ρ T L).subtype).codRestrict _ (normalized_value_mem cube)

theorem normalizedValue_injective (gen : Subgroup.closure ({T, L} : Set G) = ⊤)
    (cube : (T * L⁻¹) ^ 3 = 1) : Function.Injective (normalizedValue (ρ := ρ) cube) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro z hz
  have hL : z.val.val L = 0 := congrArg Subtype.val hz
  apply Subtype.ext
  exact cocycle_eq_zero_of_values gen z.property.1 hL

/-- Under `(T - 1)V + (L - 1)V = V`, also `(L - 1)V + ker N_E = V`. -/
theorem moved_sup_ker_norm3 (cube : (T * L⁻¹) ^ 3 = 1) (coinvariants : moved ρ T ⊔ moved ρ L = ⊤) :
    moved ρ L ⊔ LinearMap.ker (norm3 ρ (T * L⁻¹)) = ⊤ := by
  rw [eq_top_iff, ← coinvariants]
  apply sup_le _ le_sup_left
  rintro _ ⟨v, rfl⟩
  have decomposition : (ρ T - 1) v = (ρ L v - v) + (ρ (T * L⁻¹) (ρ L v) - ρ L v) := by
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel_right]
    simp
  rw [decomposition]
  apply Submodule.add_mem_sup (sub_mem_moved ρ L v)
  rw [LinearMap.mem_ker]
  exact norm3_sub_eq_zero cube _

/-- **Upper bound for parabolic `H¹`**: if `V^T ∩ V^L = 0` and `(T - 1)V + (L - 1)V = V`, then
`dim H¹_par + dim V^T + dim V^L + dim V^E ≤ dim V`. -/
theorem finrank_parabolicH1_add_le [FiniteDimensional ℂ V]
    (gen : Subgroup.closure ({T, L} : Set G) = ⊤) (cube : (T * L⁻¹) ^ 3 = 1)
    (invariants : fixed ρ T ⊓ fixed ρ L = ⊥) (coinvariants : moved ρ T ⊔ moved ρ L = ⊤) :
    finrank ℂ (parabolicH1 ρ T L) + finrank ℂ (fixed ρ T) + finrank ℂ (fixed ρ L) +
      finrank ℂ (fixed ρ (T * L⁻¹)) ≤ finrank ℂ V := by
  have := cocycles_finiteDimensional (ρ := ρ) gen cube
  -- the map from normalized cocycles to classes kills the coboundaries of `V^T`
  let classes := (crossedBoundaries ρ).mkQ.comp (normalizedCocycles ρ T L).subtype
  have range_eq : LinearMap.range classes = (normalizedCocycles ρ T L).map (crossedBoundaries ρ).mkQ := by
    rw [LinearMap.range_comp, Submodule.range_subtype]
  let boundaryT : fixed ρ T →ₗ[ℂ] LinearMap.ker classes :=
    LinearMap.codRestrict _ (LinearMap.codRestrict (normalizedCocycles ρ T L)
      ((crossedBoundary ρ).comp (fixed ρ T).subtype) (by
        intro v
        refine ⟨?_, sub_mem_moved ρ L v.val⟩
        change ρ T v.val - v.val = 0
        rw [(mem_fixed ρ).mp v.property, sub_self])) (by
        intro v
        rw [LinearMap.mem_ker]
        exact mkQ_boundary v.val)
  have boundaryT_injective : Function.Injective boundaryT := by
    apply (injective_iff_map_eq_zero _).mpr
    intro v hv
    have zero : crossedBoundary ρ v.val = 0 := congrArg (fun w => w.val.val) hv
    rw [boundary_eq_zero_iff] at zero
    have member : v.val ∈ fixed ρ T ⊓ fixed ρ L :=
      ⟨(mem_fixed ρ).mpr (zero T), (mem_fixed ρ).mpr (zero L)⟩
    rw [invariants, Submodule.mem_bot] at member
    exact Subtype.ext member
  have kernel_bound := LinearMap.finrank_le_finrank_of_injective boundaryT_injective
  have rank_nullity := LinearMap.finrank_range_add_finrank_ker (K := ℂ)
    (V := normalizedCocycles ρ T L) (V₂ := CrossedH1 ρ) classes
  rw [range_eq] at rank_nullity
  have parabolic_le := Submodule.finrank_mono (parabolicH1_le_normalized (ρ := ρ) (T := T) (L := L))
  have normalized_le :=
    LinearMap.finrank_le_finrank_of_injective (normalizedValue_injective (ρ := ρ) gen cube)
  have sup_inf := Submodule.finrank_sup_add_finrank_inf_eq (moved ρ L)
    (LinearMap.ker (norm3 ρ (T * L⁻¹)))
  rw [moved_sup_ker_norm3 cube coinvariants, finrank_top] at sup_inf
  have movedL := finrank_moved_add (ρ := ρ) L
  have norm := finrank_ker_norm3_add_le (ρ := ρ) (T * L⁻¹)
  omega

end TwoGenerators

end TernaryPeriodPolynomials.LevelThree.TwoGenerator
