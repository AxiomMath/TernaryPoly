module

public import TernaryPeriodPolynomials.ArithmeticCohomology.FiberModel.BadLineCusps

@[expose] public section


/-!
# The quotient coordinate `j_F` and "`j_F = 0` means the positive cocycle is a coboundary"

Paper: "The positive
cocycle `𝒥(φ_l)` has values `Ĵ,0,0` on `A₀,B₀,R₀`. Their finite-group relations give
`(1+𝒜+𝒜²)Ĵ=0` and `Ĵ(a,b)=-Ĵ(b,a)`. For `u=(2Ĵ+𝒜Ĵ)/3`, one has `(1-𝒜)u=Ĵ` and `ℬu=u`. Thus in
`V=ℚ[a,b]_{n+1}` the actual mixed class has quotient coordinate
`j_F=-[u]∈V/(V^{⟨𝒜,ℬ⟩}+V^ℛ)`", and "Finally suppose `j_F=0`. Write the positive
cocycle as `(1-l)m`."

A cocycle of `Γ₂ = 𝔖₃ * C₂` is a pair of cocycles of the factors; on `𝔖₃` every cocycle is
`(1-g)u` (`H¹(𝔖₃,V) = 0` over `ℚ`), and on `C₂` likewise, so `H¹(Γ₂,V) = V/(V^{𝔖₃}+V^{C₂})`.  The
converse existence of a cocycle with prescribed values is not used by the paper (the cocycle `𝒥(φ_l)`
is given); what is used, and proved here (`jF_zero_iff`), is the injectivity direction: the class of
the positive cocycle vanishes in `V/(V^{⟨A,B⟩}+V^R)` (that is, `u = v₁ + v₂` with `v₁` invariant under
`A₀, B₀` and `v₂` invariant under `R₀`) if and only if the cocycle is a coboundary `c(g) = m - g m`
on `Γ₂`.  (Coordinates `(Y,Z)`; `u` is `u = (2J + AJ)/3`.)

Formalized by Claude Sonnet 5.5.
-/

open MvPolynomial

noncomputable section

namespace TernaryPeriodPolynomials.Argument.FiberModel.BadLineCusps

variable {K : Type*} [Field K]

/-- `Γ₂` is generated by `A₀, B₀, R₀`. -/
theorem closure_a0_b0_r0 : Subgroup.closure ({a0, b0, r0} : Set Gamma2G) = ⊤ := by
  rw [eq_top_iff]
  intro g _
  have key : ∀ x ∈ genSub, ∃ hx : x ∈ Gamma2,
      (⟨x, hx⟩ : Gamma2G) ∈ Subgroup.closure ({a0, b0, r0} : Set Gamma2G) := by
    intro x hx
    change x ∈ Subgroup.closure ({A0, B0, R0} : Set GL2Z) at hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      rcases hy with rfl | hy
      · exact ⟨A0_mem, Subgroup.subset_closure (Or.inl rfl)⟩
      rcases hy with rfl | hy
      · exact ⟨B0_mem, Subgroup.subset_closure (Or.inr (Or.inl rfl))⟩
      · rw [Set.mem_singleton_iff] at hy
        subst hy
        exact ⟨R0_mem, Subgroup.subset_closure (Or.inr (Or.inr rfl))⟩
    | one => exact ⟨Subgroup.one_mem _, Subgroup.one_mem _⟩
    | mul x y _ _ hx hy =>
      obtain ⟨hx1, hx2⟩ := hx
      obtain ⟨hy1, hy2⟩ := hy
      exact ⟨Subgroup.mul_mem _ hx1 hy1, Subgroup.mul_mem _ hx2 hy2⟩
    | inv x _ hx =>
      obtain ⟨hx1, hx2⟩ := hx
      exact ⟨Subgroup.inv_mem _ hx1, Subgroup.inv_mem _ hx2⟩
  obtain ⟨hx, hr⟩ := key g.1 (Gamma2_le_genSub g.2)
  exact hr

theorem b0_sq : b0 * b0 = 1 := Subtype.ext (by simpa [b0, pow_two] using B0_sq)

theorem b0_a0_comm : b0 * a0 = a0 * a0 * b0 := by
  have h1 : a0⁻¹ = a0 * a0 := by
    rw [inv_eq_iff_mul_eq_one, ← a0_cube, pow_succ, pow_two, mul_assoc]
  calc b0 * a0 = b0 * a0 * b0 * b0 := by rw [mul_assoc _ b0 b0, b0_sq, mul_one]
    _ = a0 * a0 * b0 := by rw [b0_a0, h1]

theorem a0_cube_apply (x : MvPolynomial (Fin 2) K) :
    repG K a0 (repG K a0 (repG K a0 x)) = x := by
  rw [rep_apply_rep, rep_apply_rep, ← pow_two, ← pow_succ, a0_cube, _root_.map_one]; rfl

theorem b0_a0_apply (x : MvPolynomial (Fin 2) K) :
    repG K b0 (repG K a0 x) = repG K a0 (repG K a0 (repG K b0 x)) := by
  rw [rep_apply_rep, b0_a0_comm, mul_assoc, ← rep_apply_rep, ← rep_apply_rep]

namespace BadLineRelations

variable {d : ℕ} {J : MvPolynomial (Fin 2) K} (R : BadLineRelations K d J)
include R

/-- `u = (2J + AJ)/3`, in the coordinates `(Y, Z)`. -/
def primitive (J : MvPolynomial (Fin 2) K) : MvPolynomial (Fin 2) K :=
  (3 : K)⁻¹ • ((2 : K) • J + repG K a0 J)

/-- `(1 - A) u = J` and `B u = u`. -/
theorem primitive_spec [CharZero K] :
    primitive J - repG K a0 (primitive J) = J ∧ repG K b0 (primitive J) = primitive J := by
  have h2 : repG K a0 (repG K a0 J) = -(J + repG K a0 J) :=
    eq_neg_of_add_eq_zero_right R.cube
  have hba : repG K b0 (repG K a0 J) = -repG K a0 J := by
    rw [b0_a0_apply, R.refl, _root_.map_add, _root_.map_add, a0_cube_apply, h2]
    abel
  constructor
  · unfold primitive
    simp only [_root_.map_smul, _root_.map_add, h2]
    module
  · unfold primitive
    simp only [_root_.map_smul, _root_.map_add, hba, R.refl]
    module

end BadLineRelations

namespace PositiveCocycle

variable {d : ℕ} {c : Gamma2G → MvPolynomial (Fin 2) K} (h : PositiveCocycle K d c)
include h

/-- **`j_F = 0` means the positive cocycle is a coboundary**: the class
`[u] ∈ V/(V^{⟨A,B⟩} + V^R)` of `u = (2J + AJ)/3` vanishes iff the positive cocycle is a coboundary
`c(g) = m - g m` on `Γ₂`. -/
theorem jF_zero_iff [CharZero K] :
    (∃ m : MvPolynomial (Fin 2) K, m.IsHomogeneous d ∧ ∀ g, c g = m - repG K g m) ↔
      ∃ v₁ v₂ : MvPolynomial (Fin 2) K, v₁.IsHomogeneous d ∧ v₂.IsHomogeneous d ∧
        BadLineRelations.primitive (c a0) = v₁ + v₂ ∧
        repG K a0 v₁ = v₁ ∧ repG K b0 v₁ = v₁ ∧ repG K r0 v₂ = v₂ := by
  obtain ⟨hu1, hu2⟩ := h.relations.primitive_spec
  have huh : (BadLineRelations.primitive (c a0)).IsHomogeneous d := by
    unfold BadLineRelations.primitive
    rw [smul_eq_C_mul]
    refine IsHomogeneous.C_mul ?_ _
    rw [smul_eq_C_mul]
    exact (IsHomogeneous.C_mul h.hom _).add (actAlg_homog _ h.hom)
  generalize BadLineRelations.primitive (c a0) = u at hu1 hu2 huh ⊢
  constructor
  · rintro ⟨m, hmh, hm⟩
    have hA := hm a0
    have hB : repG K b0 m = m := by
      have := hm b0; rw [h.hB] at this
      exact (sub_eq_zero.mp this.symm).symm
    have hR : repG K r0 m = m := by
      have := hm r0; rw [h.hR] at this
      exact (sub_eq_zero.mp this.symm).symm
    refine ⟨u - m, m, huh.sub hmh, hmh, by abel, ?_, ?_, hR⟩
    · have e : repG K a0 u = u - (m - repG K a0 m) := by
        rw [← hA, ← hu1]; abel
      rw [_root_.map_sub, e]; abel
    · rw [_root_.map_sub, hu2, hB]
  · rintro ⟨v₁, v₂, hv₁, hv₂, hu, h1, h2, h3⟩
    subst hu
    refine ⟨v₂, hv₂, ?_⟩
    have hS : ∀ s ∈ ({a0, b0, r0} : Set Gamma2G), c s = v₂ - repG K s v₂ := by
      intro s hs
      rcases hs with rfl | rfl | rfl
      · rw [← hu1, _root_.map_add, h1]; abel
      · rw [h.hB]
        have : repG K b0 v₂ = v₂ := by
          have e := hu2
          rw [_root_.map_add, h2] at e
          exact add_left_cancel e
        rw [this, sub_self]
      · rw [h.hR, h3, sub_self]
    intro g
    exact h.cocycle.coboundary_closure v₂ _ hS g (by rw [closure_a0_b0_r0]; trivial)

/-- **Detection of the polynomial from `j_F = 0`**: if the class `[u]` vanishes in
`V/(V^{⟨A,B⟩} + V^R)` and `J(0,Z) = 0`, then `J = 0`. -/
theorem eq_zero_of_jF_zero [CharZero K] (hd : 1 ≤ d)
    (hj : ∃ v₁ v₂ : MvPolynomial (Fin 2) K, v₁.IsHomogeneous d ∧ v₂.IsHomogeneous d ∧
        BadLineRelations.primitive (c a0) = v₁ + v₂ ∧
        repG K a0 v₁ = v₁ ∧ repG K b0 v₁ = v₁ ∧ repG K r0 v₂ = v₂)
    (h0 : eval ![0, 1] (c a0) = 0) : c a0 = 0 := by
  obtain ⟨m, hmh, hm⟩ := h.jF_zero_iff.mpr hj
  have hB : repG K b0 m = m := by
    have := hm b0; rw [h.hB] at this
    exact (sub_eq_zero.mp this.symm).symm
  have hR : repG K r0 m = m := by
    have := hm r0; rw [h.hR] at this
    exact (sub_eq_zero.mp this.symm).symm
  exact detection hd hmh (hm a0) hB hR h0


/-- A positive cocycle is valued in the degree-`d` forms on all of `Γ₂` (induction over the
generators `A₀, B₀, R₀`). -/
theorem hom_all : ∀ g, (c g).IsHomogeneous d := by
  intro g
  have hg : g ∈ Subgroup.closure ({a0, b0, r0} : Set Gamma2G) := by
    rw [closure_a0_b0_r0]; trivial
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl | rfl
    · exact h.hom
    · rw [h.hB]; exact isHomogeneous_zero _ _ _
    · rw [h.hR]; exact isHomogeneous_zero _ _ _
  | one => rw [h.cocycle.c_one]; exact isHomogeneous_zero _ _ _
  | mul x y _ _ hx hy =>
    rw [h.cocycle x y]
    exact hx.add (actAlg_homog _ hy)
  | inv x _ hx =>
    rw [h.cocycle.c_inv]
    exact (actAlg_homog _ hx).neg

end PositiveCocycle

end TernaryPeriodPolynomials.Argument.FiberModel.BadLineCusps
