module

public import TernaryPeriodPolynomials.ArithmeticCohomology.FiberModel.Gamma2Defs

@[expose] public section


/-!
# `Γ₂` is generated by `A₀`, `B₀`, `R₀`

Euclidean descent on the first column using the translations `T^k` and `U₀^m`: every `g ∈ Γ₂`
reduces to an upper triangular matrix `T^b R₀^e`.  Together with `T = A₀⁻¹ U₀` and `U₀ = B₀ R₀` this
shows `Γ₂ = ⟨A₀, B₀, R₀⟩`.

Formalized by Claude Sonnet 5.5.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.FiberModel

/-- The translation `(1 k; 0 1)`. -/
def tk (k : ℤ) : GL2Z where
  val := !![1, k; 0, 1]
  inv := !![1, -k; 0, 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The lower unipotent `(1 0; 3m 1)`. -/
def uk (m : ℤ) : GL2Z where
  val := !![1, 0; 3 * m, 1]
  inv := !![1, 0; -(3 * m), 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

theorem tk_add_one (k : ℤ) : tk (k + 1) = tk k * Tm := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [tk, Tm, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals ring

theorem tk_sub_one (k : ℤ) : tk (k - 1) = tk k * Tm⁻¹ := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [tk, Tm, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals ring

theorem uk_add_one (m : ℤ) : uk (m + 1) = uk m * U0 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uk, U0, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals ring

theorem uk_sub_one (m : ℤ) : uk (m - 1) = uk m * U0⁻¹ := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uk, U0, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals ring

theorem tk_zero : tk 0 = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [tk]

theorem uk_zero : uk 0 = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uk]

/-- The subgroup generated by `A₀`, `B₀`, `R₀`. -/
def genSub : Subgroup GL2Z := Subgroup.closure {A0, B0, R0}

theorem U0_mem_genSub : U0 ∈ genSub := by
  have : U0 = B0 * R0 := by rw [B0_eq, mul_assoc, ← pow_two, R0_sq, mul_one]
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))

theorem Tm_mem_genSub : Tm ∈ genSub := by
  have : Tm = A0⁻¹ * U0 := by rw [A0_eq]; group
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.subset_closure (by simp))) U0_mem_genSub

theorem tk_mem_genSub (k : ℤ) : tk k ∈ genSub := by
  induction k using Int.induction_on with
  | zero => rw [tk_zero]; exact Subgroup.one_mem _
  | succ k ih => rw [tk_add_one]; exact Subgroup.mul_mem _ ih Tm_mem_genSub
  | pred k ih =>
    have h := tk_sub_one (-(k : ℤ))
    rw [show -(k : ℤ) - 1 = -(k : ℤ) - 1 from rfl] at h
    rw [h]
    exact Subgroup.mul_mem _ ih (Subgroup.inv_mem _ Tm_mem_genSub)

theorem uk_mem_genSub (m : ℤ) : uk m ∈ genSub := by
  induction m using Int.induction_on with
  | zero => rw [uk_zero]; exact Subgroup.one_mem _
  | succ k ih => rw [uk_add_one]; exact Subgroup.mul_mem _ ih U0_mem_genSub
  | pred k ih =>
    have h := uk_sub_one (-(k : ℤ))
    rw [h]
    exact Subgroup.mul_mem _ ih (Subgroup.inv_mem _ U0_mem_genSub)

theorem tk_mul_val (k : ℤ) (g : GL2Z) :
    (tk k * g).val = !![g.val 0 0 + k * g.val 1 0, g.val 0 1 + k * g.val 1 1;
      g.val 1 0, g.val 1 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [tk, Matrix.mul_apply, Fin.sum_univ_two]

theorem uk_mul_val (m : ℤ) (g : GL2Z) :
    (uk m * g).val = !![g.val 0 0, g.val 0 1;
      g.val 1 0 + 3 * m * g.val 0 0, g.val 1 1 + 3 * m * g.val 0 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uk, Matrix.mul_apply, Fin.sum_univ_two, add_comm]

theorem tk_mem_Gamma2 (k : ℤ) : tk k ∈ Gamma2 := by
  rw [mem_Gamma2]; simp [tk]

theorem uk_mem_Gamma2 (m : ℤ) : uk m ∈ Gamma2 := by
  rw [mem_Gamma2]; simp [uk]

/-- Nearest-multiple reduction: some translate of `a` by a multiple of `c` is at most half of `|c|`
in absolute value. -/
theorem exists_reduce_pos (a b : ℤ) (hb : 0 < b) : ∃ k : ℤ, 2 * (a + k * b).natAbs ≤ b.natAbs := by
  refine ⟨-((2 * a + b) / (2 * b)), ?_⟩
  have hr0 := Int.emod_nonneg (2 * a + b) (show 2 * b ≠ 0 by omega)
  have hr1 := Int.emod_lt_of_pos (2 * a + b) (show 0 < 2 * b by omega)
  have he := Int.emod_add_mul_ediv (2 * a + b) (2 * b)
  have h2 : 2 * (a + -((2 * a + b) / (2 * b)) * b) = (2 * a + b) % (2 * b) - b := by
    nlinarith [he]
  omega

theorem exists_reduce (a c : ℤ) (hc : c ≠ 0) : ∃ k : ℤ, 2 * (a + k * c).natAbs ≤ c.natAbs := by
  rcases lt_or_gt_of_ne hc with h | h
  · obtain ⟨k, hk⟩ := exists_reduce_pos a (-c) (by omega)
    refine ⟨-k, ?_⟩
    have : a + -k * c = a + k * -c := by ring
    rw [this]
    simpa using hk
  · exact exists_reduce_pos a c h

theorem det_cases (g : GL2Z) : g.val 0 0 * g.val 1 1 - g.val 0 1 * g.val 1 0 = 1 ∨
    g.val 0 0 * g.val 1 1 - g.val 0 1 * g.val 1 0 = -1 := by
  have h := Int.units_eq_one_or (Matrix.GeneralLinearGroup.det g)
  have e : ((Matrix.GeneralLinearGroup.det g : ℤˣ) : ℤ) =
      g.val 0 0 * g.val 1 1 - g.val 0 1 * g.val 1 0 := by
    rw [Matrix.GeneralLinearGroup.val_det_apply, Matrix.det_fin_two]
  rcases h with h | h
  · left; rw [← e, h]; rfl
  · right; rw [← e, h]; rfl

theorem mem_genSub_aux : ∀ (n : ℕ) (g : GL2Z), g ∈ Gamma2 →
    (g.val 0 0).natAbs + (g.val 1 0).natAbs = n → g ∈ genSub := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro g hg hn
    obtain ⟨hc3, hd3⟩ := (mem_Gamma2 g).mp hg
    have hdet := det_cases g
    by_cases hc : g.val 1 0 = 0
    · -- upper triangular
      rw [hc] at hdet
      have hd : g.val 1 1 = 1 := by
        have hu : IsUnit (g.val 1 1) := by
          rcases hdet with h | h
          · exact isUnit_iff_exists_inv.mpr ⟨g.val 0 0, by linarith [mul_comm (g.val 0 0) (g.val 1 1)]⟩
          · exact isUnit_iff_exists_inv.mpr ⟨-g.val 0 0, by linarith [mul_comm (g.val 0 0) (g.val 1 1)]⟩
        rcases Int.isUnit_iff.mp hu with h | h
        · exact h
        · omega
      have ha : g.val 0 0 = 1 ∨ g.val 0 0 = -1 := by
        rw [hd] at hdet
        omega
      have hmat : g.val = !![g.val 0 0, g.val 0 1; 0, 1] := by
        rw [← hc, ← hd]
        exact Matrix.eta_fin_two g.val
      rcases ha with ha | ha
      · have : g = tk (g.val 0 1) := by
          apply Units.ext
          rw [hmat, ha]
          simp [tk]
        rw [this]
        exact tk_mem_genSub _
      · have : g = tk (g.val 0 1) * R0 := by
          apply Units.ext
          rw [hmat, ha]
          ext i j
          fin_cases i <;> fin_cases j <;> simp [tk, R0, Matrix.mul_apply, Fin.sum_univ_two]
        rw [this]
        exact Subgroup.mul_mem _ (tk_mem_genSub _) (Subgroup.subset_closure (by simp))
    · by_cases hA : (g.val 1 0).natAbs < 2 * (g.val 0 0).natAbs
      · obtain ⟨k, hk⟩ := exists_reduce (g.val 0 0) (g.val 1 0) hc
        have hg' : tk k * g ∈ Gamma2 := Subgroup.mul_mem _ (tk_mem_Gamma2 k) hg
        have hn' : ((tk k * g).val 0 0).natAbs + ((tk k * g).val 1 0).natAbs < n := by
          rw [tk_mul_val]
          simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
            Matrix.empty_val', Matrix.cons_val_fin_one]
          omega
        have h1 := ih _ hn' (tk k * g) hg' rfl
        have h2 := Subgroup.mul_mem _ (Subgroup.inv_mem _ (tk_mem_genSub k)) h1
        simpa using h2
      · have ha : g.val 0 0 ≠ 0 := by
          intro ha0
          rw [ha0] at hdet
          have hu : IsUnit (g.val 1 0) := by
            rcases hdet with h | h
            · exact isUnit_iff_exists_inv.mpr ⟨-g.val 0 1, by linarith [mul_comm (g.val 0 1) (g.val 1 0)]⟩
            · exact isUnit_iff_exists_inv.mpr ⟨g.val 0 1, by linarith [mul_comm (g.val 0 1) (g.val 1 0)]⟩
          rcases Int.isUnit_iff.mp hu with h | h <;> omega
        obtain ⟨m, hm⟩ := exists_reduce (g.val 1 0) (3 * g.val 0 0) (by omega)
        have hg' : uk m * g ∈ Gamma2 := Subgroup.mul_mem _ (uk_mem_Gamma2 m) hg
        have hn' : ((uk m * g).val 0 0).natAbs + ((uk m * g).val 1 0).natAbs < n := by
          rw [uk_mul_val]
          simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
            Matrix.empty_val', Matrix.cons_val_fin_one]
          have : g.val 1 0 + 3 * m * g.val 0 0 = g.val 1 0 + m * (3 * g.val 0 0) := by ring
          rw [this]
          omega
        have h1 := ih _ hn' (uk m * g) hg' rfl
        have h2 := Subgroup.mul_mem _ (Subgroup.inv_mem _ (uk_mem_genSub m)) h1
        simpa using h2

/-- **`Γ₂` is generated by `A₀`, `B₀`, `R₀`.** -/
theorem Gamma2_le_genSub : Gamma2 ≤ genSub := fun g hg => mem_genSub_aux _ g hg rfl

end TernaryPeriodPolynomials.Argument.FiberModel
