/-
  Invariance under a generated algebra of endomorphisms, from invariance under a
  set of generators.  Used to view `associatePair D` as a module over the Hecke
  algebra generated by the `pairHecke` operators.
-/
module

public import TernaryPeriodPolynomials.ArithmeticCohomology.Defs

@[expose] public section


open Module

noncomputable section

namespace TernaryPeriodPolynomials.HeckeTranslate.StabilizerAdjoin

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The endomorphisms preserving a submodule form a subalgebra. -/
def stabilizerSubalgebra (A : Submodule ℂ V) : Subalgebra ℂ (Module.End ℂ V) where
  carrier := {f | ∀ x ∈ A, f x ∈ A}
  mul_mem' := by
    intro f g hf hg x hx
    exact hf (g x) (hg x hx)
  one_mem' := by intro x hx; exact hx
  add_mem' := by
    intro f g hf hg x hx
    rw [LinearMap.add_apply]
    exact Submodule.add_mem _ (hf x hx) (hg x hx)
  zero_mem' := by
    intro x hx
    rw [LinearMap.zero_apply]
    exact Submodule.zero_mem _
  algebraMap_mem' := by
    intro c x hx
    have h : (algebraMap ℂ (Module.End ℂ V)) c = c • (1 : Module.End ℂ V) :=
      Algebra.algebraMap_eq_smul_one c
    rw [h, LinearMap.smul_apply]
    exact Submodule.smul_mem _ c hx

/-- **Invariance under the generated algebra.**  If every generator preserves
`A`, then every element of the algebra they generate preserves `A`. -/
theorem mem_adjoin_invariant (A : Submodule ℂ V) (H : Set (Module.End ℂ V))
    (hgen : ∀ f ∈ H, ∀ x ∈ A, f x ∈ A)
    (f : Module.End ℂ V) (hf : f ∈ Algebra.adjoin ℂ H) {x : V} (hx : x ∈ A) :
    f x ∈ A := by
  have hsub : Algebra.adjoin ℂ H ≤ stabilizerSubalgebra A := by
    apply Algebra.adjoin_le
    intro g hg
    exact hgen g hg
  exact hsub hf x hx

end TernaryPeriodPolynomials.HeckeTranslate.StabilizerAdjoin

end
