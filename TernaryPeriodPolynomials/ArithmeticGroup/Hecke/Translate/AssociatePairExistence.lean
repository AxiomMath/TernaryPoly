/-
  Conditional existence of the associate-pair projection.

  Combining the abstract invariant-projection lemma with Hecke-stability of the
  associate pair and of a chosen complement yields a genuine
  `IsIsotypicalProjection`.  The remaining, genuinely missing inputs are the two
  stability hypotheses; uniqueness additionally needs the projector to lie in the
  Hecke algebra (`TernaryPeriodPolynomials.HeckeTranslate.HeckeAlgebraUniqueness.isotypical_unique_of_mem_adjoin`).
-/
module

public import TernaryPeriodPolynomials.ArithmeticCohomology.Defs
public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Translate.StableComplement
public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Translate.HeckeAlgebraUniqueness
public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Translate.Obstruction
public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Translate.HeckeStability

@[expose] public section



open GeneralEisenstein
open Homogeneous Adelic

noncomputable section

namespace TernaryPeriodPolynomials.HeckeTranslate.AssociatePairExistence

variable {n : ℕ} {D : InducingData n}

/-- If the associate pair and some complement are both Hecke-stable, then an
associate-pair projection exists. -/
theorem exists_isotypicalProjection_of_stable_complement
    (hecke : BoundaryHecke n D.chi)
    (hS : ∀ t, ∀ x ∈ associatePair D, pairHecke D hecke t x ∈ associatePair D)
    (hS' : ∃ S' : Submodule ℂ (BoundaryCoordinates n D.chi),
      IsCompl (associatePair D) S' ∧
      ∀ t, ∀ x ∈ S', pairHecke D hecke t x ∈ S') :
    ∃ p : Module.End ℂ (BoundaryCoordinates n D.chi), IsIsotypicalProjection D hecke p := by
  obtain ⟨S', hcompl, hstab'⟩ := hS'
  obtain ⟨p, hrange, hfix, hcomm⟩ :=
    StableComplement.exists_invariant_projection (associatePair D) S' hcompl
      (Set.range (fun t : HeckeCorrespondence => pairHecke D hecke t))
      (fun A hA => by rintro x hx; obtain ⟨t, rfl⟩ := hA; exact hS t x hx)
      (fun A hA => by rintro x hx; obtain ⟨t, rfl⟩ := hA; exact hstab' t x hx)
  refine ⟨p, hrange, hfix, ?_⟩
  intro t
  exact hcomm (pairHecke D hecke t) ⟨t, rfl⟩

/-- **Conditional assembly.**  If a solution of `IsIsotypicalProjection` lies in
the algebra generated by the Hecke operators `pairHecke D hecke t`, then the
conclusion holds: existence plus uniqueness of the associate-pair
projection.  (Such a `p` moreover forces the associate pair and its kernel to be
Hecke-stable, so this hypothesis subsumes both stability conditions.) -/
theorem cuspidal_associate_projector_of_hecke_algebra_projector
    (hecke : BoundaryHecke n D.chi)
    (halg : ∃ p : Module.End ℂ (BoundaryCoordinates n D.chi),
      IsIsotypicalProjection D hecke p ∧
      p ∈ Algebra.adjoin ℂ
        (Set.range (fun t : HeckeCorrespondence => pairHecke D hecke t))) :
    ∃ p : Module.End ℂ (BoundaryCoordinates n D.chi),
      IsIsotypicalProjection D hecke p ∧
      ∀ p', IsIsotypicalProjection D hecke p' → p' = p := by
  obtain ⟨p, hp, hpmem⟩ := halg
  exact ⟨p, hp, HeckeAlgebraUniqueness.isotypical_unique_of_mem_adjoin hp hpmem⟩

/-- **Two-way reduction.**  Existence of an associate-pair projection is
equivalent to: the associate pair is Hecke-stable *and* has a Hecke-stable
complement.  The forward direction uses that the kernel of an invariant
projection is an invariant complement; the backward direction is
`exists_isotypicalProjection_of_stable_complement`. -/
theorem exists_isotypicalProjection_iff_stable_complement
    (hecke : BoundaryHecke n D.chi) :
    (∃ p : Module.End ℂ (BoundaryCoordinates n D.chi), IsIsotypicalProjection D hecke p) ↔
      (∀ t, ∀ x ∈ associatePair D, pairHecke D hecke t x ∈ associatePair D) ∧
      (∃ S' : Submodule ℂ (BoundaryCoordinates n D.chi),
        IsCompl (associatePair D) S' ∧
        ∀ t, ∀ x ∈ S', pairHecke D hecke t x ∈ S') := by
  constructor
  · rintro ⟨p, hp⟩
    obtain ⟨S', hcompl, hstab⟩ :=
      StableComplement.exists_stable_complement_of_invariant_projection
        (associatePair D)
        {A : Module.End ℂ (BoundaryCoordinates n D.chi) |
          ∃ t : HeckeCorrespondence, A = pairHecke D hecke t} p
        hp.1 hp.2.1 (fun A hA => by
          obtain ⟨t, rfl⟩ := hA
          exact hp.2.2 t)
    exact ⟨fun t => Obstruction.projector_forces_invariance hp t, S', hcompl,
      fun t x hx => hstab (pairHecke D hecke t) ⟨t, rfl⟩ x hx⟩
  · rintro ⟨hS, hS'⟩
    exact exists_isotypicalProjection_of_stable_complement hecke hS hS'

/-- **Existence from source closure + a Hecke-stable complement.**  If the
finite-coset translate preserves source cocycles for every Hecke correspondence
(so the associate pair is Hecke-stable, by
`HeckeStability.associatePair_hecke_stable`) and the associate pair has a
Hecke-stable complement, then an associate-pair projection exists.  This removes
the raw Hecke-stability hypothesis in favour of the source-closure property. -/
theorem exists_isotypicalProjection_of_source_closure
    (hecke : BoundaryHecke n D.chi) (hhecke : ActualBoundaryHecke n D.chi hecke)
    (hclosed : ∀ t side c, IsSourceCocycle D side c →
      IsSourceCocycle D side (HeckeInvariance.translateSource D t c))
    (hcompl : ∃ S' : Submodule ℂ (BoundaryCoordinates n D.chi),
      IsCompl (associatePair D) S' ∧
      ∀ t, ∀ x ∈ S', pairHecke D hecke t x ∈ S') :
    ∃ p : Module.End ℂ (BoundaryCoordinates n D.chi), IsIsotypicalProjection D hecke p :=
  exists_isotypicalProjection_of_stable_complement hecke
    (fun t => HeckeStability.associatePair_hecke_stable t hecke hhecke (hclosed t)) hcompl

end TernaryPeriodPolynomials.HeckeTranslate.AssociatePairExistence

end
