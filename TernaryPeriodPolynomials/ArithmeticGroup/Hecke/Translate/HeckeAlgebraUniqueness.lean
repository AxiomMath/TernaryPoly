/-
  Why the uniqueness clause of `cuspidal_associate_projector` is *free* once the
  projector is constructed inside the Hecke algebra.

  The sibling problem `associate_projector_away_three_algebra` asks for the
  associate-pair projector as an element of the algebra generated by the
  away-from-three Hecke operators.  If such a `p` is produced, then every other
  candidate `p'` commutes with `p` by definition of
  `IsIsotypicalProjection` (it commutes with every `pairHecke`), and the two
  range/fixing clauses then force `p' = p`.  This file records that abstract
  argument; it is the reason the target reduces to the *construction*
  of the projector (Harder--Raghuram associate-pair splitting) rather than to an
  additional multiplicity-one input.
-/
module

public import TernaryPeriodPolynomials.ArithmeticCohomology.Defs

@[expose] public section


open GeneralEisenstein
open Homogeneous Adelic

noncomputable section

namespace TernaryPeriodPolynomials.HeckeTranslate.HeckeAlgebraUniqueness

variable {V : Type} [AddCommGroup V] [Module ℂ V]

/-- **Uniqueness inside a commutant.**  If `p` belongs to a family `H` (here: the
Hecke algebra) and `p'` commutes with every member of `H`, then the two
range/fixing clauses force `p' = p`. -/
theorem unique_of_mem_commutant
    (H : Set (Module.End ℂ V)) (p p' : Module.End ℂ V)
    (hp_mem : p ∈ H)
    (hp'_comm : ∀ A ∈ H, p'.comp A = A.comp p')
    (hp_range : LinearMap.range p = LinearMap.range p')
    (hp_fix : ∀ x ∈ LinearMap.range p, p x = x)
    (hp'_fix : ∀ x ∈ LinearMap.range p', p' x = x) :
    p' = p := by
  have hcomm : p'.comp p = p.comp p' := hp'_comm p hp_mem
  have h1 : p.comp p' = p' := by
    apply LinearMap.ext
    intro x
    show p (p' x) = p' x
    exact hp_fix (p' x) (by rw [hp_range]; exact LinearMap.mem_range_self p' x)
  have h2 : p'.comp p = p := by
    apply LinearMap.ext
    intro x
    show p' (p x) = p x
    exact hp'_fix (p x) (by rw [← hp_range]; exact LinearMap.mem_range_self p x)
  calc p' = p.comp p' := h1.symm
    _ = p'.comp p := hcomm.symm
    _ = p := h2

/-- **Commuting with the algebra generated by a set.**  If `p'` commutes with
every element of a set `S`, then `p'` commutes with every element of the
subalgebra `Algebra.adjoin ℂ S`.  (Uses the centralizer double-centralizer
lemma `Algebra.adjoin_le_centralizer_centralizer`.) -/
theorem commute_of_mem_adjoin {V : Type*} [AddCommGroup V] [Module ℂ V]
    (S : Set (Module.End ℂ V)) (p' : Module.End ℂ V)
    (h : ∀ A ∈ S, A * p' = p' * A) :
    ∀ p ∈ Algebra.adjoin ℂ S, p'.comp p = p.comp p' := by
  intro p hp
  have hmem : p' ∈ Subalgebra.centralizer ℂ S := by
    rw [Subalgebra.mem_centralizer_iff]
    exact h
  have hmem2 : p ∈ Subalgebra.centralizer ℂ ↑(Subalgebra.centralizer ℂ S) :=
    (Algebra.adjoin_le_centralizer_centralizer ℂ S) hp
  rw [Subalgebra.mem_centralizer_iff] at hmem2
  simpa only [Module.End.mul_eq_comp] using hmem2 p' hmem

variable {n : ℕ} {D : InducingData n}
variable {T : (side : Side) → HeckeCorrespondence → Module.End ℂ (StratumH2 n D.chi side)}

/-- Two solutions of `IsIsotypicalProjection` that happen to commute are equal.
This is the exact mechanism by which the sibling construction
`associate_projector_away_three_algebra` (an associate-pair projector built from
Hecke operators) yields the uniqueness clause of `cuspidal_associate_projector`:
any genuine Hecke-algebra projector commutes with every candidate, so uniqueness
is automatic and the target reduces to the construction of the projector. -/
theorem isotypical_unique_of_commuting_projector
    {p p' : Module.End ℂ (BoundaryCoordinates n D.chi)}
    (hp : IsIsotypicalProjection D T p)
    (hp' : IsIsotypicalProjection D T p')
    (hcomm : p.comp p' = p'.comp p) :
    p' = p := by
  have h1 : p.comp p' = p' := by
    apply LinearMap.ext
    intro x
    show p (p' x) = p' x
    exact hp.2.1 (p' x) (by rw [← hp'.1]; exact LinearMap.mem_range_self p' x)
  have h2 : p'.comp p = p := by
    apply LinearMap.ext
    intro x
    show p' (p x) = p x
    exact hp'.2.1 (p x) (by rw [← hp.1]; exact LinearMap.mem_range_self p x)
  calc p' = p.comp p' := h1.symm
    _ = p'.comp p := hcomm
    _ = p := h2

/-- **Reduction of the uniqueness clause to a commuting projector.**  The
uniqueness conclusion holds for some solution iff there is a
solution that commutes with *every* solution.  A projector built inside the
Hecke algebra has this property (it commutes with everything), while an
arbitrary retraction need not.  This is the precise sense in which the target
`cuspidal_associate_projector` reduces to the sibling construction
`associate_projector_away_three_algebra`. -/
theorem isotypical_unique_iff_exists_commuting_projector :
    (∃ p : Module.End ℂ (BoundaryCoordinates n D.chi),
        IsIsotypicalProjection D T p ∧
        ∀ p', IsIsotypicalProjection D T p' → p' = p) ↔
      (∃ p : Module.End ℂ (BoundaryCoordinates n D.chi),
        IsIsotypicalProjection D T p ∧
        ∀ p', IsIsotypicalProjection D T p' → p.comp p' = p'.comp p) := by
  constructor
  · rintro ⟨p, hp, huniq⟩
    exact ⟨p, hp, fun p' hp' => by rw [huniq p' hp']⟩
  · rintro ⟨p, hp, hcomm⟩
    exact ⟨p, hp, fun p' hp' =>
      isotypical_unique_of_commuting_projector hp hp' (hcomm p' hp')⟩

/-- **Reduction to the Hecke algebra.**  If the associate-pair projector `p` lies
in the algebra generated by the Hecke operators `pairHecke D T t`, then it is the
unique solution of `IsIsotypicalProjection`.  This is the precise sense in which
the target reduces to constructing the projector inside the Hecke algebra (the
sibling problem `associate_projector_away_three_algebra`). -/
theorem isotypical_unique_of_mem_adjoin
    {p : Module.End ℂ (BoundaryCoordinates n D.chi)}
    (hp : IsIsotypicalProjection D T p)
    (hpmem : p ∈ Algebra.adjoin ℂ
      (Set.range (fun t : HeckeCorrespondence => pairHecke D T t))) :
    ∀ p', IsIsotypicalProjection D T p' → p' = p := by
  intro p' hp'
  refine isotypical_unique_of_commuting_projector hp hp' ?_
  have hcomm : p'.comp p = p.comp p' :=
    commute_of_mem_adjoin
      (Set.range (fun t : HeckeCorrespondence => pairHecke D T t)) p'
      (fun A hA => by
        obtain ⟨t, rfl⟩ := hA
        simpa only [Module.End.mul_eq_comp] using (hp'.2.2 t).symm) p hpmem
  exact hcomm.symm

end TernaryPeriodPolynomials.HeckeTranslate.HeckeAlgebraUniqueness

end
