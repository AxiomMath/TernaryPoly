module

public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Eigen.SummandScalar
public import TernaryPeriodPolynomials.ArithmeticGroup.Hecke.Eigen.LineTransfer
public import TernaryPeriodPolynomials.ArithmeticCohomology.SpectralSeparation.Dichotomy

@[expose] public section


/-!
# Line summand scalars and the reduction of `SingleCharacter` to equal plane/line scalars

* `line_summand_scalar`: every away-from-three Hecke operator acts on the whole line boundary
  summand by one scalar (line analogue of `plane_summand_scalar`).
* `singleCharacter_of_common_scalar`: if every `AwayThree` pair Hecke operator acts on the
  associate pair by a single scalar, then the away-three Hecke algebra has a single
  (honest, not only generalized) eigencharacter on the associate pair.
* `common_scalar_of_eq`: the plane and line scalars give such a common scalar as soon as they agree
  whenever both summands are nonzero.

The input for `SingleCharacter` is therefore exactly the equality of the plane and line
eigenvalues of each away-from-three correspondence (the Satake/associate comparison), which is
**not** proved here.

Original work (AxiomDeep, Claude Opus 5.5).
-/

noncomputable section

open GeneralEisenstein GeneralEisenstein.Adelic Matrix

namespace TernaryPeriodPolynomials.HeckeEigen

section Generic

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- Elements of the algebra generated by operators acting by scalars on `A` act by scalars on
`A`. -/
private theorem adjoin_scalar_on (S : Set (Module.End ℂ V)) (A : Submodule ℂ V)
    (hS : ∀ f ∈ S, ∃ μ : ℂ, ∀ y ∈ A, f y = μ • y) :
    ∀ f ∈ Algebra.adjoin ℂ S, ∃ μ : ℂ, ∀ y ∈ A, f y = μ • y := by
  intro f hf
  induction hf using Algebra.adjoin_induction with
  | mem x hx => exact hS x hx
  | algebraMap c =>
    exact ⟨c, fun y _ => by rw [Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply,
      Module.End.one_apply]⟩
  | add f g _ _ hf hg =>
    obtain ⟨μ, hμ⟩ := hf
    obtain ⟨ν, hν⟩ := hg
    exact ⟨μ + ν, fun y hy => by rw [LinearMap.add_apply, hμ y hy, hν y hy, add_smul]⟩
  | mul f g _ _ hf hg =>
    obtain ⟨μ, hμ⟩ := hf
    obtain ⟨ν, hν⟩ := hg
    exact ⟨μ * ν, fun y hy => by
      rw [Module.End.mul_apply, hν y hy, map_smul, hμ y hy, smul_smul, mul_comm]⟩

/-- A subalgebra acting by scalars on `A` has a single eigencharacter on `A`. -/
private theorem singleCharacter_of_scalar_on (𝒜 : Subalgebra ℂ (Module.End ℂ V))
    (A : Submodule ℂ V) (h : ∀ f ∈ 𝒜, ∃ μ : ℂ, ∀ y ∈ A, f y = μ • y) :
    SpectralSeparation.SingleCharacter 𝒜 A := by
  intro a ha w hw _ _ f hf
  obtain ⟨μ, hμ⟩ := h f hf
  refine ⟨μ, ⟨1, ?_⟩, ⟨1, ?_⟩⟩
  · rw [pow_one]
    show f a - μ • a = 0
    rw [hμ a ha, sub_self]
  · rw [pow_one]
    show f w - μ • w = 0
    rw [hμ w hw, sub_self]

/-- A product of two operators acting by scalars `μP`, `μL` on two subspaces acts by one
scalar on the product subspace provided the scalars agree when both subspaces are nonzero. -/
private theorem prod_common_scalar {P Q : Type*} [AddCommGroup P] [Module ℂ P]
    [AddCommGroup Q] [Module ℂ Q] (SP : Submodule ℂ P) (SQ : Submodule ℂ Q)
    (f : Module.End ℂ P) (g : Module.End ℂ Q) (μP μL : ℂ)
    (hP : ∀ a ∈ SP, f a = μP • a) (hL : ∀ b ∈ SQ, g b = μL • b)
    (heq : SP ≠ ⊥ → SQ ≠ ⊥ → μP = μL) :
    ∃ μ : ℂ, ∀ y ∈ SP.prod SQ, f.prodMap g y = μ • y := by
  by_cases hp : SP = ⊥
  · refine ⟨μL, fun y hy => ?_⟩
    rw [Submodule.mem_prod] at hy
    have h1 : y.1 = 0 := by rw [hp] at hy; exact (Submodule.mem_bot ℂ).mp hy.1
    apply Prod.ext
    · show f y.1 = (μL • y).1
      rw [h1, map_zero, Prod.smul_fst, h1, smul_zero]
    · exact hL y.2 hy.2
  by_cases hl : SQ = ⊥
  · refine ⟨μP, fun y hy => ?_⟩
    rw [Submodule.mem_prod] at hy
    have h2 : y.2 = 0 := by rw [hl] at hy; exact (Submodule.mem_bot ℂ).mp hy.2
    apply Prod.ext
    · exact hP y.1 hy.1
    · show g y.2 = (μP • y).2
      rw [h2, map_zero, Prod.smul_snd, h2, smul_zero]
  · have he := heq hp hl
    refine ⟨μP, fun y hy => ?_⟩
    rw [Submodule.mem_prod] at hy
    apply Prod.ext
    · exact hP y.1 hy.1
    · show g y.2 = (μP • y).2
      rw [Prod.smul_snd, he]
      exact hL y.2 hy.2

end Generic

variable {n : ℕ}

/-- **Away-from-three Hecke operators act by one scalar on the whole line summand.** -/
theorem line_summand_scalar (D : InducingData n) (t : HeckeCorrespondence) (ht : AwayThree t) :
    ∃ μ : ℂ, ∀ hecke : BoundaryHecke n D.chi, ActualBoundaryHecke n D.chi hecke →
      ∀ a ∈ boundarySummand D .line, hecke .line t a = μ • a := by
  obtain ⟨μ, hμ⟩ := line_hecke_scalar D t ht
  exact ⟨μ, fun hecke hhecke =>
    summand_scalar_of_source D .line t hecke hhecke μ (source_scalar_of_function t μ hμ)⟩

/-- Operators of the away-three algebra act by scalars on the associate pair once its generators
do. -/
theorem algebra_scalar_of_common_scalar (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (hcommon : ∀ t, AwayThree t → ∃ μ : ℂ, ∀ y ∈ associatePair D, pairHecke D hecke t y = μ • y) :
    ∀ f ∈ awayThreeHeckeAlgebra D hecke, ∃ μ : ℂ, ∀ y ∈ associatePair D, f y = μ • y :=
  adjoin_scalar_on _ (associatePair D) (by
    rintro f ⟨t, ht, rfl⟩
    exact hcommon t ht)

/-- **`SingleCharacter` from a common scalar of every away-three pair Hecke operator.** -/
theorem singleCharacter_of_common_scalar (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (hcommon : ∀ t, AwayThree t → ∃ μ : ℂ, ∀ y ∈ associatePair D, pairHecke D hecke t y = μ • y) :
    SpectralSeparation.SingleCharacter (awayThreeHeckeAlgebra D hecke) (associatePair D) :=
  singleCharacter_of_scalar_on _ _ (algebra_scalar_of_common_scalar D hecke hcommon)

/-- A common scalar on the associate pair from equal plane and line scalars. -/
theorem common_scalar_of_eq (D : InducingData n) (hecke : BoundaryHecke n D.chi)
    (t : HeckeCorrespondence) (μP μL : ℂ)
    (hP : ∀ a ∈ boundarySummand D .plane, hecke .plane t a = μP • a)
    (hL : ∀ b ∈ boundarySummand D .line, hecke .line t b = μL • b)
    (heq : boundarySummand D .plane ≠ ⊥ → boundarySummand D .line ≠ ⊥ → μP = μL) :
    ∃ μ : ℂ, ∀ y ∈ associatePair D, pairHecke D hecke t y = μ • y :=
  prod_common_scalar (boundarySummand D .plane) (boundarySummand D .line)
    (hecke .plane t) (hecke .line t) μP μL hP hL heq

end TernaryPeriodPolynomials.HeckeEigen
