module

public import TernaryPeriodPolynomials.ArithmeticGroup.GL2Free.Matrices
public import TernaryPeriodPolynomials.ArithmeticGroup.GL2Free.Euclidean

@[expose] public section

open Matrix
noncomputable section
namespace TernaryPoly.IntegralGL2Free
open RelativeStabilizerParameters

/-- Euclidean size of the first column. -/
def height (g : GL2) : ℕ := (g.val 0 0).natAbs+(g.val 1 0).natAbs

lemma upper_height_lt (g : GL2) (t : ℤ)
    (h : |g.val 0 0+2*t*g.val 1 0| < |g.val 0 0|) : height (root 0 t*g)<height g := by
  unfold height
  rw [upper_mul_entries]
  simp only [Matrix.cons_val_zero,Matrix.cons_val_one]
  apply Nat.add_lt_add_right
  have h' : ((g.val 0 0+2*t*g.val 1 0).natAbs : ℤ)<(g.val 0 0).natAbs := by
    simpa only [Int.natCast_natAbs] using h
  exact_mod_cast h'

lemma lower_height_lt (g : GL2) (t : ℤ)
    (h : |g.val 1 0+2*t*g.val 0 0| < |g.val 1 0|) : height (root 1 t*g)<height g := by
  unfold height
  rw [lower_mul_entries]
  simp only [Matrix.cons_val_zero,Matrix.cons_val_one]
  apply Nat.add_lt_add_left
  have h' : ((g.val 1 0+2*t*g.val 0 0).natAbs : ℤ)<(g.val 1 0).natAbs := by
    simpa only [Int.natCast_natAbs] using h
  exact_mod_cast h'

lemma good_mem_generated_of_lower_zero (g : GL2) (hg : Good g) (hc : g.val 1 0=0) :
    g ∈ generated := by
  rcases hg with ⟨hd,ha,_,hb,_⟩
  rw [Matrix.det_fin_two,hc,mul_zero,sub_zero] at hd
  have hau : IsUnit (g.val 0 0) := isUnit_iff_dvd_one.mpr ⟨g.val 1 1,hd.symm⟩
  have ha1 : g.val 0 0=1 := by
    rcases Int.isUnit_iff.mp hau with h | h
    · exact h
    · omega
  have hd1 : g.val 1 1=1 := by simpa only [ha1,one_mul] using hd
  obtain ⟨b,hb⟩ := Int.dvd_of_emod_eq_zero hb
  have he : g=root 0 b := by
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;> simp [root,rootMatrix,ha1,hd1,hb,hc]
  rw [he]
  exact root_mem_generated 0 b

/-- Every congruence-shaped matrix is generated by the two even integral roots. -/
theorem good_mem_generated (g : GL2) (hg : Good g) : g ∈ generated := by
  have haux : ∀ n, ∀ g : GL2, height g=n → Good g → g ∈ generated := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro g he hg
      by_cases hc : g.val 1 0=0
      · exact good_mem_generated_of_lower_zero g hg hc
      have ha : g.val 0 0≠0 := by have h := hg.2.1; omega
      by_cases hsmall : |g.val 1 0| < |g.val 0 0|
      · have hpar : g.val 0 0%2≠g.val 1 0%2 := by
          have h₁ := hg.2.1; have h₂ := hg.2.2.2.2; omega
        obtain ⟨k,hk⟩ := even_reduction (g.val 0 0) (g.val 1 0) hc hpar
        have hlt : height (root 0 k*g)<n := by
          rw [← he]
          exact upper_height_lt g k (hk.trans hsmall)
        have hg' := ih _ hlt (root 0 k*g) rfl (hg.upper k)
        have h := generated.mul_mem (generated.inv_mem (root_mem_generated 0 k)) hg'
        simpa only [inv_mul_cancel_left] using h
      · have hpar : g.val 1 0%2≠g.val 0 0%2 := by
          have h₁ := hg.2.1; have h₂ := hg.2.2.2.2; omega
        obtain ⟨k,hk⟩ := even_reduction (g.val 1 0) (g.val 0 0) ha hpar
        have hlt : height (root 1 k*g)<n := by
          rw [← he]
          exact lower_height_lt g k (hk.trans_le (le_of_not_gt hsmall))
        have hg' := ih _ hlt (root 1 k*g) rfl (hg.lower k)
        have h := generated.mul_mem (generated.inv_mem (root_mem_generated 1 k)) hg'
        simpa only [inv_mul_cancel_left] using h
  exact haux (height g) g rfl hg

end TernaryPoly.IntegralGL2Free
