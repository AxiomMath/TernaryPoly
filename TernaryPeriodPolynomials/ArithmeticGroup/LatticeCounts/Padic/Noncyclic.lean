module

public import TernaryPeriodPolynomials.ArithmeticGroup.LatticeCounts.Padic.Dictionary

@[expose] public section


/-!
# Noncyclic ℤ_p-lattices in ℤ_p²: obligation O5

Formalized by Claude Haiku 5.5.
Paper: Appendix C,
(the noncyclic shape of the lattices `Λ`).

Statement proved (`not_isAddCyclic_iff`): for a `ℤ_p`-submodule `Λ ⊆ ℤ_p²` of index `p^r`,
the quotient `ℤ_p² ⧸ Λ` is NOT cyclic if and only if `Λ ⊆ pℤ_p²`.

Proof sketch. If `Λ ⊆ pℤ_p²` and the quotient were generated by `[(a,b)]`, then `(1,0)` and
`(0,1)` are integer multiples of `(a,b)` modulo `Λ`, and the resulting divisibilities give
`p ∣ 1`. Conversely, if some `v ∈ Λ` has a unit coordinate, then `Λ` contains `(1,c)` (or `(c,1)`)
for some `c`, and `[(0,1)]` (resp. `[(1,0)]`) generates the quotient, using the `ℤ_p`-stability of
`Λ` and `p^r ℤ_p² ⊆ Λ`.
-/

open PadicInt

namespace TernaryPeriodPolynomials.Argument.LatticeCounts.Padic

variable {p : ℕ} [hp : Fact p.Prime]

/-- A `ℤ_p`-coordinate not divisible by `p` is a unit. -/
theorem isUnit_of_not_dvd {x : ℤ_[p]} (h : ¬ (p : ℤ_[p]) ∣ x) : IsUnit x := by
  rw [PadicInt.isUnit_iff]
  have h1 : ¬ ‖x‖ < 1 := fun hx => h ((PadicInt.norm_lt_one_iff_dvd x).mp hx)
  exact le_antisymm (PadicInt.norm_le_one x) (not_lt.mp h1)

/-- `p` does not divide `1` in `ℤ_p`. -/
theorem not_dvd_one_padic : ¬ (p : ℤ_[p]) ∣ 1 := by
  intro h
  have h1 := (PadicInt.norm_lt_one_iff_dvd (1 : ℤ_[p])).mpr h
  simp at h1

/-- If `Λ ⊆ pℤ_p²` then `ℤ_p²/Λ` is not cyclic. Only additivity of `Λ` is used. -/
theorem not_isAddCyclic_of_le {Λ : AddSubgroup (ℤ_[p] × ℤ_[p])}
    (hdiv : ∀ v ∈ Λ, (p : ℤ_[p]) ∣ v.1 ∧ (p : ℤ_[p]) ∣ v.2) :
    ¬ IsAddCyclic ((ℤ_[p] × ℤ_[p]) ⧸ Λ) := by
  intro hc
  obtain ⟨g, hg⟩ := hc.exists_zsmul_surjective
  obtain ⟨⟨a, b⟩, rfl⟩ := QuotientAddGroup.mk_surjective g
  obtain ⟨n, hn⟩ := hg (QuotientAddGroup.mk ((1 : ℤ_[p]), (0 : ℤ_[p])))
  obtain ⟨m, hm⟩ := hg (QuotientAddGroup.mk ((0 : ℤ_[p]), (1 : ℤ_[p])))
  have hn' : -(n • ((a, b) : ℤ_[p] × ℤ_[p])) + ((1 : ℤ_[p]), (0 : ℤ_[p])) ∈ Λ :=
    QuotientAddGroup.eq.mp (by rw [QuotientAddGroup.mk_zsmul]; exact hn)
  have hm' : -(m • ((a, b) : ℤ_[p] × ℤ_[p])) + ((0 : ℤ_[p]), (1 : ℤ_[p])) ∈ Λ :=
    QuotientAddGroup.eq.mp (by rw [QuotientAddGroup.mk_zsmul]; exact hm)
  obtain ⟨n1, n2⟩ := hdiv _ hn'
  obtain ⟨m1, m2⟩ := hdiv _ hm'
  have h1 : (p : ℤ_[p]) ∣ -((n : ℤ_[p]) * a) + 1 := by simpa using n1
  have h4 : (p : ℤ_[p]) ∣ -((m : ℤ_[p]) * b) + 1 := by simpa using m2
  have h2 : (p : ℤ_[p]) ∣ (n : ℤ_[p]) * b := by simpa using n2
  have key : (p : ℤ_[p]) ∣ 1 := by
    have e : (1 : ℤ_[p]) = (-((n : ℤ_[p]) * a) + 1) + (n : ℤ_[p]) * a * (-((m : ℤ_[p]) * b) + 1)
        + (n : ℤ_[p]) * b * ((m : ℤ_[p]) * a) := by ring
    rw [e]
    exact dvd_add (dvd_add h1 (h4.mul_left _)) (h2.mul_right _)
  exact not_dvd_one_padic key

/-- If `Λ` contains `(1,c)`, the quotient is cyclic, generated by `[(0,1)]`. -/
theorem isAddCyclic_of_mem_unit_first {r : ℕ} {Λ : Submodule ℤ_[p] (ℤ_[p] × ℤ_[p])}
    (hΛ : Λ.toAddSubgroup.index = p ^ r) {c : ℤ_[p]} (hw : ((1 : ℤ_[p]), c) ∈ Λ) :
    IsAddCyclic ((ℤ_[p] × ℤ_[p]) ⧸ Λ.toAddSubgroup) := by
  refine ⟨⟨QuotientAddGroup.mk ((0 : ℤ_[p]), (1 : ℤ_[p])), fun q => ?_⟩⟩
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
  obtain ⟨n, c', hz⟩ := approx_coord r (x.2 - x.1 * c)
  refine ⟨(n : ℤ), ?_⟩
  dsimp only
  rw [← QuotientAddGroup.mk_zsmul]
  apply QuotientAddGroup.eq.mpr
  have e : -((n : ℤ) • ((0 : ℤ_[p]), (1 : ℤ_[p]))) + x
      = x.1 • ((1 : ℤ_[p]), c) + ((p ^ r : ℕ) • ((0 : ℤ_[p]), c')) := by
    refine Prod.ext ?_ ?_
    · simp
    · simp
      linear_combination hz
  rw [e]
  exact Λ.toAddSubgroup.add_mem (Λ.smul_mem _ hw) (pow_smul_mem_of_index hΛ _)

/-- If `Λ` contains `(c,1)`, the quotient is cyclic, generated by `[(1,0)]`. -/
theorem isAddCyclic_of_mem_unit_second {r : ℕ} {Λ : Submodule ℤ_[p] (ℤ_[p] × ℤ_[p])}
    (hΛ : Λ.toAddSubgroup.index = p ^ r) {c : ℤ_[p]} (hw : (c, (1 : ℤ_[p])) ∈ Λ) :
    IsAddCyclic ((ℤ_[p] × ℤ_[p]) ⧸ Λ.toAddSubgroup) := by
  refine ⟨⟨QuotientAddGroup.mk ((1 : ℤ_[p]), (0 : ℤ_[p])), fun q => ?_⟩⟩
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
  obtain ⟨n, c', hz⟩ := approx_coord r (x.1 - x.2 * c)
  refine ⟨(n : ℤ), ?_⟩
  dsimp only
  rw [← QuotientAddGroup.mk_zsmul]
  apply QuotientAddGroup.eq.mpr
  have e : -((n : ℤ) • ((1 : ℤ_[p]), (0 : ℤ_[p]))) + x
      = x.2 • (c, (1 : ℤ_[p])) + ((p ^ r : ℕ) • (c', (0 : ℤ_[p]))) := by
    refine Prod.ext ?_ ?_
    · simp
      linear_combination hz
    · simp
  rw [e]
  exact Λ.toAddSubgroup.add_mem (Λ.smul_mem _ hw) (pow_smul_mem_of_index hΛ _)

/-- **O5.** For a `ℤ_p`-submodule `Λ ⊆ ℤ_p²` of index `p^r`, the quotient `ℤ_p² ⧸ Λ` is not cyclic
if and only if `Λ ⊆ pℤ_p²`. -/
theorem not_isAddCyclic_iff {r : ℕ} {Λ : Submodule ℤ_[p] (ℤ_[p] × ℤ_[p])}
    (hΛ : Λ.toAddSubgroup.index = p ^ r) :
    ¬ IsAddCyclic ((ℤ_[p] × ℤ_[p]) ⧸ Λ.toAddSubgroup) ↔
      ∀ v ∈ Λ, (p : ℤ_[p]) ∣ v.1 ∧ (p : ℤ_[p]) ∣ v.2 := by
  constructor
  · intro hnc v hv
    by_contra hcon
    apply hnc
    by_cases h1 : (p : ℤ_[p]) ∣ v.1
    · have h2 : ¬ (p : ℤ_[p]) ∣ v.2 := fun h => hcon ⟨h1, h⟩
      obtain ⟨u, hu⟩ := isUnit_of_not_dvd h2
      have hw : ((↑u⁻¹ : ℤ_[p]) * v.1, (1 : ℤ_[p])) ∈ Λ := by
        have e : ((↑u⁻¹ : ℤ_[p]) * v.1, (1 : ℤ_[p])) = (↑u⁻¹ : ℤ_[p]) • v :=
          Prod.ext (by simp) (by simp [← hu])
        rw [e]
        exact Λ.smul_mem _ hv
      exact isAddCyclic_of_mem_unit_second hΛ hw
    · obtain ⟨u, hu⟩ := isUnit_of_not_dvd h1
      have hw : ((1 : ℤ_[p]), (↑u⁻¹ : ℤ_[p]) * v.2) ∈ Λ := by
        have e : ((1 : ℤ_[p]), (↑u⁻¹ : ℤ_[p]) * v.2) = (↑u⁻¹ : ℤ_[p]) • v :=
          Prod.ext (by simp [← hu]) (by simp)
        rw [e]
        exact Λ.smul_mem _ hv
      exact isAddCyclic_of_mem_unit_first hΛ hw
  · intro hdiv hc
    exact not_isAddCyclic_of_le (Λ := Λ.toAddSubgroup) (fun v hv => hdiv v hv) hc

end TernaryPeriodPolynomials.Argument.LatticeCounts.Padic
