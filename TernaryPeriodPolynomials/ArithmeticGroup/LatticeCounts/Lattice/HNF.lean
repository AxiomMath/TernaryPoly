module

public import Mathlib
public import TernaryPeriodPolynomials.ArithmeticGroup.LatticeCounts.HermiteCount

@[expose] public section


/-!
# Finite-index sublattices of `ℤ²` and Hermite triples

Formalized by Claude Haiku 5.5.
Paper: Appendix C.

The row lattice `latZ a b d = ⟨(a, b), (0, d)⟩ ⊆ ℤ²` and its Hermite triple form. We prove that
`t ↦ latOf t` is a bijection from the Hermite triples `hnfData n` onto the subgroups of `ℤ²` of index `n`.
-/

namespace TernaryPeriodPolynomials.Argument.LatticeCounts

open Finset

/-- The subgroup of `ℤ²` generated by `(a, b)` and `(0, d)`. -/
def latZ (a b d : ℤ) : AddSubgroup (ℤ × ℤ) :=
  AddSubgroup.closure {((a, b) : ℤ × ℤ), ((0, d) : ℤ × ℤ)}

/-- The sublattice attached to a Hermite triple. -/
def latOf (t : ℕ × ℕ × ℕ) : AddSubgroup (ℤ × ℤ) :=
  latZ (t.1 : ℤ) (t.2.1 : ℤ) (t.2.2 : ℤ)

theorem mem_latZ {a b d : ℤ} (z : ℤ × ℤ) :
    z ∈ latZ a b d ↔ ∃ m j : ℤ, z.1 = m * a ∧ z.2 = m * b + j * d := by
  unfold latZ
  rw [AddSubgroup.mem_closure_pair]
  constructor
  · rintro ⟨m, j, h⟩
    refine ⟨m, j, ?_, ?_⟩
    · rw [← h]; simp
    · rw [← h]; simp
  · rintro ⟨m, j, h1, h2⟩
    refine ⟨m, j, ?_⟩
    ext
    · simp [h1]
    · simp [h2]

/-- Cosets of `latZ a b d` with `a, d > 0` are indexed by `[0,a) × [0,d)`. -/
theorem card_quot_latZ {a d : ℕ} (ha : 0 < a) (hd : 0 < d) (b : ℤ) :
    Nat.card ((ℤ × ℤ) ⧸ latZ (a : ℤ) b (d : ℤ)) = a * d := by
  have ha' : (0 : ℤ) < a := by exact_mod_cast ha
  have hd' : (0 : ℤ) < d := by exact_mod_cast hd
  let F : Fin a × Fin d → (ℤ × ℤ) ⧸ latZ (a : ℤ) b (d : ℤ) := fun p =>
    QuotientAddGroup.mk (((p.1 : ℕ) : ℤ), ((p.2 : ℕ) : ℤ))
  have hinj : Function.Injective F := by
    rintro ⟨i, j⟩ ⟨i', j'⟩ h
    obtain ⟨m, k, h1, h2⟩ := (mem_latZ _).mp (QuotientAddGroup.eq.mp h)
    have h1' : -((i : ℕ) : ℤ) + ((i' : ℕ) : ℤ) = m * (a : ℤ) := h1
    have h2' : -((j : ℕ) : ℤ) + ((j' : ℕ) : ℤ) = m * b + k * (d : ℤ) := h2
    have hi := i.isLt
    have hi' := i'.isLt
    have hj := j.isLt
    have hj' := j'.isLt
    have e1 : ((i' : ℕ) : ℤ) - ((i : ℕ) : ℤ) = 0 := by
      apply Int.eq_zero_of_abs_lt_dvd (m := (a : ℤ))
      · exact ⟨m, by linarith⟩
      · rw [abs_lt]; constructor <;> omega
    have hm : m = 0 := by
      have : m * (a : ℤ) = 0 := by linarith
      exact (mul_eq_zero.mp this).resolve_right (ne_of_gt ha')
    subst hm
    have e2 : ((j' : ℕ) : ℤ) - ((j : ℕ) : ℤ) = 0 := by
      apply Int.eq_zero_of_abs_lt_dvd (m := (d : ℤ))
      · exact ⟨k, by linarith⟩
      · rw [abs_lt]; constructor <;> omega
    have hii : (i : ℕ) = (i' : ℕ) := by omega
    have hjj : (j : ℕ) = (j' : ℕ) := by omega
    rw [Fin.ext hii, Fin.ext hjj]
  have hsurj : Function.Surjective F := by
    intro z
    obtain ⟨⟨x, y⟩, rfl⟩ := QuotientAddGroup.mk_surjective z
    obtain ⟨q, r, hx, hr0, hra⟩ : ∃ q r : ℤ, x = (a : ℤ) * q + r ∧ 0 ≤ r ∧ r < (a : ℤ) :=
      ⟨x / (a : ℤ), x % (a : ℤ), by linarith [Int.emod_def x (a : ℤ)],
        Int.emod_nonneg _ (ne_of_gt ha'), Int.emod_lt_of_pos _ ha'⟩
    obtain ⟨s, r2, hy, hr20, hr2d⟩ : ∃ s r2 : ℤ, y - q * b = (d : ℤ) * s + r2 ∧ 0 ≤ r2 ∧ r2 < (d : ℤ) :=
      ⟨(y - q * b) / (d : ℤ), (y - q * b) % (d : ℤ),
        by linarith [Int.emod_def (y - q * b) (d : ℤ)],
        Int.emod_nonneg _ (ne_of_gt hd'), Int.emod_lt_of_pos _ hd'⟩
    refine ⟨(⟨r.toNat, by omega⟩, ⟨r2.toNat, by omega⟩), ?_⟩
    show (QuotientAddGroup.mk (((r.toNat : ℕ) : ℤ), ((r2.toNat : ℕ) : ℤ)) :
      (ℤ × ℤ) ⧸ latZ (a : ℤ) b (d : ℤ)) = QuotientAddGroup.mk (x, y)
    rw [Int.toNat_of_nonneg hr0, Int.toNat_of_nonneg hr20, QuotientAddGroup.eq, mem_latZ]
    refine ⟨q, s, ?_, ?_⟩
    · show -r + x = q * (a : ℤ)
      linarith
    · show -r2 + y = q * b + s * (d : ℤ)
      linarith
  rw [← Nat.card_eq_of_bijective F ⟨hinj, hsurj⟩]
  simp

theorem index_latZ {a d : ℕ} (ha : 0 < a) (hd : 0 < d) (b : ℤ) :
    (latZ (a : ℤ) b (d : ℤ)).index = a * d :=
  card_quot_latZ ha hd b

theorem index_latOf {t : ℕ × ℕ × ℕ} (ha : 0 < t.1) (hd : 0 < t.2.2) :
    (latOf t).index = t.1 * t.2.2 :=
  index_latZ ha hd _

/-- Two Hermite triples with the same lattice coincide. -/
theorem latOf_injOn {t t' : ℕ × ℕ × ℕ} (ht : 0 < t.1) (htb : t.2.1 < t.2.2)
    (ht' : 0 < t'.1) (htb' : t'.2.1 < t'.2.2) (h : latOf t = latOf t') : t = t' := by
  obtain ⟨a, b, d⟩ := t
  obtain ⟨a', b', d'⟩ := t'
  simp only [] at ht htb ht' htb' ⊢
  unfold latOf at h
  have ha' : (0 : ℤ) < a' := by exact_mod_cast ht'
  have ha : (0 : ℤ) < a := by exact_mod_cast ht
  have hd : (0 : ℤ) < d := by exact_mod_cast (lt_of_le_of_lt (Nat.zero_le _) htb)
  have hd' : (0 : ℤ) < d' := by exact_mod_cast (lt_of_le_of_lt (Nat.zero_le _) htb')
  -- the first coordinates agree
  have hab : ((a : ℤ), (b : ℤ)) ∈ latZ (a' : ℤ) (b' : ℤ) (d' : ℤ) := by
    rw [← h, mem_latZ]; exact ⟨1, 0, by simp, by simp⟩
  have hab' : ((a' : ℤ), (b' : ℤ)) ∈ latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
    rw [h, mem_latZ]; exact ⟨1, 0, by simp, by simp⟩
  rw [mem_latZ] at hab hab'
  obtain ⟨m, j, h1, h2⟩ := hab
  obtain ⟨m', j', h1', h2'⟩ := hab'
  have hdvd1 : a' ∣ a := Int.natCast_dvd_natCast.mp ⟨m, by simp only at h1; rw [h1]; ring⟩
  have hdvd2 : a ∣ a' := Int.natCast_dvd_natCast.mp ⟨m', by simp only at h1'; rw [h1']; ring⟩
  have ha_eq : a = a' := Nat.dvd_antisymm hdvd2 hdvd1
  subst ha_eq
  -- the last coordinates agree
  have hd1 : ((0 : ℤ), (d : ℤ)) ∈ latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
    rw [mem_latZ]; exact ⟨0, 1, by simp, by simp⟩
  have hd2 : ((0 : ℤ), (d' : ℤ)) ∈ latZ (a : ℤ) (b' : ℤ) (d' : ℤ) := by
    rw [mem_latZ]; exact ⟨0, 1, by simp, by simp⟩
  rw [h, mem_latZ] at hd1
  rw [← h, mem_latZ] at hd2
  obtain ⟨m1, k1, e1, e2⟩ := hd1
  obtain ⟨m2, k2, f1, f2⟩ := hd2
  have hm1 : m1 = 0 := by
    have : m1 * (a : ℤ) = 0 := by simp only at e1; linarith
    exact (mul_eq_zero.mp this).resolve_right (ne_of_gt ha)
  have hm2 : m2 = 0 := by
    have : m2 * (a : ℤ) = 0 := by simp only at f1; linarith
    exact (mul_eq_zero.mp this).resolve_right (ne_of_gt ha)
  subst hm1 hm2
  have hdd1 : (d' : ℤ) ∣ (d : ℤ) := ⟨k1, by simp only at e2; linarith⟩
  have hdd2 : (d : ℤ) ∣ (d' : ℤ) := ⟨k2, by simp only at f2; linarith⟩
  have hdd : d = d' := by
    have h3 : d' ∣ d := Int.natCast_dvd_natCast.mp hdd1
    have h4 : d ∣ d' := Int.natCast_dvd_natCast.mp hdd2
    exact Nat.dvd_antisymm h4 h3
  subst hdd
  -- the second coordinates agree
  have hab2 : ((a : ℤ), (b' : ℤ)) ∈ latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
    rw [h, mem_latZ]; exact ⟨1, 0, by simp, by simp⟩
  have hab1 : ((a : ℤ), (b : ℤ)) ∈ latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
    rw [mem_latZ]; exact ⟨1, 0, by simp, by simp⟩
  have h0 : ((0 : ℤ), (b : ℤ) - (b' : ℤ)) ∈ latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
    have := AddSubgroup.sub_mem (latZ (a : ℤ) (b : ℤ) (d : ℤ)) hab1 hab2
    convert this using 1
    ext <;> simp
  rw [mem_latZ] at h0
  obtain ⟨m3, j3, g1, g2⟩ := h0
  have hm3 : m3 = 0 := by
    have : m3 * (a : ℤ) = 0 := by simp only at g1; linarith
    exact (mul_eq_zero.mp this).resolve_right (ne_of_gt ha)
  subst hm3
  have hbb : (b : ℤ) - (b' : ℤ) = 0 := by
    apply Int.eq_zero_of_abs_lt_dvd (m := (d : ℤ))
    · exact ⟨j3, by simp only at g2; linarith⟩
    · rw [abs_lt]; constructor <;> omega
  have : b = b' := by omega
  subst this
  rfl


/-- Every subgroup of `ℤ²` of positive index is a row lattice `latZ a b d` with `a, d > 0` and `b < d`. -/
theorem exists_latZ_of_index {L : AddSubgroup (ℤ × ℤ)} (hL : 0 < L.index) :
    ∃ a b d : ℕ, 0 < a ∧ 0 < d ∧ b < d ∧ L = latZ (a : ℤ) (b : ℤ) (d : ℤ) := by
  classical
  have hpow : ∀ x : ℤ × ℤ, L.index • x ∈ L := fun x => AddSubgroup.nsmul_index_mem L x
  have hD : ∃ d : ℕ, 0 < d ∧ ((0 : ℤ), (d : ℤ)) ∈ L := by
    refine ⟨L.index, hL, ?_⟩
    have h := hpow ((0 : ℤ), (1 : ℤ))
    convert h using 1
    ext <;> simp
  have hA : ∃ a : ℕ, 0 < a ∧ ∃ b : ℤ, ((a : ℤ), b) ∈ L := by
    refine ⟨L.index, hL, 0, ?_⟩
    have h := hpow ((1 : ℤ), (0 : ℤ))
    convert h using 1
    ext <;> simp
  obtain ⟨d, hd, hdL, hd_min⟩ : ∃ d : ℕ, 0 < d ∧ ((0 : ℤ), (d : ℤ)) ∈ L ∧
      ∀ m : ℕ, 0 < m → ((0 : ℤ), (m : ℤ)) ∈ L → d ≤ m := by
    have hspec := Nat.find_spec hD
    exact ⟨Nat.find hD, hspec.1, hspec.2, fun m hm hmL => Nat.find_min' hD ⟨hm, hmL⟩⟩
  obtain ⟨a, ha, b0, hb0, ha_min⟩ : ∃ a : ℕ, 0 < a ∧ ∃ b0 : ℤ, ((a : ℤ), b0) ∈ L ∧
      ∀ m : ℕ, 0 < m → (∃ b : ℤ, ((m : ℤ), b) ∈ L) → a ≤ m := by
    have hspec := Nat.find_spec hA
    obtain ⟨b0, hb0⟩ := hspec.2
    exact ⟨Nat.find hA, hspec.1, b0, hb0, fun m hm hmL => Nat.find_min' hA ⟨hm, hmL⟩⟩
  have hd' : (0 : ℤ) < d := by exact_mod_cast hd
  have ha' : (0 : ℤ) < a := by exact_mod_cast ha
  have hdne : (d : ℤ) ≠ 0 := ne_of_gt hd'
  -- reduce the second coordinate modulo `d`
  obtain ⟨b, hbL, hb0', hbd⟩ : ∃ b : ℤ, ((a : ℤ), b) ∈ L ∧ 0 ≤ b ∧ b < (d : ℤ) := by
    refine ⟨b0 % (d : ℤ), ?_, Int.emod_nonneg _ hdne, Int.emod_lt_of_pos _ hd'⟩
    have h1 := L.sub_mem hb0 (L.zsmul_mem hdL (b0 / (d : ℤ)))
    have h2 : ((a : ℤ), b0) - (b0 / (d : ℤ)) • ((0 : ℤ), (d : ℤ)) = ((a : ℤ), b0 % (d : ℤ)) := by
      rw [Int.emod_def]
      ext <;> simp [mul_comm]
    rw [h2] at h1
    exact h1
  -- the first-coordinate and second-coordinate minimality statements
  have hfirst : ∀ w ∈ L, 0 < w.1 → w.1 < (a : ℤ) → False := by
    rintro ⟨u, v⟩ huv hu0 hua
    dsimp only at hu0 hua
    have := ha_min u.toNat (by omega) ⟨v, by rw [Int.toNat_of_nonneg hu0.le]; exact huv⟩
    omega
  have hcol : ∀ w ∈ L, w.1 = 0 → (d : ℤ) ∣ w.2 := by
    rintro ⟨u, v⟩ huv hu
    dsimp only at hu
    subst hu
    have hk := L.sub_mem huv (L.zsmul_mem hdL (v / (d : ℤ)))
    have hr : ((0 : ℤ), v) - (v / (d : ℤ)) • ((0 : ℤ), (d : ℤ)) = ((0 : ℤ), v % (d : ℤ)) := by
      rw [Int.emod_def]
      ext <;> simp [mul_comm]
    rw [hr] at hk
    have hr0 : v % (d : ℤ) = 0 := by
      rcases (Int.emod_nonneg v hdne).eq_or_lt with h | h
      · exact h.symm
      · exfalso
        have := hd_min (v % (d : ℤ)).toNat (by omega)
          (by rw [Int.toNat_of_nonneg (Int.emod_nonneg v hdne)]; exact hk)
        have := Int.emod_lt_of_pos v hd'
        omega
    exact Int.dvd_of_emod_eq_zero hr0
  -- the lattice equals `latZ a b d`
  refine ⟨a, b.toNat, d, ha, hd, ?_, ?_⟩
  · omega
  rw [Int.toNat_of_nonneg hb0']
  apply le_antisymm
  · rintro ⟨x, y⟩ hz
    rw [mem_latZ]
    obtain ⟨q, hq⟩ : ∃ q : ℤ, q = x / (a : ℤ) := ⟨_, rfl⟩
    have hwL : (x, y) - q • ((a : ℤ), b) ∈ L := L.sub_mem hz (L.zsmul_mem hbL q)
    have hw1 : x - q * (a : ℤ) = x % (a : ℤ) := by
      rw [Int.emod_def, hq]; ring
    have hwfst : ((x, y) - q • ((a : ℤ), b)).1 = x - q * (a : ℤ) := by
      simp
    have hr0 : ((x, y) - q • ((a : ℤ), b)).1 = 0 := by
      rw [hwfst]
      have h0 : 0 ≤ x - q * (a : ℤ) := by rw [hw1]; exact Int.emod_nonneg _ ha'.ne'
      have hlt : x - q * (a : ℤ) < (a : ℤ) := by rw [hw1]; exact Int.emod_lt_of_pos _ ha'
      rcases h0.eq_or_lt with h | h
      · exact h.symm
      · exact (hfirst _ hwL (by rw [hwfst]; exact h) (by rw [hwfst]; exact hlt)).elim
    obtain ⟨k, hk⟩ := hcol _ hwL hr0
    have e1 : x - q * (a : ℤ) = 0 := by rw [← hwfst]; exact hr0
    have e2 : y - q * b = (d : ℤ) * k := by
      have h := hk
      simp at h
      linarith
    refine ⟨q, k, ?_, ?_⟩
    · show x = q * (a : ℤ)
      linarith
    · show y = q * b + k * (d : ℤ)
      linarith
  · unfold latZ
    rw [AddSubgroup.closure_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact hbL
    · exact hdL

/-- Every subgroup of `ℤ²` of index `n > 0` is `latOf t` for a Hermite triple `t` of level `n`. -/
theorem exists_latOf_of_index {n : ℕ} (hn : 0 < n) {L : AddSubgroup (ℤ × ℤ)} (hL : L.index = n) :
    ∃ t ∈ hnfData n, latOf t = L := by
  obtain ⟨a, b, d, ha, hd, hbd, hLeq⟩ := exists_latZ_of_index (hL ▸ hn : 0 < L.index)
  have hprod : a * d = n := by
    rw [← index_latZ ha hd, ← hLeq, hL]
  refine ⟨(a, b, d), ?_, ?_⟩
  · rw [mem_hnfData hn]
    exact ⟨ha, hprod, hbd⟩
  · exact hLeq.symm

theorem latOf_index_of_mem {n : ℕ} (hn : 0 < n) {t : ℕ × ℕ × ℕ} (ht : t ∈ hnfData n) :
    (latOf t).index = n := by
  rw [mem_hnfData hn] at ht
  obtain ⟨h1, h2, h3⟩ := ht
  have hd : 0 < t.2.2 := Nat.pos_of_ne_zero (by intro h; rw [h, mul_zero] at h2; omega)
  rw [index_latOf h1 hd, h2]

/-- The Hermite triples of level `n` are in bijection with the subgroups of `ℤ²` of index `n`. -/
noncomputable def hnfEquiv {n : ℕ} (hn : 0 < n) :
    {t // t ∈ hnfData n} ≃ {L : AddSubgroup (ℤ × ℤ) // L.index = n} :=
  Equiv.ofBijective
    (fun t => ⟨latOf t.1, latOf_index_of_mem hn t.2⟩)
    (by
      constructor
      · rintro ⟨t, ht⟩ ⟨t', ht'⟩ h
        have h' : latOf t = latOf t' := congrArg Subtype.val h
        rw [mem_hnfData hn] at ht ht'
        exact Subtype.ext (latOf_injOn ht.1 ht.2.2 ht'.1 ht'.2.2 h')
      · rintro ⟨L, hL⟩
        obtain ⟨t, ht, hLt⟩ := exists_latOf_of_index hn hL
        exact ⟨⟨t, ht⟩, Subtype.ext hLt⟩)

/-- The number of subgroups of `ℤ²` of index `p^r` is `∑_{i ≤ r} p^i`. -/
theorem card_index_subgroups {p r : ℕ} [hp : Fact p.Prime] :
    Nat.card {L : AddSubgroup (ℤ × ℤ) // L.index = p ^ r} = ∑ i ∈ range (r + 1), p ^ i := by
  have hpos : 0 < p ^ r := pow_pos (Fact.out : p.Prime).pos r
  rw [← card_hnfData, ← Nat.card_eq_finsetCard]
  exact (Nat.card_congr (hnfEquiv hpos)).symm

end TernaryPeriodPolynomials.Argument.LatticeCounts
