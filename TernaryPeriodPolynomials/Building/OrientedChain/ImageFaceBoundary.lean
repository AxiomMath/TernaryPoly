module

public import TernaryPeriodPolynomials.Building.OrientedChain.ImageFaceProjection

@[expose] public section


noncomputable section
namespace TernaryPoly.OrientedImageFaceBoundary
open OrientedListChains OrientedImageFaceProjection
variable {V W : Type*}
local instance : DecidableEq W := Classical.decEq W

/-- Chains generated by simplices involving at most n distinct projected vertices. -/
def imageBounded (f : V → W) (n : ℕ) : Submodule ℚ (Chain V) :=
  Submodule.span ℚ {c | ∃ l : List V, (imageFace f l).card ≤ n ∧ simplex l = c}

theorem simplex_mem_imageBounded (f : V → W) (n : ℕ) (l : List V)
    (hl : (imageFace f l).card ≤ n) : simplex l ∈ imageBounded f n :=
  Submodule.subset_span ⟨l,hl,rfl⟩

theorem imageFace_sublist (f : V → W) {l m : List V} (h : m.Sublist l) :
    imageFace f m ⊆ imageFace f l := by
  intro w hw
  exact List.mem_toFinset.mpr ((h.map f).subset (List.mem_toFinset.mp hw))

/-- A simplex with too small or different base face cannot contribute to the chosen
maximal base face after taking a boundary. -/
theorem project_boundary_simplex_eq_zero (f : V → W) (s : Finset W) (l : List V)
    (hl : (imageFace f l).card ≤ s.card) (hne : imageFace f l ≠ s) :
    project f s (boundary (simplex l)) = 0 := by
  apply boundary_simplex_mem (LinearMap.ker (project f s)) l
  intro m hm _
  change project f s (simplex m) = 0
  have hn : imageFace f m ≠ s := by
    intro he
    have hs : s ⊆ imageFace f l := he ▸ imageFace_sublist f hm
    exact hne (Finset.eq_of_subset_of_card_le hs hl).symm
  rw [project_simplex,ite_eq_right hn]

/-- At maximal projected dimension, boundary coefficients separate by exact base face. -/
theorem project_boundary_project (f : V → W) (s : Finset W) {c : Chain V}
    (hc : c ∈ imageBounded f s.card) :
    project f s (boundary (project f s c)) = project f s (boundary c) := by
  classical
  induction hc using Submodule.span_induction with
  | mem c hc =>
    obtain ⟨l,hl,rfl⟩ := hc
    by_cases he : imageFace f l = s
    · rw [project_simplex,ite_eq_left he]
    · rw [project_simplex,ite_eq_right he,map_zero,map_zero,
        project_boundary_simplex_eq_zero f s l hl he]
  | zero => simp
  | add c d hc hd ihc ihd => simp only [map_add,ihc,ihd]
  | smul q c hc ih => simp only [map_smul,ih]

/-- A cycle with at most two projected vertices per simplex has zero cross-edge
boundary separately above every base edge, without asserting each block is a cycle. -/
theorem project_boundary_project_eq_zero (f : V → W) (s : Finset W) {c : Chain V}
    (hc : c ∈ imageBounded f s.card) (hd : boundary c = 0) :
    project f s (boundary (project f s c)) = 0 := by
  rw [project_boundary_project f s hc,hd,map_zero]

end TernaryPoly.OrientedImageFaceBoundary
