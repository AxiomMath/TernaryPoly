module

public import TernaryPeriodPolynomials.Building.OrientedChain.ImageFaceBoundary

@[expose] public section


noncomputable section
namespace TernaryPoly.OrientedImageFaceDecomposition
open OrientedListChains OrientedImageFaceProjection OrientedImageFaceBoundary
open OrientedBadFaceDecomposition
variable {V W : Type*}
local instance : DecidableEq W := Classical.decEq W

/-- Exact projected-face components are generated by simplices with that image cardinality. -/
theorem project_mem_imageBounded (f : V → W) (s : Finset W) (c : Chain V) :
    project f s c ∈ imageBounded f s.card := by
  classical
  refine Quotient.inductionOn' c (fun r => ?_)
  change project f s ((relations V).mkQ r) ∈ imageBounded f s.card
  rw [mkQ_expansion]
  simp only [map_sum,map_smul]
  apply Submodule.sum_mem
  intro l hl
  apply Submodule.smul_mem
  by_cases he : imageFace f l = s
  · rw [project_simplex,ite_eq_left he]
    exact simplex_mem_imageBounded f s.card l (by rw [he])
  · rw [project_simplex,ite_eq_right he]
    exact (imageBounded f s.card).zero_mem

theorem imageBounded_mono (f : V → W) {n m : ℕ} (h : n ≤ m) :
    imageBounded f n ≤ imageBounded f m := by
  apply Submodule.span_le.mpr
  rintro _ ⟨l,hl,rfl⟩
  exact simplex_mem_imageBounded f m l (hl.trans h)

/-- Above the supported image dimension, every exact base-face projection vanishes. -/
theorem project_eq_zero_of_card_lt (f : V → W) {n : ℕ} {c : Chain V}
    (hc : c ∈ imageBounded f n) (s : Finset W) (hs : n < s.card) : project f s c = 0 := by
  classical
  induction hc using Submodule.span_induction with
  | mem c hc =>
    obtain ⟨l,hl,rfl⟩ := hc
    have he : imageFace f l ≠ s := by
      intro he
      rw [he] at hl
      exact (Nat.not_le_of_gt hs) hl
    rw [project_simplex,ite_eq_right he]
  | zero => exact map_zero _
  | add c d hc hd ihc ihd => rw [map_add,ihc,ihd,add_zero]
  | smul q c hc ih => rw [map_smul,ih,smul_zero]

/-- Vanishing of every higher projected-face component is equivalent to support in
the lower image dimension, without a chosen oriented-simplex basis. -/
theorem mem_imageBounded_iff (f : V → W) (n : ℕ) (c : Chain V) :
    c ∈ imageBounded f n ↔ ∀ s : Finset W, n < s.card → project f s c = 0 := by
  classical
  constructor
  · intro hc s hs
    exact project_eq_zero_of_card_lt f hc s hs
  · intro h
    obtain ⟨S,he,_⟩ := exists_decomposition f c
    rw [← he]
    apply Submodule.sum_mem
    intro s hs
    by_cases hn : s.card ≤ n
    · exact imageBounded_mono f hn (project_mem_imageBounded f s c)
    · rw [h s (Nat.lt_of_not_ge hn)]
      exact (imageBounded f n).zero_mem

/-- Once the maximal image-face terms have been removed, the whole finite chain
belongs to the next lower projected-support filtration. -/
theorem imageBounded_of_top_zero (f : V → W) (n : ℕ) {c : Chain V}
    (hc : c ∈ imageBounded f (n+1))
    (hz : ∀ s : Finset W, s.card = n+1 → project f s c = 0) :
    c ∈ imageBounded f n := by
  apply (mem_imageBounded_iff f n c).mpr
  intro s hs
  by_cases he : s.card = n+1
  · exact hz s he
  · exact project_eq_zero_of_card_lt f hc s (by omega)

/-- Finite facewise fillings assemble into an actual finite chain in the stated submodule. -/
theorem fill_of_components (f : V → W) (D : Submodule ℚ (Chain V)) (c : Chain V)
    (hfill : ∀ s : Finset W, ∃ t : Chain V, t ∈ D ∧ boundary t = project f s c) :
    ∃ t : Chain V, t ∈ D ∧ boundary t = c := by
  classical
  obtain ⟨S,he,_⟩ := exists_decomposition f c
  choose t ht heq using hfill
  refine ⟨∑ s ∈ S, t s,Submodule.sum_mem D (fun s _ => ht s),?_⟩
  simpa only [map_sum,heq] using he

end TernaryPoly.OrientedImageFaceDecomposition
