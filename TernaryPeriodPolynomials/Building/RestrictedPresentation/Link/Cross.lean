module

public import TernaryPeriodPolynomials.Building.RestrictedPresentation.Link.Fibers

@[expose] public section


/-!
# Lemma A.1: charts adapted to a base vertex or edge, and the join over a base edge

Formalized by Claude Sonnet 5.5.
Paper: Appendix A.2: over a base edge `[u,v]` of `Z` the link is the `2`-skeleton of the
join `P_u * P_v`; relative to the endpoint fibres its first homology is `ℚ`, generated by any
cross-edge.

In an adapted chart `h` (the integral basis `g * blockGL q`) the cross edges over the standard
base edge are `[xFiber h k, yFiber h l]` and the triangles are
`[xFiber h k, xFiber h (k+1), yFiber h l]`, `[xFiber h k, yFiber h l, yFiber h (l+1)]`.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.AppendixALink

open TernaryPoly TernaryPoly.ModThreeGoodAction TernaryPoly.AugmentedFrameComplex
  TernaryPoly.OrientedListChains TernaryPoly.GoodLinkExtraction TernaryPoly.CoherentPrismReduction
  TernaryPoly.BadVertexProjection TernaryPoly.OrientedImageFaceProjection
  TernaryPoly.OrientedImageFaceBoundary TernaryPoly.OrientedImageFaceDecomposition

local instance instDecRLX : DecidableEq RationalLine := Classical.decEq _
local instance instDecRLTwoX : DecidableEq RankTwoAugmentedFrames.RationalLine2 := Classical.decEq _
local notation "res" => AugmentedPrismCaps.columnResidue

/-- The standard second quotient vertex. -/
abbrev A1 : RankTwoAugmentedFrames.RationalLine2 := RankTwoAugmentedFrames.augmentedLine 1 1

/-! ### Adapted charts -/

theorem vertex_eq_of_chart (g h : IntegralGL) (hh : augmentedLine h 0 = augmentedLine g 0)
    (Q : RationalLine) (hQ : Q ≠ augmentedLine g 0) (i : Fin 3) (k : ℤ)
    (hv : vertex g Q = vertex g (fiberLine h i k)) :
    vertex h Q = RankTwoAugmentedFrames.augmentedLine 1 i := by
  have hne : fiberLine h i k ≠ augmentedLine g 0 := by rw [← hh]; exact fiber_ne_base h i k
  have h1 := BadVertexProjectionChange.vertex_change g h hh Q hQ
  have h2 := BadVertexProjectionChange.vertex_change g h hh (fiberLine h i k) hne
  rw [hv,h2,BadVertexFibers.prism_fiber_vertex] at h1
  exact ((BadVertexProjectionChange.quotientChange g h hh).injective h1).symm

/-- A chart adapted to a vertex of the link: its first fibre is the fibre of the vertex. -/
theorem exists_chart_vertex (g : IntegralGL) (hbad : ¬Good (augmentedLine g 0).val)
    (Q : RationalLine) (hQ : ({Q} : Finset RationalLine) ∈ badLink (augmentedLine g 0)) :
    ∃ h : IntegralGL, ∃ hh : augmentedLine h 0 = augmentedLine g 0,
      vertex h Q = A0 ∧ Good (xFiber h 0).val ∧
        vertex g Q = BadVertexProjectionChange.quotientChange g h hh A0 := by
  have hQne : Q ≠ augmentedLine g 0 :=
    BadVertexProjectionChange.good_ne_base g hbad Q (hQ.2 Q (by simp))
  obtain ⟨q,hq⟩ := RankTwoAugmentedFrames.rationalLine_eq_augmentedLine (vertex g Q)
  have hh : augmentedLine (g * blockGL q) 0 = augmentedLine g 0 := blockGL_line_zero g q
  have hv : vertex g Q = vertex g (fiberLine (g * blockGL q) 0 0) :=
    (hq.symm.trans (vertex_block g q 0 0).symm)
  have hvQ := vertex_eq_of_chart g (g * blockGL q) hh Q hQne 0 0 hv
  have hbad_h : ¬Good (augmentedLine (g * blockGL q) 0).val := by rw [hh]; exact hbad
  have hQ' : ({Q} : Finset RationalLine) ∈ badLink (augmentedLine (g * blockGL q) 0) := by
    rw [hh]; exact hQ
  obtain ⟨k,hk⟩ := exists_fiber (g * blockGL q) hbad_h 0 Q hQ' hvQ
  refine ⟨g * blockGL q,hh,hvQ,?_,?_⟩
  · have hQgood : Good Q.val := hQ.2 Q (by simp)
    rw [← hk] at hQgood
    exact (good_fiber_shift _ (res_zero_of_bad _ hbad_h) 0 k 0).mp hQgood
  · rw [BadVertexProjectionChange.vertex_change g _ hh Q hQne,hvQ]

/-- A chart adapted to an edge of the link whose endpoints project to distinct vertices. -/
theorem exists_chart_edge (g : IntegralGL) (hbad : ¬Good (augmentedLine g 0).val)
    (Q R : RationalLine)
    (hQR : ({Q,R} : Finset RationalLine) ∈ badLink (augmentedLine g 0))
    (hne : vertex g Q ≠ vertex g R) :
    ∃ h : IntegralGL, ∃ hh : augmentedLine h 0 = augmentedLine g 0,
      vertex h Q = A0 ∧ vertex h R = A1 ∧ Good (xFiber h 0).val ∧ Good (yFiber h 0).val ∧
      vertex g Q = BadVertexProjectionChange.quotientChange g h hh A0 ∧
      vertex g R = BadVertexProjectionChange.quotientChange g h hh A1 := by
  have hQ : ({Q} : Finset RationalLine) ∈ badLink (augmentedLine g 0) :=
    singleton_mem_of_mem hQR (by simp)
  have hR : ({R} : Finset RationalLine) ∈ badLink (augmentedLine g 0) :=
    singleton_mem_of_mem hQR (by simp)
  have hQne : Q ≠ augmentedLine g 0 :=
    BadVertexProjectionChange.good_ne_base g hbad Q (hQ.2 Q (by simp))
  have hRne : R ≠ augmentedLine g 0 :=
    BadVertexProjectionChange.good_ne_base g hbad R (hR.2 R (by simp))
  have hamb : ({vertex g Q,vertex g R} : Finset RankTwoAugmentedFrames.RationalLine2) ∈
      RankTwoAugmentedFrames.ambient := by
    have := BadVertexProjection.mapsFaces g hbad {Q,R} hQR
    convert this using 1
    simp
  obtain ⟨q,hq0,hq1⟩ := RankTwoAugmentedFrames.edge_basis _ _ hne (by convert hamb)
  have hh : augmentedLine (g * blockGL q) 0 = augmentedLine g 0 := blockGL_line_zero g q
  have hvQ := vertex_eq_of_chart g (g * blockGL q) hh Q hQne 0 0
    (hq0.symm.trans (vertex_block g q 0 0).symm)
  have hvR := vertex_eq_of_chart g (g * blockGL q) hh R hRne 1 0
    (hq1.symm.trans (vertex_block g q 1 0).symm)
  have hbad_h : ¬Good (augmentedLine (g * blockGL q) 0).val := by rw [hh]; exact hbad
  have hQ' : ({Q} : Finset RationalLine) ∈ badLink (augmentedLine (g * blockGL q) 0) := by
    rw [hh]; exact hQ
  have hR' : ({R} : Finset RationalLine) ∈ badLink (augmentedLine (g * blockGL q) 0) := by
    rw [hh]; exact hR
  obtain ⟨k,hk⟩ := exists_fiber (g * blockGL q) hbad_h 0 Q hQ' hvQ
  obtain ⟨l,hl⟩ := exists_fiber (g * blockGL q) hbad_h 1 R hR' hvR
  refine ⟨g * blockGL q,hh,hvQ,hvR,?_,?_,?_,?_⟩
  · have hQgood : Good Q.val := hQ.2 Q (by simp)
    rw [← hk] at hQgood
    exact (good_fiber_shift _ (res_zero_of_bad _ hbad_h) 0 k 0).mp hQgood
  · have hRgood : Good R.val := hR.2 R (by simp)
    rw [← hl] at hRgood
    exact (good_fiber_shift _ (res_zero_of_bad _ hbad_h) 1 l 0).mp hRgood
  · rw [BadVertexProjectionChange.vertex_change g _ hh Q hQne,hvQ]
  · rw [BadVertexProjectionChange.vertex_change g _ hh R hRne,hvR]

/-! ### The cross edges and the mixed triangles over the standard base edge -/

def crossL (h : IntegralGL) : IntegerGridExactness.C₀ →ₗ[ℚ] Chain RationalLine :=
  Finsupp.linearCombination ℚ (fun p : ℤ × ℤ => simplex [xFiber h p.1,yFiber h p.2])

def fibL (h : IntegralGL) : IntegerGridExactness.C₁ →ₗ[ℚ] Chain RationalLine :=
  Finsupp.linearCombination ℚ (fun e : IntegerGridExactness.Edge =>
    if e.2 = 0 then simplex [xFiber h e.1.1,xFiber h (e.1.1+1)]
    else -simplex [yFiber h e.1.2,yFiber h (e.1.2+1)])

theorem boundary_mappedTriangle (h : IntegralGL) (e : IntegerGridExactness.Edge) :
    boundary (BadVertexMixedCharts.mappedTriangle h e) =
      crossL h (IntegerGridExactness.boundary₁ (Finsupp.single e 1)) +
        fibL h (Finsupp.single e 1) := by
  obtain ⟨⟨k,l⟩,i⟩ := e
  fin_cases i
  · change boundary (BadVertexMixedCharts.mappedTriangle h ((k,l),0)) = _
    rw [BadVertexMixedCharts.mappedTriangle_horizontal]
    simp [crossL,fibL,IntegerGridExactness.edgeHead,IntegerGridExactness.vertex,
      boundary_cons,boundary_nil,cons_simplex]
    abel
  · change boundary (BadVertexMixedCharts.mappedTriangle h ((k,l),1)) = _
    rw [BadVertexMixedCharts.mappedTriangle_vertical]
    simp [crossL,fibL,IntegerGridExactness.edgeHead,IntegerGridExactness.vertex,
      boundary_cons,boundary_nil,cons_simplex]
    abel

theorem boundary_mixed (h : IntegralGL) (z : IntegerGridExactness.C₁) :
    boundary (BadVertexSquareCaps.mixed h z) =
      crossL h (IntegerGridExactness.boundary₁ z) + fibL h z := by
  induction z using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy =>
    simp only [map_add,hx,hy]
    abel
  | single e q =>
    have he : BadVertexSquareCaps.mixed h (Finsupp.single e q) =
        q • BadVertexMixedCharts.mappedTriangle h e := by
      simp [BadVertexSquareCaps.mixed,IntegerPathJoinCycles.mixed,
        BadVertexMixedCharts.mappedTriangle]
    have h1 : (Finsupp.single e q : IntegerGridExactness.C₁) = q • Finsupp.single e 1 := by simp
    rw [he,map_smul,boundary_mappedTriangle,h1,map_smul,map_smul,map_smul,smul_add]

theorem mappedTriangle_mem_chains (h : IntegralGL) (hb : res h 0 = 0)
    (hx : Good (xFiber h 0).val) (hy : Good (yFiber h 0).val) (e : IntegerGridExactness.Edge) :
    BadVertexMixedCharts.mappedTriangle h e ∈ chains (badLink (augmentedLine h 0)) 3 := by
  obtain ⟨⟨k,l⟩,i⟩ := e
  fin_cases i
  · change BadVertexMixedCharts.mappedTriangle h ((k,l),0) ∈ _
    rw [BadVertexMixedCharts.mappedTriangle_horizontal]
    exact simplex_mem_chains_of_mem _ _ 3 rfl _ (mixed_triple_mem h hb 0 1 (by decide) k l hx hy)
      (fun x => by simp)
  · change BadVertexMixedCharts.mappedTriangle h ((k,l),1) ∈ _
    rw [BadVertexMixedCharts.mappedTriangle_vertical]
    refine (chains _ _).neg_mem ?_
    exact simplex_mem_chains_of_mem _ _ 3 rfl _ (mixed_triple_mem h hb 1 0 (by decide) l k hy hx)
      (fun x => by simp; tauto)

theorem mixed_mem_chains (h : IntegralGL) (hb : res h 0 = 0)
    (hx : Good (xFiber h 0).val) (hy : Good (yFiber h 0).val) (z : IntegerGridExactness.C₁) :
    BadVertexSquareCaps.mixed h z ∈ chains (badLink (augmentedLine h 0)) 3 := by
  induction z using Finsupp.induction_linear with
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y hx' hy' => rw [map_add]; exact Submodule.add_mem _ hx' hy'
  | single e q =>
    have he : BadVertexSquareCaps.mixed h (Finsupp.single e q) =
        q • BadVertexMixedCharts.mappedTriangle h e := by
      simp [BadVertexSquareCaps.mixed,IntegerPathJoinCycles.mixed,
        BadVertexMixedCharts.mappedTriangle]
    rw [he]
    exact Submodule.smul_mem _ q (mappedTriangle_mem_chains h hb hx hy e)

theorem fibL_mem_chains (h : IntegralGL) (hb : res h 0 = 0)
    (hx : Good (xFiber h 0).val) (hy : Good (yFiber h 0).val) (z : IntegerGridExactness.C₁) :
    fibL h z ∈ chains (badLink (augmentedLine h 0)) 2 ∧
      fibL h z ∈ imageBounded (vertex h) 1 := by
  induction z using Finsupp.induction_linear with
  | zero => rw [map_zero]; exact ⟨Submodule.zero_mem _,Submodule.zero_mem _⟩
  | add x y hx' hy' =>
    rw [map_add]
    exact ⟨Submodule.add_mem _ hx'.1 hy'.1,Submodule.add_mem _ hx'.2 hy'.2⟩
  | single e q =>
    rw [fibL,Finsupp.linearCombination_single]
    obtain ⟨⟨k,l⟩,i⟩ := e
    fin_cases i
    · change q • (if (0 : Fin 2) = 0 then _ else _) ∈ _ ∧ _
      simp only [ite_true]
      refine ⟨Submodule.smul_mem _ q ?_,Submodule.smul_mem _ q ?_⟩
      · exact simplex_mem_chains_of_mem _ _ 2 rfl _ (fiber_pair_mem h hb 0 hx k)
          (fun x => by simp)
      · apply simplex_mem_imageBounded
        simp [imageFace,BadVertexFibers.prism_fiber_vertex]
    · change q • (if (1 : Fin 2) = 0 then _ else _) ∈ _ ∧ _
      simp only [show ¬((1 : Fin 2) = 0) from by decide,ite_false]
      refine ⟨Submodule.smul_mem _ q ((chains _ _).neg_mem ?_),
        Submodule.smul_mem _ q ((imageBounded _ _).neg_mem ?_)⟩
      · exact simplex_mem_chains_of_mem _ _ 2 rfl _ (fiber_pair_mem h hb 1 hy l)
          (fun x => by simp)
      · apply simplex_mem_imageBounded
        simp [imageFace,BadVertexFibers.prism_fiber_vertex]

/-! ### The component over the standard base edge -/

theorem project_baseEdge_mem_range (h : IntegralGL) (hbad_h : ¬Good (augmentedLine h 0).val)
    {c : Chain RationalLine} (hc : c ∈ chains (badLink (augmentedLine h 0)) 2) :
    project (vertex h) BadVertexMixedProjection.baseEdge c ∈ LinearMap.range (crossL h) := by
  classical
  induction hc using Submodule.span_induction with
  | mem c hc =>
    obtain ⟨l,hlen,hl,rfl⟩ := hc
    rw [project_simplex]
    obtain ⟨Q,R,rfl⟩ := List.length_eq_two.mp hlen
    by_cases he : imageFace (vertex h) [Q,R] = BadVertexMixedProjection.baseEdge
    · rw [ite_eq_left he]
      by_cases hQR : Q = R
      · subst hQR
        rw [simplex_repeat_adjacent Q []]
        exact (LinearMap.range (crossL h)).zero_mem
      · have hlf : ({Q,R} : Finset RationalLine) ∈ badLink (augmentedLine h 0) := by
          have := hl.resolve_left (by simp)
          convert this using 1
          ext x; simp
        have hQ := singleton_mem_of_mem hlf (by simp : Q ∈ ({Q,R} : Finset RationalLine))
        have hR := singleton_mem_of_mem hlf (by simp : R ∈ ({Q,R} : Finset RationalLine))
        have hpair : ({vertex h Q,vertex h R} : Finset RankTwoAugmentedFrames.RationalLine2) =
            {A0,A1} := by
          have : imageFace (vertex h) [Q,R] = {vertex h Q,vertex h R} := by
            ext x; simp [imageFace]
          rw [← this]
          exact he
        rcases BadVertexMixedBlocks.pair_alignment _ _ _ _ hpair with ⟨h1,h2⟩ | ⟨h1,h2⟩
        · obtain ⟨k,rfl⟩ := exists_fiber h hbad_h 0 Q hQ h1
          obtain ⟨l',rfl⟩ := exists_fiber h hbad_h 1 R hR h2
          exact ⟨Finsupp.single (k,l') 1,by simp [crossL]⟩
        · obtain ⟨l',rfl⟩ := exists_fiber h hbad_h 1 Q hQ h1
          obtain ⟨k,rfl⟩ := exists_fiber h hbad_h 0 R hR h2
          refine ⟨-Finsupp.single (k,l') 1,?_⟩
          rw [map_neg,simplex_swap_eq_neg]
          simp [crossL]
    · rw [ite_eq_right he]
      exact (LinearMap.range (crossL h)).zero_mem
  | zero => rw [map_zero]; exact (LinearMap.range (crossL h)).zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact (LinearMap.range (crossL h)).add_mem hx hy
  | smul q x _ hx => rw [map_smul]; exact (LinearMap.range (crossL h)).smul_mem q hx

theorem map_crossL (h : IntegralGL) (a : IntegerGridExactness.C₀) :
    OrientedChainMap.map (vertex h) (crossL h a) =
      IntegerGridExactness.augmentation a • simplex [A0,A1] := by
  have hl : ∀ p : ℤ × ℤ, [xFiber h p.1,yFiber h p.2].map (vertex h) = [A0,A1] := by
    intro p
    simp [BadVertexFibers.prism_fiber_vertex]
  exact OrientedSimplexCoefficient.map_combination (vertex h)
    (fun p : ℤ × ℤ => [xFiber h p.1,yFiber h p.2]) [A0,A1] hl a

/-- The first reduction over a base edge: a cycle-compatible component is a boundary of mixed
triangles modulo fibre edges. -/
theorem cross_component_reduce (h : IntegralGL) (hbad_h : ¬Good (augmentedLine h 0).val)
    (hx : Good (xFiber h 0).val) (hy : Good (yFiber h 0).val) {c : Chain RationalLine}
    (hc : c ∈ chains (badLink (augmentedLine h 0)) 2)
    (hz : OrientedChainMap.map (vertex h) c = 0) :
    ∃ t ∈ chains (badLink (augmentedLine h 0)) 3, ∃ f ∈ chains (badLink (augmentedLine h 0)) 2,
      f ∈ imageBounded (vertex h) 1 ∧
      project (vertex h) BadVertexMixedProjection.baseEdge c = boundary t + f := by
  have hb := res_zero_of_bad h hbad_h
  obtain ⟨a,ha⟩ := project_baseEdge_mem_range h hbad_h hc
  have hzero : OrientedChainMap.map (vertex h)
      (project (vertex h) BadVertexMixedProjection.baseEdge c) = 0 := map_project_eq_zero _ _ hz
  rw [← ha,map_crossL] at hzero
  have haug : IntegerGridExactness.augmentation a = 0 :=
    (OrientedSimplexCoefficient.scalar_simplex_eq_zero_iff [A0,A1]
      (by simp [A0,A1,BadVertexMixedProjection.base_vertices_distinct]) _).mp hzero
  have hpath := IntegerGridExactness.boundary₁_pathLinear a
  rw [haug,zero_smul,sub_zero] at hpath
  have hmix := boundary_mixed h (IntegerGridExactness.pathLinear a)
  rw [hpath] at hmix
  obtain ⟨hf1,hf2⟩ := fibL_mem_chains h hb hx hy (IntegerGridExactness.pathLinear a)
  refine ⟨BadVertexSquareCaps.mixed h (IntegerGridExactness.pathLinear a),
    mixed_mem_chains h hb hx hy _,-fibL h (IntegerGridExactness.pathLinear a),
    (chains _ _).neg_mem hf1,(imageBounded _ _).neg_mem hf2,?_⟩
  rw [← ha,hmix]
  abel

end TernaryPeriodPolynomials.Argument.AppendixALink
