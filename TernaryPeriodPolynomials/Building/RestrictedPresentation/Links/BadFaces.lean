module

public import TernaryPeriodPolynomials.Building.BadEdge.LinkChains
public import TernaryPeriodPolynomials.Building.BadTriangle.LinkChains
public import TernaryPeriodPolynomials.Building.AugmentedFrame.BadFaces
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

@[expose] public section


/-!
# Appendix A: the good links of bad triangles and bad edges

Formalized by Claude Sonnet 5.5.

> Two types of links are immediate.  If a bad augmented triangle spans the saturated plane with basis `b, c`, and `w` is an integral complement, its good link is the nonempty discrete set
> `{(w + rb + sc)^± : (r,s) ∈ ℤ²}`.  For the bad edge `{b^±, c^±}`, the same vertices form a square-grid graph, with edges given by differences `±b` and `±c`.  It is connected, and its first homology
> is generated by unit squares.

Dictionary.  `X = TernaryPoly.AugmentedFrameComplex.ambient`, `Y = good` (full subcomplex on the lines with an integral vector of nonzero coordinate sum mod 3).  A basis `g` of `ℤ³` gives
`b = g e₀`, `c = g e₁`, `w = g e₂` (the columns), the augmented frame `{b, c, w, b + c}`; its bad augmented core is `augmentedCore g = {b, c, b + c}`, and "`b, c` bad" is `columnResidue g 0 = 0 = columnResidue g 1`
(then `w` is automatically good, `columnResidue g 2 ≠ 0`, and so are all `w + rb + sc`, `coordinateLine g (r,s)`).  The good link of a face `B` is `GoodLinkExtraction.augmentedGoodLink B`: faces are the nonempty
sets of good lines `s` with `B ∪ s ∈ ambient`.

* `bad_triangle_exists_core`: every all-bad triangle of `X` is `augmentedCore g` for a basis `g` (the only all-bad triangles are augmented rank-two frames).
* `bad_triangle_good_link`: the good link of `augmentedCore g` has as faces exactly the singletons `{(w + rb + sc)^±}`, each `(r,s)` once, all good: a nonempty discrete set.
* `bad_edge_good_link`: the good link of the bad edge `{b^±, c^±}` has as faces exactly the singletons and the pairs `{(w + p)^±, (w + q)^±}` with `p - q ∈ {(±1,0), (0,±1)}` (that is, the vectors differ by `±b` or `±c`,
  `gridAdjacent_iff_vector_diff`); `badEdgeLinkIso` is a graph isomorphism from the square grid `ℤ²` onto its 1-skeleton; `bad_edge_link_connected`; `bad_edge_link_H1_generated_by_squares`: every
  1-cycle of the link is a rational combination of unit-square loops (and the link has no 2-faces, so this is `H₁`), and the unit squares are cycles (`unit_square_is_cycle`).
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.AppendixA.Links

open TernaryPoly TernaryPoly.ModThreeGoodAction TernaryPoly.AugmentedFrameComplex
  TernaryPoly.AugmentedBadFaces TernaryPoly.BadEdgeLinkVertices TernaryPoly.BadEdgeLinkGrid
  TernaryPoly.BadTriangleLink TernaryPoly.GoodLinkExtraction TernaryPoly.OrientedListChains
  TernaryPoly.GoodAugmentedNormalForm


local instance linksBadFacesDecEq : DecidableEq RationalLine := Classical.decEq _

/-- Closes `∀ x, x ∈ S ↔ x ∈ T` for two literal finite sets of lines (possibly written with different decidability instances). -/
local macro "faceEq" : tactic =>
  `(tactic| (intro x; first | (simp; done) | (simp; tauto) | (simp [augmentedCore]; done) | (simp [augmentedCore]; tauto)))

/-- Faces are insensitive to the (subsingleton) decidability instance used to write a finite set. -/
theorem ambient_of_eq {s t : Finset RationalLine} (h : s ∈ ambient) (e : ∀ x, x ∈ s ↔ x ∈ t) :
    t ∈ ambient := by
  have : s = t := Finset.ext e
  exact this ▸ h

/-- **The only all-bad triangles are the augmented rank-two cores** `{b^±, c^±, (b+c)^±}` of integral bases. -/
theorem bad_triangle_exists_core {s : Finset RationalLine} (hs : s ∈ ambient) (hcard : s.card = 3)
    (hbad : ∀ L ∈ s, ¬ Good L.val) : ∃ g : IntegralGL, s = augmentedCore g :=
  all_bad_card_three_exists_core hs hcard hbad

/-- If `b, c` are bad, the complement `w` is good. -/
theorem residue_two_ne_zero (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0) :
    columnResidue g 2 ≠ 0 := by
  obtain ⟨j, hj⟩ := exists_columnResidue_ne_zero g
  rcases (by decide : ∀ j : Fin 3, j = 0 ∨ j = 1 ∨ j = 2) j with rfl | rfl | rfl
  · exact absurd h0 hj
  · exact absurd h1 hj
  · exact hj

/-- The three lines `b, c, b + c` of the core are bad when the columns `b, c` are bad. -/
theorem core_lines_bad (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0) :
    ∀ L ∈ augmentedCore g, ¬ Good L.val := by
  intro L hL
  simp only [augmentedCore, Finset.mem_insert, Finset.mem_singleton] at hL
  rcases hL with rfl | rfl | rfl
  · rw [good_augmentedLine_iff_residue]
    exact fun h => h h0
  · rw [good_augmentedLine_iff_residue]
    exact fun h => h h1
  · rw [good_augmentedLine_iff_residue]
    change ¬ (columnResidue g 0 + columnResidue g 1) ≠ 0
    simp [h0, h1]

theorem coordinateLine_good' (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (p : ℤ × ℤ) : Good (coordinateLine g p).val :=
  coordinateLine_good g h0 h1 (residue_two_ne_zero g h0 h1) p

/-- The complement vector `w + r b + s c` (`b = g e₀`, `c = g e₁`, `w = g e₂`) of the coordinate `(r, s)`. -/
def complementVector (g : IntegralGL) (p : ℤ × ℤ) : Space :=
  (p.1 : ℚ) • rationalRepresentation g (Pi.single 0 1) + (p.2 : ℚ) • rationalRepresentation g (Pi.single 1 1) +
    rationalRepresentation g (Pi.single 2 1)

/-- **The vertex of coordinate `(r, s)` is the line `(w + r b + s c)^±`.** -/
theorem complement_line_span (g : IntegralGL) (p : ℤ × ℤ) :
    (coordinateLine g p).val = Submodule.span ℚ {complementVector g p} := by
  have h : rationalVector (affineVector p) =
      (p.1 : ℚ) • (Pi.single 0 1 : Space) + (p.2 : ℚ) • (Pi.single 1 1 : Space) + (Pi.single 2 1 : Space) := by
    funext i
    fin_cases i <;> simp [rationalVector, affineVector]
  change Submodule.span ℚ {rationalVector (g.val.mulVec (affineVector p))} = _
  rw [rationalVector_mulVec, h, map_add, map_add, map_smul, map_smul]
  rfl

private theorem core_union_singleton (g : IntegralGL) (L : RationalLine) :
    augmentedCore g ∪ {L} = {augmentedLine g 0, augmentedLine g 1, augmentedLine g 3, L} := by
  ext M
  simp only [augmentedCore, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton]
  tauto

/-- **The good link of a bad augmented triangle is the nonempty discrete set `{(w + r b + s c)^±}`.**
Here `b, c` are the bad columns of the basis `g` and `w` its third column.
* every `w + r b + s c` is good, and `(r, s) ↦ (w + r b + s c)^±` is injective;
* the good vertices `L` with `{b, c, b + c, L}` an ambient face are exactly these lines;
* the faces of the good link `augmentedGoodLink (augmentedCore g)` are exactly the singletons of these lines: no two vertices are joined, so the link is discrete. -/
theorem bad_triangle_good_link (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0) :
    (∀ p : ℤ × ℤ, Good (coordinateLine g p).val) ∧ Function.Injective (coordinateLine g) ∧
    (∀ L : RationalLine, (Good L.val ∧ {augmentedLine g 0, augmentedLine g 1, augmentedLine g 3, L} ∈ ambient) ↔
        ∃ p : ℤ × ℤ, coordinateLine g p = L) ∧
    (∀ s : Finset RationalLine, s ∈ augmentedGoodLink (augmentedCore g) ↔
        ∃ p : ℤ × ℤ, s = {coordinateLine g p}) := by
  have h2 := residue_two_ne_zero g h0 h1
  refine ⟨coordinateLine_good' g h0 h1, coordinateLine_injective g, ?_, ?_⟩
  · intro L
    constructor
    · rintro ⟨hg, hf⟩
      exact exists_coordinates g h0 h1 L hg (triangle_face_implies_edge_face g L (ambient_of_eq hf (by faceEq)))
    · rintro ⟨p, rfl⟩
      exact ⟨coordinateLine_good' g h0 h1 p, ambient_of_eq (coordinateLine_triangle_face g p) (by faceEq)⟩
  · intro s
    unfold augmentedGoodLink
    rw [mem_goodLink]
    constructor
    · rintro ⟨hne, hamb, hgood⟩
      have hv : ∀ L ∈ s, {augmentedLine g 0, augmentedLine g 1, augmentedLine g 3, L} ∈ ambient := by
        intro L hL
        apply (ambient.isRelLowerSet_faces hamb).2
        · intro M hM
          simp only [Finset.mem_insert, Finset.mem_singleton] at hM
          rcases hM with rfl | rfl | rfl | rfl
          · exact Finset.mem_union_left _ (by simp [augmentedCore])
          · exact Finset.mem_union_left _ (by simp [augmentedCore])
          · exact Finset.mem_union_left _ (by simp [augmentedCore])
          · exact Finset.mem_union_right _ hL
        · simp
      have hsub : ∀ L ∈ s, ∀ M ∈ s, L = M := by
        intro L hL M hM
        by_contra hLM
        have hfive : {augmentedLine g 0, augmentedLine g 1, augmentedLine g 3, L, M} ∈ ambient := by
          apply (ambient.isRelLowerSet_faces hamb).2
          · intro N hN
            simp only [Finset.mem_insert, Finset.mem_singleton] at hN
            rcases hN with rfl | rfl | rfl | rfl | rfl
            · exact Finset.mem_union_left _ (by simp [augmentedCore])
            · exact Finset.mem_union_left _ (by simp [augmentedCore])
            · exact Finset.mem_union_left _ (by simp [augmentedCore])
            · exact Finset.mem_union_right _ hL
            · exact Finset.mem_union_right _ hM
          · simp
        exact no_link_edge g h0 h1 ⟨L, hgood L hL, ambient_of_eq (hv L hL) (by faceEq)⟩ ⟨M, hgood M hM, ambient_of_eq (hv M hM) (by faceEq)⟩
          (fun h => hLM (congrArg Subtype.val h))
          (ambient_of_eq hfive (by faceEq))
      obtain ⟨L, hL⟩ := hne
      have hs : s = {L} := by
        ext M
        simp only [Finset.mem_singleton]
        exact ⟨fun hM => hsub M hM L hL, fun h => h ▸ hL⟩
      obtain ⟨p, hp⟩ := exists_coordinates g h0 h1 L (hgood L hL)
        (triangle_face_implies_edge_face g L (ambient_of_eq (hv L hL) (by faceEq)))
      exact ⟨p, by rw [hs, hp]⟩
    · rintro ⟨p, rfl⟩
      refine ⟨Finset.singleton_nonempty _, ?_, ?_⟩
      · rw [core_union_singleton]
        exact ambient_of_eq (coordinateLine_triangle_face g p) (by faceEq)
      · intro a ha
        rw [Finset.mem_singleton] at ha
        rw [ha]
        exact coordinateLine_good' g h0 h1 p

/-- The good link of a bad triangle is nonempty. -/
theorem bad_triangle_good_link_nonempty (g : IntegralGL) (h0 : columnResidue g 0 = 0)
    (h1 : columnResidue g 1 = 0) : ∃ s, s ∈ augmentedGoodLink (augmentedCore g) :=
  ⟨_, ((bad_triangle_good_link g h0 h1).2.2.2 {coordinateLine g (0, 0)}).mpr ⟨(0, 0), rfl⟩⟩

/-! ### The bad edge -/

private theorem edge_union_singleton (g : IntegralGL) (L : RationalLine) :
    ({augmentedLine g 0, augmentedLine g 1} : Finset RationalLine) ∪ {L} =
      {augmentedLine g 0, augmentedLine g 1, L} := by
  ext M
  simp only [Finset.mem_union, Finset.mem_insert, Finset.mem_singleton]
  tauto

private theorem edge_union_pair (g : IntegralGL) (L M : RationalLine) :
    ({augmentedLine g 0, augmentedLine g 1} : Finset RationalLine) ∪ {L, M} =
      {augmentedLine g 0, augmentedLine g 1, L, M} := by
  ext N
  simp only [Finset.mem_union, Finset.mem_insert, Finset.mem_singleton]
  tauto

/-- **The good link of the bad edge `{b^±, c^±}`.**  Its faces are exactly the singletons `{(w + r b + s c)^±}` and the pairs `{(w + p)^±, (w + q)^±}` with `p, q` nearest neighbours in `ℤ²`
(`GridAdjacent`: they differ by `±1` in exactly one coordinate); there are no larger faces. -/
theorem bad_edge_good_link (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (s : Finset RationalLine) :
    s ∈ augmentedGoodLink {augmentedLine g 0, augmentedLine g 1} ↔
      (∃ p : ℤ × ℤ, s = {coordinateLine g p}) ∨
      (∃ p q : ℤ × ℤ, GridAdjacent p q ∧ s = {coordinateLine g p, coordinateLine g q}) := by
  unfold augmentedGoodLink
  rw [mem_goodLink]
  constructor
  · rintro ⟨hne, hamb, hgood⟩
    have hv : ∀ L ∈ s, {augmentedLine g 0, augmentedLine g 1, L} ∈ ambient := by
      intro L hL
      apply (ambient.isRelLowerSet_faces hamb).2
      · intro M hM
        simp only [Finset.mem_insert, Finset.mem_singleton] at hM
        rcases hM with rfl | rfl | rfl
        · exact Finset.mem_union_left _ (by simp)
        · exact Finset.mem_union_left _ (by simp)
        · exact Finset.mem_union_right _ hL
      · simp
    have hcard : s.card ≤ 2 := by
      by_contra hc
      push Not at hc
      obtain ⟨a, ha, b, hb, c, hc', hab, hac, hbc⟩ := Finset.two_lt_card.mp hc
      have hfive : {augmentedLine g 0, augmentedLine g 1, a, b, c} ∈ ambient := by
        apply (ambient.isRelLowerSet_faces hamb).2
        · intro N hN
          simp only [Finset.mem_insert, Finset.mem_singleton] at hN
          rcases hN with rfl | rfl | rfl | rfl | rfl
          · exact Finset.mem_union_left _ (by simp)
          · exact Finset.mem_union_left _ (by simp)
          · exact Finset.mem_union_right _ ha
          · exact Finset.mem_union_right _ hb
          · exact Finset.mem_union_right _ hc'
        · simp
      exact no_good_link_triangle g h0 h1 ⟨a, hgood a ha, ambient_of_eq (hv a ha) (by faceEq)⟩ ⟨b, hgood b hb, ambient_of_eq (hv b hb) (by faceEq)⟩
        ⟨c, hgood c hc', ambient_of_eq (hv c hc') (by faceEq)⟩ (fun h => hab (congrArg Subtype.val h))
        (fun h => hac (congrArg Subtype.val h)) (fun h => hbc (congrArg Subtype.val h))
        (ambient_of_eq hfive (by faceEq))
    have hpos := Finset.card_pos.mpr hne
    have coord : ∀ L ∈ s, ∃ p, coordinateLine g p = L := fun L hL =>
      exists_coordinates g h0 h1 L (hgood L hL) (ambient_of_eq (hv L hL) (by faceEq))
    interval_cases hk : s.card
    · obtain ⟨L, rfl⟩ := Finset.card_eq_one.mp hk
      obtain ⟨p, hp⟩ := coord L (Finset.mem_singleton_self _)
      exact Or.inl ⟨p, by rw [hp]⟩
    · obtain ⟨L, M, hLM, rfl⟩ := Finset.card_eq_two.mp hk
      obtain ⟨p, hp⟩ := coord L (by simp)
      obtain ⟨q, hq⟩ := coord M (by simp)
      refine Or.inr ⟨p, q, ?_, by rw [hp, hq]⟩
      have hpq : p ≠ q := by
        rintro rfl
        exact hLM (hp.symm.trans hq)
      apply gridAdjacent_of_face g p q hpq
      rw [hp, hq]
      exact ambient_of_eq hamb (by faceEq)
  · rintro (⟨p, rfl⟩ | ⟨p, q, hpq, rfl⟩)
    · refine ⟨Finset.singleton_nonempty _, ?_, ?_⟩
      · rw [edge_union_singleton]
        exact ambient_of_eq (coordinateLine_face g p) (by faceEq)
      · intro a ha
        rw [Finset.mem_singleton] at ha
        rw [ha]
        exact coordinateLine_good' g h0 h1 p
    · refine ⟨Finset.insert_nonempty _ _, ?_, ?_⟩
      · rw [edge_union_pair]
        exact ambient_of_eq (face_of_gridAdjacent g p q hpq) (by faceEq)
      · intro a ha
        simp only [Finset.mem_insert, Finset.mem_singleton] at ha
        rcases ha with rfl | rfl
        · exact coordinateLine_good' g h0 h1 p
        · exact coordinateLine_good' g h0 h1 q

/-- The bad-edge link has no face with more than two vertices (so it is a graph and `H₁` is its cycle space). -/
theorem bad_edge_good_link_card_le_two (g : IntegralGL) (h0 : columnResidue g 0 = 0)
    (h1 : columnResidue g 1 = 0) {s : Finset RationalLine}
    (hs : s ∈ augmentedGoodLink {augmentedLine g 0, augmentedLine g 1}) : s.card ≤ 2 := by
  rcases (bad_edge_good_link g h0 h1 s).mp hs with ⟨p, rfl⟩ | ⟨p, q, -, rfl⟩
  · simp
  · exact Finset.card_le_two

/-- **The 1-skeleton of the bad-edge link is the square grid**: `ℤ² ≃ g` the graph of good link vertices and ambient edges. -/
def badEdgeLinkIso (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0) :
    gridGraph ≃g goodLinkGraph g :=
  goodLinkGraphIso g h0 h1 (residue_two_ne_zero g h0 h1)

/-- Nearest-neighbour adjacency is "the vectors differ by `±b` or `±c`". -/
theorem gridAdjacent_iff_coordinate_diff (p q : ℤ × ℤ) :
    GridAdjacent p q ↔ (p.1 - q.1 = 1 ∧ p.2 = q.2) ∨ (p.1 - q.1 = -1 ∧ p.2 = q.2) ∨
      (p.1 = q.1 ∧ p.2 - q.2 = 1) ∨ (p.1 = q.1 ∧ p.2 - q.2 = -1) := by
  unfold GridAdjacent
  omega

/-- **Edges are given by differences `±b`, `±c`:** two coordinates are adjacent iff the complement vectors differ by `b`, `-b`, `c` or `-c`. -/
theorem gridAdjacent_iff_vector_diff (g : IntegralGL) (p q : ℤ × ℤ) :
    GridAdjacent p q ↔
      complementVector g p - complementVector g q ∈
        ({rationalRepresentation g (Pi.single 0 1), -rationalRepresentation g (Pi.single 0 1),
          rationalRepresentation g (Pi.single 1 1), -rationalRepresentation g (Pi.single 1 1)} :
          Set Space) := by
  have hdiff : complementVector g p - complementVector g q =
      rationalRepresentation g (((p.1 - q.1 : ℤ) : ℚ) • (Pi.single 0 1 : Space) +
        ((p.2 - q.2 : ℤ) : ℚ) • (Pi.single 1 1 : Space)) := by
    unfold complementVector
    simp only [map_add, map_smul, Int.cast_sub]
    module
  rw [hdiff, gridAdjacent_iff_coordinate_diff]
  have hinj := (rationalRepresentation g).injective
  have hb : ∀ v : Space, rationalRepresentation g v = rationalRepresentation g (Pi.single 0 1) ↔
      v = Pi.single 0 1 := fun v => hinj.eq_iff
  have hc : ∀ v : Space, rationalRepresentation g v = rationalRepresentation g (Pi.single 1 1) ↔
      v = Pi.single 1 1 := fun v => hinj.eq_iff
  have hnb : ∀ v : Space, rationalRepresentation g v = -rationalRepresentation g (Pi.single 0 1) ↔
      v = -Pi.single 0 1 := fun v => by rw [← map_neg]; exact hinj.eq_iff
  have hnc : ∀ v : Space, rationalRepresentation g v = -rationalRepresentation g (Pi.single 1 1) ↔
      v = -Pi.single 1 1 := fun v => by rw [← map_neg]; exact hinj.eq_iff
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, hb, hc, hnb, hnc]
  have iff1 : ∀ a d : ℤ, (((a : ℚ) • (Pi.single 0 1 : Space) + (d : ℚ) • (Pi.single 1 1 : Space)) =
      Pi.single 0 1) ↔ (a = 1 ∧ d = 0) := by
    intro a d
    constructor
    · intro h
      have h0 := congrFun h 0
      have h1 := congrFun h 1
      simp at h0 h1
      exact ⟨by exact_mod_cast h0, by exact_mod_cast h1⟩
    · rintro ⟨rfl, rfl⟩; simp
  have iff2 : ∀ a d : ℤ, (((a : ℚ) • (Pi.single 0 1 : Space) + (d : ℚ) • (Pi.single 1 1 : Space)) =
      -Pi.single 0 1) ↔ (a = -1 ∧ d = 0) := by
    intro a d
    constructor
    · intro h
      have h0 := congrFun h 0
      have h1 := congrFun h 1
      simp at h0 h1
      exact ⟨by exact_mod_cast h0, by exact_mod_cast h1⟩
    · rintro ⟨rfl, rfl⟩; simp
  have iff3 : ∀ a d : ℤ, (((a : ℚ) • (Pi.single 0 1 : Space) + (d : ℚ) • (Pi.single 1 1 : Space)) =
      Pi.single 1 1) ↔ (a = 0 ∧ d = 1) := by
    intro a d
    constructor
    · intro h
      have h0 := congrFun h 0
      have h1 := congrFun h 1
      simp at h0 h1
      exact ⟨by exact_mod_cast h0, by exact_mod_cast h1⟩
    · rintro ⟨rfl, rfl⟩; simp
  have iff4 : ∀ a d : ℤ, (((a : ℚ) • (Pi.single 0 1 : Space) + (d : ℚ) • (Pi.single 1 1 : Space)) =
      -Pi.single 1 1) ↔ (a = 0 ∧ d = -1) := by
    intro a d
    constructor
    · intro h
      have h0 := congrFun h 0
      have h1 := congrFun h 1
      simp at h0 h1
      exact ⟨by exact_mod_cast h0, by exact_mod_cast h1⟩
    · rintro ⟨rfl, rfl⟩; simp
  rw [iff1, iff2, iff3, iff4]
  constructor <;> intro h <;> omega

/-- The grid is connected. -/
theorem gridGraph_connected : gridGraph.Connected := by
  have hx : ∀ b a : ℤ, gridGraph.Reachable (0, b) (a, b) := by
    intro b a
    induction a using Int.induction_on with
    | zero => exact SimpleGraph.Reachable.refl _
    | succ n ih =>
      refine ih.trans (SimpleGraph.Adj.reachable ?_)
      exact Or.inl ⟨rfl, by simp⟩
    | pred n ih =>
      refine ih.trans (SimpleGraph.Adj.reachable ?_)
      exact Or.inl ⟨rfl, by simp⟩
  have hy : ∀ b : ℤ, gridGraph.Reachable (0, 0) (0, b) := by
    intro b
    induction b using Int.induction_on with
    | zero => exact SimpleGraph.Reachable.refl _
    | succ n ih =>
      refine ih.trans (SimpleGraph.Adj.reachable ?_)
      exact Or.inr ⟨rfl, by simp⟩
    | pred n ih =>
      refine ih.trans (SimpleGraph.Adj.reachable ?_)
      exact Or.inr ⟨rfl, by simp⟩
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  exact ⟨(0, 0), fun p => (hy p.2).trans (hx p.2 p.1)⟩

/-- **The bad-edge link is connected.** -/
theorem bad_edge_link_connected (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0) :
    (goodLinkGraph g).Connected :=
  (badEdgeLinkIso g h0 h1).connected_iff.mp gridGraph_connected

/-- **`H₁` of the bad-edge link is generated by unit squares**: every 1-cycle of the link (a chain of the
link complex with zero boundary) is a rational combination of the boundaries of unit squares of the grid, transported to the link;
the link has no faces with three vertices, so its `H₁` is its cycle space. -/
theorem bad_edge_link_H1_generated_by_squares (g : IntegralGL) (h0 : columnResidue g 0 = 0)
    (h1 : columnResidue g 1 = 0) {c : Chain RationalLine}
    (hc : c ∈ chains (BadEdgeLinkChains.link g) 2) (hz : boundary c = 0) :
    ∃ z : IntegerGridExactness.C₂,
      c = (BadEdgeLinkChains.edgeTransport g h0 h1 (residue_two_ne_zero g h0 h1)
        (IntegerGridExactness.boundary₂ z)).val :=
  BadEdgeLinkChains.supported_cycle_generated_by_squares g h0 h1 (residue_two_ne_zero g h0 h1) hc hz

/-- A unit square is a cycle of the link; its four edges are the literal edges `p→p+e₁→p+e₁+e₂←p+e₂←p`. -/
theorem unit_square_is_cycle (g : IntegralGL) (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (p : ℤ × ℤ) :
    (BadEdgeLinkChains.squareLoop g h0 h1 (residue_two_ne_zero g h0 h1) p).val ∈
        chains (BadEdgeLinkChains.link g) 2 ∧
      boundary (BadEdgeLinkChains.squareLoop g h0 h1 (residue_two_ne_zero g h0 h1) p).val = 0 :=
  ⟨(BadEdgeLinkChains.squareLoop g h0 h1 (residue_two_ne_zero g h0 h1) p).property,
    congrArg Subtype.val (BadEdgeLinkChains.squareLoop_boundary g h0 h1 (residue_two_ne_zero g h0 h1) p)⟩

end TernaryPeriodPolynomials.Argument.AppendixA.Links
