module

public import TernaryPeriodPolynomials.Building.BipartitePathChains
public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.Algebra.GroupWithZero.Action.Regular
public import Mathlib.Algebra.Module.Submodule.EqLocus
public import Mathlib.Algebra.Module.Torsion.Field

@[expose] public section

noncomputable section
namespace TernaryPoly.BipartitePathChains

variable {L P : Type*} (r : L → P → Prop)

/-- Chosen actual chains from each vertex to one common base vertex. -/
structure PathFamily (base : Vertex L P) where
  path : Vertex L P → Chain₁ r
  boundary_path : ∀ v, boundary r (path v) = Finsupp.single base 1 - Finsupp.single v 1

namespace PathFamily
variable {r} {base : Vertex L P} (τ : PathFamily r base)

/-- Extend the chosen paths linearly from the free vertex module. -/
def linear : Chain₀ L P →ₗ[ℚ] Chain₁ r :=
  Finsupp.lsum ℚ fun v => LinearMap.toSpanSingleton ℚ (Chain₁ r) (τ.path v)

@[simp] theorem linear_single (v : Vertex L P) (a : ℚ) :
    τ.linear (Finsupp.single v a) = a • τ.path v := by
  simp [linear]

/-- Close an arbitrary edge chain using the chosen paths at its boundary. -/
def projection : Chain₁ r →ₗ[ℚ] Chain₁ r :=
  LinearMap.id + τ.linear.comp (boundary r)

theorem projection_apply (c : Chain₁ r) :
    τ.projection c = c + τ.linear (boundary r c) := rfl

/-- Each generator is the original edge followed by the two chosen closing paths. -/
theorem projection_single (e : Edge r) :
    τ.projection (Finsupp.single e 1) =
      Finsupp.single e 1 + τ.path (.inr e.val.2) - τ.path (.inl e.val.1) := by
  rw [projection_apply,boundary_single,map_sub,linear_single,linear_single]
  simp only [one_smul]
  abel

/-- Every closed edge with its chosen paths is an actual cycle. -/
theorem boundary_projection (c : Chain₁ r) : boundary r (τ.projection c) = 0 := by
  induction c using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add c d hc hd => simp only [map_add,hc,hd,add_zero]
  | single e a =>
    have he : Finsupp.single e a = a • Finsupp.single e (1 : ℚ) := by simp
    rw [he,map_smul,map_smul,projection_single,map_sub,map_add,boundary_single,
      τ.boundary_path,τ.boundary_path]
    have hz : (Finsupp.single (.inr e.val.2) (1 : ℚ) - Finsupp.single (.inl e.val.1) 1) +
        (Finsupp.single base 1 - Finsupp.single (.inr e.val.2) 1) -
        (Finsupp.single base 1 - Finsupp.single (.inl e.val.1) 1) = 0 := by abel
    rw [hz,smul_zero]

/-- The projection is the identity on the literal kernel of the incidence boundary. -/
theorem projection_eq_self {c : Chain₁ r} (hc : c ∈ LinearMap.ker (boundary r)) :
    τ.projection c = c := by
  rw [projection_apply,LinearMap.mem_ker.mp hc,map_zero,add_zero]

/-- Bundle the projection into the actual cycle module. -/
def toCycles : Chain₁ r →ₗ[ℚ] LinearMap.ker (boundary r) :=
  τ.projection.codRestrict _ (fun c => τ.boundary_projection c)

/-- All cycles are generated by the finitely supported single-edge projections. -/
theorem toCycles_surjective : Function.Surjective τ.toCycles := by
  intro c
  refine ⟨c.val, ?_⟩
  apply Subtype.ext
  exact τ.projection_eq_self c.property

/-- A functional on cycles is determined by its values on the explicit closed edge chains. -/
theorem functional_ext {E : Type*} [AddCommGroup E] [Module ℚ E]
    (F H : LinearMap.ker (boundary r) →ₗ[ℚ] E)
    (h : ∀ e : Edge r, F (τ.toCycles (Finsupp.single e 1)) =
      H (τ.toCycles (Finsupp.single e 1))) : F = H := by
  have he : F.comp τ.toCycles = H.comp τ.toCycles := by
    apply Finsupp.lhom_ext'
    intro e
    apply LinearMap.ext
    intro a
    have ha : Finsupp.single e a = a • Finsupp.single e (1 : ℚ) := by simp
    simpa only [LinearMap.comp_apply,Finsupp.lsingle_apply,ha,map_smul] using
      congrArg (fun q : E => a • q) (h e)
  apply LinearMap.ext
  intro c
  obtain ⟨d,rfl⟩ := τ.toCycles_surjective c
  exact LinearMap.congr_fun he d

end PathFamily

/-- Connected incidence graphs have actual path families with the chosen orientation. -/
def connectedPathFamily (hc : (graph r).Preconnected) (base : Vertex L P) :
    PathFamily r base where
  path := pathsToBase r hc base
  boundary_path := boundary_pathsToBase r hc base

end TernaryPoly.BipartitePathChains
