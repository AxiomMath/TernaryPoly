module

public import TernaryPeriodPolynomials.Building.OrientedChain.VertexChains
public import TernaryPeriodPolynomials.Building.BadTriangle.Link
public import TernaryPeriodPolynomials.Building.Good.LinkExtraction

@[expose] public section

noncomputable section
namespace TernaryPoly.BadTriangleLinkChains
open ModThreeGoodAction AugmentedFrameComplex AugmentedBadFaces BadEdgeLinkVertices
open OrientedListChains OrientedVertexChains GoodLinkExtraction
open BadTriangleLink
local instance : DecidableEq RationalLine := Classical.decEq _

/-- The actual singleton vertices of the Good link are exactly the complement vertices. -/
theorem singleton_mem_link_iff (g : IntegralGL) (L : RationalLine) :
    {L} ∈ augmentedGoodLink (augmentedCore g) ↔
      (Good L.val ∧ {augmentedLine g 0,augmentedLine g 1,augmentedLine g 3,L} ∈ ambient) := by
  have hu : augmentedCore g ∪ {L} =
      ({augmentedLine g 0,augmentedLine g 1,augmentedLine g 3,L} : Finset RationalLine) := by
    ext M
    simp only [augmentedCore,Finset.mem_union,Finset.mem_insert,Finset.mem_singleton,or_assoc]
  rw [augmentedGoodLink,mem_goodLink,hu]
  simp [and_comm]

/-- Transport from the literal finitely supported complement model to actual oriented singleton chains. -/
def toOriented (g : IntegralGL) : ComplementChains g →ₗ[ℚ] Chain RationalLine :=
  singletonMap (fun L : GoodTriangleLinkVertex g => L.val)

@[simp] theorem toOriented_single (g : IntegralGL) (L : GoodTriangleLinkVertex g) (q : ℚ) :
    toOriented g (Finsupp.single L q) = q • simplex [L.val] := singletonMap_single _ _ _

/-- Every actual link degree-one chain has an actual finitely supported complement representative. -/
theorem exists_complement_chain (g : IntegralGL) {c : Chain RationalLine}
    (hc : c ∈ chains (augmentedGoodLink (augmentedCore g)) 1) :
    ∃ z : ComplementChains g, toOriented g z = c := by
  apply exists_singletonMap (augmentedGoodLink (augmentedCore g))
    (fun L : GoodTriangleLinkVertex g => L.val) _ hc
  intro L hL
  have hp := (singleton_mem_link_iff g L).mp hL
  refine ⟨⟨L,hp.1,?_⟩,rfl⟩
  apply (ambient.isRelLowerSet_faces hp.2).2
  · intro A hA
    simpa only [Finset.mem_insert,Finset.mem_singleton] using hA
  · simp

/-- An actual oriented zero-cycle forces zero augmentation of any complement representative. -/
theorem augmentation_eq_zero_of_oriented_boundary (g : IntegralGL) (z : ComplementChains g)
    (hz : boundary (toOriented g z) = 0) : augmentation g z = 0 :=
  coefficientSum_eq_zero_of_boundary (fun L : GoodTriangleLinkVertex g => L.val) z hz

/-- A coordinate-neighbor generator is the actual difference of two oriented singleton simplices. -/
def orientedNeighbor (g : IntegralGL) (e : IntegerGridExactness.Edge) : Chain RationalLine :=
  simplex [coordinateLine g (IntegerGridExactness.edgeHead e)] - simplex [coordinateLine g e.1]

/-- Finite rational combinations of the displayed actual singleton differences. -/
def orientedCombination (g : IntegralGL) : IntegerGridExactness.C₁ →ₗ[ℚ] Chain RationalLine :=
  Finsupp.linearCombination ℚ (orientedNeighbor g)

/-- The finitely supported neighbor generator maps to the literal oriented difference. -/
theorem toOriented_neighborDifference (g : IntegralGL)
    (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (h2 : columnResidue g 2 ≠ 0) (e : IntegerGridExactness.Edge) :
    toOriented g (neighborDifference g h0 h1 h2 e) = orientedNeighbor g e := by
  simp only [neighborDifference,map_sub,toOriented_single,one_smul,coordinateEquiv_val,
    orientedNeighbor]

/-- Finite neighbor combinations commute exactly with transport to actual oriented chains. -/
theorem toOriented_neighborCombination (g : IntegralGL)
    (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (h2 : columnResidue g 2 ≠ 0) (z : IntegerGridExactness.C₁) :
    toOriented g (neighborCombination g h0 h1 h2 z) = orientedCombination g z := by
  induction z using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add z w hz hw => simp only [map_add,hz,hw]
  | single e q =>
    rw [neighborCombination_single,map_smul,toOriented_neighborDifference,
      orientedCombination,Finsupp.linearCombination_single]

/-- Every actual reduced zero-cycle in the discrete bad-triangle link is generated by coordinate-neighbor differences. -/
theorem exists_oriented_neighbor_combination (g : IntegralGL)
    (h0 : columnResidue g 0 = 0) (h1 : columnResidue g 1 = 0)
    (h2 : columnResidue g 2 ≠ 0) {c : Chain RationalLine}
    (hc : c ∈ chains (augmentedGoodLink (augmentedCore g)) 1) (hd : boundary c = 0) :
    ∃ z : IntegerGridExactness.C₁, c =
      Finsupp.linearCombination ℚ (fun e =>
        simplex [coordinateLine g (IntegerGridExactness.edgeHead e)] -
          simplex [coordinateLine g e.1]) z := by
  obtain ⟨z,hz⟩ := exists_complement_chain g hc
  have haug : augmentation g z = 0 :=
    augmentation_eq_zero_of_oriented_boundary g z (by rwa [hz])
  have hker : z ∈ LinearMap.ker (augmentation g) := haug
  rw [ker_augmentation_eq_range_neighbors g h0 h1 h2] at hker
  obtain ⟨w,hw⟩ := hker
  refine ⟨w,?_⟩
  change c = orientedCombination g w
  calc
    c = toOriented g z := hz.symm
    _ = toOriented g (neighborCombination g h0 h1 h2 w) := congrArg (toOriented g) hw.symm
    _ = orientedCombination g w := toOriented_neighborCombination g h0 h1 h2 w

end TernaryPoly.BadTriangleLinkChains
