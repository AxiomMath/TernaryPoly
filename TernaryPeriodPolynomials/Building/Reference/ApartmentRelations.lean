module

public import TernaryPeriodPolynomials.Building.Reference.CoefficientMatrices
public import TernaryPeriodPolynomials.Building.Good.UnimodularOrbit

@[expose] public section


noncomputable section
namespace TernaryPoly.ReferenceApartmentRelations
open ModThreeGoodAction GoodIntegralFrames GoodLatticeReduction
open GoodIncidenceConnected GoodApartmentCycles ReferenceCoefficientMatrices

theorem identity_normalized : NormalizedColumns (1 : Mat) := by unfold NormalizedColumns; decide +kernel
private theorem a_normalized : NormalizedColumns aMatrix := by unfold NormalizedColumns; decide +kernel
private theorem aInverse_normalized : NormalizedColumns aInverseMatrix := by unfold NormalizedColumns; decide +kernel
private theorem c_normalized : NormalizedColumns cMatrix := by unfold NormalizedColumns; decide +kernel
private theorem s_normalized : NormalizedColumns sMatrix := by unfold NormalizedColumns; decide +kernel

/-- The three actual coordinate lines with their residue-one generators. -/
def coordinateLine (j : Fin 3) : Line Good := columnLine 1 identity_normalized j

/-- The extra residue-one vector appearing in the reference order-three orbit. -/
def rootVector : IntegralVector := ![-1,-1,0]

theorem rootVector_residue : ∑ i, (rootVector i : ZMod 3) = 1 := by decide +kernel

/-- The actual good line generated by the negative sum of the first two basis vectors. -/
def rootLine : Line Good := vectorLine rootVector rootVector_residue

private theorem columnLine_eq_of_vectors {M N : Mat} (hM : NormalizedColumns M)
    (hN : NormalizedColumns N) (j k : Fin 3) (h : (fun i => M i j) = (fun i => N i k)) :
    columnLine M hM j = columnLine N hN k := by
  apply Subtype.ext
  exact congrArg (fun v => Submodule.span ℚ {rationalVector v}) h

private theorem columnLine_eq_root {M : Mat} (hM : NormalizedColumns M)
    (j : Fin 3) (h : (fun i => M i j) = rootVector) :
    columnLine M hM j = rootLine := by
  apply Subtype.ext
  exact congrArg (fun v => Submodule.span ℚ {rationalVector v}) h

private theorem a_columns :
    columnLine aMatrix a_normalized 0 = coordinateLine 1 ∧
    columnLine aMatrix a_normalized 1 = rootLine ∧
    columnLine aMatrix a_normalized 2 = coordinateLine 2 := by
  exact ⟨columnLine_eq_of_vectors _ identity_normalized 0 1 (by decide +kernel),
    columnLine_eq_root _ 1 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 2 2 (by decide +kernel)⟩

private theorem aInverse_columns :
    columnLine aInverseMatrix aInverse_normalized 0 = rootLine ∧
    columnLine aInverseMatrix aInverse_normalized 1 = coordinateLine 0 ∧
    columnLine aInverseMatrix aInverse_normalized 2 = coordinateLine 2 := by
  exact ⟨columnLine_eq_root _ 0 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 1 0 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 2 2 (by decide +kernel)⟩

private theorem c_columns :
    columnLine cMatrix c_normalized 0 = coordinateLine 1 ∧
    columnLine cMatrix c_normalized 1 = coordinateLine 2 ∧
    columnLine cMatrix c_normalized 2 = coordinateLine 0 := by
  exact ⟨columnLine_eq_of_vectors _ identity_normalized 0 1 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 1 2 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 2 0 (by decide +kernel)⟩

private theorem s_columns :
    columnLine sMatrix s_normalized 0 = coordinateLine 1 ∧
    columnLine sMatrix s_normalized 1 = coordinateLine 0 ∧
    columnLine sMatrix s_normalized 2 = coordinateLine 2 := by
  exact ⟨columnLine_eq_of_vectors _ identity_normalized 0 1 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 1 0 (by decide +kernel),
    columnLine_eq_of_vectors _ identity_normalized 2 2 (by decide +kernel)⟩

private theorem coordinate_zero_ne_one : coordinateLine 0 ≠ coordinateLine 1 := by
  intro h
  have hx : rationalVector (fun i => (1 : Mat) i 0) ∈ (coordinateLine 1).val := by
    rw [← h]
    exact Submodule.subset_span (Set.mem_singleton _)
  obtain ⟨t,ht⟩ := Submodule.mem_span_singleton.mp hx
  have ht0 := congrFun ht 0
  norm_num [rationalVector] at ht0

private def coordinatePlane : Plane Good :=
  spanPlane Good (coordinateLine 0) (coordinateLine 1) coordinate_zero_ne_one

private theorem rootVector_eq : rationalVector rootVector =
    -rationalVector (fun i => (1 : Mat) i 0) -
      rationalVector (fun i => (1 : Mat) i 1) := by
  funext i
  fin_cases i <;> norm_num [rationalVector,rootVector]

private theorem rootLine_le_plane : rootLine.val ≤ coordinatePlane.val := by
  apply Submodule.span_le.mpr
  intro v hv
  rcases Set.mem_singleton_iff.mp hv with rfl
  rw [rootVector_eq]
  apply Submodule.sub_mem
  · apply Submodule.neg_mem
    exact (show (coordinateLine 0).val ≤ coordinatePlane.val from le_sup_left)
      (Submodule.subset_span (Set.mem_singleton _))
  · exact (show (coordinateLine 1).val ≤ coordinatePlane.val from le_sup_right)
      (Submodule.subset_span (Set.mem_singleton _))

/-- The three lines in the first coordinate plane have zero literal apartment cycle. -/
theorem coordinate_root_collinear :
    apartmentCycle Good (coordinateLine 0) (coordinateLine 1) rootLine = 0 :=
  apartmentCycle_collinear Good _ _ _ coordinatePlane le_sup_left le_sup_right rootLine_le_plane

/-- The three oriented reference apartments sum to zero in the actual cycle kernel. -/
theorem coordinate_norm :
    apartmentCycle Good (coordinateLine 0) (coordinateLine 1) (coordinateLine 2) +
      apartmentCycle Good (coordinateLine 1) rootLine (coordinateLine 2) +
      apartmentCycle Good rootLine (coordinateLine 0) (coordinateLine 2) = 0 := by
  have h := apartmentCycle_four Good (coordinateLine 0) (coordinateLine 1)
    rootLine (coordinateLine 2)
  rw [coordinate_root_collinear] at h
  rw [apartmentCycle_swap Good (coordinateLine 0) rootLine (coordinateLine 2)]
  simpa only [sub_zero, sub_eq_add_neg, neg_zero, add_zero, add_comm, add_left_comm, add_assoc] using h

/-- The reference apartment written as its three actual coordinate lines. -/
theorem referenceApartment_eq_coordinates : GoodUnimodularOrbit.referenceApartment =
    apartmentCycle Good (coordinateLine 0) (coordinateLine 1) (coordinateLine 2) := rfl

/-- The literal cyclic reference matrix fixes the oriented reference apartment. -/
theorem reference_c :
    GoodChainComplex.complex.cyclesAction cK GoodUnimodularOrbit.referenceApartment =
      GoodUnimodularOrbit.referenceApartment := by
  rw [← GoodUnimodularOrbit.frameApartment_val_eq_translate, referenceApartment_eq_coordinates]
  change frameApartment cMatrix c_normalized = _
  rw [frameApartment, c_columns.1, c_columns.2.1, c_columns.2.2]
  exact apartmentCycle_cyclic Good _ _ _

/-- The literal transposition reverses the orientation of the reference apartment. -/
theorem reference_s :
    GoodChainComplex.complex.cyclesAction sK GoodUnimodularOrbit.referenceApartment =
      -GoodUnimodularOrbit.referenceApartment := by
  rw [← GoodUnimodularOrbit.frameApartment_val_eq_translate, referenceApartment_eq_coordinates]
  change frameApartment sMatrix s_normalized = _
  rw [frameApartment, s_columns.1, s_columns.2.1, s_columns.2.2]
  exact apartmentCycle_swap Good _ _ _

/-- The first norm translate has the exact three column lines of the literal matrix. -/
theorem reference_a :
    GoodChainComplex.complex.cyclesAction aK GoodUnimodularOrbit.referenceApartment =
      apartmentCycle Good (coordinateLine 1) rootLine (coordinateLine 2) := by
  rw [← GoodUnimodularOrbit.frameApartment_val_eq_translate]
  change frameApartment aMatrix a_normalized = _
  rw [frameApartment, a_columns.1, a_columns.2.1, a_columns.2.2]

private theorem aK_sq_eq_inverse : aK^2 = aK⁻¹ := by
  apply Subtype.ext
  exact a_inv_eq_sq.symm

/-- The second norm translate has the exact three column lines of the inverse matrix. -/
theorem reference_a_sq :
    GoodChainComplex.complex.cyclesAction (aK^2) GoodUnimodularOrbit.referenceApartment =
      apartmentCycle Good rootLine (coordinateLine 0) (coordinateLine 2) := by
  rw [aK_sq_eq_inverse, ← GoodUnimodularOrbit.frameApartment_val_eq_translate]
  change frameApartment aInverseMatrix aInverse_normalized = _
  rw [frameApartment, aInverse_columns.1, aInverse_columns.2.1, aInverse_columns.2.2]

/-- The actual reference apartment obeys the order-three norm relation. -/
theorem reference_norm : GoodUnimodularOrbit.referenceApartment +
    GoodChainComplex.complex.cyclesAction aK GoodUnimodularOrbit.referenceApartment +
    GoodChainComplex.complex.cyclesAction (aK^2) GoodUnimodularOrbit.referenceApartment = 0 := by
  rw [reference_a, reference_a_sq, referenceApartment_eq_coordinates]
  exact coordinate_norm

/-- Evaluating an actual polynomial cycle map at the coordinate apartment. -/
def referenceValue {n : ℕ} {e : ℤ} (F : GoodChainComplex.PolynomialCycleMap n e) :
    TernaryPolynomial := F.map GoodUnimodularOrbit.referenceApartment

/-- The actual homogeneous coefficient restriction has the full polynomial action as its value. -/
theorem coefficientAction_coe (n : ℕ) (e : ℤ) (g : GoodBuilding.K)
    (f : PolynomialGLAction.HomogeneousPoly n) :
    ((GoodChainComplex.coefficientAction n e g f : PolynomialGLAction.HomogeneousPoly n) :
        TernaryPolynomial) = ReferenceCoefficientMatrices.coefficientAction e g.val f := rfl

/-- Cyclic invariance of a cycle map's reference value follows from the actual cycle action. -/
theorem referenceValue_cyclic {n : ℕ} {e : ℤ} (F : GoodChainComplex.PolynomialCycleMap n e) :
    TernaryPoly.C (referenceValue F) = referenceValue F := by
  have h := congrArg Subtype.val (F.equivariant cK GoodUnimodularOrbit.referenceApartment)
  rw [reference_c, coefficientAction_coe] at h
  change referenceValue F = ReferenceCoefficientMatrices.coefficientAction e c (referenceValue F) at h
  rw [ReferenceCoefficientMatrices.coefficientAction_c] at h
  exact h.symm

/-- The norm of a cycle map's reference value follows from the actual cycle relation. -/
theorem referenceValue_norm {n : ℕ} {e : ℤ} (F : GoodChainComplex.PolynomialCycleMap n e) :
    N (referenceValue F) = 0 := by
  apply (ReferenceCoefficientMatrices.norm_iff e (referenceValue F)).mpr
  have h := congrArg (fun z => ((F.map z : PolynomialGLAction.HomogeneousPoly n) :
    TernaryPolynomial)) reference_norm
  simp only [map_add, map_zero, F.equivariant, Submodule.coe_add, Submodule.coe_zero,
    coefficientAction_coe, Subgroup.coe_pow] at h
  change referenceValue F + ReferenceCoefficientMatrices.coefficientAction e a (referenceValue F) +
    ReferenceCoefficientMatrices.coefficientAction e (a^2) (referenceValue F) = 0 at h
  exact h

/-- Every genuine cycle map produces a polynomial satisfying the exact period relations. -/
theorem referenceValue_periodRelations {n : ℕ} {e : ℤ}
    (F : GoodChainComplex.PolynomialCycleMap n e) : PeriodRelations (referenceValue F) :=
  ⟨referenceValue_cyclic F, referenceValue_norm F⟩

/-- The determinant-twisted transposition acts by minus one on the reference value. -/
theorem referenceValue_swap_character {n : ℕ} {e : ℤ}
    (F : GoodChainComplex.PolynomialCycleMap n e) :
    (-1 : ℚ)^e • S (referenceValue F) = -referenceValue F := by
  have h := congrArg Subtype.val (F.equivariant sK GoodUnimodularOrbit.referenceApartment)
  rw [reference_s, map_neg, coefficientAction_coe] at h
  change -referenceValue F = ReferenceCoefficientMatrices.coefficientAction e s (referenceValue F) at h
  rw [ReferenceCoefficientMatrices.coefficientAction_s] at h
  exact h.symm

/-- Untwisted reference values are alternating under the literal swap. -/
theorem referenceValue_alternating {n : ℕ} (F : GoodChainComplex.PolynomialCycleMap n 0) :
    S (referenceValue F) = -referenceValue F := by
  simpa only [zpow_zero, one_smul] using referenceValue_swap_character F

/-- Determinant-minus-one reference values are symmetric under the literal swap. -/
theorem referenceValue_symmetric {n : ℕ} (F : GoodChainComplex.PolynomialCycleMap n (-1)) :
    S (referenceValue F) = referenceValue F := by
  have h := referenceValue_swap_character F
  norm_num at h
  exact h

end TernaryPoly.ReferenceApartmentRelations
