module

public import TernaryPeriodPolynomials.EisensteinSeries.Class.Nilp
public import Mathlib.RingTheory.Nilpotent.Basic
public import TernaryPeriodPolynomials.EisensteinSeries.Class.Periodic

@[expose] public section


/-!
# Unipotent representations of `ℝ²` and the lattice ideal

`UniRep σ`: `σ : ℝ² → End(Coef n)` additive, continuous, with every `σ v - 1` nilpotent. For the lattice
`c ℤ²` let `idealA σ c` be the set of `T₁ (σ(c e₀) - 1) + T₂ (σ(c e₁) - 1)` with `Tᵢ` commuting with the
representation. **`sub_one_mem_idealA`: for every real `v`, `σ v - 1 ∈ idealA σ c`.** (The set of such `v`
is an additive subgroup containing the lattice; `m v` in it implies `v` in it because
`(σ v - 1) Σ_{i<m} σ(v)^i = σ(v)^m - 1` and the sum is a unit, `m` plus a nilpotent; and the set is closed and
contains the dense rational points.) Consequently a vector fixed by the lattice generators is fixed by the
whole representation (`UniRep.fix_of_gens`). `uniRep_trL`: `ρ(t_v)` is such a representation.

Formalized by Claude Sonnet 5.5.
-/

open scoped ContDiff
noncomputable section
namespace TernaryPeriodPolynomials.Argument.EisensteinClass

open TernaryPeriodPolynomials.Argument.SeedC3

variable {n : ℕ}

/-- A unipotent representation of the additive group `ℝ²` on `Coef n`. -/
structure UniRep (σ : (Fin 2 → ℝ) → (Coef n →L[ℝ] Coef n)) : Prop where
  add : ∀ v w, σ (v + w) = σ v * σ w
  zero : σ 0 = 1
  smooth : ContDiff ℝ ∞ σ
  nilp : ∀ v, IsNilpotent (σ v - 1)

variable {σ : (Fin 2 → ℝ) → (Coef n →L[ℝ] Coef n)}

theorem UniRep.cont (h : UniRep σ) : Continuous σ := h.smooth.continuous

theorem UniRep.comm (h : UniRep σ) (v w : Fin 2 → ℝ) : Commute (σ v) (σ w) := by
  show σ v * σ w = σ w * σ v
  rw [← h.add, ← h.add, add_comm]

/-- Elements commuting with the whole representation. -/
def Comm (σ : (Fin 2 → ℝ) → (Coef n →L[ℝ] Coef n)) (T : Coef n →L[ℝ] Coef n) : Prop :=
  ∀ w, Commute T (σ w)

/-- The ideal generated by `σ(c e₀) - 1`, `σ(c e₁) - 1` in the commutant. -/
def idealA (σ : (Fin 2 → ℝ) → (Coef n →L[ℝ] Coef n)) (c : ℝ) : Submodule ℝ (Coef n →L[ℝ] Coef n) where
  carrier := {S | ∃ T₁ T₂, Comm σ T₁ ∧ Comm σ T₂ ∧
    S = T₁ * (σ (c • Pi.single 0 1) - 1) + T₂ * (σ (c • Pi.single 1 1) - 1)}
  zero_mem' := ⟨0, 0, fun w => Commute.zero_left _, fun w => Commute.zero_left _, by simp⟩
  add_mem' := by
    rintro _ _ ⟨T₁, T₂, h₁, h₂, rfl⟩ ⟨U₁, U₂, g₁, g₂, rfl⟩
    refine ⟨T₁ + U₁, T₂ + U₂, fun w => (h₁ w).add_left (g₁ w), fun w => (h₂ w).add_left (g₂ w), ?_⟩
    simp only [add_mul]; abel
  smul_mem' := by
    rintro r _ ⟨T₁, T₂, h₁, h₂, rfl⟩
    refine ⟨r • T₁, r • T₂, fun w => (h₁ w).smul_left r, fun w => (h₂ w).smul_left r, ?_⟩
    simp only [smul_mul_assoc, smul_add]

theorem Comm.one : Comm σ 1 := fun _ => Commute.one_left _

theorem Comm.mul {T U : Coef n →L[ℝ] Coef n} (hT : Comm σ T) (hU : Comm σ U) : Comm σ (T * U) :=
  fun w => (hT w).mul_left (hU w)

theorem Comm.sigma (h : UniRep σ) (v : Fin 2 → ℝ) : Comm σ (σ v) := fun w => h.comm v w

theorem idealA_mul_left {c : ℝ} {T S : Coef n →L[ℝ] Coef n} (hT : Comm σ T)
    (hS : S ∈ idealA σ c) : T * S ∈ idealA σ c := by
  obtain ⟨T₁, T₂, h₁, h₂, rfl⟩ := hS
  refine ⟨T * T₁, T * T₂, hT.mul h₁, hT.mul h₂, ?_⟩
  simp only [mul_add, mul_assoc]

theorem idealA_mul_right {c : ℝ} {T S : Coef n →L[ℝ] Coef n} (hT : Comm σ T)
    (hS : S ∈ idealA σ c) : S * T ∈ idealA σ c := by
  obtain ⟨T₁, T₂, h₁, h₂, rfl⟩ := hS
  have hc : ∀ v : Fin 2 → ℝ, Commute (σ v - 1) T := fun v =>
    ((hT v).symm.sub_left (Commute.one_left T))
  refine ⟨T₁ * T, T₂ * T, h₁.mul hT, h₂.mul hT, ?_⟩
  simp only [add_mul, mul_assoc, (hc _).eq]

/-- The set of translation vectors `v` with `σ v - 1` in the ideal. -/
def idealSet (h : UniRep σ) (c : ℝ) : AddSubgroup (Fin 2 → ℝ) where
  carrier := {v | σ v - 1 ∈ idealA σ c}
  zero_mem' := by
    show σ 0 - 1 ∈ idealA σ c
    rw [h.zero, sub_self]; exact zero_mem _
  add_mem' := by
    intro v w hv hw
    show σ (v + w) - 1 ∈ idealA σ c
    have e : σ (v + w) - 1 = σ v * (σ w - 1) + (σ v - 1) := by
      rw [h.add]; noncomm_ring
    rw [e]
    exact add_mem (idealA_mul_left (Comm.sigma h v) hw) hv
  neg_mem' := by
    intro v hv
    show σ (-v) - 1 ∈ idealA σ c
    have e : σ (-v) - 1 = -(σ (-v) * (σ v - 1)) := by
      have : σ (-v) * σ v = 1 := by rw [← h.add, neg_add_cancel, h.zero]
      rw [mul_sub, this, mul_one]; abel
    rw [e]
    exact neg_mem (idealA_mul_left (Comm.sigma h (-v)) hv)

theorem mem_idealSet_gen (h : UniRep σ) (c : ℝ) (i : Fin 2) :
    c • Pi.single i 1 ∈ idealSet h c := by
  show σ (c • Pi.single i 1) - 1 ∈ idealA σ c
  fin_cases i
  · exact ⟨1, 0, Comm.one, fun w => Commute.zero_left _, by simp⟩
  · exact ⟨0, 1, fun w => Commute.zero_left _, Comm.one, by simp⟩

theorem lattice_mem_idealSet (h : UniRep σ) (c : ℝ) (m : Fin 2 → ℤ) :
    c • intVec m ∈ idealSet h c := by
  have e : c • intVec m = (m 0) • (c • (Pi.single 0 1 : Fin 2 → ℝ)) +
      (m 1) • (c • (Pi.single 1 1 : Fin 2 → ℝ)) := by
    funext i
    fin_cases i <;> simp [intVec]
  rw [e]
  exact add_mem (zsmul_mem (mem_idealSet_gen h c 0) _) (zsmul_mem (mem_idealSet_gen h c 1) _)

theorem sigma_nsmul (h : UniRep σ) (v : Fin 2 → ℝ) (m : ℕ) : σ (m • v) = σ v ^ m := by
  induction m with
  | zero => simp [h.zero]
  | succ m ih => rw [succ_nsmul, h.add, ih, pow_succ]

theorem mem_idealSet_of_nsmul (h : UniRep σ) (c : ℝ) {v : Fin 2 → ℝ} {m : ℕ} (hm : 0 < m)
    (hv : m • v ∈ idealSet h c) : v ∈ idealSet h c := by
  set x := σ v with hx
  have hxy : IsNilpotent (x - 1) := h.nilp v
  have hxc : ∀ w, Commute x (σ w) := fun w => h.comm v w
  have hsig : σ (m • v) - 1 ∈ idealA σ c := hv
  rw [sigma_nsmul h] at hsig
  set w : Coef n →L[ℝ] Coef n := ∑ i ∈ Finset.range m, x ^ i with hw
  have hgeom : w * (x - 1) = x ^ m - 1 := geom_sum_mul x m
  -- commutation of `x - 1` with the powers of `x`
  have hyx : Commute (x - 1) x := ((Commute.refl x).sub_left (Commute.one_left x))
  have hyxp : ∀ j : ℕ, Commute (x - 1) (x ^ j) := fun j => hyx.pow_right j
  have hxi : ∀ i : ℕ, IsNilpotent (x ^ i - 1) := by
    intro i
    rw [← mul_geom_sum x i] 
    refine Commute.isNilpotent_mul_right (x := x - 1) ?_ hxy
    exact (Commute.sum_right _ _ _ fun j _ => hyxp j)
  have hcomm_xi : ∀ i j : ℕ, Commute (x ^ i - 1) (x ^ j - 1) := fun i j =>
    (((Commute.refl x).pow_pow i j).sub_left (Commute.one_left _)).sub_right
      (((Commute.one_right _).sub_left (Commute.one_right _)))
  have hN : IsNilpotent (w - (m : ℝ) • (1 : Coef n →L[ℝ] Coef n)) := by
    have e : w - (m : ℝ) • (1 : Coef n →L[ℝ] Coef n) = ∑ i ∈ Finset.range m, (x ^ i - 1) := by
      rw [hw, Finset.sum_sub_distrib]
      simp only [Finset.sum_const, Finset.card_range]
      rw [Nat.cast_smul_eq_nsmul]
    rw [e]
    exact Commute.isNilpotent_sum (fun i _ => hxi i) (fun i j _ _ => hcomm_xi i j)
  have hm1 : IsUnit ((m : ℝ) • (1 : Coef n →L[ℝ] Coef n)) := by
    have : (m : ℝ) • (1 : Coef n →L[ℝ] Coef n) = algebraMap ℝ (Coef n →L[ℝ] Coef n) (m : ℝ) := by
      rw [Algebra.algebraMap_eq_smul_one]
    rw [this]
    exact IsUnit.map _ (isUnit_iff_ne_zero.2 (by exact_mod_cast hm.ne'))
  have hcN : Commute (w - (m : ℝ) • (1 : Coef n →L[ℝ] Coef n)) ((m : ℝ) • (1 : Coef n →L[ℝ] Coef n)) := by
    simp [Commute, SemiconjBy]
  have hunit : IsUnit w := by
    have := hN.isUnit_add_left_of_commute hm1 hcN
    simpa using this
  obtain ⟨u, hu⟩ := hunit
  have hcu : Comm σ (↑u⁻¹ : Coef n →L[ℝ] Coef n) := by
    intro w'
    have : Commute w (σ w') := by
      rw [hw]
      exact Commute.sum_left _ _ _ fun i _ => (hxc w').pow_left i
    rw [← hu] at this
    exact this.units_inv_left
  have hy : x - 1 = (↑u⁻¹ : Coef n →L[ℝ] Coef n) * (x ^ m - 1) := by
    rw [← hgeom, ← hu]
    rw [← mul_assoc]
    simp
  show σ v - 1 ∈ idealA σ c
  rw [← hx, hy]
  exact idealA_mul_left hcu hsig

theorem isClosed_idealA (c : ℝ) : IsClosed (idealA σ c : Set (Coef n →L[ℝ] Coef n)) :=
  Submodule.closed_of_finiteDimensional _

/-- **Every `σ v - 1` lies in the ideal generated by the lattice generators `σ(c eᵢ) - 1`.**
(Unipotence, additivity and density of the rational points.) -/
theorem sub_one_mem_idealA (h : UniRep σ) {c : ℝ} (hc : c ≠ 0) (v : Fin 2 → ℝ) :
    σ v - 1 ∈ idealA σ c := by
  have hclosed : IsClosed ((idealSet h c : AddSubgroup (Fin 2 → ℝ)) : Set (Fin 2 → ℝ)) := by
    have : ((idealSet h c : AddSubgroup (Fin 2 → ℝ)) : Set (Fin 2 → ℝ)) =
        (fun v => σ v - 1) ⁻¹' (idealA σ c : Set (Coef n →L[ℝ] Coef n)) := rfl
    rw [this]
    exact (isClosed_idealA c).preimage ((h.cont).sub continuous_const)
  have hrat : ∀ r : Fin 2 → ℚ, (c • fun i => (r i : ℝ)) ∈ idealSet h c := by
    intro r
    set m : ℕ := (r 0).den * (r 1).den with hm
    have hmpos : 0 < m := Nat.mul_pos (r 0).den_pos (r 1).den_pos
    refine mem_idealSet_of_nsmul h c hmpos ?_
    have e : m • (c • fun i => (r i : ℝ)) =
        c • intVec ![(r 0).num * (r 1).den, (r 1).num * (r 0).den] := by
      funext i
      have h0 : ((r 0).den : ℝ) ≠ 0 := by exact_mod_cast (r 0).den_nz
      have h1 : ((r 1).den : ℝ) ≠ 0 := by exact_mod_cast (r 1).den_nz
      have e0 : (r 0 : ℝ) = ((r 0).num : ℝ) / (r 0).den := by
        exact_mod_cast (Rat.num_div_den (r 0)).symm
      have e1 : (r 1 : ℝ) = ((r 1).num : ℝ) / (r 1).den := by
        exact_mod_cast (Rat.num_div_den (r 1)).symm
      fin_cases i
      · simp [hm, intVec]
        rw [e0]
        field_simp
      · simp [hm, intVec]
        rw [e1]
        field_simp
    rw [e]
    exact lattice_mem_idealSet h c _
  have hdense : DenseRange (fun r : Fin 2 → ℚ => c • fun i => (r i : ℝ)) := by
    have h1 : DenseRange (Pi.map fun _ : Fin 2 => ((↑) : ℚ → ℝ)) :=
      DenseRange.piMap fun _ => Rat.denseRange_cast
    exact ((Homeomorph.smulOfNeZero c hc).surjective.denseRange).comp h1
      (continuous_const_smul c)
  have hall : ∀ v : Fin 2 → ℝ, v ∈ idealSet h c := by
    intro v
    have : closure (Set.range fun r : Fin 2 → ℚ => c • fun i => (r i : ℝ)) = Set.univ :=
      hdense.closure_range
    have hsub : closure (Set.range fun r : Fin 2 → ℚ => c • fun i => (r i : ℝ)) ⊆
        ((idealSet h c : AddSubgroup (Fin 2 → ℝ)) : Set (Fin 2 → ℝ)) :=
      hclosed.closure_subset_iff.2 (by rintro _ ⟨r, rfl⟩; exact hrat r)
    exact hsub (this ▸ Set.mem_univ v)
  exact hall v

/-- The coefficient transport `ρ(t_v)` is a unipotent representation of `ℝ²`. -/
theorem uniRep_trL (n : ℕ) : UniRep (trL n) where
  add v w := by rw [trL_add]; rfl
  zero := trL_zero n
  smooth := contDiff_trL n
  nilp v := trL_sub_one_isNilpotent n v

/-- Precomposition of a unipotent representation with a linear map of `ℝ²`. -/
theorem UniRep.comp_mulVec (h : UniRep σ) (M : Matrix (Fin 2) (Fin 2) ℝ) :
    UniRep (fun v => σ (M.mulVec v)) where
  add v w := by rw [Matrix.mulVec_add, h.add]
  zero := by simp [h.zero]
  smooth := h.smooth.comp (Matrix.mulVecLin M).toContinuousLinearMap.contDiff
  nilp v := h.nilp _

/-- If the lattice generators fix a vector, so does the whole representation. -/
theorem UniRep.fix_of_gens (h : UniRep σ) {c : ℝ} (hc : c ≠ 0) {e : Coef n}
    (h0 : σ (c • Pi.single 0 1) e = e) (h1 : σ (c • Pi.single 1 1) e = e) (v : Fin 2 → ℝ) :
    σ v e = e := by
  obtain ⟨T₁, T₂, -, -, hT⟩ := sub_one_mem_idealA h hc v
  have ha0 : (σ (c • Pi.single 0 1) - 1 : Coef n →L[ℝ] Coef n) e = 0 := by
    rw [sub_apply]; simp [h0]
  have ha1 : (σ (c • Pi.single 1 1) - 1 : Coef n →L[ℝ] Coef n) e = 0 := by
    rw [sub_apply]; simp [h1]
  have : (σ v - 1 : Coef n →L[ℝ] Coef n) e = 0 := by
    rw [hT]
    show T₁ ((σ (c • Pi.single 0 1) - 1 : Coef n →L[ℝ] Coef n) e) +
      T₂ ((σ (c • Pi.single 1 1) - 1 : Coef n →L[ℝ] Coef n) e) = 0
    rw [ha0, ha1]; simp
  rw [sub_apply] at this
  simpa [sub_eq_zero] using this

end TernaryPeriodPolynomials.Argument.EisensteinClass
