module

public import TernaryPeriodPolynomials.EisensteinSeries.Class.Twist
public import TernaryPeriodPolynomials.EisensteinSeries.Class.GammaNAverage
public import TernaryPeriodPolynomials.EisensteinSeries.Class.ZeroClass

@[expose] public section


/-!
# The torus average preserves the de Rham class (obligation (a), abelian Kasuya)

**Route.** Not Fourier series nor Hochschild-Serre, but explicit Cartan/Koszul homotopies for the
translation action (`Cartan.lean`, `Theta.lean`, `KThm.lean`): for a closed lattice-equivariant form `W`
with unipotent coefficient transport there is a lattice-equivariant primitive of `Av W - W`
(`exists_equivariant_primitive`; the coefficient term `Pavg - 1` lies in an ideal generated by the
lattice differences `σ(ce_i) - 1`, `sub_one_mem_idealA`). The `Γ_P` level is handled by normalization:
`exists_normalized_primitive` chooses primitives of average zero; the zig-zag functions `θ_g` are then
equivariant for the Levi-twisted representation with average zero (the average commutes with `g^*`
and `ρ(g)`, `avFormS_pullForm`, `avFormS_twForm`), so the zig-zag cocycle defect is a constant of
average zero fixed by the unipotent representation, hence zero (`const_eq_zero_of_avFormS`), and the
class of `Av F - F` vanishes (`deRhamClass_eq_zero_of_cocycle_datum`).

* `deRhamClass_avInv`: for any plane parabolic group with integral `SL₂(ℤ)` Levi blocks and radical
  lattice `cℤ²`, `c ≠ 0`, `[Av F] = [F]`.
* `averagePreservesClass`: the proposition `AveragePreservesClass N n` of `GammaNAverage.lean`.

Formalized by Claude Sonnet 5.5.
-/

open ContinuousAlternatingMap Set MeasureTheory CategoryTheory groupCohomology
open scoped ContDiff MatrixGroups
noncomputable section
namespace TernaryPeriodPolynomials.Argument.EisensteinClass

open TernaryPeriodPolynomials.Argument.ConvergenceC4 TernaryPeriodPolynomials.Argument.SeedC3
open TernaryPeriodPolynomials.Argument.SeedC3.Psi TernaryPoly.SmoothLocalDeRham
  TernaryPoly.SmoothCoveringDeRham

variable {n k : ℕ} {σ : (Fin 2 → ℝ) → (Coef n →L[ℝ] Coef n)} {c : ℝ}

/-- **A normalized equivariant primitive**: for a closed lattice-equivariant `W` there is an
equivariant `Ξ` of average zero with `dΞ = Av W - W`. -/
theorem exists_normalized_primitive (h : UniRep σ) (hc : c ≠ 0)
    (W : Form (F := Coef n) faceSet (k + 1)) (hW : d isOpen_faceSet (k + 1) W = 0)
    (hE : EqvS σ c W) :
    ∃ Ξ : Form (F := Coef n) faceSet k, EqvS σ c Ξ ∧ avFormS h.smooth c Ξ = 0 ∧
      d isOpen_faceSet k Ξ = avFormS h.smooth c W - W := by
  obtain ⟨Ξ0, hE0, hd0⟩ := exists_equivariant_primitive h hc W hW hE
  refine ⟨Ξ0 - avFormS h.smooth c Ξ0, eqvS_sub hE0 (eqvS_avFormS h hc hE0),
    avFormS_sub_avFormS h hc hE0, ?_⟩
  have h1 : avFormS h.smooth c (avFormS h.smooth c W - W) = 0 := by
    have := (avLin (k := k + 1) h.smooth c).map_sub (avFormS h.smooth c W) W
    change avFormS h.smooth c (avFormS h.smooth c W - W) = avFormS h.smooth c (avFormS h.smooth c W) -
      avFormS h.smooth c W at this
    rw [this, avFormS_idem h hc hE, sub_self]
  rw [map_sub, d_avFormS_comm, hd0, h1, sub_zero]

/-- **A constant equivariant zero-form of average zero vanishes.** -/
theorem const_eq_zero_of_avFormS (h : UniRep σ) (hc : c ≠ 0) (e : Coef n)
    (hE : EqvS σ c (constant faceSet e : Form (F := Coef n) faceSet 0))
    (hA : avFormS h.smooth c (constant faceSet e : Form (F := Coef n) faceSet 0) = 0) :
    (constant faceSet e : Form (F := Coef n) faceSet 0) = 0 := by
  have hfix : ∀ m : Fin 2 → ℤ, σ (c • intVec m) e = e := by
    intro m
    rw [eqvS_iff_pull] at hE
    have := hE m
    rw [ZigZag.pullForm_constant, ZigZag.twForm_constant] at this
    exact (TernaryPoly.SmoothSingularComparison.deRhamConstant_injective
      (F := Coef n) faceSet_nonempty this).symm
  have hall : ∀ v, σ v e = e := by
    refine h.fix_of_gens hc ?_ ?_
    · have := hfix (Pi.single 0 1)
      convert this using 3
      funext i; fin_cases i <;> simp [intVec]
    · have := hfix (Pi.single 1 1)
      convert this using 3
      funext i; fin_cases i <;> simp [intVec]
  have hshift : ∀ v, shiftS 0 σ v (constant faceSet e : Form (F := Coef n) faceSet 0) =
      constant faceSet e := by
    intro v
    unfold shiftS
    simp only [LinearMap.comp_apply]
    rw [ZigZag.pullForm_constant, ZigZag.twForm_constant, hall]
  rw [← avFormS_of_shiftS_inv h.smooth c hshift, hA]

/-- A zig-zag datum whose functions `θ_g` form an exact cocycle gives the zero class. -/
theorem deRhamClass_eq_zero_of_cocycle_datum {E F : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
    [CompleteSpace F] {s : Set E} {G : Type} [Group G]
    (hs : IsOpen s) (hc : Convex ℝ s) (hne : s.Nonempty) (A : ZigZag.Action G s)
    (ρ : Representation ℝ G F) (om : ZigZag.invClosed hs A ρ)
    (η : Form (F := F) s 1) (θ : G → Form (F := F) s 0) (hη : d hs 1 η = (om : Form (F := F) s 2))
    (hθ : ∀ g, d hs 0 (θ g) = ZigZag.pullForm hs A g 1 η - ZigZag.twForm (ZigZag.repCLM ρ g) 1 η)
    (hcoc : ∀ g h, ZigZag.pullForm hs A h 0 (θ g) + ZigZag.twForm (ZigZag.repCLM ρ g) 0 (θ h) -
      θ (g * h) = 0) :
    ZigZag.deRhamClass hs hc hne A ρ om = 0 := by
  let D : ZigZag.Datum (d hs 0) (d hs 1) (fun g => ZigZag.pullForm hs A g 1)
      (fun g => ZigZag.twForm (ZigZag.repCLM ρ g) 1) (om : Form (F := F) s 2) :=
    ⟨η, θ, hη, hθ⟩
  rw [ZigZag.deRhamClass_eq hs hc hne A ρ om D]
  have hz : ∀ g h, ZigZag.cochain (ZigZag.laws hs hc hne A ρ) D g h = 0 := by
    intro g h
    apply (ZigZag.laws hs hc hne A ρ).c_injective
    rw [ZigZag.c_cochain (ZigZag.laws hs hc hne A ρ) D g h]
    simpa [D] using hcoc g h
  have : ZigZag.cochainCocycle (ZigZag.laws hs hc hne A ρ) D = 0 := by
    apply Subtype.ext
    funext p
    exact hz p.1 p.2
  unfold ZigZag.zigzagClass
  rw [this, _root_.map_zero]

theorem avForm_eq_avFormS (n : ℕ) (c : ℝ) (F : Form (F := Coef n) faceSet 2) :
    avForm n c F = avFormS (uniRep_trL n).smooth c F := by
  apply Form.ext
  intro x hx
  rw [avForm_apply n c F hx, avFormS_apply _ c _ hx]
  rfl

section Main

variable {G : Type} [Group G] {D : PlaneData G}

theorem levi_integral (hL : LatticeData D c) (g : G) :
    ∃ A : SL(2, ℤ), (D.lam g : Matrix (Fin 2) (Fin 2) ℝ) =
      (A : Matrix (Fin 2) (Fin 2) ℤ).map (Int.castRingHom ℝ) := by
  obtain ⟨A, hA⟩ := hL.levi g⁻¹
  rw [inv_inv] at hA
  exact ⟨A, hA⟩

/-- **The torus average does not change the de Rham class** (abelian radical, any plane parabolic
group with integral Levi blocks and radical lattice `cℤ²`). -/
theorem deRhamClass_avInv (hL : LatticeData D c) (hc : c ≠ 0)
    (F : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) :
    ZigZag.deRhamClass isOpen_faceSet convex_faceSet faceSet_nonempty D.action (D.rhoR n)
        (avInv n hL F) =
      ZigZag.deRhamClass isOpen_faceSet convex_faceSet faceSet_nonempty D.action (D.rhoR n) F := by
  have hU : UniRep (trL n) := uniRep_trL n
  have hFE : EqvS (trL n) c (F : Form (F := Coef n) faceSet 2) := eqvS_of_invariant D hL F.2.2
  have hom : (((avInv n hL F - F : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n))) :
      Form (F := Coef n) faceSet 2) = avFormS hU.smooth c F.1 - F.1 := by
    rw [Submodule.coe_sub, avInv_val, avForm_eq_avFormS]
  obtain ⟨Ξ, hΞE, hΞA, hΞd⟩ := exists_normalized_primitive (k := 1) hU hc
    (F : Form (F := Coef n) faceSet 2) F.2.1 hFE
  have hinv : ∀ g, ZigZag.pullForm isOpen_faceSet D.action g 2 (avFormS hU.smooth c F.1 - F.1) =
      ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 2 (avFormS hU.smooth c F.1 - F.1) := by
    intro g
    have := (avInv n hL F - F).2.2 g
    rwa [hom] at this
  -- the differences `ζ'_g = ρ(g) Ξ - g^* Ξ`
  let ζ : G → Form (F := Coef n) faceSet 1 := fun g =>
    ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 1 Ξ - ZigZag.pullForm isOpen_faceSet D.action g 1 Ξ
  have hζd : ∀ g, d isOpen_faceSet 1 (ζ g) = 0 := by
    intro g
    simp only [ζ, map_sub]
    rw [ZigZag.d_twForm isOpen_faceSet, ZigZag.d_pullForm isOpen_faceSet, hΞd, hinv g, sub_self]
  have hint : ∀ g u, (sgm D n g u).comp (ZigZag.repCLM (D.rhoR n) g) =
      (ZigZag.repCLM (D.rhoR n) g).comp (trL n u) := fun g u => trL_intertwine D g u
  have hζE : ∀ g, EqvS (sgm D n g) c (ζ g) := by
    intro g
    obtain ⟨A, hA⟩ := levi_integral hL g
    exact eqvS_sub (eqvS_twForm_of_intertwine hΞE _ (hint g)) (eqvS_pullForm D g A hA hΞE)
  have hζA : ∀ g, avFormS (uniRep_sgm D g).smooth c (ζ g) = 0 := by
    intro g
    obtain ⟨A, hA⟩ := levi_integral hL g
    have h1 := avFormS_pullForm D hU g A hA (σ' := sgm D n g) (fun v => rfl)
      (uniRep_sgm D g).smooth hΞE
    have h2 := avFormS_twForm (c := c) (σ := trL n) (σ' := sgm D n g) hU.smooth
      (uniRep_sgm D g).smooth (ZigZag.repCLM (D.rhoR n) g) (hint g) Ξ
    have hsub : avFormS (uniRep_sgm D g).smooth c (ζ g) =
        avFormS (uniRep_sgm D g).smooth c (ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 1 Ξ) -
          avFormS (uniRep_sgm D g).smooth c (ZigZag.pullForm isOpen_faceSet D.action g 1 Ξ) :=
      (avLin (k := 1) (uniRep_sgm D g).smooth c).map_sub _ _
    rw [hsub, h1, h2, hΞA]
    simp
  have hθ : ∀ g, ∃ θ : Form (F := Coef n) faceSet 0, EqvS (sgm D n g) c θ ∧
      avFormS (uniRep_sgm D g).smooth c θ = 0 ∧
      d isOpen_faceSet 0 θ = ZigZag.pullForm isOpen_faceSet D.action g 1 Ξ -
        ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 1 Ξ := by
    intro g
    obtain ⟨Y, hYE, hYA, hYd⟩ := exists_normalized_primitive (k := 0) (uniRep_sgm D g) hc (ζ g)
      (hζd g) (hζE g)
    refine ⟨Y, hYE, hYA, ?_⟩
    rw [hYd, hζA g, zero_sub]
    simp only [ζ, neg_sub]
  choose θ hθE hθA hθd using hθ
  have hom' : d isOpen_faceSet 1 Ξ = ((avInv n hL F - F :
      ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) : Form (F := Coef n) faceSet 2) := by
    rw [hom]; exact hΞd
  let Dat : ZigZag.Datum (d isOpen_faceSet 0) (d isOpen_faceSet 1)
      (fun g => ZigZag.pullForm isOpen_faceSet D.action g 1)
      (fun g => ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 1)
      ((avInv n hL F - F : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) :
        Form (F := Coef n) faceSet 2) := ⟨Ξ, θ, hom', hθd⟩
  have hcoc : ∀ g h, ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g) +
      ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h) - θ (g * h) = 0 := by
    intro g h
    obtain ⟨v, hv⟩ := ZigZag.defect_const (ZigZag.laws isOpen_faceSet convex_faceSet
      faceSet_nonempty D.action (D.rhoR n)) Dat g h
    have hv' : ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g) +
        ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h) - θ (g * h) =
        constant faceSet v := hv
    obtain ⟨Ah, hAh⟩ := levi_integral hL h
    have t1 : EqvS (sgm D n (g * h)) c (ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g)) := by
      rw [sgm_funext_mul D g h]
      exact eqvS_pullForm D h Ah hAh (hθE g)
    have t2 : EqvS (sgm D n (g * h)) c
        (ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h)) :=
      eqvS_twForm_of_intertwine (hθE h) _ (rho_intertwine_sgm D g h)
    have hE : EqvS (sgm D n (g * h)) c (constant faceSet v : Form (F := Coef n) faceSet 0) := by
      rw [← hv']
      exact eqvS_sub (t1.add t2) (hθE (g * h))
    have a1 : avFormS (uniRep_sgm D (g * h)).smooth c
        (ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g)) = 0 := by
      have := avFormS_pullForm D (uniRep_sgm D g) h Ah hAh (σ' := sgm D n (g * h))
        (sgm_mul D g h) (uniRep_sgm D (g * h)).smooth (hθE g)
      rw [this, hθA g]
      simp
    have a2 : avFormS (uniRep_sgm D (g * h)).smooth c
        (ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h)) = 0 := by
      have := avFormS_twForm (c := c) (σ := sgm D n h) (σ' := sgm D n (g * h))
        (uniRep_sgm D h).smooth (uniRep_sgm D (g * h)).smooth (ZigZag.repCLM (D.rhoR n) g)
        (rho_intertwine_sgm D g h) (θ h)
      rw [this, hθA h]
      simp
    have hAv : avFormS (uniRep_sgm D (g * h)).smooth c
        (constant faceSet v : Form (F := Coef n) faceSet 0) = 0 := by
      rw [← hv']
      have hs := (avLin (k := 0) (uniRep_sgm D (g * h)).smooth c).map_sub
        (ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g) +
          ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h)) (θ (g * h))
      have ha := (avLin (k := 0) (uniRep_sgm D (g * h)).smooth c).map_add
        (ZigZag.pullForm isOpen_faceSet D.action h 0 (θ g))
        (ZigZag.twForm (ZigZag.repCLM (D.rhoR n) g) 0 (θ h))
      change avFormS (uniRep_sgm D (g * h)).smooth c _ = avFormS (uniRep_sgm D (g * h)).smooth c _ -
        avFormS (uniRep_sgm D (g * h)).smooth c _ at hs
      change avFormS (uniRep_sgm D (g * h)).smooth c _ = avFormS (uniRep_sgm D (g * h)).smooth c _ +
        avFormS (uniRep_sgm D (g * h)).smooth c _ at ha
      rw [hs, ha, a1, a2, hθA (g * h)]
      simp
    rw [hv']
    exact const_eq_zero_of_avFormS (uniRep_sgm D (g * h)) hc v hE hAv
  have hzero := deRhamClass_eq_zero_of_cocycle_datum isOpen_faceSet convex_faceSet
    faceSet_nonempty D.action (D.rhoR n) (avInv n hL F - F) Ξ θ hom' hθd hcoc
  have hsub := (ZigZag.deRhamClass isOpen_faceSet convex_faceSet faceSet_nonempty D.action
    (D.rhoR n)).map_sub (avInv n hL F) F
  rw [hsub] at hzero
  exact sub_eq_zero.mp hzero

end Main

/-- **Obligation (a), Kasuya for the abelian radical `Nℤ²`, proved**: the torus average does not
change the de Rham class. -/
theorem averagePreservesClass (N : ℕ) [NeZero N] (n : ℕ) : AveragePreservesClass N n :=
  fun F => deRhamClass_avInv (latticeData_gammaN N) (Nat.cast_ne_zero.mpr (NeZero.ne N)) F

end TernaryPeriodPolynomials.Argument.EisensteinClass
