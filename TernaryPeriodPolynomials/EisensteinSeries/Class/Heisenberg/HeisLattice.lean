module

public import TernaryPeriodPolynomials.EisensteinSeries.Class.Heisenberg.HeisSym

@[expose] public section


/-!
# The Nomizu-Kasuya homotopy for the Heisenberg nilmanifold with unipotent coefficients

Formalized by Claude Sonnet 5.5.

**Statement** (`heis_nomizu`).  Work in the invariant frame (the gauge `ρ(u)⁻¹ s(u)` of the paper): a cochain is a smooth function `u : ℝ³ → W`, `W` the
finite-dimensional cochain space `Λ•𝔥* ⊗ E` of the Chevalley-Eilenberg complex of the Heisenberg algebra with coefficients in a unipotent module `E`
(`CartanData`: `ε_k`, `ι_k`, the constant differential `𝔇 = Σ ε_k ρ_k + ½ ε_k ε_l c^m_{kl} ι_m`, the nilpotency of `Λ_j = [𝔇, ι_j]`), `D = Σ_k ε_k X_k + 𝔇`
the flat differential `d + ρ(θ) ∧` in the left-invariant coframe (so that `D² = 0` is the Jacobi identity together with `dθ³ = -θ¹ ∧ θ²`).  `C1 ax ay az` is the
space of smooth cochains periodic for the lattice generated by the left translations by `(ax, 0, 0)`, `(0, ay, 0)`, `(0, 0, az)`
(`(x, y, z) ↦ (x + ax, y, z + ax y)`, `(x, y + ay, z)`, `(x, y, z + az)`, the integral Heisenberg group `{[[1,a,c],[0,1,b],[0,0,1]] : a ∈ ax ℤ, b ∈ ay ℤ, c ∈ az ℤ}`).
Every `D`-closed periodic cochain `u` satisfies `u - Av u = D η` with `η` periodic and smooth, where `Av u = heisAv u` is the constant normalized Haar average
over the fundamental domain `[0, ax] × [0, ay] × [0, az]` (`heisAv_eq`) and `𝔇 (Av u) = 0`.  So `Av` is a left inverse, on cohomology, of the inclusion of the Lie
algebra complex (`Av ∘ ι = I` is trivial), and the inclusion is an isomorphism: Kasuya's theorem for the Heisenberg group, with unipotent coefficients,
without Fourier series and without a spectral sequence.

**Proof** (no analysis beyond one-variable calculus): the partial averages `A_z`, `A_y`, `A_x` along the central direction and the two further directions are
idempotents commuting with `D` and mapping `C1 → C2 → C3 → C4 = {constants}` (`stepZ`, `stepY`, `stepX`), and by `StepSys.step` (`HeisStep`) each `1 - A_j` is
`D h_j` on closed cochains; `h = h_z + h_y + h_x`.
-/


open scoped ContDiff
open MeasureTheory Set

noncomputable section

namespace TernaryPeriodPolynomials.Argument.EisensteinClass.Heisenberg

variable {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] [CompleteSpace W]

/-! ### The lattice relations -/

/-- The linear part `(x, y, z) ↦ (x, y, z + a y)` of the lattice translation in the `x`-direction. -/
def Mx (a : ℝ) : Pt →L[ℝ] Pt :=
  (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
    (((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod
      ((ContinuousLinearMap.snd ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)) +
        a • (ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))))

/-- **The lattice translation in the `x`-direction**: left multiplication by `(a, 0, 0)`:
`(x, y, z) ↦ (x + a, y, z + a y)`. -/
def latX (a : ℝ) (p : Pt) : Pt := Mx a p + (a, 0, 0)

theorem latX_apply (a : ℝ) (p : Pt) : latX a p = (p.1 + a, p.2.1, p.2.2 + a * p.2.1) := by
  simp [latX, Mx, add_comm]

theorem Mx_e1 (a : ℝ) : Mx a e1 = e1 := by simp [Mx, e1]
theorem Mx_e3 (a : ℝ) : Mx a e3 = e3 := by simp [Mx, e3]
theorem Mx_e2 (a : ℝ) : Mx a e2 = e2 + a • e3 := by simp [Mx, e2, e3]

theorem latX_shift_e3 (a : ℝ) (p : Pt) (s : ℝ) : latX a (p + s • e3) = latX a p + s • e3 := by
  simp only [latX_apply, e3]
  ext <;> simp
  ring

theorem latX_shift_e1 (a : ℝ) (p : Pt) (s : ℝ) : latX a (p + s • e1) = latX a p + s • e1 := by
  simp only [latX_apply, e1]
  ext <;> simp
  ring

/-! ### The spaces of periodic cochains -/

section Classes

variable (ax ay az : ℝ)

/-- **Heisenberg-periodic smooth functions**: invariant under the left translations by `(ax, 0, 0)`, `(0, ay, 0)`, `(0, 0, az)`
(`(x, y, z) ↦ (x + ax, y, z + ax y)`, `(x, y + ay, z)`, `(x, y, z + az)`). -/
def C1 : Submodule ℝ (Pt → W) where
  carrier := {u | ContDiff ℝ ∞ u ∧ (∀ p, u (p + az • e3) = u p) ∧ (∀ p, u (p + ay • e2) = u p) ∧
    ∀ p, u (latX ax p) = u p}
  zero_mem' := ⟨contDiff_const, fun _ => rfl, fun _ => rfl, fun _ => rfl⟩
  add_mem' := by
    rintro u w ⟨hu1, hu2, hu3, hu4⟩ ⟨hw1, hw2, hw3, hw4⟩
    exact ⟨hu1.add hw1, fun p => by simp [hu2, hw2], fun p => by simp [hu3, hw3],
      fun p => by simp [hu4, hw4]⟩
  smul_mem' := by
    rintro c u ⟨hu1, hu2, hu3, hu4⟩
    exact ⟨hu1.const_smul c, fun p => by simp [hu2], fun p => by simp [hu3], fun p => by simp [hu4]⟩

/-- The functions invariant under translation along `v`. -/
def invSub (v : Pt) : Submodule ℝ (Pt → W) where
  carrier := {u | Inv v u}
  zero_mem' := fun _ _ => rfl
  add_mem' := fun hu hw p t => by simp [hu p t, hw p t]
  smul_mem' := fun c u hu p t => by simp [hu p t]

/-- Heisenberg-periodic and independent of `z`. -/
def C2 : Submodule ℝ (Pt → W) := C1 ax ay az ⊓ invSub e3

/-- Heisenberg-periodic and independent of `y` and `z`. -/
def C3 : Submodule ℝ (Pt → W) := C2 ax ay az ⊓ invSub e2

/-- The constants. -/
def C4 : Submodule ℝ (Pt → W) := C3 ax ay az ⊓ invSub e1

omit [CompleteSpace W] in
theorem C2_le_C1 : C2 ax ay az ≤ (C1 ax ay az : Submodule ℝ (Pt → W)) := inf_le_left
omit [CompleteSpace W] in
theorem C3_le_C2 : C3 ax ay az ≤ (C2 ax ay az : Submodule ℝ (Pt → W)) := inf_le_left

end Classes

/-! ### Closure of `C1` under the invariant fields -/

section Closure

variable {ax ay az : ℝ}

omit [CompleteSpace W] in
theorem ddir_contDiff {u : Pt → W} (hu : ContDiff ℝ ∞ u) (w : Pt) : ContDiff ℝ ∞ (ddir w u) :=
  (hu.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const

omit [CompleteSpace W] in
theorem Xop_contDiff {u : Pt → W} (hu : ContDiff ℝ ∞ u) (k : Fin 3) : ContDiff ℝ ∞ (Xop k u) := by
  fin_cases k
  · exact ddir_contDiff hu e1
  · exact (ddir_contDiff hu e2).add ((contDiff_fst).smul (ddir_contDiff hu e3))
  · exact ddir_contDiff hu e3

omit [CompleteSpace W] in
theorem ddir_latX {u : Pt → W} (hu : ContDiff ℝ ∞ u) (a : ℝ) (hinv : ∀ p, u (latX a p) = u p) (p : Pt) :
    ddir e1 u (latX a p) = ddir e1 u p ∧ ddir e3 u (latX a p) = ddir e3 u p ∧
      ddir e2 u (latX a p) + a • ddir e3 u (latX a p) = ddir e2 u p := by
  have h : ∀ w, ddir (Mx a w) u (latX a p) = ddir w u p := fun w =>
    ddir_of_affine_invariant hu (Mx a) (a, 0, 0) hinv w p
  refine ⟨?_, ?_, ?_⟩
  · have := h e1; rwa [Mx_e1] at this
  · have := h e3; rwa [Mx_e3] at this
  · have := h e2
    rw [Mx_e2] at this
    rw [← this]
    show fderiv ℝ u (latX a p) e2 + a • fderiv ℝ u (latX a p) e3 = fderiv ℝ u (latX a p) (e2 + a • e3)
    rw [map_add, map_smul]

omit [CompleteSpace W] in
theorem C1_Xop {u : Pt → W} (hu : u ∈ C1 ax ay az) (k : Fin 3) : Xop k u ∈ C1 ax ay az := by
  obtain ⟨h1, h2, h3, h4⟩ := hu
  refine ⟨Xop_contDiff h1 k, ?_, ?_, ?_⟩
  · intro p
    fin_cases k
    · exact ddir_translate h1 (az • e3) h2 e1 p
    · show ddir e2 u (p + az • e3) + (p + az • e3).1 • ddir e3 u (p + az • e3) =
        ddir e2 u p + p.1 • ddir e3 u p
      rw [ddir_translate h1 (az • e3) h2 e2 p, ddir_translate h1 (az • e3) h2 e3 p]
      simp [e3]
    · exact ddir_translate h1 (az • e3) h2 e3 p
  · intro p
    fin_cases k
    · exact ddir_translate h1 (ay • e2) h3 e1 p
    · show ddir e2 u (p + ay • e2) + (p + ay • e2).1 • ddir e3 u (p + ay • e2) =
        ddir e2 u p + p.1 • ddir e3 u p
      rw [ddir_translate h1 (ay • e2) h3 e2 p, ddir_translate h1 (ay • e2) h3 e3 p]
      simp [e2]
    · exact ddir_translate h1 (ay • e2) h3 e3 p
  · intro p
    obtain ⟨a1, a3, a2⟩ := ddir_latX h1 ax h4 p
    fin_cases k
    · exact a1
    · show ddir e2 u (latX ax p) + (latX ax p).1 • ddir e3 u (latX ax p) = ddir e2 u p + p.1 • ddir e3 u p
      have hq1 : (latX ax p).1 = p.1 + ax := by rw [latX_apply]
      rw [hq1, ← a2, a3]
      simp only [add_smul]
      abel
    · exact a3

end Closure

section XopComm

variable (v : Pt) (r : ℝ)

omit [CompleteSpace W] in
theorem Xop_qD_of_fst_zero (hv : v.1 = 0) {u : Pt → W} (hu : ContDiff ℝ ∞ u) (k : Fin 3) :
    Xop k (qD v r u) = qD v r (Xop k u) := by
  fin_cases k
  · exact ddir_qD v r hu e1
  · show (fun p => ddir e2 (qD v r u) p + p.1 • ddir e3 (qD v r u) p) =
      qD v r (fun p => ddir e2 u p + p.1 • ddir e3 u p)
    have h1 : ContDiff ℝ ∞ (ddir e2 u) := ddir_contDiff hu e2
    have h2 : ContDiff ℝ ∞ (fun p : Pt => p.1 • ddir e3 u p) := contDiff_fst.smul (ddir_contDiff hu e3)
    have e : (fun p : Pt => ddir e2 u p + p.1 • ddir e3 u p) = ddir e2 u + fun p : Pt => p.1 • ddir e3 u p := rfl
    rw [e, qD_add_fun v r h1 h2, qD_xmul v r hv, ddir_qD v r hu e2, ddir_qD v r hu e3]
    rfl
  · exact ddir_qD v r hu e3

omit [CompleteSpace W] in
theorem Xop_avD_of_fst_zero (hv : v.1 = 0) {u : Pt → W} (hu : ContDiff ℝ ∞ u) (k : Fin 3) :
    Xop k (avD v r u) = avD v r (Xop k u) := by
  fin_cases k
  · exact ddir_avD v r hu e1
  · show (fun p => ddir e2 (avD v r u) p + p.1 • ddir e3 (avD v r u) p) =
      avD v r (fun p => ddir e2 u p + p.1 • ddir e3 u p)
    have h1 : ContDiff ℝ ∞ (ddir e2 u) := ddir_contDiff hu e2
    have h2 : ContDiff ℝ ∞ (fun p : Pt => p.1 • ddir e3 u p) := contDiff_fst.smul (ddir_contDiff hu e3)
    have e : (fun p : Pt => ddir e2 u p + p.1 • ddir e3 u p) = ddir e2 u + fun p : Pt => p.1 • ddir e3 u p := rfl
    rw [e, avD_add_fun v r h1.continuous h2.continuous, avD_xmul v r hv, ddir_avD v r hu e2,
      ddir_avD v r hu e3]
    rfl
  · exact ddir_avD v r hu e3

end XopComm

section StepZ

variable (ax ay az : ℝ)

omit [CompleteSpace W] in
theorem C1_lin {u : Pt → W} (hu : u ∈ C1 ax ay az) (L : W →L[ℝ] W) : lin L u ∈ C1 ax ay az := by
  obtain ⟨h1, h2, h3, h4⟩ := hu
  exact ⟨lin_contDiff L h1, fun p => by simp [lin, h2 p], fun p => by simp [lin, h3 p],
    fun p => by simp [lin, h4 p]⟩

omit [CompleteSpace W] in
theorem C2_lin {u : Pt → W} (hu : u ∈ C2 ax ay az) (L : W →L[ℝ] W) : lin L u ∈ C2 ax ay az :=
  ⟨C1_lin ax ay az hu.1 L, fun p t => by simp [lin, hu.2 p t]⟩

omit [CompleteSpace W] in
theorem C3_lin {u : Pt → W} (hu : u ∈ C3 ax ay az) (L : W →L[ℝ] W) : lin L u ∈ C3 ax ay az :=
  ⟨C2_lin ax ay az hu.1 L, fun p t => by simp [lin, hu.2 p t]⟩

omit [CompleteSpace W] in
theorem C1_qD_z {u : Pt → W} (hu : u ∈ C1 ax ay az) : qD e3 az u ∈ C1 ax ay az := by
  obtain ⟨h1, h2, h3, h4⟩ := hu
  refine ⟨qD_smooth e3 az h1, qD_per e3 az h2, fun p => ?_, fun p => ?_⟩
  · exact qD_sym e3 az (fun q => q + ay • e2) (translation_commutes e3 _) h3 p
  · exact qD_sym e3 az (latX ax) (latX_shift_e3 ax) h4 p

omit [CompleteSpace W] in
theorem C1_avD_z {u : Pt → W} (hu : u ∈ C1 ax ay az) (haz : az ≠ 0) : avD e3 az u ∈ C2 ax ay az := by
  obtain ⟨h1, h2, h3, h4⟩ := hu
  refine ⟨⟨avD_smooth e3 az h1, avD_per e3 az h2, fun p => ?_, fun p => ?_⟩, avD_inv e3 az h2 haz⟩
  · exact avD_sym e3 az (fun q => q + ay • e2) (translation_commutes e3 _) h3 p
  · exact avD_sym e3 az (latX ax) (latX_shift_e3 ax) h4 p

/-- **The averaging step along the center** (`z`-direction, period `az`): `C1 → C2`. -/
def stepZ (T : CartanData W) (haz : az ≠ 0)
    (hD2 : ∀ u : Pt → W, ContDiff ℝ ∞ u → Dop T (Dop T u) = 0) : StepSys T where
  Cin := C1 ax ay az
  Cout := C2 ax ay az
  outLe := C2_le_C1 ax ay az
  v := e3
  r := az
  j := 2
  hr := haz
  smooth := fun u hu => hu.1
  per := fun u hu => hu.2.1
  closedX := fun u hu k => C1_Xop hu k
  closedLin := fun u hu L => C1_lin ax ay az hu L
  closedQ := fun u hu => C1_qD_z ax ay az hu
  avOut := fun u hu => C1_avD_z ax ay az hu haz
  xdir := fun u hu => rfl
  Xq := fun u hu k => Xop_qD_of_fst_zero e3 az (by simp [e3]) hu.1 k
  Xa := fun u hu k => Xop_avD_of_fst_zero e3 az (by simp [e3]) hu.1 k
  D2 := fun u hu => hD2 u hu.1

end StepZ

section StepY

variable (ax ay az : ℝ)

omit [CompleteSpace W] in
/-- On `C2` the lattice relation in the `x`-direction is a pure translation. -/
theorem C2_per_x {u : Pt → W} (hu : u ∈ C2 ax ay az) (p : Pt) : u (p + ax • e1) = u p := by
  obtain ⟨⟨h1, h2, h3, h4⟩, hinv⟩ := hu
  have : latX ax p = (p + ax • e1) + (ax * p.2.1) • e3 := by
    rw [latX_apply]; ext <;> simp [e1, e3]
  rw [← h4 p, this, hinv]

omit [CompleteSpace W] in
theorem C2_Xop {u : Pt → W} (hu : u ∈ C2 ax ay az) (k : Fin 3) : Xop k u ∈ C2 ax ay az := by
  refine ⟨C1_Xop hu.1 k, fun p t => ?_⟩
  have h1 := hu.1.1
  have hinv := hu.2
  fin_cases k
  · exact ddir_translate h1 (t • e3) (fun q => hinv q t) e1 p
  · show ddir e2 u (p + t • e3) + (p + t • e3).1 • ddir e3 u (p + t • e3) = ddir e2 u p + p.1 • ddir e3 u p
    rw [ddir_translate h1 (t • e3) (fun q => hinv q t) e2 p, ddir_translate h1 (t • e3) (fun q => hinv q t) e3 p]
    simp [e3]
  · exact ddir_translate h1 (t • e3) (fun q => hinv q t) e3 p

omit [CompleteSpace W] in
theorem C2_ddir_e3 {u : Pt → W} (hu : u ∈ C2 ax ay az) : ddir e3 u = fun _ => (0 : W) :=
  ddir_of_inv e3 hu.1.1 hu.2

omit [CompleteSpace W] in
theorem C2_qD_y {u : Pt → W} (hu : u ∈ C2 ax ay az) : qD e2 ay u ∈ C2 ax ay az := by
  obtain ⟨⟨h1, h2, h3, h4⟩, hinv⟩ := hu
  have hq : ∀ (t : ℝ) p, qD e2 ay u (p + t • e3) = qD e2 ay u p := fun t p =>
    qD_sym e2 ay (fun q => q + t • e3) (translation_commutes e2 _) (fun q => hinv q t) p
  refine ⟨⟨qD_smooth e2 ay h1, fun p => ?_, qD_per e2 ay h3, fun p => ?_⟩, fun p t => hq t p⟩
  · exact hq az p
  · have : latX ax p = (p + ax • e1) + (ax * p.2.1) • e3 := by
      rw [latX_apply]; ext <;> simp [e1, e3]
    rw [this, hq]
    exact qD_sym e2 ay (fun q => q + ax • e1) (translation_commutes e2 _)
      (C2_per_x ax ay az ⟨⟨h1, h2, h3, h4⟩, hinv⟩) p

omit [CompleteSpace W] in
theorem C2_avD_y {u : Pt → W} (hu : u ∈ C2 ax ay az) (hay : ay ≠ 0) : avD e2 ay u ∈ C3 ax ay az := by
  obtain ⟨⟨h1, h2, h3, h4⟩, hinv⟩ := hu
  have hq : ∀ (t : ℝ) p, avD e2 ay u (p + t • e3) = avD e2 ay u p := fun t p =>
    avD_sym e2 ay (fun q => q + t • e3) (translation_commutes e2 _) (fun q => hinv q t) p
  refine ⟨⟨⟨avD_smooth e2 ay h1, fun p => ?_, avD_per e2 ay h3, fun p => ?_⟩, fun p t => hq t p⟩,
    avD_inv e2 ay h3 hay⟩
  · exact hq az p
  · have : latX ax p = (p + ax • e1) + (ax * p.2.1) • e3 := by
      rw [latX_apply]; ext <;> simp [e1, e3]
    rw [this, hq]
    exact avD_sym e2 ay (fun q => q + ax • e1) (translation_commutes e2 _)
      (C2_per_x ax ay az ⟨⟨h1, h2, h3, h4⟩, hinv⟩) p

/-- **The averaging step in the `y`-direction** (period `ay`): `C2 → C3`. -/
def stepY (T : CartanData W) (hay : ay ≠ 0)
    (hD2 : ∀ u : Pt → W, ContDiff ℝ ∞ u → Dop T (Dop T u) = 0) : StepSys T where
  Cin := C2 ax ay az
  Cout := C3 ax ay az
  outLe := C3_le_C2 ax ay az
  v := e2
  r := ay
  j := 1
  hr := hay
  smooth := fun u hu => hu.1.1
  per := fun u hu => hu.1.2.2.1
  closedX := fun u hu k => C2_Xop ax ay az hu k
  closedLin := fun u hu L => C2_lin ax ay az hu L
  closedQ := fun u hu => C2_qD_y ax ay az hu
  avOut := fun u hu => C2_avD_y ax ay az hu hay
  xdir := fun u hu => by
    funext p
    show ddir e2 u p + p.1 • ddir e3 u p = ddir e2 u p
    rw [C2_ddir_e3 ax ay az hu]
    simp
  Xq := fun u hu k => Xop_qD_of_fst_zero e2 ay (by simp [e2]) hu.1.1 k
  Xa := fun u hu k => Xop_avD_of_fst_zero e2 ay (by simp [e2]) hu.1.1 k
  D2 := fun u hu => hD2 u hu.1.1

end StepY

section StepX

variable (ax ay az : ℝ)

omit [CompleteSpace W] in
theorem C3_ddir {u : Pt → W} (hu : u ∈ C3 ax ay az) :
    ddir e2 u = (fun _ => (0 : W)) ∧ ddir e3 u = (fun _ => (0 : W)) :=
  ⟨ddir_of_inv e2 hu.1.1.1 hu.2, C2_ddir_e3 ax ay az hu.1⟩

omit [CompleteSpace W] in
theorem C3_Xop1 {u : Pt → W} (hu : u ∈ C3 ax ay az) : Xop 1 u = fun _ => (0 : W) := by
  obtain ⟨h2, h3⟩ := C3_ddir ax ay az hu
  funext p
  show ddir e2 u p + p.1 • ddir e3 u p = 0
  rw [h2, h3]; simp

omit [CompleteSpace W] in
theorem C3_Xop2 {u : Pt → W} (hu : u ∈ C3 ax ay az) : Xop 2 u = fun _ => (0 : W) :=
  (C3_ddir ax ay az hu).2

omit [CompleteSpace W] in
theorem C3_Xop {u : Pt → W} (hu : u ∈ C3 ax ay az) (k : Fin 3) : Xop k u ∈ C3 ax ay az := by
  fin_cases k
  · refine ⟨C2_Xop ax ay az hu.1 0, fun p t => ?_⟩
    show ddir e1 u (p + t • e2) = ddir e1 u p
    exact ddir_translate hu.1.1.1 (t • e2) (fun q => hu.2 q t) e1 p
  · show Xop 1 u ∈ C3 ax ay az
    rw [C3_Xop1 ax ay az hu]
    exact (C3 ax ay az).zero_mem
  · show Xop 2 u ∈ C3 ax ay az
    rw [C3_Xop2 ax ay az hu]
    exact (C3 ax ay az).zero_mem

omit [CompleteSpace W] in
theorem C3_per_x {u : Pt → W} (hu : u ∈ C3 ax ay az) (p : Pt) : u (p + ax • e1) = u p :=
  C2_per_x ax ay az hu.1 p

omit [CompleteSpace W] in
theorem C3_qD_x {u : Pt → W} (hu : u ∈ C3 ax ay az) : qD e1 ax u ∈ C3 ax ay az := by
  obtain ⟨⟨⟨h1, h2, h3, h4⟩, hinv3⟩, hinv2⟩ := hu
  have q3 : ∀ (t : ℝ) p, qD e1 ax u (p + t • e3) = qD e1 ax u p := fun t p =>
    qD_sym e1 ax (fun q => q + t • e3) (translation_commutes e1 _) (fun q => hinv3 q t) p
  have q2 : ∀ (t : ℝ) p, qD e1 ax u (p + t • e2) = qD e1 ax u p := fun t p =>
    qD_sym e1 ax (fun q => q + t • e2) (translation_commutes e1 _) (fun q => hinv2 q t) p
  refine ⟨⟨⟨qD_smooth e1 ax h1, fun p => q3 az p, fun p => q2 ay p, fun p => ?_⟩, fun p t => q3 t p⟩,
    fun p t => q2 t p⟩
  exact qD_sym e1 ax (latX ax) (latX_shift_e1 ax) h4 p

omit [CompleteSpace W] in
theorem C3_avD_x {u : Pt → W} (hu : u ∈ C3 ax ay az) (hax : ax ≠ 0) : avD e1 ax u ∈ C4 ax ay az := by
  obtain ⟨⟨⟨h1, h2, h3, h4⟩, hinv3⟩, hinv2⟩ := hu
  have q3 : ∀ (t : ℝ) p, avD e1 ax u (p + t • e3) = avD e1 ax u p := fun t p =>
    avD_sym e1 ax (fun q => q + t • e3) (translation_commutes e1 _) (fun q => hinv3 q t) p
  have q2 : ∀ (t : ℝ) p, avD e1 ax u (p + t • e2) = avD e1 ax u p := fun t p =>
    avD_sym e1 ax (fun q => q + t • e2) (translation_commutes e1 _) (fun q => hinv2 q t) p
  have hperx : Per e1 ax u := C2_per_x ax ay az ⟨⟨h1, h2, h3, h4⟩, hinv3⟩
  refine ⟨⟨⟨⟨avD_smooth e1 ax h1, fun p => q3 az p, fun p => q2 ay p, fun p => ?_⟩, fun p t => q3 t p⟩,
    fun p t => q2 t p⟩, avD_inv e1 ax hperx hax⟩
  exact avD_sym e1 ax (latX ax) (latX_shift_e1 ax) h4 p

/-- **The averaging step in the `x`-direction** (period `ax`): `C3 → C4` (constants). -/
def stepX (T : CartanData W) (hax : ax ≠ 0)
    (hD2 : ∀ u : Pt → W, ContDiff ℝ ∞ u → Dop T (Dop T u) = 0) : StepSys T where
  Cin := C3 ax ay az
  Cout := C4 ax ay az
  outLe := inf_le_left
  v := e1
  r := ax
  j := 0
  hr := hax
  smooth := fun u hu => hu.1.1.1
  per := fun u hu => C3_per_x ax ay az hu
  closedX := fun u hu k => C3_Xop ax ay az hu k
  closedLin := fun u hu L => C3_lin ax ay az hu L
  closedQ := fun u hu => C3_qD_x ax ay az hu
  avOut := fun u hu => C3_avD_x ax ay az hu hax
  xdir := fun u hu => rfl
  Xq := fun u hu k => by
    have hq := C3_qD_x ax ay az hu
    fin_cases k
    · exact ddir_qD e1 ax hu.1.1.1 e1
    · show Xop 1 (qD e1 ax u) = qD e1 ax (Xop 1 u)
      rw [C3_Xop1 ax ay az hq, C3_Xop1 ax ay az hu]
      exact (qD_of_inv e1 ax (fun _ _ => rfl)).symm
    · show Xop 2 (qD e1 ax u) = qD e1 ax (Xop 2 u)
      rw [C3_Xop2 ax ay az hq, C3_Xop2 ax ay az hu]
      exact (qD_of_inv e1 ax (fun _ _ => rfl)).symm
  Xa := fun u hu k => by
    have hq := C3_avD_x ax ay az hu hax
    fin_cases k
    · exact ddir_avD e1 ax hu.1.1.1 e1
    · show Xop 1 (avD e1 ax u) = avD e1 ax (Xop 1 u)
      rw [C3_Xop1 ax ay az hq.1, C3_Xop1 ax ay az hu]
      exact (avD_of_inv e1 ax (fun _ _ => rfl)).symm
    · show Xop 2 (avD e1 ax u) = avD e1 ax (Xop 2 u)
      rw [C3_Xop2 ax ay az hq.1, C3_Xop2 ax ay az hu]
      exact (avD_of_inv e1 ax (fun _ _ => rfl)).symm
  D2 := fun u hu => hD2 u hu.1.1.1

end StepX

section Main

variable (ax ay az : ℝ)

/-- **The Haar average over the nilmanifold**, as the iterated average along `z`, `y`, `x` (period `az`, `ay`, `ax`), evaluated at the origin:
`∫₀¹∫₀¹∫₀¹ u(r ax, s ay, t az) dt ds dr`, the integral of `u` over the fundamental domain `[0, ax] × [0, ay] × [0, az]` with total volume one. -/
def heisAv (u : Pt → W) : W := avD e1 ax (avD e2 ay (avD e3 az u)) 0

omit [CompleteSpace W] in
theorem heisAv_eq (u : Pt → W) :
    heisAv ax ay az u = ∫ r in (0 : ℝ)..1, ∫ s in (0 : ℝ)..1, ∫ t in (0 : ℝ)..1,
      u ((r * ax, s * ay, t * az) : Pt) := by
  unfold heisAv avD
  refine intervalIntegral.integral_congr (fun r _ => ?_)
  refine intervalIntegral.integral_congr (fun s _ => ?_)
  refine intervalIntegral.integral_congr (fun t _ => ?_)
  congr 1
  simp [e1, e2, e3]

omit [CompleteSpace W] in
theorem C4_const {u : Pt → W} (hu : u ∈ C4 ax ay az) (p : Pt) : u p = u 0 := by
  obtain ⟨⟨⟨_, hz⟩, hy⟩, hx⟩ := hu
  have : p = (0 + p.1 • e1) + p.2.1 • e2 + p.2.2 • e3 := by
    ext <;> simp [e1, e2, e3]
  rw [this, hz, hy, hx]

omit [CompleteSpace W] in
theorem Dop_const (T : CartanData W) (c : W) : Dop T (fun _ => c) = fun _ => T.D0 c := by
  have hX : ∀ k, Xop k (fun _ : Pt => c) = 0 := by
    intro k
    fin_cases k <;> (funext p; simp [Xop, ddir])
  funext p
  simp [Dop, hX, lin]

/-- **The Heisenberg Nomizu-Kasuya homotopy.**  Let `W` be the finite-dimensional cochain space of the Chevalley-Eilenberg complex of the
Heisenberg algebra with coefficients (`CartanData`: the operators `ε_k`, `ι_k`, the constant differential `𝔇`, `Λ_j` nilpotent), `D = Σ ε_k X_k + 𝔇`
the differential on Heisenberg-periodic smooth cochains (`C1`: the periodic cochains for the lattice `(ax, ay, az)`), `D² = 0`.  Every `D`-closed
periodic cochain `u` differs from its constant Haar average `Av u` (a `𝔇`-closed constant, i.e. a Lie algebra cocycle) by a coboundary:
`u - Av u = D η` with `η` periodic and smooth. -/
theorem heis_nomizu (T : CartanData W) (hax : ax ≠ 0) (hay : ay ≠ 0) (haz : az ≠ 0)
    (hD2 : ∀ u : Pt → W, ContDiff ℝ ∞ u → Dop T (Dop T u) = 0) {u : Pt → W}
    (hu : u ∈ C1 ax ay az) (hcl : Dop T u = 0) :
    ∃ η ∈ C1 ax ay az, T.D0 (heisAv ax ay az u) = 0 ∧
      u - (fun _ => heisAv ax ay az u) = Dop T η := by
  have avD_zero : ∀ (v : Pt) (r : ℝ), avD v r (0 : Pt → W) = 0 := fun v r => by
    funext p; simp [avD]
  let SZ := stepZ ax ay az T haz hD2
  let SY := stepY ax ay az T hay hD2
  let SX := stepX ax ay az T hax hD2
  obtain ⟨h1, h1m, hs1⟩ := SZ.step hu hcl
  have u2m : avD e3 az u ∈ C2 ax ay az := SZ.avOut u hu
  have u2cl : Dop T (avD e3 az u) = 0 := by
    have := SZ.avD_Dop hu
    rw [hcl] at this
    exact this.trans (avD_zero e3 az)
  obtain ⟨h2, h2m, hs2⟩ := SY.step u2m u2cl
  have u3m : avD e2 ay (avD e3 az u) ∈ C3 ax ay az := SY.avOut _ u2m
  have u3cl : Dop T (avD e2 ay (avD e3 az u)) = 0 := by
    have := SY.avD_Dop u2m
    rw [u2cl] at this
    exact this.trans (avD_zero e2 ay)
  obtain ⟨h3, h3m, hs3⟩ := SX.step u3m u3cl
  have u4m : avD e1 ax (avD e2 ay (avD e3 az u)) ∈ C4 ax ay az := SX.avOut _ u3m
  have u4cl : Dop T (avD e1 ax (avD e2 ay (avD e3 az u))) = 0 := by
    have := SX.avD_Dop u3m
    rw [u3cl] at this
    exact this.trans (avD_zero e1 ax)
  have hconst : avD e1 ax (avD e2 ay (avD e3 az u)) = fun _ => heisAv ax ay az u := by
    funext p
    exact C4_const ax ay az u4m p
  have hh1 : h1 ∈ C1 ax ay az := h1m
  have hh2 : h2 ∈ C1 ax ay az := C2_le_C1 ax ay az h2m
  have hh3 : h3 ∈ C1 ax ay az := C2_le_C1 ax ay az (C3_le_C2 ax ay az h3m)
  refine ⟨h1 + h2 + h3, Submodule.add_mem _ (Submodule.add_mem _ hh1 hh2) hh3, ?_, ?_⟩
  · have := u4cl
    rw [hconst, Dop_const] at this
    exact congrFun this 0
  · have hs1' : u - avD e3 az u = Dop T h1 := hs1
    have hs2' : avD e3 az u - avD e2 ay (avD e3 az u) = Dop T h2 := hs2
    have hs3' : avD e2 ay (avD e3 az u) - avD e1 ax (avD e2 ay (avD e3 az u)) = Dop T h3 := hs3
    rw [Dop_add T (show ContDiff ℝ ∞ (h1 + h2) from hh1.1.add hh2.1) hh3.1, Dop_add T hh1.1 hh2.1, ← hs1', ← hs2', ← hs3', ← hconst]
    abel

end Main

end TernaryPeriodPolynomials.Argument.EisensteinClass.Heisenberg
