module

public import TernaryPeriodPolynomials.EisensteinSeries.Class.Heisenberg.HeisFrame

@[expose] public section



/-!
# Invariance under the three lattice generators implies invariance under the lattice

Formalized by Claude Sonnet 5.5.

The lattice of the flag group at level `N` is `{(N i, N j, N k)} ⊂ H` (Malcev coordinates), generated by `(N, 0, 0)` (`latX N`), `(0, N, 0)` (`p ↦ p + N e₂`), `(0, 0, N)`
(`p ↦ p + N e₃`).  A function invariant under these three is invariant under the whole lattice (`lattice_invariant`): `(a, b, c) = (a, 0, 0)(0, b, 0)(0, 0, c - ab)` and `ab ∈ N² ℤ`.
-/

open scoped ContDiff
noncomputable section

namespace TernaryPeriodPolynomials.Argument.EisensteinClass.Heisenberg

section LatticeInv

variable {W : Type}

theorem latX_add (a b : ℝ) (p : Pt) : latX a (latX b p) = latX (a + b) p := by
  simp only [latX_apply]
  ext <;> simp <;> ring

theorem latX_zero (p : Pt) : latX 0 p = p := by
  simp [latX_apply]

theorem periodic_e3 {u : Pt → W} {T : ℝ} (h : ∀ p, u (p + T • e3) = u p) (m : ℤ) (p : Pt) :
    u (p + ((m : ℝ) * T) • e3) = u p := by
  have hper : Function.Periodic (fun t : ℝ => u (p + t • e3)) T := by
    intro t
    show u (p + (t + T) • e3) = u (p + t • e3)
    rw [add_smul, ← add_assoc]
    exact h _
  have := hper.int_mul m 0
  simpa using this

theorem periodic_e2 {u : Pt → W} {T : ℝ} (h : ∀ p, u (p + T • e2) = u p) (m : ℤ) (p : Pt) :
    u (p + ((m : ℝ) * T) • e2) = u p := by
  have hper : Function.Periodic (fun t : ℝ => u (p + t • e2)) T := by
    intro t
    show u (p + (t + T) • e2) = u (p + t • e2)
    rw [add_smul, ← add_assoc]
    exact h _
  have := hper.int_mul m 0
  simpa using this

theorem periodic_latX_nat {u : Pt → W} {T : ℝ} (h : ∀ p, u (latX T p) = u p) (n : ℕ) (p : Pt) :
    u (latX ((n : ℝ) * T) p) = u p := by
  induction n generalizing p with
  | zero => simp [latX_zero]
  | succ n ih =>
    have e : latX (((n + 1 : ℕ) : ℝ) * T) p = latX T (latX ((n : ℝ) * T) p) := by
      rw [latX_add]; congr 1; push_cast; ring
    rw [e, h, ih]

theorem periodic_latX {u : Pt → W} {T : ℝ} (h : ∀ p, u (latX T p) = u p) (m : ℤ) (p : Pt) :
    u (latX ((m : ℝ) * T) p) = u p := by
  rcases Int.eq_nat_or_neg m with ⟨n, rfl | rfl⟩
  · exact_mod_cast periodic_latX_nat h n p
  · have e : latX ((n : ℝ) * T) (latX (((-(n : ℤ) : ℤ) : ℝ) * T) p) = p := by
      rw [latX_add]; push_cast
      rw [show (n : ℝ) * T + -(n : ℝ) * T = 0 by ring, latX_zero]
    have h1 := periodic_latX_nat h n (latX (((-(n : ℤ) : ℤ) : ℝ) * T) p)
    rw [e] at h1
    exact h1.symm

theorem mulH_decomp (a b c : ℝ) (p : Pt) :
    mulH (a, b, c) p = mulH (a, 0, 0) (mulH (0, b, 0) (mulH (0, 0, c - a * b) p)) := by
  simp only [mulH]
  ext <;> simp
  ring

theorem mulH_e3 (c : ℝ) (p : Pt) : mulH (0, 0, c) p = p + c • e3 := by
  simp only [mulH, e3]; ext <;> simp [add_comm]

theorem mulH_e2 (b : ℝ) (p : Pt) : mulH (0, b, 0) p = p + b • e2 := by
  simp only [mulH, e2]; ext <;> simp [add_comm]

/-- **A function invariant under the three lattice generators is invariant under the whole lattice** `(Nℤ)³ ⊂ H`. -/
theorem lattice_invariant {u : Pt → W} {N : ℕ} (h3 : ∀ p, u (p + (N : ℝ) • e3) = u p)
    (h2 : ∀ p, u (p + (N : ℝ) • e2) = u p) (h1 : ∀ p, u (latX (N : ℝ) p) = u p) (i j k : ℤ) (p : Pt) :
    u (mulH ((N : ℝ) * i, (N : ℝ) * j, (N : ℝ) * k) p) = u p := by
  rw [mulH_decomp, ← latX_eq_mulH, mulH_e2, mulH_e3]
  have hc : (N : ℝ) * k - (N : ℝ) * i * ((N : ℝ) * j) = (((k - N * i * j : ℤ) : ℝ)) * N := by
    push_cast; ring
  rw [hc, show (N : ℝ) * i = (i : ℝ) * N by ring, periodic_latX h1 i, show (N : ℝ) * j = (j : ℝ) * N by ring,
    periodic_e2 h2 j, periodic_e3 h3]

end LatticeInv

end TernaryPeriodPolynomials.Argument.EisensteinClass.Heisenberg
