module

public import TernaryPeriodPolynomials.EisensteinSeries.ConstantTerms.Instance
public import Mathlib.RingTheory.RootsOfUnity.Lemmas

@[expose] public section


/-!
# `Γ(N)` is neat, in the paper's wording

A subgroup of `SL₃(ℤ)` is neat if for each of its elements the subgroup of `ℂˣ` generated by the
eigenvalues contains no nontrivial root of unity (`IsNeat`). The eigenvalues of `γ ∈ Γ(N)` are the
roots of its characteristic polynomial; each is an algebraic integer `≡ 1 (mod N)`, as is its inverse
(an eigenvalue of `γ⁻¹ ∈ Γ(N)`), and these congruences are stable under products
(`congGroup`). A root of unity `ζ ≠ 1` of order `m` with `ζ ≡ 1 (mod N)` would satisfy
`N^(m-1) ∣ m`, because `∏_{k<m}(1 - ζ^(k+1)) = m` and each factor is divisible by `1 - ζ`; this is
impossible for `N ≥ 3` (`gammaN_isNeat`). Serre's lemma, without cyclotomic norms.

Formalized by Claude Sonnet 5.5.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.ConvergenceC4

open scoped MatrixGroups
open Matrix Polynomial

/-! ### Congruence to one modulo `N` among algebraic integers -/

/-- `x ≡ 1 (mod N)` among algebraic integers: `(x - 1)/N` is integral over `ℤ`. -/
def CongOne (N : ℕ) (x : ℂ) : Prop := IsIntegral ℤ ((x - 1) / N)

theorem CongOne.isIntegral {N : ℕ} (hN : N ≠ 0) {x : ℂ} (h : CongOne N x) : IsIntegral ℤ x := by
  have hN' : (N : ℂ) ≠ 0 := by exact_mod_cast hN
  have : x = (N : ℂ) * ((x - 1) / N) + 1 := by field_simp; ring
  rw [this]
  exact IsIntegral.add (IsIntegral.mul (isIntegral_algebraMap (x := (N : ℤ)) (A := ℂ)) h) isIntegral_one

theorem CongOne.mul {N : ℕ} (hN : N ≠ 0) {x y : ℂ} (hx : CongOne N x) (hy : CongOne N y) :
    CongOne N (x * y) := by
  have hN' : (N : ℂ) ≠ 0 := by exact_mod_cast hN
  have : (x * y - 1) / N = (x - 1) / N * y + (y - 1) / N := by field_simp; ring
  unfold CongOne
  rw [this]
  exact IsIntegral.add (IsIntegral.mul hx (hy.isIntegral hN)) hy

/-- The subgroup of `ℂˣ` of units that are `≡ 1 (mod N)`, together with their inverses. -/
def congGroup (N : ℕ) (hN : N ≠ 0) : Subgroup ℂˣ where
  carrier := {u | CongOne N (u : ℂ) ∧ CongOne N ((u⁻¹ : ℂˣ) : ℂ)}
  one_mem' := by
    refine ⟨?_, ?_⟩ <;> simp [CongOne, isIntegral_zero]
  mul_mem' := by
    rintro u v ⟨hu, hu'⟩ ⟨hv, hv'⟩
    refine ⟨by simpa using hu.mul hN hv, ?_⟩
    simpa [_root_.mul_inv_rev, mul_comm] using hu'.mul hN hv'
  inv_mem' := by
    rintro u ⟨hu, hu'⟩
    exact ⟨hu', by simpa using hu⟩

/-- A root of unity `≠ 1` in the group `congGroup N` forces `N ^ (m - 1) ∣ m` for its order `m`. -/
theorem pow_dvd_order_of_mem_congGroup {N : ℕ} (hN : N ≠ 0) {u : ℂˣ}
    (hu : u ∈ congGroup N hN) {m : ℕ} (hprim : IsPrimitiveRoot (u : ℂ) (m + 1)) :
    ((N : ℤ) ^ m) ∣ ((m : ℤ) + 1) := by
  obtain ⟨hu1, -⟩ := hu
  have hN' : (N : ℂ) ≠ 0 := by exact_mod_cast hN
  set x : ℂ := (u : ℂ) with hx
  have hxint : IsIntegral ℤ x := hu1.isIntegral hN
  -- each factor `(1 - x^(k+1))/N` is integral
  have hν : ∀ k : ℕ, IsIntegral ℤ ((1 - x ^ (k + 1)) / N) := by
    intro k
    have e : (1 - x ^ (k + 1)) / N = -(((x - 1) / N) * ∑ j ∈ Finset.range (k + 1), x ^ j) := by
      have h := geom_sum_mul x (k + 1)
      have h2 : 1 - x ^ (k + 1) = -((x - 1) * ∑ j ∈ Finset.range (k + 1), x ^ j) := by
        linear_combination h
      rw [h2]
      ring
    rw [e]
    refine IsIntegral.neg (IsIntegral.mul hu1 ?_)
    exact IsIntegral.sum _ fun j _ => hxint.pow j
  have hprod := IsPrimitiveRoot.prod_one_sub_pow_eq_order hprim
  have hfac : ∏ k ∈ Finset.range m, (1 - x ^ (k + 1)) =
      (N : ℂ) ^ m * ∏ k ∈ Finset.range m, ((1 - x ^ (k + 1)) / N) := by
    have e : ∀ k ∈ Finset.range m, (1 - x ^ (k + 1)) = (N : ℂ) * ((1 - x ^ (k + 1)) / N) := by
      intro k _; field_simp
    rw [Finset.prod_congr rfl e, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range]
  have hP : IsIntegral ℤ (∏ k ∈ Finset.range m, ((1 - x ^ (k + 1)) / N)) :=
    IsIntegral.prod _ fun k _ => hν k
  set q : ℚ := ((m : ℚ) + 1) / (N : ℚ) ^ m with hq
  have hqc : (q : ℂ) = ∏ k ∈ Finset.range m, ((1 - x ^ (k + 1)) / N) := by
    have h1 : ((m : ℂ) + 1) = (N : ℂ) ^ m * ∏ k ∈ Finset.range m, ((1 - x ^ (k + 1)) / N) := by
      rw [← hfac]; exact_mod_cast hprod.symm
    rw [hq]
    push_cast
    rw [h1]
    field_simp
  have hqint : IsIntegral ℤ q := by
    rw [← isIntegral_algebraMap_iff (A := ℚ) (B := ℂ)]
    simpa [hqc] using hP
  obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.1 hqint
  have hNq : (N : ℚ) ^ m ≠ 0 := pow_ne_zero _ (by exact_mod_cast hN)
  refine ⟨z, ?_⟩
  have : ((m : ℚ) + 1) = (N : ℚ) ^ m * z := by
    have hz' : (z : ℚ) = q := hz
    rw [hz', hq]; field_simp
  exact_mod_cast this

/-- **A root of unity in `congGroup N` is trivial for `N ≥ 3`.** -/
theorem congGroup_torsionFree {N : ℕ} (hN : 3 ≤ N) {u : ℂˣ}
    (hu : u ∈ congGroup N (by omega)) (hfin : IsOfFinOrder u) : u = 1 := by
  by_contra hne
  have hpos := hfin.orderOf_pos
  have hne1 : orderOf u ≠ 1 := fun h => hne (orderOf_eq_one_iff.1 h)
  obtain ⟨m, hm⟩ : ∃ m, orderOf u = m + 1 := ⟨orderOf u - 1, by omega⟩
  have hm1 : 1 ≤ m := by omega
  have hprim : IsPrimitiveRoot (u : ℂ) (m + 1) := by
    have := (IsPrimitiveRoot.orderOf u).map_of_injective (f := Units.coeHom ℂ) Units.val_injective
    rwa [hm] at this
  have hdvd := pow_dvd_order_of_mem_congGroup (by omega) hu hprim
  have hle : (N : ℤ) ^ m ≤ (m : ℤ) + 1 := Int.le_of_dvd (by positivity) hdvd
  have hbern : (1 : ℤ) + (m : ℤ) * 2 ≤ (1 + 2) ^ m := one_add_mul_le_pow (by norm_num) m
  have h3 : ((3 : ℤ)) ^ m ≤ (N : ℤ) ^ m :=
    pow_le_pow_left₀ (by norm_num) (by exact_mod_cast hN) m
  have h2 : (1 + 2 : ℤ) = 3 := by norm_num
  rw [h2] at hbern
  have hm1' : (1 : ℤ) ≤ m := by exact_mod_cast hm1
  linarith

/-! ### Eigenvalues of elements of `Γ(N)` -/

/-- The eigenvalues of `γ ∈ SL₃(ℤ)`: the roots in `ℂ` of its characteristic polynomial. -/
def IsEigenvalue (γ : SL(3, ℤ)) (z : ℂ) : Prop :=
  ((γ : Matrix (Fin 3) (Fin 3) ℤ).map (Int.castRingHom ℂ)).charpoly.IsRoot z

/-- Every eigenvalue of an element of `Γ(N)` is `≡ 1 (mod N)` among algebraic integers. -/
theorem eigenvalue_cong {N : ℕ} (hN : N ≠ 0) {γ : SL(3, ℤ)} (hγ : γ ∈ gammaN N) {z : ℂ}
    (hz : IsEigenvalue γ z) : CongOne N z := by
  have hN' : (N : ℂ) ≠ 0 := by exact_mod_cast hN
  set A : Matrix (Fin 3) (Fin 3) ℤ := (γ : Matrix (Fin 3) (Fin 3) ℤ) with hA
  set Mc : Matrix (Fin 3) (Fin 3) ℂ := A.map (Int.castRingHom ℂ) with hMc
  -- the integer matrix `B = (γ - 1)/N`
  have hdiv := mem_gammaN.1 hγ
  let B : Matrix (Fin 3) (Fin 3) ℤ := Matrix.of fun i j => (A i j - (1 : Matrix (Fin 3) (Fin 3) ℤ) i j) / N
  have hB : ∀ i j, A i j = (1 : Matrix (Fin 3) (Fin 3) ℤ) i j + (N : ℤ) * B i j := by
    intro i j
    have := Int.mul_ediv_cancel' (hdiv i j)
    simp only [B, Matrix.of_apply]
    linarith
  set Bc : Matrix (Fin 3) (Fin 3) ℂ := B.map (Int.castRingHom ℂ) with hBc
  have hMB : Mc = 1 + (N : ℂ) • Bc := by
    ext i j
    simp only [hMc, hBc, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
      eq_intCast]
    have h1 : ((1 : Matrix (Fin 3) (Fin 3) ℤ) i j : ℂ) = (1 : Matrix (Fin 3) (Fin 3) ℂ) i j := by
      by_cases hij : i = j <;> simp [Matrix.one_apply, hij]
    rw [← h1]
    exact_mod_cast hB i j
  -- an eigenvector
  have hdet : (Matrix.scalar (Fin 3) z - Mc).det = 0 := by
    have := hz
    unfold IsEigenvalue at this
    rw [Polynomial.IsRoot, Matrix.eval_charpoly] at this
    exact this
  obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.2 hdet
  have h1 : Mc *ᵥ v = z • v := by
    rw [Matrix.sub_mulVec] at hv
    have hs : (Matrix.scalar (Fin 3) z) *ᵥ v = z • v := by
      ext i; simp [Matrix.mulVec, dotProduct, Matrix.scalar_apply, Matrix.diagonal]
    rw [hs] at hv
    exact (sub_eq_zero.1 hv).symm
  have h2 : Bc *ᵥ v = ((z - 1) / N) • v := by
    rw [hMB, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec] at h1
    have h3 : (N : ℂ) • (Bc *ᵥ v) = (z - 1) • v := by
      rw [sub_smul, one_smul, ← h1]; abel
    have := congrArg (fun w => ((N : ℂ)⁻¹) • w) h3
    simp only [smul_smul, inv_mul_cancel₀ hN', one_smul] at this
    rw [this, div_eq_inv_mul]
  have hdet2 : (Matrix.scalar (Fin 3) ((z - 1) / N) - Bc).det = 0 := by
    refine Matrix.exists_mulVec_eq_zero_iff.1 ⟨v, hv0, ?_⟩
    rw [Matrix.sub_mulVec, h2]
    have hs : (Matrix.scalar (Fin 3) ((z - 1) / N)) *ᵥ v = ((z - 1) / N) • v := by
      ext i; simp [Matrix.mulVec, dotProduct, Matrix.scalar_apply, Matrix.diagonal]
    rw [hs, sub_self]
  have hroot : (B.charpoly.map (Int.castRingHom ℂ)).eval ((z - 1) / N) = 0 := by
    rw [← Matrix.charpoly_map B (Int.castRingHom ℂ), Matrix.eval_charpoly]
    exact hdet2
  refine ⟨B.charpoly, Matrix.charpoly_monic B, ?_⟩
  rw [Polynomial.eval₂_eq_eval_map]
  exact hroot

theorem isEigenvalue_iff (γ : SL(3, ℤ)) (z : ℂ) :
    IsEigenvalue γ z ↔ ∃ v : Fin 3 → ℂ, v ≠ 0 ∧
      ((γ : Matrix (Fin 3) (Fin 3) ℤ).map (Int.castRingHom ℂ)) *ᵥ v = z • v := by
  unfold IsEigenvalue
  rw [Polynomial.IsRoot, Matrix.eval_charpoly, ← Matrix.exists_mulVec_eq_zero_iff]
  have hs : ∀ v : Fin 3 → ℂ, (Matrix.scalar (Fin 3) z) *ᵥ v = z • v := fun v => by
    ext i; simp [Matrix.mulVec, dotProduct, Matrix.scalar_apply, Matrix.diagonal]
  constructor
  · rintro ⟨v, hv0, hv⟩
    refine ⟨v, hv0, ?_⟩
    rw [Matrix.sub_mulVec, hs] at hv
    exact (sub_eq_zero.1 hv).symm
  · rintro ⟨v, hv0, hv⟩
    refine ⟨v, hv0, ?_⟩
    rw [Matrix.sub_mulVec, hs, hv, sub_self]

/-- The inverse of an eigenvalue is an eigenvalue of the inverse. -/
theorem isEigenvalue_inv {γ : SL(3, ℤ)} {z : ℂ} (hz : IsEigenvalue γ z) :
    z ≠ 0 ∧ IsEigenvalue γ⁻¹ z⁻¹ := by
  obtain ⟨v, hv0, hv⟩ := (isEigenvalue_iff γ z).1 hz
  set Mc : Matrix (Fin 3) (Fin 3) ℂ := (γ : Matrix (Fin 3) (Fin 3) ℤ).map (Int.castRingHom ℂ)
  set Mi : Matrix (Fin 3) (Fin 3) ℂ :=
    ((γ⁻¹ : SL(3, ℤ)) : Matrix (Fin 3) (Fin 3) ℤ).map (Int.castRingHom ℂ) with hMi
  have hMM : Mi * Mc = 1 := by
    have h1 : (((γ⁻¹ * γ : SL(3, ℤ)) : Matrix (Fin 3) (Fin 3) ℤ)) = 1 := by simp
    rw [Matrix.SpecialLinearGroup.coe_mul] at h1
    have h2 := congrArg (Int.castRingHom ℂ).mapMatrix h1
    rw [map_mul, map_one] at h2
    exact h2
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hv
    have := congrArg (fun w => Mi *ᵥ w) hv
    simp only [Matrix.mulVec_mulVec, hMM, Matrix.one_mulVec, Matrix.mulVec_zero] at this
    exact hv0 this
  refine ⟨hz0, (isEigenvalue_iff _ _).2 ⟨v, hv0, ?_⟩⟩
  have := congrArg (fun w => Mi *ᵥ w) hv
  simp only [Matrix.mulVec_mulVec, hMM, Matrix.one_mulVec, Matrix.mulVec_smul] at this
  have h3 := congrArg (fun w => z⁻¹ • w) this
  simp only [smul_smul, inv_mul_cancel₀ hz0, one_smul] at h3
  exact h3.symm

/-- The subgroup of `ℂˣ` generated by the eigenvalues of `γ`. -/
def eigenvalueGroup (γ : SL(3, ℤ)) : Subgroup ℂˣ :=
  Subgroup.closure {u : ℂˣ | IsEigenvalue γ (u : ℂ)}

/-- **Neatness, in the paper's wording**: for each element of `Γ`, the subgroup of `ℂˣ`
generated by its eigenvalues contains no nontrivial root of unity. -/
def IsNeat (Γ : Subgroup SL(3, ℤ)) : Prop :=
  ∀ γ ∈ Γ, ∀ u ∈ eigenvalueGroup γ, IsOfFinOrder u → u = 1

/-- **The principal congruence subgroup `Γ(N)`, `N ≥ 3`, is neat.** (Serre's lemma: the eigenvalues
of `γ ≡ 1 (mod N)` are algebraic integers `≡ 1 (mod N)`, and so are the elements of the group
they generate; a root of unity `ζ ≠ 1` of order `m` in that group would give `N^{m-1} ∣ m`, from
`∏_{k<m}(1 - ζ^k) = m`.) -/
theorem gammaN_isNeat {N : ℕ} (hN : 3 ≤ N) : IsNeat (gammaN N) := by
  intro γ hγ u hu hfin
  have hN0 : N ≠ 0 := by omega
  have hle : eigenvalueGroup γ ≤ congGroup N hN0 := by
    refine (Subgroup.closure_le _).2 fun w hw => ?_
    obtain ⟨hw0, hwi⟩ := isEigenvalue_inv hw
    refine ⟨eigenvalue_cong hN0 hγ hw, ?_⟩
    have := eigenvalue_cong hN0 ((gammaN N).inv_mem hγ) hwi
    simpa using this
  exact congGroup_torsionFree hN (hle hu) hfin

end TernaryPeriodPolynomials.Argument.ConvergenceC4
