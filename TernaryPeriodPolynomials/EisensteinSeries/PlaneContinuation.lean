@[expose] public section


open GeneralEisenstein
open Homogeneous Adelic

namespace TernaryPeriodPolynomials.PlaneEisensteinContinuation

theorem plane_eisenstein_continuation : ∀ (n : ℕ) (D : InducingData n), ∀ F : ℂ → AdelicGL → ℂ,
    IsFlatSection D F → ∃ E : ℂ → AdelicGL → ℂ, IsEisensteinContinuation F E := by
  intro n D F flat
  exact PlaneContinuation.exists_continuation flat

end TernaryPeriodPolynomials.PlaneEisensteinContinuation
