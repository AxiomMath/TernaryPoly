module

public import TernaryPeriodPolynomials.EisensteinSeries.Regularity.Basic
public import TernaryPeriodPolynomials.ArithmeticCohomology.Automorphic.SmoothVectors
public import TernaryPeriodPolynomials.EisensteinSeries.CuspIntegral.Space

@[expose] public section


/-!
# Finite-adelic models of holomorphic cusp forms

The holomorphic model of a cuspidal representation of `GL₂(𝔸)` generated by weight-`k`
holomorphic cusp forms is assembled from a unitary representation `σ` of `GL₂(𝔸_f)` on a
Hilbert space `E` whose smooth vectors (those fixed by an open compact subgroup) are realized,
injectively and `GL₂(𝔸_f)`-equivariantly, by holomorphic weight-`k` functions on `GL₂(𝔸)`
with the four scalar cuspidal properties of `CuspIntegral.IsCuspidalLike`. This file
defines the fixed and smooth subspaces of `σ` and the structure `FiniteModel` recording these
data. The intended instance is the Petersson completion of the span of the
`GL₂(𝔸_f)`-translates of the adelic lifts of cusp forms on `Γ₁(3)`, with `ε` the inclusion.
-/

noncomputable section

open GeneralEisenstein GeneralEisenstein.Adelic Matrix
open TernaryPeriodPolynomials.Automorphic.SmoothVectors
open TernaryPeriodPolynomials.CuspIntegral

namespace TernaryPeriodPolynomials.Regularity

section Fixed

variable {E : Type*} [AddCommGroup E] [Module ℂ E] (σ : Representation ℂ BinaryFiniteGL E)

/-- The vectors fixed by every element of a subgroup `U` of `GL₂(𝔸_f)`. -/
def fixedSubmodule (U : Subgroup BinaryFiniteGL) : Submodule ℂ E where
  carrier := {e | ∀ u : U, σ u.val e = e}
  add_mem' {a b} ha hb u := by rw [map_add, ha u, hb u]
  zero_mem' _ := map_zero _
  smul_mem' c e he u := by rw [map_smul, he u]

theorem mem_fixedSubmodule {U : Subgroup BinaryFiniteGL} {e : E} :
    e ∈ fixedSubmodule σ U ↔ ∀ u : U, σ u.val e = e :=
  Iff.rfl

theorem fixedSubmodule_anti {U V : Subgroup BinaryFiniteGL} (hUV : U ≤ V) :
    fixedSubmodule σ V ≤ fixedSubmodule σ U :=
  fun _ he u => he ⟨u.val, hUV u.property⟩

/-- The smooth vectors of `σ`: those fixed by some open compact subgroup of `GL₂(𝔸_f)`. -/
def finiteSmooth : Submodule ℂ E where
  carrier := {e | ∃ U : Subgroup BinaryFiniteGL, IsOpenCompact U ∧ e ∈ fixedSubmodule σ U}
  add_mem' := by
    rintro a b ⟨U, hU, ha⟩ ⟨V, hV, hb⟩
    refine ⟨U ⊓ V, hU.inf hV, fun u => ?_⟩
    rw [map_add, ha ⟨u.val, u.property.1⟩, hb ⟨u.val, u.property.2⟩]
  zero_mem' := ⟨integralLevel, integralLevel_isOpenCompact, (fixedSubmodule σ _).zero_mem⟩
  smul_mem' := by
    rintro c e ⟨U, hU, he⟩
    exact ⟨U, hU, (fixedSubmodule σ U).smul_mem c he⟩

theorem mem_finiteSmooth_of_fixed {U : Subgroup BinaryFiniteGL} (hU : IsOpenCompact U) {e : E}
    (he : e ∈ fixedSubmodule σ U) : e ∈ finiteSmooth σ :=
  ⟨U, hU, he⟩

/-- The smooth vectors are stable under `σ`: if `U` fixes `e`, then `g U g⁻¹` fixes `σ g e`. -/
theorem finiteSmooth_stable (g : BinaryFiniteGL) {e : E} (he : e ∈ finiteSmooth σ) :
    σ g e ∈ finiteSmooth σ := by
  obtain ⟨U, hU, hUe⟩ := he
  refine ⟨U.map (MulAut.conj g).toMonoidHom, hU.map_conj g, ?_⟩
  rintro ⟨_, hmem⟩
  obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hmem
  change σ (g * u * g⁻¹) (σ g e) = σ g e
  rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply,
    ← Module.End.mul_apply (σ g⁻¹), ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply,
    hUe ⟨u, hu⟩]

end Fixed

/-- A finite-adelic model of weight-`k` holomorphic cusp forms.

`E` carries a unitary, strongly continuous representation `σ` of `GL₂(𝔸_f)` with
finite-dimensional spaces of vectors fixed by open compact subgroups. Its smooth vectors are
realized by `ε` as functions on `GL₂(𝔸)`: injectively, equivariantly for right translation by
`GL₂(𝔸_f)`, continuous, with the scalar cuspidal properties for the central character `χ`, of
weight `k` under the stabiliser `stab a b = !![a, b; -b, a]` of `i`, and holomorphic: for every
`x`, the function `z ↦ (Im z)^(-k/2) ε e (x · gUp z)` is holomorphic on the upper half plane,
where `gUp z = !![Im z, Re z; 0, 1]` sends `i` to `z`. -/
structure FiniteModel (k : ℕ) where
  /-- The Hilbert space of the finite-adelic component. -/
  E : Type
  [normed : NormedAddCommGroup E]
  [inner : InnerProductSpace ℂ E]
  [complete : CompleteSpace E]
  /-- The representation of `GL₂(𝔸_f)`. -/
  σ : Representation ℂ BinaryFiniteGL E
  unitary : ∀ g e, ‖σ g e‖ = ‖e‖
  continuous : ∀ e, Continuous fun g => σ g e
  finiteDimensional : ∀ U : Subgroup BinaryFiniteGL, IsOpenCompact U →
    FiniteDimensional ℂ (fixedSubmodule σ U)
  /-- The realization of smooth vectors as functions on `GL₂(𝔸)`. -/
  ε : finiteSmooth σ →ₗ[ℂ] (BinaryAdelicGL → ℂ)
  injective : Function.Injective ε
  equivariant : ∀ g (e : finiteSmooth σ) x,
    ε ⟨σ g e, finiteSmooth_stable σ g e.property⟩ x = ε e (x * atFinite g)
  /-- The central character. -/
  χ : Adelesˣ →* ℂ
  χ_unitary : ∀ t, ‖χ t‖ = 1
  like : ∀ e, IsCuspidalLike χ (ε e)
  continuous_ε : ∀ e, Continuous (ε e)
  weight : ∀ e x (a b : ℝ), a ^ 2 + b ^ 2 ≠ 0 →
    ε e (x * atInfinity (stab a b)) = ((⟨a, b⟩ : ℂ) / ((‖(⟨a, b⟩ : ℂ)‖ : ℝ) : ℂ)) ^ k * ε e x
  holomorphic : ∀ e x, DifferentiableOn ℂ
    (fun z : ℂ => (((z.im ^ ((k : ℝ) / 2))⁻¹ : ℝ) : ℂ) * ε e (x * atInfinity (gUp z))) upper

attribute [instance] FiniteModel.normed FiniteModel.inner FiniteModel.complete

end TernaryPeriodPolynomials.Regularity

end
