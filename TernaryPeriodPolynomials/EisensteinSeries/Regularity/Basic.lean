/-!
# Vocabulary for the holomorphic model of the archimedean component

The archimedean component of the cuspidal representation generated by a holomorphic cusp form
of weight `k` is modelled on holomorphic functions on `ℂ ∖ ℝ`, on which a real invertible
matrix `g = !![a, b; c, d]` acts by the complex Möbius transformation
`moeb g w = (a w + b) / (c w + d)` (a matrix of negative determinant exchanges the two half
planes). This file fixes the vocabulary:

* `offReal`, `upper`: the sets `ℂ ∖ ℝ` and `{Im > 0}`, and the hyperbolic measure
  `hypMeasure = |Im w|^(-2) dA(w)` on `ℂ ∖ ℝ`;
* `denom g w = c w + d`, `moeb g w`, and the weight-`k` factor
  `autFactor k g w = |det g|^(-k/2) (denom g⁻¹ w)^(-k)`;
* `gUp z = !![Im z, Re z; 0, 1]` (sending `i` to `z`), `gBar w = gUp (conj w)`,
  `stab a b = !![a, b; -b, a]` (the stabiliser of `i`) and the rotations `rotGL θ`;
* the Cayley transform `cay z = (z - i)/(z + i)` with inverse `icay`, the disc transform
  `discTransform k G ζ = (icay ζ + i)^k • G (icay ζ)` of a function on the upper half plane,
  its Taylor coefficients `upperCoeff k G n`, and the radial moments `discMoment m a`.
-/

noncomputable section

open Complex MeasureTheory Matrix

namespace TernaryPeriodPolynomials.Regularity

/-- The complement `ℂ ∖ ℝ` of the real axis. -/
def offReal : Set ℂ := {w | w.im ≠ 0}

/-- The upper half plane as a subset of `ℂ`. -/
def upper : Set ℂ := {z | 0 < z.im}

/-- The hyperbolic measure `|Im w|^(-2) dA(w)` on `ℂ ∖ ℝ`, extended by zero to the real axis. -/
def hypMeasure : Measure ℂ :=
  (volume.restrict offReal).withDensity fun w => ENNReal.ofReal ((w.im ^ 2)⁻¹)

/-- The automorphy factor `c w + d` of `g = !![a, b; c, d]`. -/
def denom (g : GL (Fin 2) ℝ) (w : ℂ) : ℂ := (g.val 1 0 : ℂ) * w + (g.val 1 1 : ℂ)

/-- The complex Möbius transformation `(a w + b) / (c w + d)` of `g = !![a, b; c, d]`. -/
def moeb (g : GL (Fin 2) ℝ) (w : ℂ) : ℂ :=
  ((g.val 0 0 : ℂ) * w + (g.val 0 1 : ℂ)) / denom g w

/-- The weight-`k` factor `|det g|^(-k/2) (denom g⁻¹ w)^(-k)` of the action of `g`. -/
def autFactor (k : ℕ) (g : GL (Fin 2) ℝ) (w : ℂ) : ℂ :=
  (((|g.val.det| ^ ((k : ℝ) / 2))⁻¹ : ℝ) : ℂ) * (denom g⁻¹ w ^ k)⁻¹

/-- The matrix `!![Im z, Re z; 0, 1]`, which sends `i` to `z`; the identity when `Im z = 0`. -/
def gUp (z : ℂ) : GL (Fin 2) ℝ :=
  if h : z.im ≠ 0 then
    Matrix.GeneralLinearGroup.mkOfDetNeZero !![z.im, z.re; 0, 1] (by
      rw [Matrix.det_fin_two_of]
      intro h'
      exact h (by linear_combination h'))
  else 1

/-- The matrix `!![-Im w, Re w; 0, 1]`, which sends `i` to `conj w`. -/
def gBar (w : ℂ) : GL (Fin 2) ℝ := gUp ((starRingEnd ℂ) w)

/-- The matrix `!![a, b; -b, a]`, which fixes `i`; the identity when `a = b = 0`. -/
def stab (a b : ℝ) : GL (Fin 2) ℝ :=
  if h : a ^ 2 + b ^ 2 ≠ 0 then
    Matrix.GeneralLinearGroup.mkOfDetNeZero !![a, b; -b, a] (by
      rw [Matrix.det_fin_two_of]
      intro h'
      exact h (by linear_combination h'))
  else 1

/-- The rotation `!![cos θ, -sin θ; sin θ, cos θ]`. -/
def rotGL (θ : ℝ) : GL (Fin 2) ℝ := stab (Real.cos θ) (-Real.sin θ)

/-- The Cayley transform `(z - i) / (z + i)` from the upper half plane to the unit disc. -/
def cay (z : ℂ) : ℂ := (z - I) / (z + I)

/-- The inverse Cayley transform `i (1 + ζ) / (1 - ζ)` from the unit disc to the upper half
plane. -/
def icay (ζ : ℂ) : ℂ := I * (1 + ζ) / (1 - ζ)

section Coefficients

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The weight-`k` disc transform `ζ ↦ (icay ζ + i)^k • G (icay ζ)` of a function `G` on the
upper half plane. -/
def discTransform (k : ℕ) (G : ℂ → E) (ζ : ℂ) : E := (icay ζ + I) ^ k • G (icay ζ)

/-- The `n`-th Taylor coefficient at `0`, as a Cauchy integral over the circle of radius `1/2`. -/
def taylorCoeff (H : ℂ → E) (n : ℕ) : E := cauchyPowerSeries H 0 (1 / 2) n (fun _ => 1)

/-- The `n`-th coefficient of a function on the upper half plane: the Taylor coefficient of its
disc transform. -/
def upperCoeff (k : ℕ) (G : ℂ → E) (n : ℕ) : E := taylorCoeff (discTransform k G) n

/-- The reflection `z ↦ F (-z)`, moving the lower half plane to the upper one. -/
def lowerPart (F : ℂ → E) : ℂ → E := fun z => F (-z)

end Coefficients

/-- The radial moment `∫_{|ζ| < 1} |ζ|^m (1 - |ζ|²)^a dA(ζ)`. -/
def discMoment (m : ℕ) (a : ℝ) : ℝ :=
  ∫ ζ in Metric.ball (0 : ℂ) 1, ‖ζ‖ ^ m * (1 - ‖ζ‖ ^ 2) ^ a

/-! ### Matrix entries -/

theorem gUp_val {z : ℂ} (h : z.im ≠ 0) : (gUp z).val = !![z.im, z.re; 0, 1] := by
  rw [gUp, dite_eq_left h]
  exact Matrix.GeneralLinearGroup.val_mkOfDetNeZero _ _

theorem gBar_val {w : ℂ} (h : w.im ≠ 0) : (gBar w).val = !![-w.im, w.re; 0, 1] := by
  have h' : ((starRingEnd ℂ) w).im ≠ 0 := by simpa using h
  rw [gBar, gUp_val h']
  simp

theorem stab_val {a b : ℝ} (h : a ^ 2 + b ^ 2 ≠ 0) : (stab a b).val = !![a, b; -b, a] := by
  rw [stab, dite_eq_left h]
  exact Matrix.GeneralLinearGroup.val_mkOfDetNeZero _ _

theorem rotGL_val (θ : ℝ) :
    (rotGL θ).val = !![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ] := by
  have h : Real.cos θ ^ 2 + (-Real.sin θ) ^ 2 ≠ 0 := by
    rw [neg_sq, Real.cos_sq_add_sin_sq]
    exact one_ne_zero
  rw [rotGL, stab_val h, neg_neg]

end TernaryPeriodPolynomials.Regularity

end
