module

public import Mathlib
public import TernaryPeriodPolynomials.ArithmeticCohomology.Defs.HomogeneousCohomology
public import Batteries.Data.MLList.Basic
public import Batteries.Lean.LawfulMonadLift
public import Batteries.Lean.Meta.Simp
public import Batteries.Recycling.MonadSatisfying.Lean
public import Batteries.Util.Pickle

@[expose] public section


/-!
# Extension of a homogeneous cohomology class over a central involution (generic)

Let `Γ ≤ G`, `ρ` a representation of `G` on `V`, and `z ∈ G` a central element with `z² = 1`.  The extended level
`Γ' = Γ ∪ Γ z` (`centralExtension`) is a subgroup; restriction of equivariant homogeneous cochains from `Γ'` to `Γ`
(`resCocycle`, `resH2`) is the restriction `H²(Γ', ρ) → H²(Γ, ρ)`.

* `classOf_translateCocycle`: the translation `x ↦ z x` of the vertices of a `Γ`-cocycle does not change its class (prism
  homotopy: `translate c − c = ∂ (c(x₀, z x₀, z x₁) − c(x₀, x₁, z x₁))`).
* `smul_sub_one_eq_zero`: if `ρ z = s • id`, every class in the image of the restriction from `Γ'` satisfies
  `(s − 1) • a = 0`.
* `exists_extension_of_one`: if `ρ z = 1`, every class of `H²(Γ, ρ)` is in the image of the restriction from `Γ'`
  (average `½(c(x) + c(z x))`).

Formalized by Claude Sonnet 5.5.
-/

open GeneralEisenstein.Homogeneous

noncomputable section

namespace TernaryPeriodPolynomials.Argument.ConvergentEisenstein.FiniteEntries

section Generic

variable {G V : Type} [Group G] [AddCommGroup V] [Module ℂ V]

/-- The group generated by `Γ` and a central involution `z`. -/
def centralExtension (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1) : Subgroup G where
  carrier := {g | g ∈ Γ ∨ ∃ γ ∈ Γ, g = γ * z}
  one_mem' := Or.inl Γ.one_mem
  mul_mem' := by
    rintro a b (ha | ⟨γ, hγ, rfl⟩) (hb | ⟨δ, hδ, rfl⟩)
    · exact Or.inl (Γ.mul_mem ha hb)
    · exact Or.inr ⟨a * δ, Γ.mul_mem ha hδ, by rw [mul_assoc]⟩
    · refine Or.inr ⟨γ * b, Γ.mul_mem hγ hb, ?_⟩
      rw [mul_assoc, hz b, ← mul_assoc]
    · refine Or.inl ?_
      have : γ * z * (δ * z) = γ * δ := by
        rw [mul_assoc, ← mul_assoc z δ z, hz δ, mul_assoc δ z z, hz2, mul_one]
      rw [this]
      exact Γ.mul_mem hγ hδ
  inv_mem' := by
    rintro a (ha | ⟨γ, hγ, rfl⟩)
    · exact Or.inl (Γ.inv_mem ha)
    · refine Or.inr ⟨γ⁻¹, Γ.inv_mem hγ, ?_⟩
      have hzinv : z⁻¹ = z := inv_eq_of_mul_eq_one_right hz2
      rw [mul_inv_rev, hzinv, hz γ⁻¹]

theorem le_centralExtension (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1) :
    Γ ≤ centralExtension Γ z hz hz2 := fun _ h => Or.inl h

theorem z_mem_centralExtension (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1) :
    z ∈ centralExtension Γ z hz hz2 :=
  Or.inr ⟨1, Γ.one_mem, by rw [one_mul]⟩

/-- Restriction of equivariant cochains to a subgroup. -/
def resCochain {Γ Γ' : Subgroup G} (ρ : Representation ℂ G V) (h : Γ ≤ Γ') (k : ℕ) :
    cochains Γ' ρ k →ₗ[ℂ] cochains Γ ρ k where
  toFun f := ⟨f.val, fun γ x => f.property ⟨γ.val, h γ.2⟩ x⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Restriction of cocycles. -/
def resCocycle {Γ Γ' : Subgroup G} (ρ : Representation ℂ G V) (h : Γ ≤ Γ') :
    cocycles Γ' ρ →ₗ[ℂ] cocycles Γ ρ where
  toFun c := ⟨resCochain ρ h 2 c.val, c.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem resCocycle_boundaryMap {Γ Γ' : Subgroup G} (ρ : Representation ℂ G V) (h : Γ ≤ Γ')
    (b : cochains Γ' ρ 1) :
    resCocycle ρ h (boundaryMap Γ' ρ b) = boundaryMap Γ ρ (resCochain ρ h 1 b) := rfl

/-- The restriction `H²(Γ', ρ) → H²(Γ, ρ)`. -/
def resH2 {Γ Γ' : Subgroup G} (ρ : Representation ℂ G V) (h : Γ ≤ Γ') : H2 Γ' ρ →ₗ[ℂ] H2 Γ ρ :=
  Submodule.mapQ _ _ (resCocycle ρ h) (by
    rintro _ ⟨b, rfl⟩
    exact ⟨resCochain ρ h 1 b, (resCocycle_boundaryMap ρ h b).symm⟩)

theorem resH2_classOf {Γ Γ' : Subgroup G} (ρ : Representation ℂ G V) (h : Γ ≤ Γ') (c : cocycles Γ' ρ) :
    resH2 ρ h (classOf Γ' ρ c) = classOf Γ ρ (resCocycle ρ h c) := rfl

/-- Translation of the vertices by a central element, as a map of cochains. -/
def translateCochain (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (ρ : Representation ℂ G V) (k : ℕ) :
    cochains Γ ρ k →ₗ[ℂ] cochains Γ ρ k where
  toFun f := ⟨fun x => f.val (fun i => z * x i), by
    intro γ x
    have := f.property γ (fun i => z * x i)
    have e : (fun i => γ.val * (z * x i)) = fun i => z * (γ.val * x i) := by
      funext i; rw [← mul_assoc, ← hz γ.val, mul_assoc]
    simp only [← e]
    exact this⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem translate_vec3 (z : G) (a b c : G) :
    (fun i : Fin 3 => z * (![a, b, c] : Fin 3 → G) i) = ![z * a, z * b, z * c] := by
  funext i; fin_cases i <;> rfl

theorem translate_differentialTwo (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (ρ : Representation ℂ G V)
    (c : cochains Γ ρ 2) (x : Fin 4 → G) :
    differentialTwo Γ ρ (translateCochain Γ z hz ρ 2 c) x =
      differentialTwo Γ ρ c (fun i => z * x i) := by
  change c.val (fun i => z * (![x 1, x 2, x 3] : Fin 3 → G) i) - c.val (fun i => z * (![x 0, x 2, x 3] : Fin 3 → G) i) +
      c.val (fun i => z * (![x 0, x 1, x 3] : Fin 3 → G) i) - c.val (fun i => z * (![x 0, x 1, x 2] : Fin 3 → G) i) =
    c.val ![z * x 1, z * x 2, z * x 3] - c.val ![z * x 0, z * x 2, z * x 3] +
      c.val ![z * x 0, z * x 1, z * x 3] - c.val ![z * x 0, z * x 1, z * x 2]
  simp only [translate_vec3]

/-- Translation of cocycles. -/
def translateCocycle (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (ρ : Representation ℂ G V) :
    cocycles Γ ρ →ₗ[ℂ] cocycles Γ ρ where
  toFun c := ⟨translateCochain Γ z hz ρ 2 c.val, by
    funext x
    rw [translate_differentialTwo]
    exact congrFun c.property _⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The prism cochain `(x₀, x₁) ↦ c(x₀, z x₀, z x₁) − c(x₀, x₁, z x₁)`. -/
def prism (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (ρ : Representation ℂ G V) (c : cocycles Γ ρ) :
    cochains Γ ρ 1 :=
  ⟨fun x => c.val.val ![x 0, z * x 0, z * x 1] - c.val.val ![x 0, x 1, z * x 1], by
    intro γ x
    have h1 := c.val.property γ ![x 0, z * x 0, z * x 1]
    have h2 := c.val.property γ ![x 0, x 1, z * x 1]
    have e1 : (fun i => γ.val * ![x 0, z * x 0, z * x 1] i) =
        ![γ.val * x 0, z * (γ.val * x 0), z * (γ.val * x 1)] := by
      funext i; fin_cases i
      · rfl
      · show γ.val * (z * x 0) = z * (γ.val * x 0)
        rw [← mul_assoc, ← hz γ.val, mul_assoc]
      · show γ.val * (z * x 1) = z * (γ.val * x 1)
        rw [← mul_assoc, ← hz γ.val, mul_assoc]
    have e2 : (fun i => γ.val * ![x 0, x 1, z * x 1] i) =
        ![γ.val * x 0, γ.val * x 1, z * (γ.val * x 1)] := by
      funext i; fin_cases i
      · rfl
      · rfl
      · show γ.val * (z * x 1) = z * (γ.val * x 1)
        rw [← mul_assoc, ← hz γ.val, mul_assoc]
    rw [e1] at h1
    rw [e2] at h2
    change c.val.val ![γ.val * x 0, z * (γ.val * x 0), z * (γ.val * x 1)] -
        c.val.val ![γ.val * x 0, γ.val * x 1, z * (γ.val * x 1)] = _
    rw [h1, h2, map_sub]⟩

theorem boundary_prism (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (ρ : Representation ℂ G V)
    (c : cocycles Γ ρ) :
    boundaryMap Γ ρ (prism Γ z hz ρ c) = translateCocycle Γ z hz ρ c - c := by
  apply Subtype.ext
  apply Subtype.ext
  funext x
  have hc1 := congrFun c.property ![x 0, x 1, x 2, z * x 2]
  have hc2 := congrFun c.property ![x 0, x 1, z * x 1, z * x 2]
  have hc3 := congrFun c.property ![x 0, z * x 0, z * x 1, z * x 2]
  have hc1' : c.val.val ![x 1, x 2, z * x 2] - c.val.val ![x 0, x 2, z * x 2] +
      c.val.val ![x 0, x 1, z * x 2] - c.val.val ![x 0, x 1, x 2] = 0 := hc1
  have hc2' : c.val.val ![x 1, z * x 1, z * x 2] - c.val.val ![x 0, z * x 1, z * x 2] +
      c.val.val ![x 0, x 1, z * x 2] - c.val.val ![x 0, x 1, z * x 1] = 0 := hc2
  have hc3' : c.val.val ![z * x 0, z * x 1, z * x 2] - c.val.val ![x 0, z * x 1, z * x 2] +
      c.val.val ![x 0, z * x 0, z * x 2] - c.val.val ![x 0, z * x 0, z * x 1] = 0 := hc3
  have hx : x = ![x 0, x 1, x 2] := by funext i; fin_cases i <;> rfl
  have hxz : (fun i => z * x i) = ![z * x 0, z * x 1, z * x 2] := by funext i; fin_cases i <;> rfl
  change (c.val.val ![x 1, z * x 1, z * x 2] - c.val.val ![x 1, x 2, z * x 2]) -
      (c.val.val ![x 0, z * x 0, z * x 2] - c.val.val ![x 0, x 2, z * x 2]) +
      (c.val.val ![x 0, z * x 0, z * x 1] - c.val.val ![x 0, x 1, z * x 1]) =
      c.val.val (fun i => z * x i) - c.val.val x
  have hx' : c.val.val x = c.val.val ![x 0, x 1, x 2] := congrArg c.val.val hx
  rw [hxz, hx']
  linear_combination (norm := module) (-1 : ℂ) • hc3' + hc2' - hc1'

theorem classOf_boundaryMap (Γ : Subgroup G) (ρ : Representation ℂ G V) (b : cochains Γ ρ 1) :
    classOf Γ ρ (boundaryMap Γ ρ b) = 0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr ⟨b, rfl⟩

/-- **Translation by a central element does not change a cohomology class.** -/
theorem classOf_translateCocycle (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z)
    (ρ : Representation ℂ G V) (c : cocycles Γ ρ) :
    classOf Γ ρ (translateCocycle Γ z hz ρ c) = classOf Γ ρ c := by
  have h := boundary_prism Γ z hz ρ c
  have e : translateCocycle Γ z hz ρ c = c + boundaryMap Γ ρ (prism Γ z hz ρ c) := by
    rw [h]; abel
  rw [e, map_add, classOf_boundaryMap, add_zero]

/-- **A class that extends over the central involution `z` is killed by `s - 1` when `ρ z = s`.** -/
theorem smul_sub_one_eq_zero (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1)
    (ρ : Representation ℂ G V) (s : ℂ) (hρ : ∀ v, ρ z v = s • v)
    (c' : cocycles (centralExtension Γ z hz hz2) ρ) :
    (s - 1) • classOf Γ ρ (resCocycle ρ (le_centralExtension Γ z hz hz2) c') = 0 := by
  have e : translateCocycle Γ z hz ρ (resCocycle ρ (le_centralExtension Γ z hz hz2) c') =
      s • resCocycle ρ (le_centralExtension Γ z hz hz2) c' := by
    apply Subtype.ext
    apply Subtype.ext
    funext x
    change c'.val.val (fun i => z * x i) = s • c'.val.val x
    rw [c'.val.property ⟨z, z_mem_centralExtension Γ z hz hz2⟩ x, hρ]
  have h := classOf_translateCocycle Γ z hz ρ (resCocycle ρ (le_centralExtension Γ z hz hz2) c')
  rw [e, map_smul] at h
  rw [sub_smul, one_smul, h, sub_self]

/-- The averaged cochain `½ (c(x) + c(z x))`. -/
def avgCocycle (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1)
    (ρ : Representation ℂ G V) (hρ : ∀ v, ρ z v = v) (c : cocycles Γ ρ) :
    cocycles (centralExtension Γ z hz hz2) ρ :=
  ⟨⟨fun x => (1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i)), by
    have base : ∀ (γ : Γ) (x : Fin 3 → G), (1 / 2 : ℂ) • (c.val.val (fun i => γ.val * x i) +
        c.val.val (fun i => z * (γ.val * x i))) =
        ρ γ.val ((1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i))) := by
      intro γ x
      have e : (fun i => z * (γ.val * x i)) = fun i => γ.val * (z * x i) := by
        funext i; rw [← mul_assoc, hz γ.val, mul_assoc]
      rw [e, c.val.property γ x, c.val.property γ (fun i => z * x i), map_smul, map_add]
    have flip : ∀ x : Fin 3 → G, (1 / 2 : ℂ) • (c.val.val (fun i => z * x i) +
        c.val.val (fun i => z * (z * x i))) = (1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i)) := by
      intro x
      have e : (fun i => z * (z * x i)) = x := by
        funext i; rw [← mul_assoc, hz2, one_mul]
      rw [e, add_comm]
    rintro ⟨g, hg | ⟨γ, hγ, rfl⟩⟩ x
    · exact base ⟨g, hg⟩ x
    · have e : (fun i => γ * z * x i) = fun i => γ * (z * x i) := by
        funext i; rw [mul_assoc]
      change (1 / 2 : ℂ) • (c.val.val (fun i => γ * z * x i) + c.val.val (fun i => z * (γ * z * x i))) =
        ρ (γ * z) ((1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i)))
      rw [map_mul, Module.End.mul_apply]
      have hzz : ρ z ((1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i))) =
          (1 / 2 : ℂ) • (c.val.val x + c.val.val (fun i => z * x i)) := hρ _
      rw [hzz, ← base ⟨γ, hγ⟩ x]
      have e2 : (fun i => z * (γ * z * x i)) = fun i => γ * x i := by
        funext i; rw [mul_assoc, ← mul_assoc z γ, hz γ, mul_assoc γ z, ← mul_assoc z z, hz2, one_mul]
      rw [e, e2]
      have e3 : (fun i => z * ((⟨γ, hγ⟩ : Γ).val * x i)) = fun i => γ * (z * x i) := by
        funext i
        show z * (γ * x i) = γ * (z * x i)
        rw [← mul_assoc, hz γ, mul_assoc]
      show (1 / 2 : ℂ) • (c.val.val (fun i => γ * (z * x i)) + c.val.val (fun i => γ * x i)) =
        (1 / 2 : ℂ) • (c.val.val (fun i => γ * x i) + c.val.val (fun i => z * (γ * x i)))
      rw [add_comm, ← e3]⟩, by
    funext x
    have h1 : c.val.val ![x 1, x 2, x 3] - c.val.val ![x 0, x 2, x 3] + c.val.val ![x 0, x 1, x 3] -
        c.val.val ![x 0, x 1, x 2] = 0 := congrFun c.property x
    have h2 : c.val.val ![z * x 1, z * x 2, z * x 3] - c.val.val ![z * x 0, z * x 2, z * x 3] +
        c.val.val ![z * x 0, z * x 1, z * x 3] - c.val.val ![z * x 0, z * x 1, z * x 2] = 0 :=
      congrFun c.property (fun i => z * x i)
    change (1 / 2 : ℂ) • (c.val.val ![x 1, x 2, x 3] + c.val.val (fun i => z * (![x 1, x 2, x 3] : Fin 3 → G) i)) -
        (1 / 2 : ℂ) • (c.val.val ![x 0, x 2, x 3] + c.val.val (fun i => z * (![x 0, x 2, x 3] : Fin 3 → G) i)) +
        (1 / 2 : ℂ) • (c.val.val ![x 0, x 1, x 3] + c.val.val (fun i => z * (![x 0, x 1, x 3] : Fin 3 → G) i)) -
        (1 / 2 : ℂ) • (c.val.val ![x 0, x 1, x 2] + c.val.val (fun i => z * (![x 0, x 1, x 2] : Fin 3 → G) i)) = 0
    simp only [translate_vec3]
    linear_combination (norm := module) (1 / 2 : ℂ) • h1 + (1 / 2 : ℂ) • h2⟩

/-- **If `ρ z = 1`, every class of `H²(Γ, ρ)` extends over `Γ ∪ Γ z`.** -/
theorem exists_extension_of_one (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1)
    (ρ : Representation ℂ G V) (hρ : ∀ v, ρ z v = v) (c : cocycles Γ ρ) :
    ∃ c' : cocycles (centralExtension Γ z hz hz2) ρ,
      classOf Γ ρ (resCocycle ρ (le_centralExtension Γ z hz hz2) c') = classOf Γ ρ c := by
  refine ⟨avgCocycle Γ z hz hz2 ρ hρ c, ?_⟩
  have e : resCocycle ρ (le_centralExtension Γ z hz hz2) (avgCocycle Γ z hz hz2 ρ hρ c) =
      (1 / 2 : ℂ) • (c + translateCocycle Γ z hz ρ c) := by
    apply Subtype.ext
    apply Subtype.ext
    funext x
    rfl
  rw [e, map_smul, map_add, classOf_translateCocycle, ← two_smul ℂ (classOf Γ ρ c), smul_smul]
  norm_num

/-- A `Γ`-cocycle that is `z`-equivariant is a cocycle of the extended level. -/
def extendCocycle (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1)
    (ρ : Representation ℂ G V) (c : cocycles Γ ρ)
    (h : ∀ x, c.val.val (fun i => z * x i) = ρ z (c.val.val x)) :
    cocycles (centralExtension Γ z hz hz2) ρ :=
  ⟨⟨c.val.val, by
    rintro ⟨g, hg | ⟨γ, hγ, rfl⟩⟩ x
    · exact c.val.property ⟨g, hg⟩ x
    · have e : (fun i => γ * z * x i) = fun i => γ * (z * x i) := by
        funext i; rw [mul_assoc]
      change c.val.val (fun i => γ * z * x i) = ρ (γ * z) (c.val.val x)
      rw [e, c.val.property ⟨γ, hγ⟩ (fun i => z * x i), h, map_mul, Module.End.mul_apply]⟩, c.property⟩

theorem resCocycle_extendCocycle (Γ : Subgroup G) (z : G) (hz : ∀ g, z * g = g * z) (hz2 : z * z = 1)
    (ρ : Representation ℂ G V) (c : cocycles Γ ρ)
    (h : ∀ x, c.val.val (fun i => z * x i) = ρ z (c.val.val x)) :
    resCocycle ρ (le_centralExtension Γ z hz hz2) (extendCocycle Γ z hz hz2 ρ c h) = c := rfl

end Generic

end TernaryPeriodPolynomials.Argument.ConvergentEisenstein.FiniteEntries
