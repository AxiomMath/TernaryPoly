module

public import TernaryPeriodPolynomials.ArithmeticCohomology.EisensteinGraph.StandardConstruction.LinearFamilies
public import TernaryPeriodPolynomials.ArithmeticCohomology.EisensteinGraph.StandardConstruction.RealTranslations
public import TernaryPeriodPolynomials.ArithmeticCohomology.EisensteinGraph.StandardConstruction.Smooth.NormPower
public import TernaryPeriodPolynomials.ArithmeticCohomology.EisensteinGraph.StandardConstruction.Smooth.Translations

@[expose] public section


/-!
# Scalar multipliers of plane sections, and the height multiplier `ρ_h^z`

Step 7 of the edge-convergence plan compares the flat families of `f` and of its right translate
`R(h) f` through the multiplier `ρ_h(y)^z`, `ρ_h(y) = Ξ(y h) / Ξ(y)`, where `Ξ` is the plane height
`Ξ(y) = |det y|^{1/3} ‖e₃ y‖⁻¹`. Everything used about `Ξ` is recorded in `HeightLaw`
(an abstract `log Ξ`); the existence of a function satisfying it is a separate (elementary)
obligation, which is NOT part of this file.

* `PlaneMultiplier m` : `m` is invariant on the left under the whole plane parabolic generated by the
  radical and the Levi `planeLevi A t`, invariant on the right under the finite level, and smooth
  under real right translation. Then `m • f` is a plane-induced section whenever `f` is
  (`isInduced_mul_of_multiplier`).
* `HeightLaw logXi` : the transformation law of `log Ξ` (explicit Levi weights, right invariance
  under the maximal compact, normalization at `1`, real smoothness).
* `heightMultiplier logXi h z y = exp (z (log Ξ (y h) - log Ξ y))` is a `PlaneMultiplier`
  (left `P`-invariance, finite-level invariance, analyticity in `z`, smoothness).
-/

open GeneralEisenstein GeneralEisenstein.Adelic GeneralEisenstein.Homogeneous Matrix
open TernaryPeriodPolynomials.EisensteinGraph.StandardConstruction
open scoped Matrix.Norms.Elementwise

noncomputable section

namespace TernaryPeriodPolynomials.EdgeConvergence.SectionMultipliers

/-- A scalar function by which plane-induced sections may be multiplied. -/
structure PlaneMultiplier (m : AdelicGL → ℂ) : Prop where
  radical : ∀ first second g, m (planeUnipotent first second * g) = m g
  levi : ∀ (binary : BinaryAdelicGL) (unit : Adelesˣ) g, m (planeLevi binary unit * g) = m g
  finite : ∀ (level : finiteLevel) g, m (g * atFinite level.val) = m g
  smooth : ∀ g, Smooth (fun x : Fin 1 → RealGL3 => m (g * atInfinity (x 0)))

/-- Multiplying a plane-induced section by a `PlaneMultiplier` gives a plane-induced section. -/
theorem isInduced_mul_of_multiplier {degree : ℕ} (data : InducingData degree) (parameter : ℂ)
    (m f : AdelicGL → ℂ) (multiplier : PlaneMultiplier m)
    (induced : IsInduced data .plane parameter f) :
    IsInduced data .plane parameter (fun g => m g * f g) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro g
    exact (multiplier.smooth g).mul (induced.1 g)
  · intro level g
    change m (g * atFinite level.val) * f (g * atFinite level.val) = m g * f g
    rw [multiplier.finite level g, induced.2.1 level g]
  · intro a
    obtain ⟨vectors, vectorsSmooth, realizes⟩ := induced.2.2.1 a
    refine ⟨fun x => m (a * atInfinity (x (Fin.last 0))) • vectors x, ?_, ?_⟩
    · have scalarSmooth : Smooth (fun x : Fin (0 + 1) → RealGL3 =>
          m (a * atInfinity (x (Fin.last 0)))) := multiplier.smooth a
      show Smooth (fun x : Fin (0 + 1) → RealGL3 =>
        m (a * atInfinity (x (Fin.last 0))) • (vectors x).val)
      exact ContDiffOn.smul scalarSmooth vectorsSmooth
    · intro x binary
      have levi : m (binaryLevi .plane binary * (a * atInfinity (x (Fin.last 0)))) =
          m (a * atInfinity (x (Fin.last 0))) := multiplier.levi binary 1 _
      change data.cusp.realize (m (a * atInfinity (x (Fin.last 0))) • vectors x) binary =
        normPower (GeneralLinearGroup.det binary) (-binaryInductionExponent degree .plane parameter) *
          (m (binaryLevi .plane binary * (a * atInfinity (x (Fin.last 0)))) *
            f (binaryLevi .plane binary * (a * atInfinity (x (Fin.last 0)))))
      rw [map_smul, Pi.smul_apply, smul_eq_mul, realizes x binary, levi]
      ring
  · refine ⟨?_, ?_, ?_⟩
    · intro first second g
      change m (planeUnipotent first second * g) * f (planeUnipotent first second * g) = m g * f g
      rw [multiplier.radical, induced.2.2.2.1 first second g]
    · intro unit g
      change m (planeLevi 1 unit * g) * f (planeLevi 1 unit * g) = _ * (m g * f g)
      rw [multiplier.levi, induced.2.2.2.2.1 unit g]
      ring
    · intro g
      have membership := (cuspFunctions data.cusp).smul_mem (m g) (induced.2.2.2.2.2 g)
      convert membership using 1
      funext binary
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [multiplier.levi binary 1 g]
      ring

/-- Smoothness of `exp (z · u)` for a real smooth `u`. -/
theorem smooth_cexp_mul {arity : ℕ} (z : ℂ) (u : (Fin arity → RealGL3) → ℝ) (smooth : Smooth u) :
    Smooth (fun x => Complex.exp (z * (u x : ℂ))) := by
  have ofReal : ContDiffOn ℝ ⊤ (fun matrices : Fin arity → Matrix (Fin 3) (Fin 3) ℝ =>
      ((u (fun i => invertibleMatrix (matrices i)) : ℝ) : ℂ))
      {matrices | ∀ i, (matrices i).det ≠ 0} :=
    Complex.ofRealCLM.contDiff.comp_contDiffOn smooth
  exact (contDiffOn_const.mul ofReal).cexp

/-- The transformation law of `log Ξ`, where `Ξ(y) = |det y|^{1/3} ‖e₃ y‖⁻¹` is the plane height. -/
structure HeightLaw (logXi : AdelicGL → ℝ) : Prop where
  radical : ∀ first second y, logXi (planeUnipotent first second * y) = logXi y
  levi : ∀ (binary : BinaryAdelicGL) (unit : Adelesˣ) y,
    logXi (planeLevi binary unit * y) = logXi y +
      (1 / 3) * Real.log (adeleNorm (GeneralLinearGroup.det binary) : ℝ) -
        (2 / 3) * Real.log (adeleNorm unit : ℝ)
  rightCompact : ∀ y k, inMaximalCompact k → logXi (y * k) = logXi y
  one : logXi 1 = 0
  smooth : ∀ g, Smooth (fun x : Fin 1 → RealGL3 => logXi (g * atInfinity (x 0)))

/-- The multiplier `ρ_h(y)^z = (Ξ(y h) / Ξ(y))^z`. -/
def heightMultiplier (logXi : AdelicGL → ℝ) (real : RealGL3) (z : ℂ) (y : AdelicGL) : ℂ :=
  Complex.exp (z * ((logXi (y * atInfinity real) - logXi y : ℝ) : ℂ))

theorem heightMultiplier_zero (logXi : AdelicGL → ℝ) (real : RealGL3) (y : AdelicGL) :
    heightMultiplier logXi real 0 y = 1 := by
  simp [heightMultiplier]

theorem heightMultiplier_ne_zero (logXi : AdelicGL → ℝ) (real : RealGL3) (z : ℂ) (y : AdelicGL) :
    heightMultiplier logXi real z y ≠ 0 := Complex.exp_ne_zero _

theorem heightMultiplier_add (logXi : AdelicGL → ℝ) (real : RealGL3) (first second : ℂ)
    (y : AdelicGL) :
    heightMultiplier logXi real (first + second) y =
      heightMultiplier logXi real first y * heightMultiplier logXi real second y := by
  simp only [heightMultiplier, add_mul, Complex.exp_add]

/-- Analyticity in the exponent `z` (jointly with any analytic reparametrization). -/
theorem heightMultiplier_analytic (logXi : AdelicGL → ℝ) (real : RealGL3) (y : AdelicGL)
    (point : ℂ) : AnalyticAt ℂ (fun z => heightMultiplier logXi real z y) point :=
  (analyticAt_id.mul analyticAt_const).cexp

theorem heightMultiplier_analyticAt_prod (logXi : AdelicGL → ℝ) (real : RealGL3) (y : AdelicGL)
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E] (exponent : E → ℂ) (point : E)
    (analytic : AnalyticAt ℂ exponent point) :
    AnalyticAt ℂ (fun p => heightMultiplier logXi real (exponent p) y) point :=
  (analytic.mul analyticAt_const).cexp

/-- The Levi weights cancel in the difference defining the multiplier. -/
theorem sub_cancel_weights (first second weight correction : ℝ) :
    (first + weight - correction) - (second + weight - correction) = first - second := by
  ring

namespace HeightLaw

variable {logXi : AdelicGL → ℝ}

/-- Left invariance of the multiplier under the radical. -/
theorem heightMultiplier_radical (law : HeightLaw logXi) (real : RealGL3) (z : ℂ)
    (first second : Adeles) (y : AdelicGL) :
    heightMultiplier logXi real z (planeUnipotent first second * y) =
      heightMultiplier logXi real z y := by
  unfold heightMultiplier
  rw [mul_assoc, law.radical, law.radical]

/-- Left invariance of the multiplier under the Levi factor: the Levi weights cancel. -/
theorem heightMultiplier_levi (law : HeightLaw logXi) (real : RealGL3) (z : ℂ)
    (binary : BinaryAdelicGL) (unit : Adelesˣ) (y : AdelicGL) :
    heightMultiplier logXi real z (planeLevi binary unit * y) =
      heightMultiplier logXi real z y := by
  unfold heightMultiplier
  rw [mul_assoc, law.levi, law.levi, sub_cancel_weights]

/-- Invariance of the multiplier under right translation by the finite level. -/
theorem heightMultiplier_finite (law : HeightLaw logXi) (real : RealGL3) (z : ℂ)
    (level : finiteLevel) (y : AdelicGL) :
    heightMultiplier logXi real z (y * atFinite level.val) =
      heightMultiplier logXi real z y := by
  have compact := SmoothNormPower.finiteLevel_compact level
  unfold heightMultiplier
  have commute : y * atFinite level.val * atInfinity real =
      (y * atInfinity real) * atFinite level.val := by
    rw [mul_assoc, RealTranslations.atFinite_atInfinity_commute, ← mul_assoc]
  rw [commute, law.rightCompact _ _ compact, law.rightCompact _ _ compact]

/-- The height multiplier is smooth under real right translation. -/
theorem heightMultiplier_smooth (law : HeightLaw logXi) (real : RealGL3) (z : ℂ) (g : AdelicGL) :
    Smooth (fun x : Fin 1 → RealGL3 => heightMultiplier logXi real z (g * atInfinity (x 0))) := by
  have shifted : Smooth (fun x : Fin 1 → RealGL3 => logXi (g * atInfinity (x 0 * real))) :=
    SmoothTranslations.smooth_mul_right
      (fun x : Fin 1 → RealGL3 => logXi (g * atInfinity (x 0))) (law.smooth g) (fun _ => real)
  have difference : Smooth (fun x : Fin 1 → RealGL3 =>
      logXi (g * atInfinity (x 0 * real)) - logXi (g * atInfinity (x 0))) :=
    shifted.sub (law.smooth g)
  have equal : (fun x : Fin 1 → RealGL3 => heightMultiplier logXi real z (g * atInfinity (x 0))) =
      (fun x : Fin 1 → RealGL3 => Complex.exp (z *
        ((logXi (g * atInfinity (x 0 * real)) - logXi (g * atInfinity (x 0)) : ℝ) : ℂ))) := by
    funext x
    simp only [heightMultiplier, RealTranslations.atInfinity_mul, mul_assoc]
  rw [equal]
  exact smooth_cexp_mul z _ difference

/-- The height multiplier is a plane multiplier: left invariant under the whole plane parabolic
(the Levi weights of `Ξ(p y h)` and `Ξ(p y)` coincide), finite-level invariant, real smooth. -/
theorem planeMultiplier (law : HeightLaw logXi) (real : RealGL3) (z : ℂ) :
    PlaneMultiplier (heightMultiplier logXi real z) where
  radical first second g := law.heightMultiplier_radical real z first second g
  levi binary unit g := law.heightMultiplier_levi real z binary unit g
  finite level g := law.heightMultiplier_finite real z level g
  smooth g := law.heightMultiplier_smooth real z g

end HeightLaw

/-- The twist `y ↦ ρ_h(y)^z f(y h)` of a section by the height multiplier and right translation. -/
def twist (logXi : AdelicGL → ℝ) (real : RealGL3) (z : ℂ) (f : AdelicGL → ℂ) : AdelicGL → ℂ :=
  fun y => heightMultiplier logXi real z y * f (y * atInfinity real)

theorem twist_zero (logXi : AdelicGL → ℝ) (real : RealGL3) (f : AdelicGL → ℂ) :
    twist logXi real 0 f = fun y => f (y * atInfinity real) := by
  funext y
  simp [twist, heightMultiplier_zero]

/-- The twisted section is plane-induced at the same parameter, for every `z`. -/
theorem isInduced_twist {degree : ℕ} (data : InducingData degree) (parameter : ℂ)
    {logXi : AdelicGL → ℝ} (law : HeightLaw logXi) (real : RealGL3) (z : ℂ)
    (f : AdelicGL → ℂ) (induced : IsInduced data .plane parameter f) :
    IsInduced data .plane parameter (twist logXi real z f) :=
  isInduced_mul_of_multiplier data parameter (heightMultiplier logXi real z)
    (fun argument => f (argument * atInfinity real)) (law.planeMultiplier real z)
    (RealTranslations.induced_right_real data .plane parameter f induced real)

end TernaryPeriodPolynomials.EdgeConvergence.SectionMultipliers
