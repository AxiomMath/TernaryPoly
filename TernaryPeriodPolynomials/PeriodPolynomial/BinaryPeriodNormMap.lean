module

public import TernaryPeriodPolynomials.PeriodPolynomial.FiniteInvariant.Operators
public import TernaryPeriodPolynomials.ArithmeticCohomology.OrdinaryCycle.Residue.PeriodSpace

@[expose] public section


open MvPolynomial
noncomputable section
namespace TernaryPoly.BinaryFiniteInvariant

/-- Symmetric polynomials odd under the first coordinate sign. -/
def oddSymmetric (d : ℕ) : Submodule ℚ (H d) where
  carrier := {q | swap d q = q ∧ negateFirst d q = -q}
  zero_mem' := by simp
  add_mem' := by rintro q r ⟨hs,hd⟩ ⟨ht,he⟩; simp [map_add,hs,hd,ht,he,add_comm]
  smul_mem' := by rintro a q ⟨hs,hd⟩; simp [map_smul,hs,hd,smul_neg]

/-- Invariants of the literal order-six group generated by swap and rotation. -/
def invariants (d : ℕ) : Submodule ℚ (H d) where
  carrier := {q | swap d q = q ∧ rotation d q = q}
  zero_mem' := by simp
  add_mem' := by rintro q r ⟨hs,hd⟩ ⟨ht,he⟩; simp [map_add,hs,hd,ht,he]
  smul_mem' := by rintro a q ⟨hs,hd⟩; simp [map_smul,hs,hd]

/-- The actual cyclic norm operator. -/
def norm (d : ℕ) : Module.End ℚ (H d) := 1 + rotation d + rotation d * rotation d

@[simp] theorem norm_apply (d : ℕ) (q : H d) :
    norm d q = q + rotation d q + rotation d (rotation d q) := rfl

theorem rotation_norm (d : ℕ) : rotation d * norm d = norm d := by
  simp only [norm,mul_add,mul_one,←mul_assoc,rotation_cube]
  abel

theorem swap_rotation (d : ℕ) : swap d * rotation d = (rotation d * rotation d) * swap d := by
  have h := congrArg (fun f : Module.End ℚ (H d) => f * swap d) (swap_rotation_swap d)
  simpa only [mul_assoc,swap_sq,mul_one] using h

theorem swap_rotation_sq (d : ℕ) : swap d * (rotation d * rotation d) = rotation d * swap d := by
  change operator d swapMatrix * (operator d rotationMatrix * operator d rotationMatrix) =
    operator d rotationMatrix * operator d swapMatrix
  rw [←operator_mul,←operator_mul,←operator_mul]
  congr 1
  decide +kernel

theorem swap_norm (d : ℕ) : swap d * norm d = norm d * swap d := by
  simp only [norm,mul_add,add_mul,mul_one,one_mul,swap_rotation,swap_rotation_sq]
  abel

/-- The cyclic norm of a symmetric polynomial is fixed by both literal finite-group generators. -/
theorem norm_mem_invariants (d : ℕ) (q : H d) (hq : swap d q = q) : norm d q ∈ invariants d := by
  constructor
  · change (swap d * norm d) q = norm d q
    rw [swap_norm,Module.End.mul_apply,hq]
  · change (rotation d * norm d) q = norm d q
    rw [rotation_norm]

/-- No surjectivity is assumed: this is the actual restricted cyclic norm. -/
def normMap (d : ℕ) : oddSymmetric d →ₗ[ℚ] invariants d where
  toFun q := ⟨norm d q.val,norm_mem_invariants d q.val q.property.1⟩
  map_add' q r := by apply Subtype.ext; exact map_add _ _ _
  map_smul' a q := by apply Subtype.ext; exact map_smul _ _ _

@[simp] theorem normMap_val (d : ℕ) (q : oddSymmetric d) : (normMap d q).val = norm d q.val := rfl

end TernaryPoly.BinaryFiniteInvariant
