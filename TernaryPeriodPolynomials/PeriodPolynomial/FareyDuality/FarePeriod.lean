module

public import TernaryPeriodPolynomials.PeriodPolynomial.FareyDuality.FareyEdge
public import TernaryPeriodPolynomials.ArithmeticCohomology.OrdinaryCycle.Residue.PeriodSpace
public import TernaryPeriodPolynomials.ModularForm.ModularSymbol.Coefficients

@[expose] public section


/-!
# The standard-edge coefficients are the polynomial period space

Formalized by Claude Sonnet 5.5.

`edge2 M` (see `FareyEdge`) identifies `H₁(GL₂(ℤ), M)` with the `Stab(p₀)`-invariant, `sOne`-odd vectors of `M` annihilated
by the norm over `Stab(triPlus)`.  This file computes the two stabilizers explicitly.

* `Stab(p₀) = {1, -1, w, -w}` with `w = [[0,1],[1,0]]` (`stab_p0_entries`, `stab_p0_of_entries`).
* `Stab(triPlus)` consists of the twelve signed permutations of the triangle (`stab_entries`, `smul_triPlus_of_entries`); it is
  generated by `-1`, `w` and the rotation `rho` of order three.  For a vector fixed by `w` and `-1`, the norm over it vanishes
  iff `b + ρ b + ρ² b = 0` (`cycle_iff`).
* `isEdgeCoeff_iff`: `IsEdgeCoeff M b ↔ w b = b ∧ (-1) b = b ∧ sOne b = -b ∧ b + ρ b + ρ² b = 0`.

For the coefficient module `Dplain d` (binary forms of degree `d`, trivial determinant twist, `integralAction d 0`) the
conditions are exactly the four literal period equations of `periodSpace d`: swap, separately odd in each variable, and
`q - q(x-y, y) + q(x, x-y) = 0` (`isEdgeCoeff_Dplain_iff`).  Hence `periodEquivHomology d : H₁(GL₂(ℤ), Sym^d) ≃ₗ[ℚ]
periodSpace d` (`range_edge2_Dplain`).  The determinant twist belongs to the later identification with the model; here
the coefficients are the untwisted ones on which the period equations are literally stated.
-/

noncomputable section

namespace TernaryPeriodPolynomials.Argument.FareyTree

open TernaryPoly TernaryPoly.RankTwoAugmentedFrames TernaryPoly.BinaryModularSymbolCoefficients
open MvPolynomial

/-- The vector `e₁ + e₂`. -/
def e12 : IntegralVector := ![1, 1]

/-- `-I`. -/
def mI : IntegralGL := colGL (-e1) (-e2) (by
  left; simp [det2, e1, e2])

/-- The swap matrix `[[0,1],[1,0]]`. -/
def wSwap : IntegralGL := colGL e2 e1 (by
  right; simp [det2, e1, e2])

/-- The rotation `[[0,-1],[1,-1]]` of the standard triangle. -/
def rho : IntegralGL := colGL e2 (-e12) (by
  left; simp [det2, e2, e12])

/-- The inverse rotation `[[-1,1],[-1,0]]`. -/
def rho2 : IntegralGL := colGL (-e12) e1 (by
  left; simp [det2, e1, e12])

theorem rho_mul_rho2 : rho * rho2 = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rho, rho2, Matrix.mul_apply, Fin.sum_univ_two, colGL_val_zero, colGL_val_one, e1, e2, e12]

theorem rho2_mul_rho : rho2 * rho = 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rho, rho2, Matrix.mul_apply, Fin.sum_univ_two, colGL_val_zero, colGL_val_one, e1, e2, e12]

/-- Polynomial substitution by an integral matrix. -/
def subsZ (h : IntegralGL) : Poly →ₐ[ℚ] Poly :=
  substitute (h.val.map (Int.castRingHom ℚ))

theorem integralAction_zero_coe (n : ℕ) (g h : IntegralGL) (hgh : g * h = 1)
    (f : HomogeneousPoly n) :
    ((integralAction n 0 g f : HomogeneousPoly n) : Poly) = subsZ h f := by
  rw [integralAction_coe, action_apply]
  have hinv : (Matrix.GeneralLinearGroup.map (Int.castRingHom ℚ) g)⁻¹ = Matrix.GeneralLinearGroup.map (Int.castRingHom ℚ) h := by
    apply inv_eq_of_mul_eq_one_right
    rw [← map_mul, hgh, map_one]
  rw [hinv]
  simp [determinantCharacter, subsZ]

theorem bind₁_comp_apply (σ f : Fin 2 → Poly) (q : Poly) :
    bind₁ σ (bind₁ f q) = bind₁ (fun i => bind₁ σ (f i)) q := by
  rw [← AlgHom.comp_apply, bind₁_comp_bind₁]

/-- Transport of a substitution relation by a further substitution. -/
theorem subs_transport (q : Poly) (f : Fin 2 → Poly) (ε : ℚ) (h : bind₁ f q = ε • q)
    (σ : Fin 2 → Poly) : bind₁ (fun i => bind₁ σ (f i)) q = ε • bind₁ σ q := by
  rw [← bind₁_comp_apply, h, map_smul]

theorem subs_transport' (q : Poly) (f : Fin 2 → Poly) (r : Poly) (h : bind₁ f q = r)
    (σ : Fin 2 → Poly) : bind₁ (fun i => bind₁ σ (f i)) q = bind₁ σ r := by
  rw [← bind₁_comp_apply, h]

/-- The three relations satisfied by a separately odd symmetric polynomial. -/
structure Sym3 (q : Poly) : Prop where
  swap : bind₁ (![X 1, X 0] : Fin 2 → Poly) q = q
  odd1 : bind₁ (![-X 0, X 1] : Fin 2 → Poly) q = -q
  odd2 : bind₁ (![X 0, -X 1] : Fin 2 → Poly) q = -q

theorem Sym3.even {q : Poly} (h : Sym3 q) : bind₁ (![-X 0, -X 1] : Fin 2 → Poly) q = q := by
  have := subs_transport' q (![-X 0, X 1] : Fin 2 → Poly) (-q) h.odd1 (![X 0, -X 1] : Fin 2 → Poly)
  have e : (fun i => bind₁ (![X 0, -X 1] : Fin 2 → Poly) ((![-X 0, X 1] : Fin 2 → Poly) i)) = (![-X 0, -X 1] : Fin 2 → Poly) := by
    funext i; fin_cases i <;> simp
  rw [e, map_neg, h.odd2, neg_neg] at this
  exact this

theorem Sym3.rot1 {q : Poly} (h : Sym3 q) :
    bind₁ (![-X 0 + X 1, -X 0] : Fin 2 → Poly) q = bind₁ (![X 0, X 0 - X 1] : Fin 2 → Poly) q := by
  have h1 := subs_transport' q (![-X 0, -X 1] : Fin 2 → Poly) q h.even (![X 0 - X 1, X 0] : Fin 2 → Poly)
  have e1 : (fun i => bind₁ (![X 0 - X 1, X 0] : Fin 2 → Poly) ((![-X 0, -X 1] : Fin 2 → Poly) i)) = (![-X 0 + X 1, -X 0] : Fin 2 → Poly) := by
    funext i; fin_cases i <;> simp; ring_nf
  have h2 := subs_transport' q (![X 1, X 0] : Fin 2 → Poly) q h.swap (![X 0, X 0 - X 1] : Fin 2 → Poly)
  have e2 : (fun i => bind₁ (![X 0, X 0 - X 1] : Fin 2 → Poly) ((![X 1, X 0] : Fin 2 → Poly) i)) = (![X 0 - X 1, X 0] : Fin 2 → Poly) := by
    funext i; fin_cases i <;> simp
  rw [e1] at h1
  rw [e2] at h2
  exact h1.trans h2

theorem Sym3.rot2 {q : Poly} (h : Sym3 q) :
    bind₁ (![-X 1, X 0 - X 1] : Fin 2 → Poly) q = -bind₁ (![X 0 - X 1, X 1] : Fin 2 → Poly) q := by
  have h1 := subs_transport' q (![-X 0, X 1] : Fin 2 → Poly) (-q) h.odd1 (![X 1, X 0 - X 1] : Fin 2 → Poly)
  have e1 : (fun i => bind₁ (![X 1, X 0 - X 1] : Fin 2 → Poly) ((![-X 0, X 1] : Fin 2 → Poly) i)) = (![-X 1, X 0 - X 1] : Fin 2 → Poly) := by
    funext i; fin_cases i <;> simp
  have h2 := subs_transport' q (![X 1, X 0] : Fin 2 → Poly) q h.swap (![X 0 - X 1, X 1] : Fin 2 → Poly)
  have e2 : (fun i => bind₁ (![X 0 - X 1, X 1] : Fin 2 → Poly) ((![X 1, X 0] : Fin 2 → Poly) i)) = (![X 1, X 0 - X 1] : Fin 2 → Poly) := by
    funext i; fin_cases i <;> simp
  rw [e1, map_neg] at h1
  rw [e2] at h2
  rw [h1, h2]


/-- Entries of an element of `GL₂(ℤ)` that stabilizes the standard triangle: the twelve signed permutations of
the triangle. -/
def EntPlus (a b c d : ℤ) : Prop :=
  (a = 1 ∧ b = 0 ∧ c = 0 ∧ d = 1) ∨ (a = -1 ∧ b = 0 ∧ c = 0 ∧ d = -1) ∨
  (a = 0 ∧ b = 1 ∧ c = 1 ∧ d = 0) ∨ (a = 0 ∧ b = -1 ∧ c = -1 ∧ d = 0) ∨
  (a = 0 ∧ b = -1 ∧ c = 1 ∧ d = -1) ∨ (a = 0 ∧ b = 1 ∧ c = -1 ∧ d = 1) ∨
  (a = -1 ∧ b = 1 ∧ c = -1 ∧ d = 0) ∨ (a = 1 ∧ b = -1 ∧ c = 1 ∧ d = 0) ∨
  (a = 1 ∧ b = -1 ∧ c = 0 ∧ d = -1) ∨ (a = -1 ∧ b = 1 ∧ c = 0 ∧ d = 1) ∨
  (a = -1 ∧ b = 0 ∧ c = -1 ∧ d = 1) ∨ (a = 1 ∧ b = 0 ∧ c = 1 ∧ d = -1)

theorem vec_eq_iff (c d : IntegralVector) : c = d ↔ c 0 = d 0 ∧ c 1 = d 1 := by
  constructor
  · rintro rfl; exact ⟨rfl, rfl⟩
  · rintro ⟨h0, h1⟩
    funext i; fin_cases i
    · exact h0
    · exact h1

theorem plus_eq : plusLine e12_unimod = augmentedLine 1 2 := by
  have h := col_sum_isGen (1 : IntegralGL)
  have e : (fun i => (1 : IntegralGL).val i 0 + (1 : IntegralGL).val i 1) = e1 + e2 := by
    funext i; fin_cases i <;> simp [e1, e2]
  rw [e] at h
  exact ((isGen_plusLine e12_unimod).line_eq_iff h).mpr (Or.inl rfl)

theorem smul_plus (g : IntegralGL) : g • plusLine e12_unimod = augmentedLine g 2 := by
  rw [plus_eq, smul_augmentedLine, mul_one]

theorem eq_or_neg_comm' {α : Type*} [AddCommGroup α] (a c : α) : (a = c ∨ a = -c) ↔ (c = a ∨ c = -a) := by
  constructor <;> rintro (h | h)
  · exact Or.inl h.symm
  · exact Or.inr (neg_eq_iff_eq_neg.mp h.symm)
  · exact Or.inl h.symm
  · exact Or.inr (neg_eq_iff_eq_neg.mpr h).symm

theorem mem_triPlus_gen {z : RationalLine2} {c : IntegralVector} (hz : IsGen z c) :
    z ∈ triPlus.1 ↔
      (c = e1 ∨ c = -e1 ∨ c = e2 ∨ c = -e2 ∨ c = (e1 + e2) ∨ c = -(e1 + e2)) := by
  simp only [triPlus, Finset.mem_insert, Finset.mem_singleton]
  have k1 : z = cusp1 ↔ (c = e1 ∨ c = -e1) := by
    rw [hz.line_eq_iff isGen_cusp1]; exact eq_or_neg_comm' _ _
  have k2 : z = cusp2 ↔ (c = e2 ∨ c = -e2) := by
    rw [hz.line_eq_iff isGen_cusp2]; exact eq_or_neg_comm' _ _
  have k3 : z = plusLine e12_unimod ↔ (c = (e1 + e2) ∨ c = -(e1 + e2)) := by
    rw [hz.line_eq_iff (isGen_plusLine e12_unimod)]; exact eq_or_neg_comm' _ _
  rw [k1, k2, k3]
  tauto

theorem inV_iff (c : IntegralVector) :
    (c = e1 ∨ c = -e1 ∨ c = e2 ∨ c = -e2 ∨ c = (e1 + e2) ∨ c = -(e1 + e2)) ↔
      ((c 0 = 1 ∧ c 1 = 0) ∨ (c 0 = -1 ∧ c 1 = 0) ∨ (c 0 = 0 ∧ c 1 = 1) ∨ (c 0 = 0 ∧ c 1 = -1) ∨
        (c 0 = 1 ∧ c 1 = 1) ∨ (c 0 = -1 ∧ c 1 = -1)) := by
  simp only [vec_eq_iff, e1, e2, Pi.neg_apply, Pi.add_apply]
  simp

theorem stab_entries (g : IntegralGL) (hg : g ∈ MulAction.stabilizer IntegralGL triPlus) :
    EntPlus (g.val 0 0) (g.val 0 1) (g.val 1 0) (g.val 1 1) := by
  have hg' : g • triPlus = triPlus := hg
  have key : ∀ x, x ∈ triPlus.1 → g • x ∈ triPlus.1 := by
    intro x hx
    have := smul_mem_tri_smul (g := g) hx
    rwa [hg'] at this
  have g0 : IsGen (g • cusp1) (fun i => g.val i 0) := by
    rw [smul_cusp1]; exact col_isGen g 0
  have g1 : IsGen (g • cusp2) (fun i => g.val i 1) := by
    rw [smul_cusp2]; exact col_isGen g 1
  have g2 : IsGen (g • plusLine e12_unimod) (fun i => g.val i 0 + g.val i 1) := by
    rw [smul_plus]; exact col_sum_isGen g
  have h0 := (mem_triPlus_gen g0).mp (key cusp1 (by simp [triPlus]))
  have h1 := (mem_triPlus_gen g1).mp (key cusp2 (by simp [triPlus]))
  have h2 := (mem_triPlus_gen g2).mp (key (plusLine e12_unimod) (by simp [triPlus]))
  rw [inV_iff] at h0 h1 h2
  unfold EntPlus
  rcases h0 with ⟨a1, a2⟩ | ⟨a1, a2⟩ | ⟨a1, a2⟩ | ⟨a1, a2⟩ | ⟨a1, a2⟩ | ⟨a1, a2⟩ <;>
  rcases h1 with ⟨b1, b2⟩ | ⟨b1, b2⟩ | ⟨b1, b2⟩ | ⟨b1, b2⟩ | ⟨b1, b2⟩ | ⟨b1, b2⟩ <;>
  simp [a1, a2, b1, b2] at h2 ⊢

theorem mem_triMinus_gen {z : RationalLine2} {c : IntegralVector} (hz : IsGen z c) :
    z ∈ triMinus.1 ↔
      (c = e1 ∨ c = -e1 ∨ c = e2 ∨ c = -e2 ∨ c = (e1 - e2) ∨ c = -(e1 - e2)) := by
  simp only [triMinus, Finset.mem_insert, Finset.mem_singleton]
  have k1 : z = cusp1 ↔ (c = e1 ∨ c = -e1) := by
    rw [hz.line_eq_iff isGen_cusp1]; exact eq_or_neg_comm' _ _
  have k2 : z = cusp2 ↔ (c = e2 ∨ c = -e2) := by
    rw [hz.line_eq_iff isGen_cusp2]; exact eq_or_neg_comm' _ _
  have k3 : z = minusLine e12_unimod ↔ (c = (e1 - e2) ∨ c = -(e1 - e2)) := by
    rw [hz.line_eq_iff (isGen_minusLine e12_unimod)]; exact eq_or_neg_comm' _ _
  rw [k1, k2, k3]
  tauto

theorem inVm_iff (c : IntegralVector) :
    (c = e1 ∨ c = -e1 ∨ c = e2 ∨ c = -e2 ∨ c = (e1 - e2) ∨ c = -(e1 - e2)) ↔
      ((c 0 = 1 ∧ c 1 = 0) ∨ (c 0 = -1 ∧ c 1 = 0) ∨ (c 0 = 0 ∧ c 1 = 1) ∨ (c 0 = 0 ∧ c 1 = -1) ∨
        (c 0 = 1 ∧ c 1 = -1) ∨ (c 0 = -1 ∧ c 1 = 1)) := by
  simp only [vec_eq_iff, e1, e2, Pi.neg_apply, Pi.sub_apply]
  simp

theorem smul_tri_eq_of_subset (g : IntegralGL) (t : Tri) (h : ∀ x ∈ t.1, g • x ∈ t.1) :
    g • t = t := by
  apply Subtype.ext
  rw [tri_smul_val]
  apply Finset.eq_of_subset_of_card_le
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
    exact h x hx
  · rw [Finset.card_image_of_injective _ (MulAction.injective g)]

theorem stab_p0_entries (g : IntegralGL) (hg : g ∈ MulAction.stabilizer IntegralGL p0) :
    (g.val 0 0 = 1 ∧ g.val 0 1 = 0 ∧ g.val 1 0 = 0 ∧ g.val 1 1 = 1) ∨
    (g.val 0 0 = -1 ∧ g.val 0 1 = 0 ∧ g.val 1 0 = 0 ∧ g.val 1 1 = -1) ∨
    (g.val 0 0 = 0 ∧ g.val 0 1 = 1 ∧ g.val 1 0 = 1 ∧ g.val 1 1 = 0) ∨
    (g.val 0 0 = 0 ∧ g.val 0 1 = -1 ∧ g.val 1 0 = -1 ∧ g.val 1 1 = 0) := by
  have hg0 : g • p0 = p0 := hg
  have hp : g • triPlus = triPlus := congrArg (fun q : OTE => q.1.1) hg0
  have hm : g • triMinus = triMinus := congrArg (fun q : OTE => q.1.2) hg0
  have hent := stab_entries g hp
  have key : ∀ x, x ∈ triMinus.1 → g • x ∈ triMinus.1 := by
    intro x hx
    have := smul_mem_tri_smul (g := g) hx
    rwa [hm] at this
  have g0 : IsGen (g • cusp1) (fun i => g.val i 0) := by
    rw [smul_cusp1]; exact col_isGen g 0
  have g1 : IsGen (g • cusp2) (fun i => g.val i 1) := by
    rw [smul_cusp2]; exact col_isGen g 1
  have h0 := (mem_triMinus_gen g0).mp (key cusp1 (by simp [triMinus]))
  have h1 := (mem_triMinus_gen g1).mp (key cusp2 (by simp [triMinus]))
  rw [inVm_iff] at h0 h1
  unfold EntPlus at hent
  rcases hent with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ |
    ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;>
  simp [a, b, c, d] at h0 h1 ⊢

theorem minus_eq : minusLine e12_unimod = augmentedLine sOne 2 := by
  have h := col_sum_isGen sOne
  have e : (fun i => sOne.val i 0 + sOne.val i 1) = e1 - e2 := by
    funext i; fin_cases i <;> simp [sOne, colGL_val_zero, colGL_val_one, e1, e2]
  rw [e] at h
  exact ((isGen_minusLine e12_unimod).line_eq_iff h).mpr (Or.inl rfl)

theorem smul_minus_gen (g : IntegralGL) :
    IsGen (g • minusLine e12_unimod) (fun i => g.val i 0 - g.val i 1) := by
  rw [minus_eq, smul_augmentedLine]
  have h := col_sum_isGen (g * sOne)
  have e : (fun i => (g * sOne).val i 0 + (g * sOne).val i 1) = fun i => g.val i 0 - g.val i 1 := by
    funext i; fin_cases i <;>
      simp [sOne, Matrix.mul_apply, Fin.sum_univ_two, colGL_val_zero, colGL_val_one, e1, e2, sub_eq_add_neg]
  rw [e] at h
  exact h

theorem stab_p0_of_entries (g : IntegralGL)
    (h : (g.val 0 0 = 1 ∧ g.val 0 1 = 0 ∧ g.val 1 0 = 0 ∧ g.val 1 1 = 1) ∨
    (g.val 0 0 = -1 ∧ g.val 0 1 = 0 ∧ g.val 1 0 = 0 ∧ g.val 1 1 = -1) ∨
    (g.val 0 0 = 0 ∧ g.val 0 1 = 1 ∧ g.val 1 0 = 1 ∧ g.val 1 1 = 0) ∨
    (g.val 0 0 = 0 ∧ g.val 0 1 = -1 ∧ g.val 1 0 = -1 ∧ g.val 1 1 = 0)) :
    g ∈ MulAction.stabilizer IntegralGL p0 := by
  have g0 : IsGen (g • cusp1) (fun i => g.val i 0) := by
    rw [smul_cusp1]; exact col_isGen g 0
  have g1 : IsGen (g • cusp2) (fun i => g.val i 1) := by
    rw [smul_cusp2]; exact col_isGen g 1
  have g2 : IsGen (g • plusLine e12_unimod) (fun i => g.val i 0 + g.val i 1) := by
    rw [smul_plus]; exact col_sum_isGen g
  have g3 := smul_minus_gen g
  have hp : g • triPlus = triPlus := by
    apply smul_tri_eq_of_subset
    intro x hx
    simp only [triPlus, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · rw [mem_triPlus_gen g0, inV_iff]
      clear g0 g1 g2 g3
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
    · rw [mem_triPlus_gen g1, inV_iff]
      clear g0 g1 g2 g3
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
    · rw [mem_triPlus_gen g2, inV_iff]
      clear g0 g1 g2 g3
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
  have hm : g • triMinus = triMinus := by
    apply smul_tri_eq_of_subset
    intro x hx
    simp only [triMinus, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · rw [mem_triMinus_gen g0, inVm_iff]
      clear g0 g1 g2 g3 hp
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
    · rw [mem_triMinus_gen g1, inVm_iff]
      clear g0 g1 g2 g3 hp
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
    · rw [mem_triMinus_gen g3, inVm_iff]
      clear g0 g1 g2 g3 hp
      rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
  show g • p0 = p0
  exact Subtype.ext (Prod.ext hp hm)

/-! ### The triangle stabilizer and the period relations -/

theorem eq_of_entries {g h : IntegralGL} (h00 : g.val 0 0 = h.val 0 0) (h01 : g.val 0 1 = h.val 0 1)
    (h10 : g.val 1 0 = h.val 1 0) (h11 : g.val 1 1 = h.val 1 1) : g = h := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j
  · exact h00
  · exact h01
  · exact h10
  · exact h11

local macro "wsimp" : tactic =>
  `(tactic| simp [rho, rho2, wSwap, mI, sOne, Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two, colGL_val_zero,
    colGL_val_one, e1, e2, e12])

theorem mI_comm (g : IntegralGL) : mI * g = g * mI := by
  apply eq_of_entries <;> wsimp

theorem w_rho : wSwap * rho = rho2 * wSwap := by
  apply eq_of_entries <;> wsimp

theorem w_rho2 : wSwap * rho2 = rho * wSwap := by
  apply eq_of_entries <;> wsimp

theorem rho_rho : rho * rho = rho2 := by
  apply eq_of_entries <;> wsimp

theorem w_w : wSwap * wSwap = 1 := by
  apply eq_of_entries <;> wsimp

theorem mI_mI : mI * mI = 1 := by
  apply eq_of_entries <;> wsimp

theorem rho_inv : rho⁻¹ = rho2 := inv_eq_of_mul_eq_one_right rho_mul_rho2

theorem rho2_inv : rho2⁻¹ = rho := inv_eq_of_mul_eq_one_right rho2_mul_rho

/-- Entries of `g • triPlus = triPlus`: the converse of `stab_entries`. -/
theorem smul_triPlus_of_entries (g : IntegralGL)
    (h : EntPlus (g.val 0 0) (g.val 0 1) (g.val 1 0) (g.val 1 1)) : g • triPlus = triPlus := by
  have g0 : IsGen (g • cusp1) (fun i => g.val i 0) := by
    rw [smul_cusp1]; exact col_isGen g 0
  have g1 : IsGen (g • cusp2) (fun i => g.val i 1) := by
    rw [smul_cusp2]; exact col_isGen g 1
  have g2 : IsGen (g • plusLine e12_unimod) (fun i => g.val i 0 + g.val i 1) := by
    rw [smul_plus]; exact col_sum_isGen g
  apply smul_tri_eq_of_subset
  intro x hx
  simp only [triPlus, Finset.mem_insert, Finset.mem_singleton] at hx
  unfold EntPlus at h
  rcases hx with rfl | rfl | rfl
  · rw [mem_triPlus_gen g0, inV_iff]
    clear g0 g1 g2
    rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ |
      ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
  · rw [mem_triPlus_gen g1, inV_iff]
    clear g0 g1 g2
    rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ |
      ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all
  · rw [mem_triPlus_gen g2, inV_iff]
    clear g0 g1 g2
    rcases h with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ |
      ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩ <;> simp_all

theorem rho_mem : rho ∈ MulAction.stabilizer IntegralGL triPlus := by
  apply smul_triPlus_of_entries
  unfold EntPlus
  simp [rho, colGL_val_zero, colGL_val_one, e2, e12]

theorem rho2_mem : rho2 ∈ MulAction.stabilizer IntegralGL triPlus := by
  apply smul_triPlus_of_entries
  unfold EntPlus
  simp [rho2, colGL_val_zero, colGL_val_one, e1, e12]

theorem w_mem : wSwap ∈ MulAction.stabilizer IntegralGL p0 := by
  apply stab_p0_of_entries
  simp [wSwap, colGL_val_zero, colGL_val_one, e1, e2]

theorem mI_mem : mI ∈ MulAction.stabilizer IntegralGL p0 := by
  apply stab_p0_of_entries
  simp [mI, colGL_val_zero, colGL_val_one, e1, e2]

section Abstract

open TernaryPeriodPolynomials.Argument.BinaryDuality

variable (M : Rep ℚ IntegralGL)

theorem rho_comp (g h : IntegralGL) (m : M) : M.ρ g (M.ρ h m) = M.ρ (g * h) m := by
  rw [map_mul, Module.End.mul_apply]

/-- The vector `b + ρ b + ρ² b` formed from a vector. -/
def tri3 (b : M) : M := b + M.ρ rho b + M.ρ rho2 b

theorem tri3_fixed (b : M) (hw : M.ρ wSwap b = b) (hm : M.ρ mI b = b) (g : IntegralGL)
    (hg : EntPlus (g.val 0 0) (g.val 0 1) (g.val 1 0) (g.val 1 1)) : M.ρ g (tri3 M b) = tri3 M b := by
  have fI : M.ρ mI (tri3 M b) = tri3 M b := by
    have key : ∀ h : IntegralGL, M.ρ mI (M.ρ h b) = M.ρ h b := by
      intro h
      rw [rho_comp, mI_comm, ← rho_comp, hm]
    unfold tri3
    rw [map_add, map_add, hm, key, key]
  have fW : M.ρ wSwap (tri3 M b) = tri3 M b := by
    unfold tri3
    rw [map_add, map_add, hw, rho_comp, rho_comp, w_rho, w_rho2, ← rho_comp, ← rho_comp, hw]
    abel
  have fR : M.ρ rho (tri3 M b) = tri3 M b := by
    unfold tri3
    rw [map_add, map_add, rho_comp, rho_comp, rho_rho, rho_mul_rho2, map_one]
    simp only [Module.End.one_apply]
    abel
  have fR2 : M.ρ rho2 (tri3 M b) = tri3 M b := by
    rw [← rho_rho, ← rho_comp, fR, fR]
  have fix_mul : ∀ g h : IntegralGL, M.ρ g (tri3 M b) = tri3 M b → M.ρ h (tri3 M b) = tri3 M b →
      M.ρ (g * h) (tri3 M b) = tri3 M b := by
    intro g h hg hh
    rw [← rho_comp, hh, hg]
  have f1 : M.ρ 1 (tri3 M b) = tri3 M b := by rw [map_one]; rfl
  unfold EntPlus at hg
  rcases hg with ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ |
    ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ |
    ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩
  · rw [eq_of_entries (g := g) (h := 1) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact f1
  · rw [eq_of_entries (g := g) (h := mI) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fI
  · rw [eq_of_entries (g := g) (h := wSwap) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fW
  · rw [eq_of_entries (g := g) (h := mI * wSwap) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fI fW
  · rw [eq_of_entries (g := g) (h := rho) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fR
  · rw [eq_of_entries (g := g) (h := mI * rho) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fI fR
  · rw [eq_of_entries (g := g) (h := rho2) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fR2
  · rw [eq_of_entries (g := g) (h := mI * rho2) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fI fR2
  · rw [eq_of_entries (g := g) (h := rho2 * wSwap) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fR2 fW
  · rw [eq_of_entries (g := g) (h := mI * (rho2 * wSwap)) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fI (fix_mul _ _ fR2 fW)
  · rw [eq_of_entries (g := g) (h := rho * wSwap) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fR fW
  · rw [eq_of_entries (g := g) (h := mI * (rho * wSwap)) (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)]
    exact fix_mul _ _ fI (fix_mul _ _ fR fW)

theorem normStab_tri_stab (m : M) (g : IntegralGL) (hg : g ∈ MulAction.stabilizer IntegralGL triPlus) :
    normStab (tri_stabilizer_finite triPlus) M (M.ρ g m) = normStab (tri_stabilizer_finite triPlus) M m := by
  have := normAt_smul (tri_stabilizer_finite triPlus) M triPlus g m
  rwa [MulAction.mem_stabilizer_iff.mp hg] at this

theorem normStab_fixed (m : M) (h : ∀ s : MulAction.stabilizer IntegralGL triPlus, M.ρ s m = m) :
    normStab (tri_stabilizer_finite triPlus) M m =
      ((transp_finite (tri_stabilizer_finite triPlus) triPlus).toFinset.card : ℚ) • m := by
  unfold normStab normAt
  rw [LinearMap.sum_apply]
  have : ∀ γ ∈ (transp_finite (tri_stabilizer_finite triPlus) triPlus).toFinset, M.ρ γ m = m := by
    intro γ hγ
    have hγ' : γ ∈ MulAction.stabilizer IntegralGL triPlus := by
      have := (Set.Finite.mem_toFinset _).mp hγ
      rw [transp_base] at this
      exact this
    exact h ⟨γ, hγ'⟩
  rw [Finset.sum_congr rfl this, Finset.sum_const, Nat.cast_smul_eq_nsmul]

theorem normStab_card_ne_zero :
    ((transp_finite (tri_stabilizer_finite triPlus) triPlus).toFinset.card : ℚ) ≠ 0 := by
  have : (transp_finite (tri_stabilizer_finite triPlus) triPlus).toFinset.card ≠ 0 := by
    apply Finset.card_ne_zero_of_mem (a := 1)
    rw [Set.Finite.mem_toFinset, transp_base]
    exact (MulAction.stabilizer IntegralGL triPlus).one_mem
  exact_mod_cast this

theorem cycle_iff (b : M) (hw : M.ρ wSwap b = b) (hm : M.ρ mI b = b) :
    normStab (tri_stabilizer_finite triPlus) M b = 0 ↔ tri3 M b = 0 := by
  have hc : normStab (tri_stabilizer_finite triPlus) M (tri3 M b) =
      ((transp_finite (tri_stabilizer_finite triPlus) triPlus).toFinset.card : ℚ) • tri3 M b :=
    normStab_fixed M _ fun s => tri3_fixed M b hw hm s (stab_entries s s.2)
  have h3 : normStab (tri_stabilizer_finite triPlus) M (tri3 M b) =
      (3 : ℚ) • normStab (tri_stabilizer_finite triPlus) M b := by
    unfold tri3
    rw [map_add, map_add, normStab_tri_stab M b rho rho_mem, normStab_tri_stab M b rho2 rho2_mem]
    module
  rw [h3] at hc
  constructor
  · intro h
    rw [h, smul_zero] at hc
    exact (smul_eq_zero.mp hc.symm).resolve_left (normStab_card_ne_zero)
  · intro h
    rw [h, smul_zero] at hc
    exact (smul_eq_zero.mp hc).resolve_left (by norm_num)

theorem isEdgeCoeff_iff (b : M) : IsEdgeCoeff M b ↔
    M.ρ wSwap b = b ∧ M.ρ mI b = b ∧ M.ρ sOne b = -b ∧ tri3 M b = 0 := by
  constructor
  · intro h
    have hw : M.ρ wSwap b = b := h.stab ⟨wSwap, w_mem⟩
    have hm : M.ρ mI b = b := h.stab ⟨mI, mI_mem⟩
    exact ⟨hw, hm, h.anti, (cycle_iff M b hw hm).mp h.cycle⟩
  · rintro ⟨hw, hm, hs, hc⟩
    refine ⟨?_, hs, (cycle_iff M b hw hm).mpr hc⟩
    intro s
    have := stab_p0_entries s s.2
    rcases this with ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩ | ⟨ha, hb, hc, hd⟩
    · have e : (s : IntegralGL) = 1 :=
        eq_of_entries (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)
      rw [e, map_one]; rfl
    · have e : (s : IntegralGL) = mI :=
        eq_of_entries (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)
      rw [e]; exact hm
    · have e : (s : IntegralGL) = wSwap :=
        eq_of_entries (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)
      rw [e]; exact hw
    · have e : (s : IntegralGL) = mI * wSwap :=
        eq_of_entries (by rw [ha]; wsimp) (by rw [hb]; wsimp) (by rw [hc]; wsimp) (by rw [hd]; wsimp)
      rw [e, ← rho_comp, hw, hm]

end Abstract

section Polynomial

open TernaryPoly.SinglePoleCoordinate TernaryPoly.OrdinaryResiduePeriod

/-- The coefficient module `Sym^d` of binary forms of degree `d` with trivial determinant twist, as a
representation of `GL₂(ℤ)`. -/
abbrev Dplain (d : ℕ) : Rep ℚ IntegralGL := Rep.of (integralAction d 0)

theorem coe_rho (d : ℕ) (g h : IntegralGL) (hgh : g * h = 1) (q : BinaryV d) :
    (((Dplain d).ρ g q : BinaryV d) : Poly) = subsZ h q :=
  integralAction_zero_coe d g h hgh q

theorem subsZ_eq_bind (h : IntegralGL) (f : Fin 2 → Poly)
    (h0 : f 0 = C ((h.val 0 0 : ℤ) : ℚ) * X 0 + C ((h.val 0 1 : ℤ) : ℚ) * X 1)
    (h1 : f 1 = C ((h.val 1 0 : ℤ) : ℚ) * X 0 + C ((h.val 1 1 : ℤ) : ℚ) * X 1) :
    subsZ h = bind₁ f := by
  unfold subsZ substitute
  congr 1
  funext i
  fin_cases i
  · simpa [linearForm, Fin.sum_univ_two] using h0.symm
  · simpa [linearForm, Fin.sum_univ_two] using h1.symm

theorem subsZ_w : subsZ wSwap = bind₁ (![X 1, X 0] : Fin 2 → Poly) := by
  apply subsZ_eq_bind <;> simp [wSwap, colGL_val_zero, colGL_val_one, e1, e2]

theorem subsZ_mI : subsZ mI = bind₁ (![-X 0, -X 1] : Fin 2 → Poly) := by
  apply subsZ_eq_bind <;> simp [mI, colGL_val_zero, colGL_val_one, e1, e2]

theorem subsZ_sOne : subsZ sOne = bind₁ (![X 0, -X 1] : Fin 2 → Poly) := by
  apply subsZ_eq_bind <;> simp [sOne, colGL_val_zero, colGL_val_one, e1, e2]

theorem subsZ_rho : subsZ rho = bind₁ (![-X 1, X 0 - X 1] : Fin 2 → Poly) := by
  apply subsZ_eq_bind <;> simp [rho, colGL_val_zero, colGL_val_one, e2, e12, sub_eq_add_neg]

theorem subsZ_rho2 : subsZ rho2 = bind₁ (![-X 0 + X 1, -X 0] : Fin 2 → Poly) := by
  apply subsZ_eq_bind <;> simp [rho2, colGL_val_zero, colGL_val_one, e1, e12]

theorem isEdgeCoeff_Dplain_iff (d : ℕ) (q : BinaryV d) : IsEdgeCoeff (Dplain d) q ↔ q ∈ periodSpace d := by
  rw [isEdgeCoeff_iff, mem_periodSpace]
  have hW : (((Dplain d).ρ wSwap q : BinaryV d) : Poly) = bind₁ (![X 1, X 0] : Fin 2 → Poly) q := by
    rw [coe_rho d wSwap wSwap w_w, subsZ_w]
  have hM : (((Dplain d).ρ mI q : BinaryV d) : Poly) = bind₁ (![-X 0, -X 1] : Fin 2 → Poly) q := by
    rw [coe_rho d mI mI mI_mI, subsZ_mI]
  have hS : (((Dplain d).ρ sOne q : BinaryV d) : Poly) = bind₁ (![X 0, -X 1] : Fin 2 → Poly) q := by
    rw [coe_rho d sOne sOne sOne_mul_self, subsZ_sOne]
  have hR : (((Dplain d).ρ rho q : BinaryV d) : Poly) = bind₁ (![-X 0 + X 1, -X 0] : Fin 2 → Poly) q := by
    rw [coe_rho d rho rho2 rho_mul_rho2, subsZ_rho2]
  have hR2 : (((Dplain d).ρ rho2 q : BinaryV d) : Poly) = bind₁ (![-X 1, X 0 - X 1] : Fin 2 → Poly) q := by
    rw [coe_rho d rho2 rho rho2_mul_rho, subsZ_rho]
  have hC : ((tri3 (Dplain d) q : BinaryV d) : Poly) =
      (q : Poly) + bind₁ (![-X 0 + X 1, -X 0] : Fin 2 → Poly) q +
        bind₁ (![-X 1, X 0 - X 1] : Fin 2 → Poly) q := by
    unfold tri3
    rw [Submodule.coe_add, Submodule.coe_add, hR, hR2]
  have ext_iff : ∀ a b : BinaryV d, a = b ↔ (a : Poly) = (b : Poly) := fun a b => Subtype.ext_iff
  constructor
  · rintro ⟨hw, hm, hs, hc⟩
    rw [ext_iff, hW] at hw
    rw [ext_iff, hM] at hm
    rw [ext_iff, hS] at hs
    rw [ext_iff, hC, Submodule.coe_zero] at hc
    have hs' : bind₁ (![X 0, -X 1] : Fin 2 → Poly) (q : Poly) = -q := by simpa using hs
    have hm' : bind₁ (![-X 0, -X 1] : Fin 2 → Poly) (q : Poly) = q := hm
    have o1 : bind₁ (![-X 0, X 1] : Fin 2 → Poly) (q : Poly) = -q := by
      have := subs_transport' q (![X 0, -X 1] : Fin 2 → Poly) (-q) hs' (![-X 0, -X 1] : Fin 2 → Poly)
      have e : (fun i => bind₁ (![-X 0, -X 1] : Fin 2 → Poly) ((![X 0, -X 1] : Fin 2 → Poly) i)) =
          (![-X 0, X 1] : Fin 2 → Poly) := by
        funext i; fin_cases i <;> simp
      rw [e, map_neg, hm'] at this
      exact this
    have h3 : Sym3 (q : Poly) := ⟨hw, o1, hs'⟩
    refine ⟨hw, o1, hs', ?_⟩
    rw [h3.rot1, h3.rot2] at hc
    linear_combination hc
  · intro hq
    obtain ⟨sw, o1, o2, per⟩ := hq
    have h3 : Sym3 (q : Poly) := ⟨sw, o1, o2⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [ext_iff, hW]; exact sw
    · rw [ext_iff, hM]; exact h3.even
    · rw [ext_iff, hS, Submodule.coe_neg]; exact o2
    · rw [ext_iff, hC, Submodule.coe_zero, h3.rot1, h3.rot2]; linear_combination per

/-- The standard-edge coefficients of classes in `H₁(GL₂(ℤ), Sym^d)` are exactly the polynomial period space:
the symmetric, separately odd binary period relations. -/
theorem range_edge2_Dplain (d : ℕ) : LinearMap.range (edge2 (Dplain d)) = periodSpace d := by
  ext q
  rw [LinearMap.mem_range, ← isEdgeCoeff_Dplain_iff]
  constructor
  · rintro ⟨x, rfl⟩
    exact edge2_isEdgeCoeff _ x
  · exact edge2_surjective_of (M := Dplain d)

/-- The period space of degree `d` is isomorphic to `H₁(GL₂(ℤ), Sym^d)`, through the coefficient at the standard
oriented edge of the dual Farey tree. -/
def periodEquivHomology (d : ℕ) : groupHomology (Dplain d) 1 ≃ₗ[ℚ] periodSpace d :=
  (LinearEquiv.ofInjective (edge2 (Dplain d)) (edge2_injective _)).trans
    (LinearEquiv.ofEq _ _ (range_edge2_Dplain d))

end Polynomial

end TernaryPeriodPolynomials.Argument.FareyTree
