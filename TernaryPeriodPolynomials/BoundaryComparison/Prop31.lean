module

public import TernaryPeriodPolynomials.Building.Good.OrbitCompleteness
public import TernaryPeriodPolynomials.SymmetricSolution.CycleLifting
public import TernaryPeriodPolynomials.Building.Reference.ApartmentRelations
public import TernaryPeriodPolynomials.Polynomial.Definitions
public import Mathlib.RepresentationTheory.Basic

@[expose] public section


/-!
# Proposition 3.1 as one statement (`thm:good-apartment`)

Formalized by Claude Sonnet 5.5.

> **Proposition 3.1.** The graph `𝒯↑` is connected, and we have
> `St↑ ≅ ℚK / (ℚK(1+A+A²) + ℚK(C-1) + ℚK(S₀+1))`.
> Evaluation on the identity apartment gives isomorphisms
> `Hom_K(St↑, E_{n,0}) ≅ W_n^alt(ℚ)`, `Hom_K(St↑, E_{n,1}) ≅ W_n^sym(ℚ)`.

## Dictionary

* `𝒯↑`: `GoodBuilding.graph` (good rational lines and planes, joined by inclusion);
  `St↑ = H̃₁(𝒯↑;ℚ)`: `GoodChainComplex.Cycles`, the finite rational edge chains of zero boundary, with the `K`-action `complex.cyclesAction`, viewed as a `ℚK`-module through
  `Representation.asModule` (`StUpModule`).
* `K`: `ModThreeGoodAction.K`; `ℚK`: `MonoidAlgebra ℚ K`.
* `A`, `S₀`: `ReferenceCoefficientMatrices.aK`, `sK` (the matrices of the paper).  The paper's
  `C = ((0,1,0),(0,0,1),(1,0,0))` is the inverse of the library's `cK`, so `paperC := cK⁻¹`; the left
  ideals generated by `C - 1` and `cK - 1` coincide.  `presentationIdeal` is the left ideal
  `ℚK(1+A+A²) + ℚK(C-1) + ℚK(S₀+1)` (`Ideal.span` of the three elements in the noncommutative ring `ℚK`).
* The class of `1` corresponds to the identity apartment `GoodUnimodularOrbit.referenceApartment`.
* `E_{n,t} = Sym^n((ℚ³)*) ⊗ det^{-t}` with `g · f(x) = det(g)^{-t} f(g⁻¹x)`: the representation
  `GoodChainComplex.coefficientAction n e` with determinant exponent `e = -t`; so `t = 0` is `e = 0` and
  `t = 1` is `e = -1`.  `HomK n e` is the space of `K`-equivariant linear maps `St↑ → E_{n,t}`.
* `W_n^alt(ℚ)`, `W_n^sym(ℚ)`: `TernaryPoly.Paper.alternatingSolutionSpace ℚ n`,
  `symmetricSolutionSpace ℚ n`.

The ingredients are the library's `GoodBuilding.connected`, `GoodOrbitCompleteness.orbitMap_ker` (the kernel of
`ℚK → St↑`, `g ↦ g · [identity apartment]`, is exactly spanned by the translated relations, without
premises), `GoodOrbitRelations.orbitMap_surjective`, and the cycle-map lifting `BenchmarkCycleLifting`.
-/

open MvPolynomial TernaryPoly TernaryPoly.GoodBuilding TernaryPoly.ReferenceCoefficientMatrices

noncomputable section

namespace TernaryPeriodPolynomials.Argument.Statements.Prop31

/-- `ℚK`. -/
abbrev QK := MonoidAlgebra ℚ K

/-- `St↑ = H̃₁(𝒯↑;ℚ)`: the module of cycles of the good incidence graph. -/
abbrev StUp := GoodChainComplex.Cycles

/-- The paper's matrix `C` (`C f (x,y,z) = f(y,z,x)`), the inverse of the library's `cK`. -/
def paperC : K := cK⁻¹

/-- The left ideal `ℚK(1+A+A²) + ℚK(C-1) + ℚK(S₀+1)`. -/
def presentationIdeal : Ideal QK :=
  Ideal.span {1 + MonoidAlgebra.of ℚ K aK + MonoidAlgebra.of ℚ K (aK ^ 2),
    MonoidAlgebra.of ℚ K paperC - 1, MonoidAlgebra.of ℚ K sK + 1}

/-- `ℚK`-module structure on the cycles. -/
abbrev StUpModule := GoodChainComplex.complex.cyclesAction.asModule

/-- Evaluation `x ↦ x • [identity apartment]`. -/
def evalRef : QK →ₗ[QK] StUpModule :=
  LinearMap.toSpanSingleton QK StUpModule
    (GoodChainComplex.complex.cyclesAction.asModuleEquiv.symm GoodUnimodularOrbit.referenceApartment)

theorem evalRef_single (g : K) :
    evalRef (MonoidAlgebra.of ℚ K g) =
      GoodChainComplex.complex.cyclesAction.asModuleEquiv.symm
        (GoodChainComplex.complex.cyclesAction g GoodUnimodularOrbit.referenceApartment) := by
  simp only [evalRef, LinearMap.toSpanSingleton_apply]
  rw [MonoidAlgebra.of_apply, Representation.asModuleEquiv_symm_map_rho]
  rfl


/-- The coefficient-to-algebra transport `FreeOrbit → ℚK`. -/
def ofCoeffL : GoodOrbitRelations.FreeOrbit →ₗ[ℚ] QK :=
  (MonoidAlgebra.coeffLinearEquiv ℚ : QK ≃ₗ[ℚ] (K →₀ ℚ)).symm.toLinearMap

theorem ofCoeffL_delta (g : K) :
    ofCoeffL (GoodOrbitRelations.delta g) = MonoidAlgebra.of ℚ K g := by
  simp [ofCoeffL, GoodOrbitRelations.delta, MonoidAlgebra.of_apply]

theorem ofCoeffL_coeff (x : QK) :
    ofCoeffL ((MonoidAlgebra.coeffLinearEquiv ℚ : QK ≃ₗ[ℚ] (K →₀ ℚ)) x) = x := by
  simp [ofCoeffL]

theorem asModuleEquiv_evalRef_ofCoeffL (y : GoodOrbitRelations.FreeOrbit) :
    GoodChainComplex.complex.cyclesAction.asModuleEquiv (evalRef (ofCoeffL y)) =
      GoodOrbitRelations.orbitMap y := by
  have h : (GoodChainComplex.complex.cyclesAction.asModuleEquiv.toLinearMap.comp
      ((evalRef.restrictScalars ℚ).comp ofCoeffL)) = GoodOrbitRelations.orbitMap := by
    apply Finsupp.lhom_ext
    intro g q
    have hs : ofCoeffL (Finsupp.single g q) = q • MonoidAlgebra.of ℚ K g := by
      have : (Finsupp.single g q : GoodOrbitRelations.FreeOrbit) =
          q • GoodOrbitRelations.delta g := by
        simp [GoodOrbitRelations.delta]
      rw [this, map_smul, ofCoeffL_delta]
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [hs, map_smul, LinearMap.restrictScalars_apply, evalRef_single, map_smul,
      LinearEquiv.apply_symm_apply]
    simp [GoodOrbitRelations.orbitMap]
  exact LinearMap.congr_fun h y

open GoodOrbitRelations

theorem ofCoeffL_mem_ideal {y : FreeOrbit} (hy : y ∈ relations) :
    ofCoeffL y ∈ presentationIdeal := by
  have hmul : MonoidAlgebra.of ℚ K cK * MonoidAlgebra.of ℚ K paperC = 1 := by
    rw [paperC, ← map_mul, mul_inv_cancel, map_one]
  induction hy using Submodule.span_induction with
  | mem y hy =>
    rcases hy with (⟨g, rfl⟩ | ⟨g, rfl⟩) | ⟨g, rfl⟩
    · have : ofCoeffL (normRelation g) = MonoidAlgebra.of ℚ K g *
          (1 + MonoidAlgebra.of ℚ K aK + MonoidAlgebra.of ℚ K (aK ^ 2)) := by
        simp [normRelation, ofCoeffL_delta, mul_add]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · have : ofCoeffL (cyclicRelation g) = -(MonoidAlgebra.of ℚ K g * MonoidAlgebra.of ℚ K cK) *
          (MonoidAlgebra.of ℚ K paperC - 1) := by
        rw [neg_mul, mul_sub, mul_one, mul_assoc, hmul, mul_one]
        simp only [cyclicRelation, map_sub, ofCoeffL_delta, map_mul]
        abel
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · have : ofCoeffL (swapRelation g) = MonoidAlgebra.of ℚ K g *
          (MonoidAlgebra.of ℚ K sK + 1) := by
        simp [swapRelation, ofCoeffL_delta, mul_add]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x _ hx => rw [map_smul]; exact Submodule.smul_of_tower_mem _ a hx

theorem evalRef_eq_zero_of_mem_ker {y : FreeOrbit} (hy : y ∈ LinearMap.ker orbitMap) :
    evalRef (ofCoeffL y) = 0 := by
  apply GoodChainComplex.complex.cyclesAction.asModuleEquiv.injective
  rw [asModuleEquiv_evalRef_ofCoeffL, map_zero]
  exact hy

theorem ker_evalRef : LinearMap.ker evalRef = presentationIdeal := by
  apply le_antisymm
  · intro x hx
    have hx' : evalRef x = 0 := hx
    have hco : (MonoidAlgebra.coeffLinearEquiv ℚ : QK ≃ₗ[ℚ] (K →₀ ℚ)) x ∈ relations := by
      rw [← GoodOrbitCompleteness.orbitMap_ker, LinearMap.mem_ker, ← asModuleEquiv_evalRef_ofCoeffL,
        ofCoeffL_coeff, hx', map_zero]
    have := ofCoeffL_mem_ideal hco
    rwa [ofCoeffL_coeff] at this
  · unfold presentationIdeal
    apply Submodule.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · have : (1 + MonoidAlgebra.of ℚ K aK + MonoidAlgebra.of ℚ K (aK ^ 2) : QK) =
          ofCoeffL (normRelation 1) := by
        simp [normRelation, ofCoeffL_delta, MonoidAlgebra.one_def]
      rw [SetLike.mem_coe, LinearMap.mem_ker, this]
      exact evalRef_eq_zero_of_mem_ker (normRelation_mem_ker 1)
    · have : (MonoidAlgebra.of ℚ K paperC - 1 : QK) = -ofCoeffL (cyclicRelation paperC) := by
        simp [cyclicRelation, ofCoeffL_delta, paperC, MonoidAlgebra.one_def]
      rw [SetLike.mem_coe, LinearMap.mem_ker, this, map_neg,
        evalRef_eq_zero_of_mem_ker (cyclicRelation_mem_ker paperC), neg_zero]
    · have : (MonoidAlgebra.of ℚ K sK + 1 : QK) = ofCoeffL (swapRelation 1) := by
        simp [swapRelation, ofCoeffL_delta, MonoidAlgebra.one_def]
      rw [SetLike.mem_coe, LinearMap.mem_ker, this]
      exact evalRef_eq_zero_of_mem_ker (swapRelation_mem_ker 1)

theorem evalRef_surjective : Function.Surjective evalRef := by
  intro m
  obtain ⟨y, hy⟩ := orbitMap_surjective (GoodChainComplex.complex.cyclesAction.asModuleEquiv m)
  refine ⟨ofCoeffL y, GoodChainComplex.complex.cyclesAction.asModuleEquiv.injective ?_⟩
  rw [asModuleEquiv_evalRef_ofCoeffL, hy]

section Generic

variable {G : Type} [Group G] {V : Type} [AddCommGroup V] [Module ℚ V] (ρ : Representation ℚ G V)

/-- Cyclic modules over a group algebra: `ℚG / I ≅ ρ.asModule` when `I` is the annihilator of a generator. -/
theorem quot_equiv (m0 : ρ.asModule) (I : Ideal (MonoidAlgebra ℚ G))
    (hker : LinearMap.ker (LinearMap.toSpanSingleton (MonoidAlgebra ℚ G) ρ.asModule m0) = I)
    (hsurj : Function.Surjective
      (LinearMap.toSpanSingleton (MonoidAlgebra ℚ G) ρ.asModule m0)) :
    ∃ e : (MonoidAlgebra ℚ G ⧸ I) ≃ₗ[MonoidAlgebra ℚ G] ρ.asModule,
      e (Submodule.Quotient.mk 1) = m0 := by
  subst hker
  exact ⟨LinearMap.quotKerEquivOfSurjective _ hsurj, by simp⟩

end Generic

/-- `St↑ ≅ ℚK / (ℚK(1+A+A²) + ℚK(C-1) + ℚK(S₀+1))` as `ℚK`-modules, the identity apartment
corresponding to the class of `1`. -/
theorem presentation_exists :
    ∃ e : (QK ⧸ presentationIdeal) ≃ₗ[QK] StUpModule,
      e (Submodule.Quotient.mk 1) =
        GoodChainComplex.complex.cyclesAction.asModuleEquiv.symm
          GoodUnimodularOrbit.referenceApartment :=
  quot_equiv GoodChainComplex.complex.cyclesAction _ presentationIdeal ker_evalRef
    evalRef_surjective


open TernaryPoly.Paper TernaryPoly.ReferenceApartmentRelations
/-- `K`-equivariant linear maps `St↑ → E_{n,t}` with `E_{n,t} = Sym^n((ℚ³)*) ⊗ det^{-t}`: the left action
`g · f(x) = det(g)^e f(g⁻¹x)` with `e = -t` (`coefficientAction n e`). -/
def HomK (n : ℕ) (e : ℤ) :
    Submodule ℚ (StUp →ₗ[ℚ] PolynomialGLAction.HomogeneousPoly n) where
  carrier := {φ | ∀ (g : K) (c : StUp), φ (GoodChainComplex.complex.cyclesAction g c) =
    GoodChainComplex.coefficientAction n e g (φ c)}
  zero_mem' := by intro g c; simp
  add_mem' := by
    intro a b ha hb g c
    simp only [LinearMap.add_apply, ha g c, hb g c, map_add]
  smul_mem' := by
    intro r a ha g c
    simp only [LinearMap.smul_apply, ha g c, map_smul]

/-- Evaluation of a functional at the identity apartment. -/
def refMap (n : ℕ) (e : ℤ) : HomK n e →ₗ[ℚ] MvPolynomial (Fin 3) ℚ where
  toFun φ := ((φ.1 GoodUnimodularOrbit.referenceApartment :
      PolynomialGLAction.HomogeneousPoly n) : MvPolynomial (Fin 3) ℚ)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem refMap_apply (n : ℕ) (e : ℤ) (φ : HomK n e) :
    refMap n e φ = ((φ.1 GoodUnimodularOrbit.referenceApartment :
      PolynomialGLAction.HomogeneousPoly n) : MvPolynomial (Fin 3) ℚ) := rfl

/-- A functional in `HomK n e` is a polynomial cycle map. -/
def toCycleMap {n : ℕ} {e : ℤ} (φ : HomK n e) : GoodChainComplex.PolynomialCycleMap n e :=
  ⟨φ.1, φ.2⟩

theorem refMap_eq_referenceValue {n : ℕ} {e : ℤ} (φ : HomK n e) :
    refMap n e φ = referenceValue (toCycleMap φ) := rfl

theorem homK_ext {n : ℕ} {e : ℤ} (φ ψ : HomK n e) (h : refMap n e φ = refMap n e ψ) : φ = ψ := by
  apply Subtype.ext
  have hF : toCycleMap φ = toCycleMap ψ := by
    apply GoodOrbitSpan.polynomialCycleMap_ext
    exact Subtype.ext h
  exact congrArg GoodChainComplex.PolynomialCycleMap.map hF

theorem refMap_mem_alternating (n : ℕ) (φ : HomK n 0) :
    refMap n 0 φ ∈ alternatingSolutionSpace ℚ n := by
  have h1 := referenceValue_periodRelations (toCycleMap φ)
  have h2 := referenceValue_alternating (toCycleMap φ)
  refine ⟨⟨(φ.1 GoodUnimodularOrbit.referenceApartment).2, h1⟩, ?_⟩
  change (bind₁ ![X 1, X 0, X 2]) (referenceValue (toCycleMap φ)) +
    referenceValue (toCycleMap φ) = 0
  have : S (referenceValue (toCycleMap φ)) = bind₁ ![X 1, X 0, X 2] (referenceValue (toCycleMap φ)) :=
    rfl
  rw [← this, h2]; abel

theorem refMap_mem_symmetric (n : ℕ) (φ : HomK n (-1)) :
    refMap n (-1) φ ∈ symmetricSolutionSpace ℚ n := by
  have h1 := referenceValue_periodRelations (toCycleMap φ)
  have h2 := referenceValue_symmetric (toCycleMap φ)
  refine ⟨⟨(φ.1 GoodUnimodularOrbit.referenceApartment).2, h1⟩, ?_⟩
  change (bind₁ ![X 1, X 0, X 2]) (referenceValue (toCycleMap φ)) -
    referenceValue (toCycleMap φ) = 0
  have : S (referenceValue (toCycleMap φ)) = bind₁ ![X 1, X 0, X 2] (referenceValue (toCycleMap φ)) :=
    rfl
  rw [← this, h2]; abel

theorem hom_alternating (n : ℕ) :
    ∃ e : HomK n 0 ≃ₗ[ℚ] alternatingSolutionSpace ℚ n,
      ∀ φ, ((e φ : alternatingSolutionSpace ℚ n) : MvPolynomial (Fin 3) ℚ) =
        ((φ.1 GoodUnimodularOrbit.referenceApartment : PolynomialGLAction.HomogeneousPoly n) :
          MvPolynomial (Fin 3) ℚ) := by
  let T : HomK n 0 →ₗ[ℚ] alternatingSolutionSpace ℚ n :=
    LinearMap.codRestrict _ (refMap n 0) (refMap_mem_alternating n)
  have hinj : Function.Injective T := by
    intro φ ψ h
    exact homK_ext φ ψ (congrArg (fun x : alternatingSolutionSpace ℚ n =>
      (x : MvPolynomial (Fin 3) ℚ)) h)
  have hsurj : Function.Surjective T := by
    intro y
    have hy := y.2
    have hhom : (y : MvPolynomial (Fin 3) ℚ) ∈ homogeneousSubmodule (Fin 3) ℚ n := hy.1.1
    have hrel : PeriodRelations (⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 := hy.1.2
    have hswap : S (⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 =
        -(⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 := by
      have : (bind₁ ![X 1, X 0, X 2]) (y : MvPolynomial (Fin 3) ℚ) +
          (y : MvPolynomial (Fin 3) ℚ) = 0 := hy.2
      exact eq_neg_of_add_eq_zero_left this
    refine ⟨⟨(CycleLifting.alternatingCycleMap _ hrel hswap).map,
      (CycleLifting.alternatingCycleMap _ hrel hswap).equivariant⟩, ?_⟩
    apply Subtype.ext
    exact congrArg (fun p : PolynomialGLAction.HomogeneousPoly n => (p : MvPolynomial (Fin 3) ℚ))
      (CycleLifting.alternatingCycleMap_reference _ hrel hswap)
  exact ⟨LinearEquiv.ofBijective T ⟨hinj, hsurj⟩, fun φ => rfl⟩

theorem hom_symmetric (n : ℕ) :
    ∃ e : HomK n (-1) ≃ₗ[ℚ] symmetricSolutionSpace ℚ n,
      ∀ φ, ((e φ : symmetricSolutionSpace ℚ n) : MvPolynomial (Fin 3) ℚ) =
        ((φ.1 GoodUnimodularOrbit.referenceApartment : PolynomialGLAction.HomogeneousPoly n) :
          MvPolynomial (Fin 3) ℚ) := by
  let T : HomK n (-1) →ₗ[ℚ] symmetricSolutionSpace ℚ n :=
    LinearMap.codRestrict _ (refMap n (-1)) (refMap_mem_symmetric n)
  have hinj : Function.Injective T := by
    intro φ ψ h
    exact homK_ext φ ψ (congrArg (fun x : symmetricSolutionSpace ℚ n =>
      (x : MvPolynomial (Fin 3) ℚ)) h)
  have hsurj : Function.Surjective T := by
    intro y
    have hy := y.2
    have hhom : (y : MvPolynomial (Fin 3) ℚ) ∈ homogeneousSubmodule (Fin 3) ℚ n := hy.1.1
    have hrel : PeriodRelations (⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 := hy.1.2
    have hswap : S (⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 =
        (⟨y, hhom⟩ : PolynomialGLAction.HomogeneousPoly n).1 := by
      have : (bind₁ ![X 1, X 0, X 2]) (y : MvPolynomial (Fin 3) ℚ) -
          (y : MvPolynomial (Fin 3) ℚ) = 0 := hy.2
      exact sub_eq_zero.mp this
    refine ⟨⟨(CycleLifting.symmetricCycleMap _ hrel hswap).map,
      (CycleLifting.symmetricCycleMap _ hrel hswap).equivariant⟩, ?_⟩
    apply Subtype.ext
    exact congrArg (fun p : PolynomialGLAction.HomogeneousPoly n => (p : MvPolynomial (Fin 3) ℚ))
      (CycleLifting.symmetricCycleMap_reference _ hrel hswap)
  exact ⟨LinearEquiv.ofBijective T ⟨hinj, hsurj⟩, fun φ => rfl⟩

open TernaryPoly.Paper
/-- **Proposition 3.1** (`thm:good-apartment`): `𝒯↑` is connected, `St↑ ≅ ℚK/(ℚK(1+A+A²) + ℚK(C-1) +
ℚK(S₀+1))` as `ℚK`-modules with the identity apartment corresponding to the class of `1`, and evaluation
on the identity apartment gives `Hom_K(St↑, E_{n,0}) ≅ W_n^alt(ℚ)` and `Hom_K(St↑, E_{n,1}) ≅
W_n^sym(ℚ)` (determinant exponents `0` and `-1`). -/
theorem prop_3_1 :
    GoodBuilding.graph.Connected ∧
    (∃ e : (QK ⧸ presentationIdeal) ≃ₗ[QK] StUpModule,
      e (Submodule.Quotient.mk 1) =
        GoodChainComplex.complex.cyclesAction.asModuleEquiv.symm
          GoodUnimodularOrbit.referenceApartment) ∧
    (∀ n : ℕ, ∃ e : HomK n 0 ≃ₗ[ℚ] alternatingSolutionSpace ℚ n,
      ∀ φ, ((e φ : alternatingSolutionSpace ℚ n) : MvPolynomial (Fin 3) ℚ) =
        ((φ.1 GoodUnimodularOrbit.referenceApartment : PolynomialGLAction.HomogeneousPoly n) :
          MvPolynomial (Fin 3) ℚ)) ∧
    (∀ n : ℕ, ∃ e : HomK n (-1) ≃ₗ[ℚ] symmetricSolutionSpace ℚ n,
      ∀ φ, ((e φ : symmetricSolutionSpace ℚ n) : MvPolynomial (Fin 3) ℚ) =
        ((φ.1 GoodUnimodularOrbit.referenceApartment : PolynomialGLAction.HomogeneousPoly n) :
          MvPolynomial (Fin 3) ℚ)) :=
  ⟨GoodBuilding.connected, presentation_exists, hom_alternating, hom_symmetric⟩

end TernaryPeriodPolynomials.Argument.Statements.Prop31
