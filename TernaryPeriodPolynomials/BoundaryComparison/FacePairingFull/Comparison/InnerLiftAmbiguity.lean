module

public import TernaryPeriodPolynomials.BoundaryComparison.FacePairingFull.Comparison.InnerLift
public import TernaryPeriodPolynomials.BoundaryComparison.FacePairingFull.Comparison.Cone.Corner

@[expose] public section


/-!
# The ambiguity of the lifts of inner classes to the cone

The lift `innerLineCone z u` of an inner line class depends on the cocycle `z` and on the edge primitive
`u` (`z|_{Edges} = du`).  This file determines exactly how:

* (`innerLineCone_shift`) it does not depend on the representative `z`: replacing `z` by `z + dw` and `u` by
  `u + w|_{Edges}` does not change the class (the two cone cocycles differ by the cone coboundary of `(0, w, 0)`);
* (`innerLineCone_edge_change`) for a fixed `z`, two edge primitives `u`, `u'` give lifts differing by the class
  `cornerClass (modelHomOf (u' - u))` of a corner cocycle: a cone class supported on the corner, which
  restricts to zero on the line and plane faces (`cornerClass_line`, `cornerClass_plane`).

The same holds for plane lifts.  Together: the lift of an inner class is well defined modulo the subgroup of
`H²(∂M; ρ)` generated by corner cocycles, i.e. modulo the image of `H¹` of the corner (edge) complex.  This is
exactly the freedom in the edge primitive `w` of the model's face pairing, of which `pairingValue_eq`
(`FacePairingForm`) proves independence: the model pairing of inner classes depends only on their face
classes.

Formalized by Claude Sonnet 5.5.
-/

open CategoryTheory Category Limits HomologicalComplex
open GeneralEisenstein GeneralEisenstein.Homogeneous
open TernaryPeriodPolynomials.Argument.TopHomology
open TernaryPoly.SymmetricSpaceBoundaryFull TernaryPoly.EquivariantSingularSmall
open TernaryPoly.SymmetricSpaceBoundaryMV (Flag)
open TernaryPoly.OrdinaryIncidence (Line Plane)

noncomputable section

namespace TernaryPeriodPolynomials.Argument.FacePairingFull.Comparison

attribute [local instance] vertexAction

variable {V : Type} [AddCommGroup V] [Module ℂ V] [Module ℚ V] [IsScalarTower ℚ ℂ V]
  (ρ : Representation ℂ RationalGL3 V)

theorem cornerCochain_cocycle (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
    (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0) :
    coneR.d 3 2 ≫ cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1 e = 0 := by
  apply (signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 2).injective
  rw [cone_coboundary_coordinates, cornerCochain_coords]
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · change -((prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e) +
      flagLineHom.hom.f 2 ≫ (0 : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ coeffRep ρ) -
      flagPlaneHom.hom.f 2 ≫ (0 : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ coeffRep ρ) = 0
    rw [he, comp_zero, comp_zero]
    abel
  · exact comp_zero
  · exact comp_zero

/-- The cone class of a corner cocycle `e` (zero face components). -/
def cornerClass (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
    (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0) :
    (homCochains coneR (coeffRep ρ)).homology 2 :=
  cls2 (homCochains coneR (coeffRep ρ))
    (cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1 e)
    (cornerCochain_cocycle ρ e he)

theorem cornerClass_face_zero (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
    (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0) {Z : Type} [MulAction Γ6 Z]
    (ι : prodComplex Γ6 RationalGL3 Z ⟶ coneR)
    (hι : ι.f 2 ≫ cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1 e = 0) :
    (homologyMap (homPullback ι (coeffRep ρ)) 2).hom (cornerClass ρ e he) = 0 := by
  unfold cornerClass
  refine (cls2_map _ (homPullback ι (coeffRep ρ)) _ _
    (map_cocycle _ (homPullback ι (coeffRep ρ)) _ (cornerCochain_cocycle ρ e he))).trans ?_
  exact (cls2_congr _ _ (map_zero _) hι).trans (cls2_zero _ (map_zero _))

theorem cornerClass_line (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
    (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0) :
    (homologyMap (homPullback coneLine (coeffRep ρ)) 2).hom (cornerClass ρ e he) = 0 := by
  refine cornerClass_face_zero ρ e he coneLine ?_
  have h := signedConeHomSucc_apply flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
    (cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1 e)
  rw [cornerCochain_coords] at h
  exact (congrArg (fun t => t.2.1) h).symm

theorem cornerClass_plane (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
    (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0) :
    (homologyMap (homPullback conePlane (coeffRep ρ)) 2).hom (cornerClass ρ e he) = 0 := by
  refine cornerClass_face_zero ρ e he conePlane ?_
  have h := signedConeHomSucc_apply flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
    (cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1 e)
  rw [cornerCochain_coords] at h
  exact (congrArg (fun t => t.2.2) h).symm

/-- Pullback of a stratum cochain to the complete flags. -/
def edgePull (s : Side) {k : ℕ} (w : cochains N6 (flagRepresentation ρ s) k) :
    cochains N6 (functionRepresentation ρ Edges) k :=
  ⟨fun x e => w.1 x (endpoint s e), by
    intro γ x
    funext e
    have h := congrFun (w.2 γ x) (endpoint s e)
    change w.1 (fun i => γ.val * x i) (endpoint s e) = ρ γ.val (w.1 x (endpoint s (γ.val⁻¹ • e)))
    rw [h]
    change ρ γ.val (w.1 x (γ.val⁻¹ • endpoint s e)) = _
    rw [endpoint_smul]⟩

omit [Module ℚ V] [IsScalarTower ℚ ℂ V] in
theorem differentialOne_edgePull (s : Side) (w : cochains N6 (flagRepresentation ρ s) 1) (x e) :
    (differentialOne N6 (functionRepresentation ρ Edges) (edgePull ρ s w)).1 x e =
      (differentialOne N6 (flagRepresentation ρ s) w).1 x (endpoint s e) := rfl

theorem flagLine_comp_modelHomOf_one (w : cochains N6 (functionRepresentation ρ (Flags .line)) 1) :
    flagLineHom.hom.f 1 ≫ modelHomOf ρ psiLine psiLine_smul w =
      modelHomOf ρ psiEdge psiEdge_smul (edgePull ρ .line w) := by
  apply homFunA_injective
  funext y
  obtain ⟨x, φ⟩ := y
  have h := homFunA_comp_map (A := coeffRep ρ) (V := RationalGL3) (Γ := Γ6) (Z := Flag)
    (Z' := Line) TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine
    TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine_equivariant
    (modelHomOf ρ psiLine psiLine_smul w) x φ
  refine h.trans ?_
  rw [homFunA_modelHomOf, homFunA_modelHomOf]
  change w.1 x (psiLine.symm (TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagLine φ)) =
    w.1 x (endpoint .line (psiEdge.symm φ))
  refine congrArg (w.1 x) ?_
  rw [Equiv.symm_apply_eq]
  have := psiEdge_line (psiEdge.symm φ)
  rw [Equiv.apply_symm_apply] at this
  exact this

theorem flagPlane_comp_modelHomOf_one (w : cochains N6 (functionRepresentation ρ (Flags .plane)) 1) :
    flagPlaneHom.hom.f 1 ≫ modelHomOf ρ psiPlane psiPlane_smul w =
      modelHomOf ρ psiEdge psiEdge_smul (edgePull ρ .plane w) := by
  apply homFunA_injective
  funext y
  obtain ⟨x, φ⟩ := y
  have h := homFunA_comp_map (A := coeffRep ρ) (V := RationalGL3) (Γ := Γ6) (Z := Flag)
    (Z' := Plane) TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane
    TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane_equivariant
    (modelHomOf ρ psiPlane psiPlane_smul w) x φ
  refine h.trans ?_
  rw [homFunA_modelHomOf, homFunA_modelHomOf]
  change w.1 x (psiPlane.symm (TernaryPoly.SymmetricSpaceBoundaryFaceAugmentation.flagPlane φ)) =
    w.1 x (endpoint .plane (psiEdge.symm φ))
  refine congrArg (w.1 x) ?_
  rw [Equiv.symm_apply_eq]
  have := psiEdge_plane (psiEdge.symm φ)
  rw [Equiv.apply_symm_apply] at this
  exact this

/-- **Change of edge primitive**: two edge primitives of the same line cocycle give lifts differing by a
corner class. -/
theorem innerLineCone_edge_change (z : cocycles N6 (functionRepresentation ρ (Flags .line)))
    (u u' : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (hu' : ∀ x e, z.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u').1 x e) :
    ∃ (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
      (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0),
      innerLineCone ρ z u' hu' = innerLineCone ρ z u hu + cornerClass ρ e he := by
  have hd : differentialOne N6 (functionRepresentation ρ Edges) u' =
      differentialOne N6 (functionRepresentation ρ Edges) u := by
    apply Subtype.ext
    funext x e
    exact (hu' x e).symm.trans (hu x e)
  have he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫
      (modelHomOf ρ psiEdge psiEdge_smul u' - modelHomOf ρ psiEdge psiEdge_smul u) = 0 := by
    rw [Preadditive.comp_sub, ← modelHomOf_differentialOne', ← modelHomOf_differentialOne', hd,
      sub_self]
  refine ⟨_, he, ?_⟩
  have hsum : innerLineCochain ρ z.val u' = innerLineCochain ρ z.val u +
      cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
        (modelHomOf ρ psiEdge psiEdge_smul u' - modelHomOf ρ psiEdge psiEdge_smul u) := by
    apply (signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1).injective
    rw [map_add, cornerCochain_coords]
    have h1 : ∀ v, signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
        (innerLineCochain ρ z.val v) =
        (modelHomOf ρ psiEdge psiEdge_smul v, (modelHomOf ρ psiLine psiLine_smul z.val, 0)) :=
      fun v => LinearEquiv.apply_symm_apply _ _
    rw [h1, h1]
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · exact (add_sub_cancel _ _).symm
    · change _ = _ + 0
      rw [add_zero]
    · change (0 : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ coeffRep ρ) = 0 + 0
      rw [add_zero]
  have hcz := innerLineCochain_cocycle ρ z u hu
  have hcz' := innerLineCochain_cocycle ρ z u' hu'
  have hcc := cornerCochain_cocycle ρ _ he
  unfold innerLineCone cornerClass
  refine (cls2_congr _ _ (by rw [← hsum]; exact hcz') hsum).trans ?_
  exact cls2_add _ _ _ hcz hcc _

omit [Module ℚ V] [IsScalarTower ℚ ℂ V] in
theorem shift_witness_line (z : cocycles N6 (functionRepresentation ρ (Flags .line)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (w : cochains N6 (functionRepresentation ρ (Flags .line)) 1) (x e) :
    (z + boundaryMap N6 (functionRepresentation ρ (Flags .line)) w).val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) (u + edgePull ρ .line w)).1 x e := by
  rw [map_add]
  change z.val.1 x (endpoint .line e) +
    (differentialOne N6 (functionRepresentation ρ (Flags .line)) w).1 x (endpoint .line e) = _
  rw [hu x e]
  rfl

omit [Module ℚ V] [IsScalarTower ℚ ℂ V] in
theorem shift_witness_plane (z : cocycles N6 (functionRepresentation ρ (Flags .plane)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (w : cochains N6 (functionRepresentation ρ (Flags .plane)) 1) (x e) :
    (z + boundaryMap N6 (functionRepresentation ρ (Flags .plane)) w).val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) (u + edgePull ρ .plane w)).1 x e := by
  rw [map_add]
  change z.val.1 x (endpoint .plane e) +
    (differentialOne N6 (functionRepresentation ρ (Flags .plane)) w).1 x (endpoint .plane e) = _
  rw [hu x e]
  rfl

theorem cls2_add_coboundary (K : CochainComplex (ModuleCat.{0} ℚ) ℕ) (a : K.X 2)
    (ha : (K.d 2 3).hom a = 0) (b : K.X 1) (hab : (K.d 2 3).hom (a + (K.d 1 2).hom b) = 0) :
    cls2 K (a + (K.d 1 2).hom b) hab = cls2 K a ha := by
  have hb : (K.d 2 3).hom ((K.d 1 2).hom b) = 0 := by
    exact LinearMap.congr_fun (ModuleCat.hom_ext_iff.1 (K.d_comp_d 1 2 3)) b
  rw [cls2_add K a _ ha hb hab, (cls2_eq_zero_iff K _ hb).2 ⟨b, rfl⟩, add_zero]

theorem innerLineCochain_shift (z : cocycles N6 (functionRepresentation ρ (Flags .line)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (w : cochains N6 (functionRepresentation ρ (Flags .line)) 1) :
    ∃ c : coneR.X 1 ⟶ coeffRep ρ,
      innerLineCochain ρ (z + boundaryMap N6 (functionRepresentation ρ (Flags .line)) w).val
        (u + edgePull ρ .line w) = innerLineCochain ρ z.val u + coneR.d 2 1 ≫ c := by
  refine ⟨(signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0).symm
      (0, (modelHomOf ρ psiLine psiLine_smul w, 0)), ?_⟩
  have hc : signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0
      ((signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0).symm
        (0, (modelHomOf ρ psiLine psiLine_smul w, 0))) =
      (0, (modelHomOf ρ psiLine psiLine_smul w, 0)) := LinearEquiv.apply_symm_apply _ _
  apply (signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1).injective
  rw [map_add, cone_coboundary_coordinates, hc]
  have h1 : ∀ (z' : cochains N6 (functionRepresentation ρ (Flags .line)) 2) v,
      signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
      (innerLineCochain ρ z' v) =
      (modelHomOf ρ psiEdge psiEdge_smul v, (modelHomOf ρ psiLine psiLine_smul z', 0)) :=
    fun z' v => LinearEquiv.apply_symm_apply _ _
  rw [h1, h1]
  have e1 : modelHomOf ρ psiEdge psiEdge_smul (u + edgePull ρ .line w) =
      modelHomOf ρ psiEdge psiEdge_smul u +
        flagLineHom.hom.f 1 ≫ modelHomOf ρ psiLine psiLine_smul w := by
    rw [modelHomOf_add, flagLine_comp_modelHomOf_one]
  have e2 : modelHomOf ρ psiLine psiLine_smul (z.val + differentialOne N6 _ w) =
      modelHomOf ρ psiLine psiLine_smul z.val +
        (prodComplex Γ6 RationalGL3 Line).d 2 1 ≫ modelHomOf ρ psiLine psiLine_smul w := by
    rw [modelHomOf_add, modelHomOf_differentialOne']
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · refine e1.trans ?_
    simp only [comp_zero, neg_zero, zero_add, sub_zero]
    rfl
  · exact e2.trans (by simp only [comp_zero]; rfl)
  · change (0 : (prodComplex Γ6 RationalGL3 Plane).X 2 ⟶ coeffRep ρ) =
      0 + (prodComplex Γ6 RationalGL3 Plane).d 2 1 ≫
        (0 : (prodComplex Γ6 RationalGL3 Plane).X 1 ⟶ coeffRep ρ)
    rw [comp_zero, zero_add]

/-- Adding a cone coboundary does not change the class. -/
theorem cls2_add_cone_coboundary {C : ChainComplex (Rep.{0} ℚ Γ6) ℕ} {W : Rep.{0} ℚ Γ6}
    (a : C.X 2 ⟶ W) (ha : C.d 3 2 ≫ a = 0) (c : C.X 1 ⟶ W)
    (hac : C.d 3 2 ≫ (a + C.d 2 1 ≫ c) = 0) :
    cls2 (homCochains C W) (a + C.d 2 1 ≫ c) hac = cls2 (homCochains C W) a ha := by
  have hb : C.d 3 2 ≫ (C.d 2 1 ≫ c) = 0 := by
    rw [← Category.assoc, C.d_comp_d, zero_comp]
  have h1 : cls2 (homCochains C W) (C.d 2 1 ≫ c) hb = 0 :=
    (cls2_eq_zero_iff _ _ hb).2 ⟨c, rfl⟩
  have h2 := cls2_add (homCochains C W) a (C.d 2 1 ≫ c) ha hb hac
  exact h2.trans (by rw [h1, add_zero])

/-- **Independence of the representative**: shifting `z` by a coboundary and `u` by its pullback does not
change the class of the lift. -/
theorem innerLineCone_shift (z : cocycles N6 (functionRepresentation ρ (Flags .line)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (w : cochains N6 (functionRepresentation ρ (Flags .line)) 1) :
    innerLineCone ρ (z + boundaryMap N6 (functionRepresentation ρ (Flags .line)) w)
      (u + edgePull ρ .line w) (shift_witness_line ρ z u hu w) = innerLineCone ρ z u hu := by
  obtain ⟨c, hsum⟩ := innerLineCochain_shift ρ z u w
  have hcz := innerLineCochain_cocycle ρ z u hu
  have hcz' := innerLineCochain_cocycle ρ (z + boundaryMap N6 _ w) (u + edgePull ρ .line w)
    (shift_witness_line ρ z u hu w)
  have hac : coneR.d 3 2 ≫ (innerLineCochain ρ z.val u + coneR.d 2 1 ≫ c) = 0 := by
    rw [← hsum]
    exact hcz'
  unfold innerLineCone
  exact (cls2_congr (homCochains coneR (coeffRep ρ)) _ hac hsum).trans
    (cls2_add_cone_coboundary _ hcz c hac)

/-- **Change of edge primitive** for plane lifts. -/
theorem innerPlaneCone_edge_change (z : cocycles N6 (functionRepresentation ρ (Flags .plane)))
    (u u' : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (hu' : ∀ x e, z.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u').1 x e) :
    ∃ (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
      (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0),
      innerPlaneCone ρ z u' hu' = innerPlaneCone ρ z u hu + cornerClass ρ e he := by
  have hd : differentialOne N6 (functionRepresentation ρ Edges) u' =
      differentialOne N6 (functionRepresentation ρ Edges) u := by
    apply Subtype.ext
    funext x e
    exact (hu' x e).symm.trans (hu x e)
  have he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫
      (modelHomOf ρ psiEdge psiEdge_smul u - modelHomOf ρ psiEdge psiEdge_smul u') = 0 := by
    rw [Preadditive.comp_sub, ← modelHomOf_differentialOne', ← modelHomOf_differentialOne', hd,
      sub_self]
  refine ⟨_, he, ?_⟩
  have hsum : innerPlaneCochain ρ z.val u' = innerPlaneCochain ρ z.val u +
      cornerCochain flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
        (modelHomOf ρ psiEdge psiEdge_smul u - modelHomOf ρ psiEdge psiEdge_smul u') := by
    apply (signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1).injective
    rw [map_add, cornerCochain_coords]
    have h1 : ∀ v, signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
        (innerPlaneCochain ρ z.val v) =
        (-modelHomOf ρ psiEdge psiEdge_smul v, (0, modelHomOf ρ psiPlane psiPlane_smul z.val)) :=
      fun v => LinearEquiv.apply_symm_apply _ _
    rw [h1, h1]
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · change -modelHomOf ρ psiEdge psiEdge_smul u' = -modelHomOf ρ psiEdge psiEdge_smul u +
        (modelHomOf ρ psiEdge psiEdge_smul u - modelHomOf ρ psiEdge psiEdge_smul u')
      abel
    · change (0 : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ coeffRep ρ) = 0 + 0
      rw [add_zero]
    · change _ = _ + 0
      rw [add_zero]
  have hcz := innerPlaneCochain_cocycle ρ z u hu
  have hcz' := innerPlaneCochain_cocycle ρ z u' hu'
  have hcc := cornerCochain_cocycle ρ _ he
  unfold innerPlaneCone cornerClass
  refine (cls2_congr _ _ (by rw [← hsum]; exact hcz') hsum).trans ?_
  exact cls2_add _ _ _ hcz hcc _

theorem innerPlaneCochain_shift (z : cocycles N6 (functionRepresentation ρ (Flags .plane)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (w : cochains N6 (functionRepresentation ρ (Flags .plane)) 1) :
    ∃ c : coneR.X 1 ⟶ coeffRep ρ,
      innerPlaneCochain ρ (z + boundaryMap N6 (functionRepresentation ρ (Flags .plane)) w).val
        (u + edgePull ρ .plane w) = innerPlaneCochain ρ z.val u + coneR.d 2 1 ≫ c := by
  refine ⟨(signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0).symm
      (0, (0, modelHomOf ρ psiPlane psiPlane_smul w)), ?_⟩
  have hc : signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0
      ((signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 0).symm
        (0, (0, modelHomOf ρ psiPlane psiPlane_smul w))) =
      (0, (0, modelHomOf ρ psiPlane psiPlane_smul w)) := LinearEquiv.apply_symm_apply _ _
  apply (signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1).injective
  rw [map_add, cone_coboundary_coordinates, hc]
  have h1 : ∀ (z' : cochains N6 (functionRepresentation ρ (Flags .plane)) 2) v,
      signedConeHomSucc flagLineHom.hom flagPlaneHom.hom (coeffRep ρ) 1
      (innerPlaneCochain ρ z' v) =
      (-modelHomOf ρ psiEdge psiEdge_smul v, (0, modelHomOf ρ psiPlane psiPlane_smul z')) :=
    fun z' v => LinearEquiv.apply_symm_apply _ _
  rw [h1, h1]
  have e1 : modelHomOf ρ psiEdge psiEdge_smul (u + edgePull ρ .plane w) =
      modelHomOf ρ psiEdge psiEdge_smul u +
        flagPlaneHom.hom.f 1 ≫ modelHomOf ρ psiPlane psiPlane_smul w := by
    rw [modelHomOf_add, flagPlane_comp_modelHomOf_one]
  have e2 : modelHomOf ρ psiPlane psiPlane_smul (z.val + differentialOne N6 _ w) =
      modelHomOf ρ psiPlane psiPlane_smul z.val +
        (prodComplex Γ6 RationalGL3 Plane).d 2 1 ≫ modelHomOf ρ psiPlane psiPlane_smul w := by
    rw [modelHomOf_add, modelHomOf_differentialOne']
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · change -modelHomOf ρ psiEdge psiEdge_smul (u + edgePull ρ .plane w) =
      -modelHomOf ρ psiEdge psiEdge_smul u + (-((prodComplex Γ6 RationalGL3 Flag).d 1 0 ≫ 0) +
        flagLineHom.hom.f 1 ≫ (0 : (prodComplex Γ6 RationalGL3 Line).X 1 ⟶ coeffRep ρ) -
        flagPlaneHom.hom.f 1 ≫ modelHomOf ρ psiPlane psiPlane_smul w)
    rw [e1]
    simp only [comp_zero, neg_zero, zero_add, neg_add_rev]
    abel
  · change (0 : (prodComplex Γ6 RationalGL3 Line).X 2 ⟶ coeffRep ρ) =
      0 + (prodComplex Γ6 RationalGL3 Line).d 2 1 ≫
        (0 : (prodComplex Γ6 RationalGL3 Line).X 1 ⟶ coeffRep ρ)
    rw [comp_zero, zero_add]
  · exact e2.trans (by simp only [comp_zero]; rfl)

/-- **Independence of the representative** for plane lifts. -/
theorem innerPlaneCone_shift (z : cocycles N6 (functionRepresentation ρ (Flags .plane)))
    (u : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (w : cochains N6 (functionRepresentation ρ (Flags .plane)) 1) :
    innerPlaneCone ρ (z + boundaryMap N6 (functionRepresentation ρ (Flags .plane)) w)
      (u + edgePull ρ .plane w) (shift_witness_plane ρ z u hu w) = innerPlaneCone ρ z u hu := by
  obtain ⟨c, hsum⟩ := innerPlaneCochain_shift ρ z u w
  have hcz := innerPlaneCochain_cocycle ρ z u hu
  have hcz' := innerPlaneCochain_cocycle ρ (z + boundaryMap N6 _ w) (u + edgePull ρ .plane w)
    (shift_witness_plane ρ z u hu w)
  have hac : coneR.d 3 2 ≫ (innerPlaneCochain ρ z.val u + coneR.d 2 1 ≫ c) = 0 := by
    rw [← hsum]
    exact hcz'
  unfold innerPlaneCone
  exact (cls2_congr (homCochains coneR (coeffRep ρ)) _ hac hsum).trans
    (cls2_add_cone_coboundary _ hcz c hac)

/-- **The lift of an inner line class is canonical modulo corner classes**: two lifts of the same class of
`H²(N6, Fun(Flags, ρ))` (any representatives, any edge primitives) differ by the class of a corner cocycle,
which restricts to zero on the line and plane faces (`cornerClass_line`, `cornerClass_plane`). -/
theorem innerLineCone_unique_mod_corner (z z' : cocycles N6 (functionRepresentation ρ (Flags .line)))
    (u u' : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (hu' : ∀ x e, z'.val.1 x (endpoint .line e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u').1 x e)
    (hz : classOf N6 (functionRepresentation ρ (Flags .line)) z =
      classOf N6 (functionRepresentation ρ (Flags .line)) z') :
    ∃ (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
      (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0),
      innerLineCone ρ z' u' hu' = innerLineCone ρ z u hu + cornerClass ρ e he := by
  have hmem : z' - z ∈ LinearMap.range (boundaryMap N6 (functionRepresentation ρ (Flags .line))) :=
    (Submodule.Quotient.eq _).1 hz.symm
  obtain ⟨w, hw⟩ := hmem
  have hz' : z' = z + boundaryMap N6 (functionRepresentation ρ (Flags .line)) w := by
    rw [hw]; abel
  subst hz'
  obtain ⟨e, he, h⟩ := innerLineCone_edge_change ρ
    (z + boundaryMap N6 (functionRepresentation ρ (Flags .line)) w) (u + edgePull ρ .line w) u'
    (shift_witness_line ρ z u hu w) hu'
  exact ⟨e, he, by rw [h, innerLineCone_shift]⟩

/-- The plane analogue of `innerLineCone_unique_mod_corner`. -/
theorem innerPlaneCone_unique_mod_corner (z z' : cocycles N6 (functionRepresentation ρ (Flags .plane)))
    (u u' : cochains N6 (functionRepresentation ρ Edges) 1)
    (hu : ∀ x e, z.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u).1 x e)
    (hu' : ∀ x e, z'.val.1 x (endpoint .plane e) =
      (differentialOne N6 (functionRepresentation ρ Edges) u').1 x e)
    (hz : classOf N6 (functionRepresentation ρ (Flags .plane)) z =
      classOf N6 (functionRepresentation ρ (Flags .plane)) z') :
    ∃ (e : (prodComplex Γ6 RationalGL3 Flag).X 1 ⟶ coeffRep ρ)
      (he : (prodComplex Γ6 RationalGL3 Flag).d 2 1 ≫ e = 0),
      innerPlaneCone ρ z' u' hu' = innerPlaneCone ρ z u hu + cornerClass ρ e he := by
  have hmem : z' - z ∈ LinearMap.range (boundaryMap N6 (functionRepresentation ρ (Flags .plane))) :=
    (Submodule.Quotient.eq _).1 hz.symm
  obtain ⟨w, hw⟩ := hmem
  have hz' : z' = z + boundaryMap N6 (functionRepresentation ρ (Flags .plane)) w := by
    rw [hw]; abel
  subst hz'
  obtain ⟨e, he, h⟩ := innerPlaneCone_edge_change ρ
    (z + boundaryMap N6 (functionRepresentation ρ (Flags .plane)) w) (u + edgePull ρ .plane w) u'
    (shift_witness_plane ρ z u hu w) hu'
  exact ⟨e, he, by rw [h, innerPlaneCone_shift]⟩

end TernaryPeriodPolynomials.Argument.FacePairingFull.Comparison
