module

public import TernaryPeriodPolynomials.BoundaryComparison.SeedClasses.Descent.FStar
public import TernaryPeriodPolynomials.BoundaryComparison.SeedClasses.ReflectionForm

@[expose] public section


/-!
# The finite reflection projection of the seeds (Lemma C.3, S4c)

Paper: Lemma C.3 (`ar:lem:seed`),: "At the neat integral stabilizer, `t = δ = 1`, and the modular transformation law
proves equivariance. The finite reflection projection supplies the corresponding full-level
statement."

The full-level plane group `Λ₀ = ℤ² ⋊ GL₂(ℤ)` is generated by `Λ₀⁺ = ℤ² ⋊ SL₂(ℤ)`, which acts on the
face holomorphically, and the reflection `r = diag(-1, 1, 1)` (`SeedC3.reflFCLM`), which acts
antiholomorphically with `r^* ω_h = (-1)^{n+1} ρ(r) \overline{ω_{h^*}}` and
`r^* \overline{ω_{h^*}} = (-1)^{n+1} ρ(r) ω_h` (`SeedC3.pullForm_refl_seed`,
`SeedC3.pullForm_refl_conjSeed`), `h^*(z) = \overline{h(-\bar z)}`, which is the cusp form `fStar f`
(`FStar.lean`). The projection onto the `ε`-isotypic part of the reflection (`ε = ±1`) is
`P_ε ω_f = ½ (ω_f + ε (-1)^{n+1} \overline{ω_{f^*}})`:

* `reflSeedInv D hΛ f ε` is a closed `ρ`-equivariant form for `Λ₀⁺`, and
  `pullForm_refl_reflSeed`: `r^*` acts on it by `ε ρ(r)`, i.e. it is equivariant for the whole of
  `Λ₀` with the coefficients `Sym^n ⊗ det⁻¹` twisted by `ε^{[det = -1]}`; `ε = +1` is the untwisted
  coefficient system `E_n` of the library;
* `deRhamClass_reflSeedInv`: its de Rham class is `[ω_f] + ε (-1)^{n+1} [\overline{ω_{f^*}}]`;
* `edge_reflSeed`: its Hochschild--Serre edge in the binary coordinates is
  `(n+1)⁻¹ ((-1)^{n+1} [c_f] - ε [R c_f])`, a parity projection of the library's period class
  `[c_f]` (`R` the parity reflection `modularCocycleReflection`); for `n` odd, `ε = 1` it is the
  odd part `(n+1)⁻¹ ([c_f] - [R c_f])`, as for the period of a level-one cusp form of even weight
  `n + 3`.

Formalized by Claude Sonnet 5.5.
-/

open UpperHalfPlane ModularForm ComplexConjugate
open TernaryPoly.SmoothLocalDeRham CategoryTheory
open TernaryPeriodPolynomials.SphericalDetection.Helpers

noncomputable section

namespace TernaryPeriodPolynomials.Argument.SeedC3S4c

open TernaryPeriodPolynomials.Argument.SeedC3

section

variable {G : Type} [Group G] (D : PlaneData G) (hΛ : ∀ g, (D.lam g : GL (Fin 2) ℝ) ∈ Lvl1)
  {n : ℕ} (f : CuspForm Lvl1 ((n + 3 : ℕ) : ℤ))

/-- The `ε`-twisted combination `ω_f + ε (-1)^{n+1} \overline{ω_{f^*}}` of the seed of `f` and the
antiholomorphic seed of `f^*`, a closed `ρ`-equivariant two-form for the plane group `Λ₀⁺`. -/
def reflSeedInv (ε : ℝ) : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n) :=
  cuspSeedInv D hΛ (f := f) + (ε * (-1 : ℝ) ^ (n + 1)) • cuspSeedConjInv D hΛ (f := fStar f)

/-- The reflection acts on the combination `ω_f + ε (-1)^{n+1} \overline{ω_{f^*}}` by `ε ρ(r)`
(`ε = ±1`): the `ε`-isotypic part of the seed for the full level group `Λ₀⁺ ⋊ ⟨r⟩`. -/
theorem pullForm_refl_reflSeed {ε : ℝ} (hε : ε * ε = 1) :
    ZigZag.pullForm isOpen_faceSet reflAction reflGen 2
        ((reflSeedInv D hΛ f ε : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) :
          Form (F := Coef n) faceSet 2) =
      ε • ZigZag.twForm (reflCoefCLM n) 2
        ((reflSeedInv D hΛ f ε : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) :
          Form (F := Coef n) faceSet 2) := by
  have hrel : ∀ z : ℂ, 0 < z.im → cuspH Lvl1 n (fStar f) z = conj (cuspH Lvl1 n f (-conj z)) :=
    fun z hz => fStar_cuspH f hz
  have h1 := pullForm_refl_seed n (cuspH Lvl1 n f) (cuspH Lvl1 n (fStar f))
    (cuspH_holo Lvl1 n f) (cuspH_holo Lvl1 n (fStar f)) hrel
  have h2 := pullForm_refl_conjSeed n (cuspH Lvl1 n f) (cuspH Lvl1 n (fStar f))
    (cuspH_holo Lvl1 n f) (cuspH_holo Lvl1 n (fStar f)) hrel
  have hcc : ((-1 : ℝ) ^ (n + 1)) * ((-1 : ℝ) ^ (n + 1)) = 1 := by
    rw [← mul_pow]; norm_num
  change ZigZag.pullForm isOpen_faceSet reflAction reflGen 2
      (d isOpen_faceSet 1 (Psi.etaForm (cuspH Lvl1 n f) (cuspH_holo Lvl1 n f) n) +
        (ε * (-1 : ℝ) ^ (n + 1)) • ZigZag.twForm (conjCLM n) 2
          (d isOpen_faceSet 1 (Psi.etaForm (cuspH Lvl1 n (fStar f))
            (cuspH_holo Lvl1 n (fStar f)) n))) = _
  have hR : ((reflSeedInv D hΛ f ε : ZigZag.invClosed isOpen_faceSet D.action (D.rhoR n)) :
      Form (F := Coef n) faceSet 2) =
      d isOpen_faceSet 1 (Psi.etaForm (cuspH Lvl1 n f) (cuspH_holo Lvl1 n f) n) +
        (ε * (-1 : ℝ) ^ (n + 1)) • ZigZag.twForm (conjCLM n) 2
          (d isOpen_faceSet 1 (Psi.etaForm (cuspH Lvl1 n (fStar f))
            (cuspH_holo Lvl1 n (fStar f)) n)) := rfl
  rw [hR, map_add, map_smul, h1, h2, ZigZag.twForm_mul]
  simp only [map_add, map_smul, smul_add, smul_smul]
  have e1 : ε * (-1 : ℝ) ^ (n + 1) * (-1 : ℝ) ^ (n + 1) = ε := by rw [mul_assoc, hcc, mul_one]
  have e2 : ε * (ε * (-1 : ℝ) ^ (n + 1)) = (-1 : ℝ) ^ (n + 1) := by
    rw [← mul_assoc, hε, one_mul]
  rw [e1, e2, add_comm]

/-- The de Rham class of the `ε`-combination is the corresponding combination of the classes. -/
theorem deRhamClass_reflSeedInv (ε : ℝ) :
    ZigZag.deRhamClass isOpen_faceSet convex_faceSet faceSet_nonempty D.action (D.rhoR n)
        (reflSeedInv D hΛ f ε) =
      cuspSeedClass D hΛ (f := f) +
        (ε * (-1 : ℝ) ^ (n + 1)) • cuspSeedConjClass D hΛ (f := fStar f) := by
  unfold reflSeedInv
  rw [map_add, map_smul, deRhamClass_cuspSeed, deRhamClass_cuspSeedConj]

end

section Edge

theorem comb_lemma {V : Type*} [AddCommGroup V] [Module ℂ V] (x y : V) (κ s ε : ℂ)
    (hs : s * s = 1) :
    (κ * s) • x + (ε * s) • (-(κ * s)) • y = κ • (s • x - ε • y) := by
  have e : ε * s * -(κ * s) = -(κ * ε) := by linear_combination (-(κ * ε)) * hs
  rw [smul_smul, e, smul_sub, smul_smul, smul_smul, sub_eq_add_neg]
  congr 1
  exact neg_smul _ _

variable {n : ℕ} (f : CuspForm Lvl1 ((n + 3 : ℕ) : ℤ))

/-- The class of the library's holomorphic period cocycle of `f`. -/
def periodClass (hw : ((n + 3 : ℕ) : ℤ) = ((n + 1 : ℕ) : ℤ) + 2) :
    groupCohomology.H1 (modularBinaryRep (n + 1) (-1)) :=
  groupCohomology.H1π (modularBinaryRep (n + 1) (-1)) (classicalBinaryCocycle f (n + 1) hw (-1))

/-- The class of its parity reflection. -/
def periodClassRefl (hw : ((n + 3 : ℕ) : ℤ) = ((n + 1 : ℕ) : ℤ) + 2) :
    groupCohomology.H1 (modularBinaryRep (n + 1) (-1)) :=
  groupCohomology.H1π (modularBinaryRep (n + 1) (-1))
    (modularCocycleReflection (n + 1) (-1) (classicalBinaryCocycle f (n + 1) hw (-1)))

/-- **The edge of the `ε`-isotypic seed.** In the binary coordinates of
`H¹(SL₂(ℤ), Sym^{n+1} ⊗ det⁻¹)` the edge of the relative cocycle of
`ω_f + ε (-1)^{n+1} \overline{ω_{f^*}}` is `(n+1)⁻¹ ((-1)^{n+1} [c_f] - ε [R c_f])`, `c_f` the
library's holomorphic period cocycle and `R` its parity reflection. For `n` odd, `ε = 1` this is
the odd part `(n+1)⁻¹ ([c_f] - [R c_f])`. -/
theorem edge_reflSeed (ε : ℝ) (hw : ((n + 3 : ℕ) : ℤ) = ((n + 1 : ℕ) : ℤ) + 2) :
    (plusLeviCohomologyIso n).hom (plusEdgeS n
        (relativeTwoCocycleClass plusExtensionS.inl (plusRep n)
          (seedRelCocycle f + (((ε * (-1 : ℝ) ^ (n + 1) : ℝ) : ℂ)) •
            seedConjRelCocycle (fStar f)))) =
      (((n : ℂ) + 1)⁻¹) • (((-1 : ℂ) ^ (n + 1)) • periodClass f hw -
        (ε : ℂ) • periodClassRefl f hw) := by
  rw [map_add, map_smul, map_add, map_smul, map_add, map_smul]
  rw [seedEdge f hw, seedConjEdge_fStar f hw]
  have hs : ((-1 : ℂ) ^ (n + 1)) * ((-1 : ℂ) ^ (n + 1)) = 1 := by
    rw [← mul_pow]; norm_num
  have key := comb_lemma (periodClass f hw) (periodClassRefl f hw) (((n : ℂ) + 1)⁻¹)
    ((-1 : ℂ) ^ (n + 1)) (ε : ℂ) hs
  push_cast
  exact key

/-- **Complexification of the `ε`-isotypic seed class.** -/
theorem complexify_reflSeed (ε : ℝ) :
    complexify n (ZigZag.deRhamClass isOpen_faceSet convex_faceSet faceSet_nonempty
        plusPlaneData.action (plusPlaneData.rhoR n) (reflSeedInv plusPlaneData plus_hΛ f ε)) =
      (relativeTwoCocycleClass plusExtensionS.inl (plusRep n)
        (seedRelCocycle f + (((ε * (-1 : ℝ) ^ (n + 1) : ℝ) : ℂ)) •
          seedConjRelCocycle (fStar f))).val := by
  have h1 := deRhamClass_reflSeedInv plusPlaneData plus_hΛ f ε
  have h2 := complexify_cuspSeedClass f
  have h3 := complexify_cuspSeedConjClass (fStar f)
  have h4 := (complexify n).map_add (cuspSeedClass plusPlaneData plus_hΛ (f := f))
    ((ε * (-1 : ℝ) ^ (n + 1)) • cuspSeedConjClass plusPlaneData plus_hΛ (f := fStar f))
  have h5 := (complexify n).map_smul (ε * (-1 : ℝ) ^ (n + 1))
    (cuspSeedConjClass plusPlaneData plus_hΛ (f := fStar f))
  refine (congrArg (complexify n) h1).trans (h4.trans
    ((congrArg (fun z => complexify n (cuspSeedClass plusPlaneData plus_hΛ (f := f)) + z) h5).trans
    ((congrArg₂ (fun a b => a + (ε * (-1 : ℝ) ^ (n + 1)) • b) h2 h3).trans ?_)))
  have h6 := (relativeTwoCocycleClass plusExtensionS.inl (plusRep n)).map_add
    (seedRelCocycle f) ((((ε * (-1 : ℝ) ^ (n + 1) : ℝ) : ℂ)) • seedConjRelCocycle (fStar f))
  have h7 := (relativeTwoCocycleClass plusExtensionS.inl (plusRep n)).map_smul
    (((ε * (-1 : ℝ) ^ (n + 1) : ℝ) : ℂ)) (seedConjRelCocycle (fStar f))
  refine Eq.trans ?_ (congrArg Subtype.val (h6.trans (congrArg
    (fun z => relativeTwoCocycleClass plusExtensionS.inl (plusRep n) (seedRelCocycle f) + z) h7))).symm
  rw [Submodule.coe_add, Submodule.coe_smul]
  exact congrArg _ (Complex.coe_smul _ _).symm

end Edge

end TernaryPeriodPolynomials.Argument.SeedC3S4c
