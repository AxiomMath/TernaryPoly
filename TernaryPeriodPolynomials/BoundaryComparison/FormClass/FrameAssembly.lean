module

public import TernaryPeriodPolynomials.BoundaryComparison.FormClass.DualFlags
public import TernaryPeriodPolynomials.BoundaryComparison.FormClass.Gamma.NPlaneValues
public import TernaryPeriodPolynomials.ArithmeticCohomology.CongruenceLevel.Stokes.Frame

@[expose] public section


/-!
# Assembling the `GammaNC5FaceObligations` from a `BoundaryFrame` on the dual types of the Eisenstein classes

Formalized by Claude Sonnet 5.5.
Paper: Proposition `ar:prop:C5` at level `Γ(N)`, with Lemma `ar:lem:stokes`.

`faceObligations_of_frame`: for `3 ≤ N`, `4 ≤ n`, the types `QDi N n` (dual mixed cuspidal groups of the line faces), `PDmod N n` (dual plane groups) and `Hd` (the module
generated by the dual series, all of whose elements have zero flag restrictions: `Hd_zeroFlags`), and any `BoundaryFrame` on these types whose dual restrictions `rPd`, `rQd` are
`dualRP`, `dualRQ`, together with the perfectness of the per-face pairings, give `GammaNC5FaceObligations`.  The fields `T`, `eisensteinP` come from `eisensteinP_gammaN`
(a linear section; not canonical) and `Td`, `dualEisenstein` from `dualEisenstein_gammaN`.
-/

open scoped MatrixGroups DirectSum
open TernaryPeriodPolynomials.Argument.GammaNFacesFull TernaryPeriodPolynomials.Argument.GammaNFaces
open TernaryPeriodPolynomials.Argument.GammaNStokes

noncomputable section
namespace TernaryPeriodPolynomials.Argument.FormClassK

variable (N : ℕ) [NeZero N] (n : ℕ)

/-- **`GammaNC5FaceObligations` from a boundary frame on the Eisenstein dual types.** -/
def faceObligations_of_frame (hN : 3 ≤ N) (hn : 4 ≤ n)
    (F : BoundaryFrame N n (QDi N n) (PDmod N n) (Hd (N := N) (n := n) hn))
    (hP : F.rPd = dualRP hn) (hQ : F.rQd = dualRQ hN hn)
    (perfectQface : ∀ (i : LineFaces N) (a : lineFaceCuspidal N i.rep n),
      (∀ b, F.pairQface i a b = 0) → a = 0) :
    GammaNC5FaceObligations N n (QDi N n) (PDmod N n) (Hd (N := N) (n := n) hn) :=
  F.toFaceObligations (eisensteinP_gammaN N n hN hn).choose (eisensteinP_gammaN N n hN hn).choose_spec
    (dualEisenstein_gammaN (N := N) (n := n) hN hn).choose
    (fun η => by
      obtain ⟨c', h1, h2⟩ := (dualEisenstein_gammaN (N := N) (n := n) hN hn).choose_spec η
      exact ⟨c', by rw [hQ]; exact h1, by rw [hP]; exact h2⟩)
    perfectQface

end TernaryPeriodPolynomials.Argument.FormClassK
