module

public import TernaryPeriodPolynomials.EisensteinSeries.Dual.Values
public import TernaryPeriodPolynomials.BoundaryComparison.FormClass.Gamma.NLinear
public import TernaryPeriodPolynomials.BoundaryComparison.FormClass.CellOrbit

@[expose] public section


/-!
# `dualEisenstein` at level `Γ(N)`, instantiated with the dual values

Formalized by Claude Sonnet 5.5.
* `no_dual_cell_of_ne`: different line faces have no cell for `ȷ(rep j) ȷ(rep i)⁻¹` (orbit bookkeeping through `ȷ`: `jmath_mem_lineBorel_iff`).
* `DualTuple`, `dualE`, `dualS`, `dualS_surjective`, `Hd`, `dualRQ`, `dualRP`: tuples of cusp forms indexed by the line faces, the dual series class, the dual seed vector in `⨁ 𝒞_Q(E^∨)`
  (surjective by Eichler-Shimura spanning), the module `Hd` generated by the dual series, and the line and plane restrictions.
* `dualRQ_dualEH`: `r_Q ℰ_Q^∨ = η` at every line face (the `dualCuspValues`, `self_hol/self_conj` for the same face, `none` for different faces).
* **`dualEisenstein_gammaN`**: the `dualEisenstein` field of the `GammaNC5FaceObligations` for these types (`Hd` = classes generated by the dual series, `QDi i = 𝒞_Q(E^∨)`,
  `PD` = plane groups of the plane faces), by `dualEisenstein_of_section`.  Not provided: the Stokes field for `Hd` (admissibility: the dual classes have zero flag restrictions, the `FlagReal`)
  and the perfect pairing; the choice of `Hd`, `PD` should be aligned with the `BoundaryFrame`.
-/

open scoped MatrixGroups DirectSum
open TernaryPeriodPolynomials.Argument.GammaNFacesFull TernaryPeriodPolynomials.Argument.GammaNFaces
open TernaryPeriodPolynomials.Argument.SeedC3S4c
open TernaryPeriodPolynomials.Argument.EisensteinClass TernaryPeriodPolynomials.Argument.SeedC3 TernaryPeriodPolynomials.Argument.ConvergenceC4
open TernaryPeriodPolynomials.Argument.EisensteinDual

noncomputable section
namespace TernaryPeriodPolynomials.Argument.FormClassK

theorem rt_mem_lineBorel_iff {A : SL(3, ℤ)} : rtSL A ∈ lineBorel ↔ A ∈ planeBorel := by
  constructor
  · rintro ⟨h0, h1⟩
    exact ⟨by simpa [coe_rtSL, rt, Fin.rev] using h1, by simpa [coe_rtSL, rt, Fin.rev] using h0⟩
  · rintro ⟨h0, h1⟩
    exact ⟨by simpa [coe_rtSL, rt, Fin.rev] using h1, by simpa [coe_rtSL, rt, Fin.rev] using h0⟩

theorem jmath_mem_lineBorel_iff {A : SL(3, ℤ)} : jmath A ∈ lineBorel ↔ A ∈ planeBorel := by
  unfold jmath
  rw [inv_mem_iff, rt_mem_lineBorel_iff]

variable (N : ℕ) [NeZero N] (n : ℕ)

open scoped Classical

omit [NeZero N] in
/-- **Different line faces: no dual cell.**  For line faces `j ≠ i` the plane cusps `ȷ(rep j)`, `ȷ(rep i)` are in different `Γ(N)`-orbits, so there is no cell
(`IsCellK`) for `ȷ(rep j) ȷ(rep i)⁻¹`: S4's `dualClassC_none` applies. -/
theorem no_dual_cell_of_ne {i j : LineFaces N} (hji : j ≠ i) :
    ∀ c : Ck N (jmath j.rep * (jmath i.rep)⁻¹), ¬ IsCellK N (jmath j.rep * (jmath i.rep)⁻¹) c := by
  intro c hc
  obtain ⟨q, hq, γ, hγ, hrel⟩ := (cell_exists_iff N (jmath i.rep) (jmath j.rep)).1 ⟨c, hc⟩
  apply hji
  have h1 : j.rep = jmath q * i.rep * jmath γ := by
    have := congrArg jmath hrel
    rwa [jmath_jmath, jmath_mul, jmath_mul, jmath_jmath] at this
  have hrel' : (lineFaceSetoid N).r i.rep j.rep :=
    ⟨jmath q, jmath_mem_lineBorel_iff.2 hq, jmath γ, jmath_mem_gammaN.2 hγ, h1⟩
  have e1 : (Quotient.mk (lineFaceSetoid N) i.rep : LineFaces N) = i := Quotient.out_eq i
  have e2 : (Quotient.mk (lineFaceSetoid N) j.rep : LineFaces N) = j := Quotient.out_eq j
  rw [← e1, ← e2]
  exact (Quotient.sound hrel').symm

/-- Tuples of cusp forms indexed by the line faces and the two seeds (twisted scalar action: conjugate on the antiholomorphic seed). -/
def DualTuple : Type := LineFaces N → Bool → CuspForm (leviGroup N) ((n + 3 : ℕ) : ℤ)

instance : AddCommGroup (DualTuple N n) :=
  inferInstanceAs (AddCommGroup (LineFaces N → Bool → CuspForm (leviGroup N) ((n + 3 : ℕ) : ℤ)))

instance : SMul ℂ (DualTuple N n) where
  smul a f := fun x b => (if b then star a else a) • f x b

instance : Module ℂ (DualTuple N n) where
  one_smul f := by
    funext x b
    change (if b then star (1 : ℂ) else (1 : ℂ)) • f x b = f x b
    cases b <;> simp
  mul_smul a c f := by
    funext x b
    change (if b then star (a * c) else a * c) • f x b = (if b then star a else a) • ((if b then star c else c) • f x b)
    cases b <;> simp [mul_smul, star_mul']
  smul_zero a := by
    funext x b
    change (if b then star a else a) • (0 : CuspForm (leviGroup N) ((n + 3 : ℕ) : ℤ)) = 0
    simp
  smul_add a f g := by
    funext x b
    change (if b then star a else a) • (f x b + g x b) =
      (if b then star a else a) • f x b + (if b then star a else a) • g x b
    rw [smul_add]
  add_smul a c f := by
    funext x b
    change (if b then star (a + c) else a + c) • f x b = (if b then star a else a) • f x b + (if b then star c else c) • f x b
    cases b <;> simp [add_smul]
  zero_smul f := by
    funext x b
    change (if b then star (0 : ℂ) else (0 : ℂ)) • f x b = 0
    cases b <;> simp

variable {N n}

/-- The dual global class of a tuple: `∑_j ∑_b ℰ_Q^∨` at the line cusp `rep j`, seed `b`. -/
def dualE (hn : 4 ≤ n) : DualTuple N n →ₗ[ℂ] groupCohomology.H2 (Rep.of (dualRhoC N n)) where
  toFun u := ∑ j : LineFaces N, ∑ b : Bool, dualClassC N n (u j b) hn b j.rep
  map_add' u v := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    exact (Finset.sum_congr rfl fun b _ => dualClassC_add N n hn b j.rep (u j b) (v j b)).trans Finset.sum_add_distrib
  map_smul' a u := by
    simp only [RingHom.id_apply]
    refine (Finset.sum_congr rfl fun j _ => ?_).trans (Finset.smul_sum).symm
    refine (Finset.sum_congr rfl fun b _ => ?_).trans (Finset.smul_sum).symm
    have h := dualClassC_smul N n hn b j.rep (if b then star a else a) (u j b)
    have hc : cx b (if b then star a else a) = a := by cases b <;> simp [cx]
    rw [hc] at h
    exact h

/-- The restriction of a dual class to the line cusp `rep i`. -/
abbrev resLine (i : LineFaces N) :=
  resToC N n (ρ := dualRhoC N n) (gammaNQAt N i.rep) (gammaNQAt_le_N N i.rep)

/-- The dual mixed cuspidal groups of the line faces. -/
abbrev QDi (N n : ℕ) [NeZero N] (i : LineFaces N) := ↥(dualCuspidalQ N n i.rep)

/-- The dual seed vector of a tuple: at the line face `i`, the dual holomorphic seed of `u i false` plus the dual antiholomorphic seed of `u i true`. -/
def dualS : DualTuple N n →ₗ[ℂ] ⨁ i : LineFaces N, QDi N n i where
  toFun u := ∑ i : LineFaces N, DirectSum.lof ℂ (LineFaces N) (fun i => QDi N n i) i
    ⟨dualSeedHolC N n (u i false) i.rep + dualSeedConjC N n (u i true) i.rep,
      (mem_dualCuspidalQ_iff_seeds N n i.rep _).2 ⟨_, _, rfl⟩⟩
  map_add' u v := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← map_add]
    refine congrArg _ (Subtype.ext ?_)
    change dualSeedHolC N n (u i false + v i false) i.rep + dualSeedConjC N n (u i true + v i true) i.rep = _
    rw [dualSeedHolC_add, dualSeedConjC_add]
    change _ = (dualSeedHolC N n (u i false) i.rep + dualSeedConjC N n (u i true) i.rep) +
      (dualSeedHolC N n (v i false) i.rep + dualSeedConjC N n (v i true) i.rep)
    abel
  map_smul' a u := by
    simp only [RingHom.id_apply]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← map_smul]
    refine congrArg _ (Subtype.ext ?_)
    change dualSeedHolC N n (a • u i false) i.rep + dualSeedConjC N n ((star a) • u i true) i.rep = _
    rw [dualSeedHolC_smul, dualSeedConjC_smul]
    have : (starRingEnd ℂ) (star a) = a := by simp
    rw [this]
    change _ = a • (dualSeedHolC N n (u i false) i.rep + dualSeedConjC N n (u i true) i.rep)
    rw [smul_add]

theorem dualS_apply (u : DualTuple N n) (i : LineFaces N) :
    (dualS u i : groupCohomology.H2 (Rep.of ((dualRhoC N n).comp (Subgroup.inclusion (gammaNQAt_le_N N i.rep))))) =
      dualSeedHolC N n (u i false) i.rep + dualSeedConjC N n (u i true) i.rep := by
  unfold dualS
  change ((∑ j : LineFaces N, DirectSum.lof ℂ (LineFaces N) (fun i => QDi N n i) j _) i : QDi N n i).1 = _
  rw [DFinsupp.finsetSum_apply, Finset.sum_eq_single i]
  · simp [DirectSum.lof_eq_of]
  · intro j _ hj
    simp [DirectSum.lof_eq_of, DirectSum.of_eq_of_ne _ _ _ (Ne.symm hj)]
  · simp

/-- **Seed surjectivity for the dual series**: every element of `⨁ 𝒞_Q(E^∨)` is a dual seed vector (Eichler-Shimura spanning). -/
theorem dualS_surjective : Function.Surjective (dualS (N := N) (n := n)) := by
  intro η
  have h1 : ∀ i : LineFaces N, ∃ f g : CuspForm (leviGroup N) ((n + 3 : ℕ) : ℤ),
      (η i : groupCohomology.H2 (Rep.of ((dualRhoC N n).comp (Subgroup.inclusion (gammaNQAt_le_N N i.rep))))) =
        dualSeedHolC N n f i.rep + dualSeedConjC N n g i.rep := fun i =>
    (mem_dualCuspidalQ_iff_seeds N n i.rep _).1 (η i).2
  choose F G hFG using h1
  refine ⟨(fun i b => if b then G i else F i : DualTuple N n), ?_⟩
  apply DFinsupp.ext
  intro i
  apply Subtype.ext
  exact (dualS_apply (N := N) (n := n) (fun i b => if b then G i else F i : DualTuple N n) i).trans (hFG i).symm

/-- The module of the admissible dual global classes generated by the dual series. -/
abbrev Hd (hn : 4 ≤ n) := LinearMap.range (dualE (N := N) (n := n) hn)

theorem resLine_mem (hN : 3 ≤ N) (hn : 4 ≤ n) (i : LineFaces N) (c : Hd (N := N) (n := n) hn) :
    resLine i c.1 ∈ dualCuspidalQ N n i.rep := by
  obtain ⟨u, hu⟩ := c.2
  rw [← hu]
  change resLine i (∑ j : LineFaces N, ∑ b : Bool, dualClassC N n (u j b) hn b j.rep) ∈ _
  rw [map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [map_sum]
  refine Submodule.sum_mem _ fun b _ => ?_
  rw [← dualSeedSpan_eq_dualCuspidalQ]
  exact dualClassC_mem N n hN hn (u j b) b i.rep j.rep

/-- The line restriction of the dual classes, as a linear map into `⨁ 𝒞_Q(E^∨)`. -/
def dualRQ (hN : 3 ≤ N) (hn : 4 ≤ n) : Hd (N := N) (n := n) hn →ₗ[ℂ] ⨁ i : LineFaces N, QDi N n i where
  toFun c := ∑ i : LineFaces N, DirectSum.lof ℂ (LineFaces N) (fun i => QDi N n i) i ⟨resLine i c.1, resLine_mem hN hn i c⟩
  map_add' c d := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← map_add]
    exact congrArg _ (Subtype.ext (map_add _ _ _))
  map_smul' a c := by
    simp only [RingHom.id_apply]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← map_smul]
    exact congrArg _ (Subtype.ext (map_smul _ _ _))

/-- The plane restriction of the dual classes, into the plane groups of the plane faces. -/
abbrev PDmod (N n : ℕ) [NeZero N] := ⨁ x : PlaneFaces N, groupCohomology.H2 (Rep.of ((dualRhoC N n).comp
  (Subgroup.inclusion (gammaNPAt_le N (planeFaceRepr x)))))

def dualRP (hn : 4 ≤ n) : Hd (N := N) (n := n) hn →ₗ[ℂ] PDmod N n :=
  ∑ x : PlaneFaces N, (DirectSum.lof ℂ (PlaneFaces N) (fun x => groupCohomology.H2 (Rep.of ((dualRhoC N n).comp
    (Subgroup.inclusion (gammaNPAt_le N (planeFaceRepr x)))))) x).comp
    ((resToC N n (ρ := dualRhoC N n) (gammaNPAt N (planeFaceRepr x)) (gammaNPAt_le N (planeFaceRepr x))).comp
      (Submodule.subtype _))

/-- The dual series as a linear map into `Hd`. -/
def dualEH (hn : 4 ≤ n) : DualTuple N n →ₗ[ℂ] Hd (N := N) (n := n) hn :=
  (dualE hn).codRestrict _ (fun u => LinearMap.mem_range_self _ u)

theorem dualRQ_dualEH (hN : 3 ≤ N) (hn : 4 ≤ n) (u : DualTuple N n) : dualRQ hN hn (dualEH hn u) = dualS u := by
  apply DFinsupp.ext
  intro i
  apply Subtype.ext
  rw [dualS_apply]
  change ((∑ j : LineFaces N, DirectSum.lof ℂ (LineFaces N) (fun i => QDi N n i) j _) i : QDi N n i).1 = _
  rw [DFinsupp.finsetSum_apply, Finset.sum_eq_single i]
  · simp only [DirectSum.lof_eq_of, DirectSum.of_eq_same]
    change resLine i (dualE hn u) = _
    change resLine i (∑ j : LineFaces N, ∑ b : Bool, dualClassC N n (u j b) hn b j.rep) = _
    rw [map_sum, Finset.sum_eq_single i]
    · rw [map_sum, Fintype.sum_bool]
      rw [(dualCuspValues N n hN hn).self_conj, (dualCuspValues N n hN hn).self_hol, add_comm]
    · intro j _ hj
      rw [map_sum]
      exact Finset.sum_eq_zero fun b _ => (dualCuspValues N n hN hn).none _ _ _ b (no_dual_cell_of_ne N hj)
    · simp
  · intro j _ hj
    simp [DirectSum.lof_eq_of, DirectSum.of_eq_of_ne _ _ _ (Ne.symm hj)]
  · simp

/-- **`dualEisenstein` of S1's `GammaNC5FaceObligations`, instantiated** (`3 ≤ N`, `4 ≤ n`): for `Hd` the module generated by the dual series, `QDi i = 𝒞_Q(E^∨)` at the line face `i`,
`PD` the plane groups of the plane faces, `rQd`/`rPd` the line/plane restrictions: there is a linear `Td : ⨁ 𝒞_Q(E^∨) → PD` such that every `η` is the line coordinate of an element of `Hd`
whose plane coordinate is `Td η`.  The map `Td` is built from a linear section (not canonical). -/
theorem dualEisenstein_gammaN (hN : 3 ≤ N) (hn : 4 ≤ n) :
    ∃ Td : (⨁ i : LineFaces N, QDi N n i) →ₗ[ℂ] PDmod N n,
      ∀ η : ⨁ i : LineFaces N, QDi N n i, ∃ c' : Hd (N := N) (n := n) hn, dualRQ hN hn c' = η ∧ dualRP hn c' = Td η :=
  dualEisenstein_of_section (dualRP hn) (dualRQ hN hn) (dualEH hn) dualS (dualRQ_dualEH hN hn) dualS_surjective

end TernaryPeriodPolynomials.Argument.FormClassK
