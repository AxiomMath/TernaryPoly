module

public import TernaryPeriodPolynomials.BoundaryComparison.FormClass.Gamma.NDual
public import TernaryPeriodPolynomials.EisensteinSeries.Dual.FlagZero

@[expose] public section


/-!
# Admissibility of the dual classes: zero flag restrictions of the module `Hd`

Formalized by Claude Sonnet 5.5.
Paper: Lemma `ar:lem:stokes`.

* `DualZeroFlags c`: the complex dual class `c` restricts to zero on `Γ(N) ∩ h⁻¹Bh` for every `h ∈ SL₃(ℤ)` (every flag stabilizer; the complex analogue of `ZeroFlags`).
* `resToC_cxGen`: complex restriction commutes with the complexification of the real classes.
* `dualClassC_zeroFlags`: each complexified dual series `dualClassC` has zero flag restrictions (the `EisensteinDual.dual_rB_zero`).
* `dualZeroFlagsSubmodule`, `Hd_zeroFlags`: every element of `Hd` (the module generated by the dual series, `GammaNDual.Hd`) has zero flag restrictions, so `Hd` is the module of
  admissible dual classes required by the `decomp'` field of the `BoundaryFrame`.
-/

open scoped MatrixGroups DirectSum
open TernaryPeriodPolynomials.Argument.GammaNFacesFull TernaryPeriodPolynomials.Argument.GammaNFaces
open TernaryPeriodPolynomials.Argument.SeedC3S4c
open TernaryPeriodPolynomials.Argument.EisensteinClass TernaryPeriodPolynomials.Argument.SeedC3 TernaryPeriodPolynomials.Argument.ConvergenceC4
open TernaryPeriodPolynomials.Argument.EisensteinDual

noncomputable section
namespace TernaryPeriodPolynomials.Argument.FormClassK

variable (N : ℕ) [NeZero N] (n : ℕ)

/-- **Zero flag restrictions of a complex dual class**: `r_B c = 0` on the stabilizer `Γ(N) ∩ h⁻¹ B h` of every rational complete flag. -/
def DualZeroFlags (c : groupCohomology.H2 (Rep.of (dualRhoC N n))) : Prop :=
  ∀ h : SL(3, ℤ), resToC N n (ρ := dualRhoC N n) (gammaNBAt N h) (gammaNBAt_le_N N h) c = 0

omit [NeZero N] in
/-- Complex restriction commutes with complexification. -/
theorem resToC_cxGen (S : Subgroup SL(3, ℤ)) (hS : S ≤ gammaN N) (x : groupCohomology.H2 (Rep.of (dualRhoN N n))) :
    resToC N n (ρ := dualRhoC N n) S hS (cxGen (dualRhoN N n) (dualRhoC N n) (fun _ _ => rfl) x) =
      cxGen ((dualRhoN N n).comp (Subgroup.inclusion hS)) ((dualRhoC N n).comp (Subgroup.inclusion hS)) (fun _ _ => rfl)
        (resTo S hS (dualRhoN N n) x) :=
  (cxGen_map ((dualRhoN N n).comp (Subgroup.inclusion hS)) ((dualRhoC N n).comp (Subgroup.inclusion hS)) (fun _ _ => rfl)
    (dualRhoN N n) (dualRhoC N n) (fun _ _ => rfl) (Subgroup.inclusion hS) (fun _ => rfl) (fun _ => rfl) x).symm

/-- **The complexified dual series has zero flag restrictions** (`3 ≤ N`, `4 ≤ n`; any line cusp, either seed). -/
theorem dualClassC_zeroFlags (hN : 3 ≤ N) (hn : 4 ≤ n) (f : CuspForm (leviGroup N) ((n + 3 : ℕ) : ℤ)) (b : Bool) (h' : SL(3, ℤ)) :
    DualZeroFlags N n (dualClassC N n f hn b h') := by
  intro h
  rw [dualClassC_eq_cxGen, resToC_cxGen, EisensteinDual.dual_rB_zero N n f hN hn b h' h]
  exact map_zero _

/-- The submodule of complex dual classes with zero flag restrictions. -/
def dualZeroFlagsSubmodule : Submodule ℂ (groupCohomology.H2 (Rep.of (dualRhoC N n))) :=
  ⨅ h : SL(3, ℤ), LinearMap.ker (resToC N n (ρ := dualRhoC N n) (gammaNBAt N h) (gammaNBAt_le_N N h))

omit [NeZero N] in
theorem mem_dualZeroFlagsSubmodule {c : groupCohomology.H2 (Rep.of (dualRhoC N n))} :
    c ∈ dualZeroFlagsSubmodule N n ↔ DualZeroFlags N n c := by
  simp [dualZeroFlagsSubmodule, DualZeroFlags, Submodule.mem_iInf]

/-- **Admissibility of `Hd`**: every element of the module generated by the dual series has zero flag restrictions. -/
theorem Hd_zeroFlags (hN : 3 ≤ N) (hn : 4 ≤ n) (c : Hd (N := N) (n := n) hn) : DualZeroFlags N n c.1 := by
  obtain ⟨u, hu⟩ := c.2
  rw [← mem_dualZeroFlagsSubmodule, ← hu]
  change (∑ j : LineFaces N, ∑ b : Bool, dualClassC N n (u j b) hn b j.rep) ∈ _
  refine Submodule.sum_mem _ fun j _ => Submodule.sum_mem _ fun b _ => ?_
  exact (mem_dualZeroFlagsSubmodule N n).2 (dualClassC_zeroFlags N n hN hn _ b _)

/-- `Hd` is contained in the zero-flag submodule. -/
theorem Hd_le_zeroFlags (hN : 3 ≤ N) (hn : 4 ≤ n) :
    LinearMap.range (dualE (N := N) (n := n) hn) ≤ dualZeroFlagsSubmodule N n := fun c hc =>
  (mem_dualZeroFlagsSubmodule N n).2 (Hd_zeroFlags N n hN hn ⟨c, hc⟩)

end TernaryPeriodPolynomials.Argument.FormClassK
